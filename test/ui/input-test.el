;;; input-test.el --- GUI tests: paced clicks, keys, typing, targets -*- lexical-binding: t -*-
(require 'ert)
(require 'drgnx-uitest)

(defun drgnx-test--lines-buffer ()
  "Show a fresh buffer with 60 numbered lines in a single window; return it."
  (let ((buf (get-buffer-create "*drgnx-lines*")))
    (with-current-buffer buf
      (erase-buffer)
      (dotimes (i 60) (insert (format "line %02d\n" i)))
      (goto-char (point-min)))
    (delete-other-windows)
    (switch-to-buffer buf)
    (redisplay t)
    buf))

(ert-deftest drgnx-ui-input/click-by-pixel-moves-point ()
  (drgnx-test--lines-buffer)
  (let* ((w (selected-window))
         (body (window-body-pixel-edges w))
         (lh (default-line-height))
         (x (+ (nth 0 body) 10))
         (y (+ (nth 1 body) (* 10 lh) (/ lh 2))))
    (should (eq (plist-get (drgnx-uitest-run (drgnx-uitest-click-events (drgnx-uitest-posn x y))) :settled) t))
    (should (equal (buffer-substring (pos-bol) (pos-eol)) "line 10"))))

(ert-deftest drgnx-ui-input/click-by-target ()
  (drgnx-test--lines-buffer)
  (let ((xy (drgnx-uitest-target-xy "*drgnx-lines*" "line 25")))
    (drgnx-uitest-run (drgnx-uitest-click-events (drgnx-uitest-posn (car xy) (cdr xy))))
    (should (equal (buffer-substring (pos-bol) (pos-eol)) "line 25"))))

(ert-deftest drgnx-ui-input/target-by-major-mode ()
  (drgnx-test--lines-buffer)
  (should (eq (drgnx-uitest-find-window "fundamental-mode") (selected-window))))

(ert-deftest drgnx-ui-input/target-not-visible-errors ()
  (drgnx-test--lines-buffer)
  (should-error (drgnx-uitest-target-xy "*drgnx-lines*" "line 99"))
  (should-error (drgnx-uitest-target-xy "*no-such-buffer*" "x")))

(ert-deftest drgnx-ui-input/keys-and-typing ()
  (with-current-buffer (get-buffer-create "*drgnx-type*") (erase-buffer))
  (delete-other-windows)
  (switch-to-buffer "*drgnx-type*")
  (drgnx-uitest-run (append (drgnx-uitest-type-events "he said \"hi\" ✓")
                            (drgnx-uitest-key-events "C-a C-k")))
  (should (equal (buffer-string) ""))
  (should (equal (current-kill 0) "he said \"hi\" ✓")))

(ert-deftest drgnx-ui-input/target-beyond-the-right-edge-errors ()
  (let ((buf (get-buffer-create "*drgnx-wide*")))
    (with-current-buffer buf
      (erase-buffer) (setq truncate-lines t)
      (insert (make-string 400 ?x) "FARAWAY\n") (goto-char (point-min)))
    (delete-other-windows)
    (switch-to-buffer buf)
    (redisplay t)
    (should-error (drgnx-uitest-target-xy "*drgnx-wide*" "FARAWAY"))))

(ert-deftest drgnx-ui-input/target-skips-invisible-text ()
  (let ((buf (get-buffer-create "*drgnx-invisible*")))
    (with-current-buffer buf
      (erase-buffer)
      (insert "aaa HIDDEN bbb HIDDEN ccc\n")
      (overlay-put (make-overlay 5 11) 'invisible t)
      (goto-char (point-min)))
    (delete-other-windows)
    (switch-to-buffer buf)
    (redisplay t)
    (let ((xy (drgnx-uitest-target-xy "*drgnx-invisible*" "HIDDEN")))
      (drgnx-uitest-run (drgnx-uitest-click-events (drgnx-uitest-posn (car xy) (cdr xy))))
      (should (= (point) 16)))                       ; the second, visible HIDDEN
    (with-current-buffer buf (overlay-put (make-overlay 16 22) 'invisible t))
    (redisplay t)
    (should-error (drgnx-uitest-target-xy "*drgnx-invisible*" "HIDDEN"))))

(defun drgnx-test--record-clicks ()
  "In the current buffer, record clicks and drags into the returned list cell."
  (let ((log (list nil)) (map (make-sparse-keymap)))
    (define-key map [down-mouse-1] #'ignore)
    (define-key map [mouse-1] (lambda (_e) (interactive "e") (push 'click (car log))))
    (define-key map [drag-mouse-1] (lambda (_e) (interactive "e") (push 'drag (car log))))
    (use-local-map map)
    log))

(ert-deftest drgnx-ui-input/release-on-moved-content-is-a-drag ()
  ;; Emacs makes a release a drag when the text under the pointer changed since the press —
  ;; the Explorer moving under a held button (how a click once moved a file).
  (drgnx-test--lines-buffer)
  (let ((log (drgnx-test--record-clicks))
        (xy (drgnx-uitest-target-xy "*drgnx-lines*" "line 05"))
        (win (selected-window)))
    (run-with-timer 0.1 nil (lambda () (set-window-start win (with-current-buffer (window-buffer win)
                                                                (save-excursion (goto-char (point-min))
                                                                                (forward-line 3) (point))))))
    (drgnx-uitest-run (drgnx-uitest-click-events (drgnx-uitest-posn (car xy) (cdr xy)) 1 1 0.3))
    (use-local-map nil)
    (should (equal (car log) '(drag)))))

(ert-deftest drgnx-ui-input/release-on-same-content-is-a-click ()
  (drgnx-test--lines-buffer)
  (let ((log (drgnx-test--record-clicks))
        (xy (drgnx-uitest-target-xy "*drgnx-lines*" "line 05")))
    (drgnx-uitest-run (drgnx-uitest-click-events (drgnx-uitest-posn (car xy) (cdr xy)) 1 1 0.3))
    (use-local-map nil)
    (should (equal (car log) '(click)))))
