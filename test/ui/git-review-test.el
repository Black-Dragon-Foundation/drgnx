;;; git-review-test.el --- GUI tests: the diff view, inline blame, the Review and Pull Requests tabs on a graphical frame (run by `drgnx test --ui') -*- lexical-binding: t -*-
(require 'ert)
(require 'drgnx-uitest)

(defconst drgnx-git-ui-test--repo                           ; the session runs the repository's test/ui
  (expand-file-name "../../" (file-name-as-directory (or (getenv "DRGNX_UI_TEST") default-directory))))
(add-to-list 'load-path (expand-file-name "core" drgnx-git-ui-test--repo))
(require 'drgnx-agents)
;; loaded before the test stubs `drgnx-agents-mirror-start': `drgnx-review-branch' requires it, and a first load
;; inside the stub's `cl-letf' would put the real function (a hub call) back
(require 'drgnx-agents-mirror)
(require 'drgnx-job)
(load (expand-file-name "test/fixtures/git-fixture" drgnx-git-ui-test--repo) nil t)
(load (expand-file-name "test/fixtures/wait-fixture" drgnx-git-ui-test--repo) nil t)
(dolist (m '("tools/drgnx-diff" "extra/drgnx-blame" "tools/drgnx-review" "tools/drgnx-prs"))
  (load (expand-file-name (concat "modules/" m) drgnx-git-ui-test--repo) nil t))

(defun drgnx-git-ui-test--wait (pred &optional secs)
  (drgnx-test-wait pred :secs (max 30 (or secs 0)) :what "the git GUI test's predicate"))

(defun drgnx-git-ui-test--shot (dir name)
  (let ((shot (plist-get (drgnx-uitest-capture dir) :root)) (out (expand-file-name name temporary-file-directory)))
    (should (file-exists-p shot))
    (copy-file shot out t)
    (message "git and review screenshot: %s" out)))

(ert-deftest drgnx-ui-git/diff-blame-review-prs ()
  (let ((root (drgnx-uitest-root-frame)) (dir (make-temp-file "drgnx-git-shot" t)))
    (unwind-protect
        (drgnx-git-test-with-repo
          (drgnx-git-test-write repo "src/parser.el" (mapconcat (lambda (i) (format "(defun step-%d () \"Step %d.\" %d)\n" i i i)) (number-sequence 1 60) ""))
          (drgnx-git-test repo "add" "-A") (drgnx-git-test repo "commit" "-q" "-m" "Start the parser")
          (drgnx-git-test repo "checkout" "-q" "-b" "feature")
          (drgnx-git-test-write repo "src/parser.el" (mapconcat (lambda (i) (format (if (memq i '(5 30)) "(defun step-%d () \"Step %d, faster.\" (* 2 %d))\n" "(defun step-%d () \"Step %d.\" %d)\n") i i i)) (number-sequence 1 60) ""))
          (drgnx-git-test-write repo "README" "A parser.\n")
          (drgnx-git-test repo "add" "-A") (drgnx-git-test repo "commit" "-q" "-m" "Make two steps faster")
          (with-selected-frame root
            (delete-other-windows)
            (let ((default-directory repo))
              ;; the diff view: the branch against main, split, then folded
              (drgnx-diff-branch)
              (let ((buf (current-buffer)))
                (should (drgnx-git-ui-test--wait (lambda () (null (buffer-local-value 'drgnx-diff--proc buf)))))
                (should (eq (window-buffer (selected-window)) buf))
                (should (string-search "src/parser.el" (buffer-string)))
                (drgnx-diff-toggle-layout)
                (redisplay t)
                (should (string-search " │ " (buffer-string)))
                (should-not (seq-some (lambda (l) (> (string-width l) (window-body-width))) (split-string (buffer-string) "\n")))
                (drgnx-git-ui-test--shot dir "git-diff-split.png")
                (drgnx-diff-collapse-all)
                (should-not (string-search "faster" (buffer-string)))
                (kill-buffer buf))
              ;; inline blame on line 5
              (find-file (expand-file-name "src/parser.el" repo))
              (drgnx-blame-mode 1)
              (goto-char (point-min)) (forward-line 4)
              (drgnx-blame--update)
              (should (drgnx-git-ui-test--wait (lambda () (and drgnx-blame--overlay (overlay-buffer drgnx-blame--overlay)
                                                               (string-search "Make two steps faster" (overlay-get drgnx-blame--overlay 'after-string))))))
              (redisplay t)
              ;; the Review tab, from a reviewer that answers with two findings
              (let* ((s (drgnx-agents--make :id "ui-rev" :name "reviewer" :status 'idle :conn 'fake :cwd repo))
                     (drgnx-review--runs (make-hash-table :test #'equal)) (drgnx-review--current nil))
                (cl-letf (((symbol-function 'drgnx-agents-mirror-start) (lambda (&rest _) s))
                          ((symbol-function 'drgnx-agents-deliver) (lambda (&rest _) t))
                          ((symbol-function 'drgnx-agents-kill) #'ignore))
                  (drgnx-review-branch)
                  (drgnx-review--changed s)
                  (setf (drgnx-agent-session-entries s)
                        (list (list :type 'user :text "[drgnx review] …")
                              (list :type 'agent :text "FINDING: src/parser.el:30: important: doubling changes the result\nFINDING: README:1: minor: say what it parses\nVERDICT: fail" :done t)
                              (list :type 'stop :stop "end_turn" :done t)))
                  (drgnx-review--changed s)
                  (redisplay t)
                  (should (get-buffer-window "*drgnx review*" root))
                  (should (string-search "feature vs main · 2 findings · fail" (with-current-buffer "*drgnx review*" (buffer-string))))
                  (drgnx-git-ui-test--shot dir "git-review-tab.png")))
              ;; the Pull Requests tab, forge's answer stubbed: a stack of two
              (cl-letf (((symbol-function 'drgnx-prs--pullreqs)
                         (lambda (_) (list (list :number 12 :title "Faster steps" :author "ada" :state 'open :base "main" :head "feature" :updated "2026-10-17T09:00:00Z")
                                           (list :number 13 :title "Docs for the steps" :author "bob" :state 'draft :base "feature" :head "docs" :updated "2026-10-17T10:00:00Z")))))
                (drgnx-prs-view)
                (redisplay t)
                (should (get-buffer-window "*drgnx pull requests*" root))
                (should (string-search "└ Docs for the steps" (with-current-buffer "*drgnx pull requests*" (buffer-string))))))))
      (dolist (b '("*drgnx review*" "*drgnx pull requests*")) (when (get-buffer b) (kill-buffer b)))
      (delete-directory dir t))))

;;; git-review-test.el ends here
