;;; extensions-details-test.el --- batch tests: the Extensions details page, generations and the Settings links -*- lexical-binding: t -*-
;; test-class: det
;; The hub and the job layer are stubbed (`cl-letf'); files are made in the test's own temp directories.  See
;; docs/guide/extensions.md.
(require 'ert)
(require 'cl-lib)
(require 'drgnx-paths)
(require 'drgnx-view)
(require 'drgnx-settings-page)
(load (expand-file-name "modules/tools/drgnx-extensions-list" drgnx-dir) nil t)
(load (expand-file-name "modules/tools/drgnx-extensions-details" drgnx-dir) nil t)

(defmacro drgnx-extensions-details-test--with (&rest body)
  "BODY with no hub: the details call goes nowhere; every details buffer is killed after."
  (declare (indent 0) (debug t))
  `(unwind-protect
       (cl-letf (((symbol-function 'drgnx-hub-call) (lambda (&rest _) nil)))
         (unless (drgnx-view-type-p 'extension-details) (drgnx-extensions-details--define-view))
         ,@body)
     (dolist (b (buffer-list))
       (when (string-prefix-p "*Extension" (buffer-name b)) (kill-buffer b)))
     (drgnx-view--undefine 'extension-details)))

(ert-deftest drgnx-extensions/an-installed-readme-is-plain-text ()
  (let* ((elpa (drgnx-elpa-dir)) (dir (expand-file-name "foo-1.0/" elpa)))
    (make-directory dir t)
    (unwind-protect
        (progn
          (with-temp-file (expand-file-name "foo.el" dir)
            (insert ";;; foo.el --- a fixture  -*- lexical-binding: t -*-\n;;; Commentary:\n;; Does foo things.\n;;\n;; More.\n;;; Code:\n(provide 'foo)\n"))
          (with-temp-file (expand-file-name "README.org" dir)
            (insert "-*- eval: (setq drgnx-extensions-test-x 1) -*-\n#+TITLE: Foo\n#+begin_src elisp\n(setq drgnx-extensions-test-x 2)\n#+end_src\n"))
          (let ((calls nil))
            (cl-letf (((symbol-function 'org-mode) (lambda () (push 'org-mode calls)))
                      ((symbol-function 'set-auto-mode) (lambda (&rest _) (push 'set-auto-mode calls)))
                      ((symbol-function 'hack-local-variables) (lambda (&rest _) (push 'hack-local-variables calls))))
              (let ((text (drgnx-extensions-details-readme-text "foo")))
                (should (string-search "Does foo things." text))
                (should (string-search "#+begin_src elisp" text))
                (should-not (text-properties-at 0 text))
                (should-not (next-property-change 0 text))))
            (should-not calls)
            (should-not (boundp 'drgnx-extensions-test-x))))
      (delete-directory dir t))))

(ert-deftest drgnx-extensions/the-preview-tab-is-replaced ()
  (drgnx-extensions-details-test--with
    (let ((a (drgnx-extensions-details-open "pkg:a")))
      (should (eq (drgnx-extensions-details-open "pkg:b") a))
      (should (equal (buffer-local-value 'drgnx-extensions-details--id a) "pkg:b"))
      (let ((pinned (drgnx-extensions-details-open "pkg:b" t)))
        (should (equal (buffer-name pinned) "*Extension: b*"))
        (let ((next (drgnx-extensions-details-open "pkg:c")))
          (should-not (eq next pinned))
          (should (equal (buffer-local-value 'drgnx-extensions-details--id pinned) "pkg:b"))
          (should (equal (buffer-local-value 'drgnx-extensions-details--id next) "pkg:c"))
          (should (= 2 (length (seq-filter (lambda (b) (string-prefix-p "*Extension" (buffer-name b))) (buffer-list))))))))))

(ert-deftest drgnx-extensions/another-version-queues-that-version ()
  (let (queued)
    (cl-letf (((symbol-function 'drgnx-extensions-jobs-queue) (lambda (entry) (push entry queued) 1))
              ;; a source the trust layer lets through at once
              ((symbol-function 'drgnx-extensions-trust-before-install) (lambda (_id then) (funcall then))))
      (drgnx-extensions-details-install-version "pkg:a" "1.0")
      (should (equal queued '((:add a :version "1.0")))))))

(ert-deftest drgnx-extensions/the-versions-offered-are-the-cached-ones ()
  (let ((dir (drgnx-package-cache-dir)))
    (make-directory dir t)
    (dolist (f '("magit-3.9.tar" "magit-4.1.tar" "magit-section-4.1.tar" "other-1.0.el"))
      (with-temp-file (expand-file-name f dir) (insert "x")))
    (unwind-protect
        (should (equal (drgnx-extensions-details-versions "magit" "4.1") '("3.9")))
      (dolist (f '("magit-3.9.tar" "magit-4.1.tar" "magit-section-4.1.tar" "other-1.0.el"))
        (delete-file (expand-file-name f dir))))))

(ert-deftest drgnx-extensions/settings-lists-wants-read-only ()
  (cl-letf (((symbol-function 'drgnx-pkg-read-lock)
             (lambda () '((magit :version "4.1" :wanted user) (dash :version "2.19") (forge :version "0.4" :wanted user)))))
    (let ((line (drgnx-settings-page-wants-line)))
      (should (string-search "magit, forge" line))
      (should-not (string-search "dash" line))
      (should (string-search "read-only" line)))
    (let ((area (drgnx-settings-page--extensions-line '(area . extensions)))
          (pkg (drgnx-settings-page--extensions-line '(package . magit))))
      (should (string-search "magit, forge" area))
      (should (string-search "[Extensions]" area))
      (should (string-search "magit 4.1" pkg))
      (should (string-search "[Extensions]" pkg)))
    (should (equal (drgnx-settings-page--extensions-line '(area . editor)) ""))))

(ert-deftest drgnx-extensions/why-names-every-reason ()
  (cl-letf (((symbol-function 'drgnx-extensions-details--ensure-site) (lambda (_name) "config.el:31")))
    (should (equal (drgnx-extensions-details-why-text '("you" (:needed-by ("forge")) "ensure") "magit")
                   "Why: you (Extensions) · needed by forge · config.el:31 (:ensure)"))
    (should (equal (drgnx-extensions-details-why-text '((:module "tools/git") "packages-eld" "by-hand") "magit")
                   "Why: module tools/git · packages.eld · installed by hand"))
    (should (equal (drgnx-extensions-details-why-text nil "magit") nil))))

(ert-deftest drgnx-extensions/compare-links-per-forge ()
  (should (equal (drgnx-extensions-details-compare-url "https://github.com/magit/magit.git" "aaa" "bbb")
                 "https://github.com/magit/magit/compare/aaa...bbb"))
  (should (equal (drgnx-extensions-details-compare-url "https://gitlab.com/o/r/" "aaa" "bbb")
                 "https://gitlab.com/o/r/-/compare/aaa...bbb"))
  (should (equal (drgnx-extensions-details-compare-url "https://codeberg.org/o/r" "aaa" "bbb")
                 "https://codeberg.org/o/r/compare/aaa...bbb"))
  (should (equal (drgnx-extensions-details-compare-url "https://git.sr.ht/~o/r" "aaa" "bbb")
                 "https://git.sr.ht/~o/r/log/aaa..bbb"))
  (should-not (drgnx-extensions-details-compare-url "https://example.invalid/o/r" "aaa" "bbb"))
  (should-not (drgnx-extensions-details-compare-url nil "aaa" "bbb")))

(ert-deftest drgnx-extensions/a-module-toggle-writes-the-setting ()
  (let (commits)
    (cl-letf (((symbol-function 'drgnx-settings-editors-commit)
               (lambda (var tab root value) (push (list var tab root value) commits)))
              ((symbol-function 'drgnx-module-default-off-p) (lambda (m) (eq m 'tools/optional)))
              ((symbol-function 'drgnx-module-disabled-p) (lambda (m &rest _) (memq m '(tools/optional tools/off-by-user)))))
      (let ((drgnx-modules-disabled '(tools/off-by-user)) (drgnx-modules-enabled nil))
        ;; a module that is on by default and off: back on, out of the disabled list
        (drgnx-extensions-details-toggle-module 'tools/off-by-user)
        (should (equal (pop commits) '(drgnx-modules-disabled user nil nil)))
        ;; one that is on: into the disabled list
        (drgnx-extensions-details-toggle-module 'tools/running)
        (should (equal (pop commits) '(drgnx-modules-disabled user nil (tools/off-by-user tools/running))))
        ;; one that is off until chosen: into the enabled list
        (drgnx-extensions-details-toggle-module 'tools/optional)
        (should (equal (pop commits) '(drgnx-modules-enabled user nil (tools/optional))))))))

(ert-deftest drgnx-extensions/generations-mark-the-ones-in-use ()
  (let ((gens (drgnx-generations-dir)))
    (dolist (n '(1 2))
      (let ((d (expand-file-name (number-to-string n) gens)))
        (make-directory d t)
        (with-temp-file (expand-file-name "generation.eld" d)
          (insert (format "(:time \"2026-11-0%dT10:00:00+0000\" :note \"note %d\")\n" n n)))
        (with-temp-file (expand-file-name "drgnx.lock.eld" d)
          (insert (format "(:version 1 :packages ((magit :version \"4.%d\") (dash :version \"2.19\")))\n" n)))))
    (unwind-protect
        (cl-letf (((symbol-function 'drgnx-pkg-generations-in-use) (lambda (&optional _) '(1)))
                  ((symbol-function 'drgnx-pkg-current-generation) (lambda () 2))
                  ((symbol-function 'drgnx-pkg-copies-p) (lambda () t)))
          (let ((rows (drgnx-extensions-details-generations)))
            (should (equal (mapcar (lambda (r) (plist-get r :n)) rows) '(2 1)))
            (should (equal (mapcar (lambda (r) (plist-get r :in-use)) rows) '(nil t)))
            (should (equal (mapcar (lambda (r) (plist-get r :current)) rows) '(t nil)))
            (should (equal (plist-get (car rows) :differs) '("magit 4.1 → 4.2")))
            (let ((text (substring-no-properties (drgnx-extensions-details-generation-row 1))))
              (should (string-search "in use" text))
              (should (string-search "note 1" text)))
            (should (string-search "copies the packages twice" (drgnx-extensions-details-copies-note)))))
      (dolist (n '(1 2)) (delete-directory (expand-file-name (number-to-string n) gens) t)))))

