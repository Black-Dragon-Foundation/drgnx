;;; mod-commit-message-test.el --- batch tests: Git: Generate Commit Message — the staged diff, the chat role, no trailers -*- lexical-binding: t -*-
(require 'ert)
(require 'drgnx)
(load (expand-file-name "test/fixtures/git-fixture" drgnx-dir) nil t)
(load (expand-file-name "modules/tools/drgnx-commit-message" drgnx-dir) nil t)

(unless (fboundp 'git-commit-mode)                         ; magit's commit buffer, when magit is not here
  (define-minor-mode git-commit-mode "A stand-in for magit's commit message mode."))

(defmacro drgnx-commit-message-test--in (text answer &rest body)
  "BODY in a commit message buffer holding TEXT in a repo with a staged change; the chat role answers ANSWER
\(a string, or (nil INFO))."
  (declare (indent 2))
  `(drgnx-git-test-with-repo
     (drgnx-git-test-write repo "a.txt" "one\n")
     (drgnx-git-test repo "add" "-A") (drgnx-git-test repo "commit" "-q" "-m" "Start the file")
     (drgnx-git-test-write repo "a.txt" "one\ntwo\n")
     (drgnx-git-test repo "add" "-A")
     (let ((requests nil) (msgs nil))
       (cl-letf (((symbol-function 'drgnx-ai-request)
                  (lambda (role kind payload cb &rest _)
                    (push (list role kind payload) requests)
                    (let ((a ,answer)) (if (stringp a) (funcall cb a '(:provider x)) (apply cb a)))
                    nil))
                 ((symbol-function 'message) (lambda (fmt &rest args) (push (apply #'format fmt args) msgs))))
         (with-temp-buffer
           (setq default-directory repo)
           (insert ,text)
           (git-commit-mode 1)
           ,@body)))))

(ert-deftest drgnx-commit-message/payload-carries-diff-and-style ()
  (let* ((subjects (mapcar (lambda (i) (format "Subject %d" i)) (number-sequence 1 10)))
         (msgs (plist-get (drgnx-commit-message--payload "DIFF" subjects) :messages))
         (system (plist-get (aref msgs 0) :content)))
    (should (equal (plist-get (aref msgs 0) :role) "system"))
    (should (string-search "at most 72 characters" system))
    (should (string-search "No trailers, no Co-authored-by" system))
    (dolist (s subjects) (should (string-search s system)))
    (should (equal (plist-get (aref msgs 1) :content) "DIFF"))))

(ert-deftest drgnx-commit-message/huge-diffs-are-cut ()
  (let ((user (plist-get (aref (plist-get (drgnx-commit-message--payload (make-string 30000 ?a) nil) :messages) 1) :content)))
    (should (string-suffix-p "\n[diff truncated]" user))
    (should (= (length user) (+ 24000 (length "\n[diff truncated]"))))))

(ert-deftest drgnx-commit-message/clean-strips-trailers-and-fences ()
  (should (equal (drgnx-commit-message--clean "```\nFix x\n\nCo-authored-by: A <a@b>\nSigned-off-by: B\n```") "Fix x"))
  (should (equal (drgnx-commit-message--clean "\n\nAdd y\n\nBecause z.\nGenerated by a tool\n") "Add y\n\nBecause z.")))

(ert-deftest drgnx-commit-message/fills-an-empty-message ()
  (drgnx-commit-message-test--in "\n# Please enter the commit message\n" "Add two\n\nCo-authored-by: Bot <b@t>"
    (drgnx-commit-message-generate)
    (should (string-prefix-p "Add two\n# Please enter" (buffer-string)))
    (pcase-let ((`(,role ,kind ,payload) (car requests)))
      (should (eq role 'chat)) (should (eq kind 'chat))
      (should (string-search "+two" (plist-get (aref (plist-get payload :messages) 1) :content)))
      (should (string-search "Start the file" (plist-get (aref (plist-get payload :messages) 0) :content))))))

(ert-deftest drgnx-commit-message/keeps-what-you-wrote ()
  (drgnx-commit-message-test--in "My text\n# Please enter\n" "Add two"
    (drgnx-commit-message-generate)
    (should (equal (buffer-string) "My text\n# Please enter\n"))
    (should (equal (car kill-ring) "Add two"))
    (should (seq-some (lambda (m) (string-search "kill ring" m)) msgs))))

(ert-deftest drgnx-commit-message/failures-leave-the-buffer-alone ()
  (drgnx-commit-message-test--in "\n# Please\n" '(nil (:error "openrouter: no key"))
    (drgnx-commit-message-generate)
    (should (equal (buffer-string) "\n# Please\n"))
    (should (seq-some (lambda (m) (string-search "openrouter: no key" m)) msgs))
    (drgnx-git-test repo "commit" "-q" "-m" "Add two")                     ; nothing staged now
    (should (string-match-p "Nothing staged" (cadr (should-error (drgnx-commit-message-generate) :type 'user-error)))))
  (with-temp-buffer
    (should-error (drgnx-commit-message-generate) :type 'user-error)))

;;; mod-commit-message-test.el ends here
