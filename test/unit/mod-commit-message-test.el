;;; mod-commit-message-test.el --- batch tests: Git: Generate Commit Message — the staged diff, the chat role, no trailers -*- lexical-binding: t -*-
(require 'ert)
(require 'drgnx)
(require 'drgnx-ai-client)                                  ; loaded here: the command's lazy require would undo the mock
(load (expand-file-name "test/fixtures/git-fixture" drgnx-dir) nil t)
(load (expand-file-name "modules/tools/drgnx-commit-message" drgnx-dir) nil t)

(unless (fboundp 'git-commit-mode)                         ; magit's commit buffer, when magit is not here
  (define-minor-mode git-commit-mode "A stand-in for magit's commit message mode."))

(defmacro drgnx-commit-message-test--in (text answer &rest body)
  "BODY in a commit message buffer holding TEXT in a repo with a staged change; the chat role answers ANSWER
\(a string, or (nil INFO))."
  (declare (indent 2))
  `(drgnx-git-test-with-repo
     (drgnx-git-test-write repo "a.txt" "one\n")
     (drgnx-git-test repo "add" "-A") (drgnx-git-test repo "commit" "-q" "-m" "Start the file")
     (drgnx-git-test-write repo "a.txt" "one\ntwo\n")
     (drgnx-git-test repo "add" "-A")
     (let ((requests nil) (msgs nil))
       (cl-letf (((symbol-function 'drgnx-ai-request)
                  (lambda (role kind payload cb &rest _)
                    (push (list role kind payload) requests)
                    (let ((a ,answer)) (if (stringp a) (funcall cb a '(:provider x)) (apply cb a)))
                    nil))
                 ((symbol-function 'message) (lambda (fmt &rest args) (push (apply #'format fmt args) msgs))))
         (with-temp-buffer
           (setq default-directory repo)
           (insert ,text)
           (git-commit-mode 1)
           ,@body)))))

(ert-deftest drgnx-commit-message/payload-carries-diff-and-style ()
  (let* ((subjects (mapcar (lambda (i) (format "Subject %d" i)) (number-sequence 1 10)))
         (msgs (plist-get (drgnx-commit-message--payload "DIFF" subjects) :messages))
         (system (plist-get (aref msgs 0) :content)))
    (should (equal (plist-get (aref msgs 0) :role) "system"))
    (should (string-search "at most 72 characters" system))
    (should (string-search "No trailers, no Co-authored-by" system))
    (dolist (s subjects) (should (string-search s system)))
    (should (equal (plist-get (aref msgs 1) :content) "DIFF"))))

(ert-deftest drgnx-commit-message/huge-diffs-are-cut ()
  (let ((user (plist-get (aref (plist-get (drgnx-commit-message--payload (make-string 30000 ?a) nil) :messages) 1) :content)))
    (should (string-suffix-p "\n[diff truncated]" user))
    (should (= (length user) (+ 24000 (length "\n[diff truncated]"))))))

(ert-deftest drgnx-commit-message/clean-strips-trailers-and-fences ()
  (should (equal (drgnx-commit-message--clean "```\nFix x\n\nCo-authored-by: A <a@b>\nSigned-off-by: B\n```") "Fix x"))
  (should (equal (drgnx-commit-message--clean "\n\nAdd y\n\nBecause z.\nGenerated by a tool\n") "Add y\n\nBecause z.")))

(ert-deftest drgnx-commit-message/fills-an-empty-message ()
  (drgnx-commit-message-test--in "\n# Please enter the commit message\n" "Add two\n\nCo-authored-by: Bot <b@t>"
    (drgnx-commit-message-generate)
    (should (string-prefix-p "Add two\n# Please enter" (buffer-string)))
    (pcase-let ((`(,role ,kind ,payload) (car requests)))
      (should (eq role 'chat)) (should (eq kind 'chat))
      (should (string-search "+two" (plist-get (aref (plist-get payload :messages) 1) :content)))
      (should (string-search "Start the file" (plist-get (aref (plist-get payload :messages) 0) :content))))))

(ert-deftest drgnx-commit-message/keeps-what-you-wrote ()
  (drgnx-commit-message-test--in "My text\n# Please enter\n" "Add two"
    (drgnx-commit-message-generate)
    (should (equal (buffer-string) "My text\n# Please enter\n"))
    (should (equal (car kill-ring) "Add two"))
    (should (seq-some (lambda (m) (string-search "kill ring" m)) msgs))))

(ert-deftest drgnx-commit-message/failures-leave-the-buffer-alone ()
  (drgnx-commit-message-test--in "\n# Please\n" '(nil (:error "openrouter: no key"))
    (drgnx-commit-message-generate)
    (should (equal (buffer-string) "\n# Please\n"))
    (should (seq-some (lambda (m) (string-search "openrouter: no key" m)) msgs))
    (drgnx-git-test repo "commit" "-q" "-m" "Add two")                     ; nothing staged now
    (should (string-match-p "Nothing staged" (cadr (should-error (drgnx-commit-message-generate) :type 'user-error)))))
  (with-temp-buffer
    (should-error (drgnx-commit-message-generate) :type 'user-error)))

;; review fixes (M11b final review)
(ert-deftest drgnx-commit-message/no-tool-lines-of-any-spelling ()
  ;; I7
  (should (equal (drgnx-commit-message--clean "Fix x\n\n🤖 Generated with [Claude Code](https://claude.ai/code)\ngenerated by some tool\nCreated with an assistant") "Fix x")))

(defmacro drgnx-commit-message-test--kind (kind &rest body)
  "BODY with the commit being written taken to be of KIND (`amend', `all' or nil)."
  (declare (indent 1))
  `(cl-letf (((symbol-function 'drgnx-commit-message--kind) (lambda (_root) ,kind))) ,@body))

(ert-deftest drgnx-commit-message/amend-describes-the-whole-commit ()
  ;; M11b-11: git commit --amend: the message is for HEAD's change plus what is staged now
  (drgnx-git-test-with-repo
    (drgnx-git-test-write repo "a.txt" "one\n")
    (drgnx-git-test repo "add" "-A") (drgnx-git-test repo "commit" "-q" "-m" "Start")
    (drgnx-git-test-write repo "b.txt" "head change\n")
    (drgnx-git-test repo "add" "-A") (drgnx-git-test repo "commit" "-q" "-m" "Add b")
    (drgnx-git-test-write repo "a.txt" "one\nstaged now\n")
    (drgnx-git-test repo "add" "-A")
    (let ((plain (drgnx-commit-message--diff repo nil))
          (amend (drgnx-commit-message-test--kind 'amend (drgnx-commit-message--diff repo nil))))
      (should-not (string-search "head change" plain))
      (should (string-search "staged now" plain))
      (should (string-search "head change" amend))
      (should (string-search "staged now" amend)))))

(ert-deftest drgnx-commit-message/amending-the-first-commit ()
  (drgnx-git-test-with-repo
    (drgnx-git-test-write repo "a.txt" "root content\n")
    (drgnx-git-test repo "add" "-A") (drgnx-git-test repo "commit" "-q" "-m" "Start")
    (should (string-search "root content" (drgnx-commit-message-test--kind 'amend (drgnx-commit-message--diff repo nil))))))

(ert-deftest drgnx-commit-message/all-describes-the-unstaged-changes-too ()
  ;; M11b-11: git commit -a commits tracked changes that are not staged
  (drgnx-git-test-with-repo
    (drgnx-git-test-write repo "a.txt" "one\n")
    (drgnx-git-test repo "add" "-A") (drgnx-git-test repo "commit" "-q" "-m" "Start")
    (drgnx-git-test-write repo "a.txt" "one\nunstaged\n")
    (should (string-blank-p (drgnx-commit-message--diff repo nil)))
    (should (string-search "unstaged" (drgnx-commit-message-test--kind 'all (drgnx-commit-message--diff repo nil))))))

(ert-deftest drgnx-commit-message/first-commit-has-a-diff ()
  ;; M11b-11: no HEAD yet: the index against the empty tree, in every mode
  (drgnx-git-test-with-repo
    (drgnx-git-test-write repo "a.txt" "brand new\n")
    (drgnx-git-test repo "add" "-A")
    (dolist (kind '(nil all))
      (should (string-search "brand new" (drgnx-commit-message-test--kind kind (drgnx-commit-message--diff repo nil)))))))

(ert-deftest drgnx-commit-message/kind-from-magit-or-the-running-git ()
  (cl-letf (((symbol-function 'magit-repository-local-get) (lambda (&rest _) 'magit-commit-amend)))
    (should (eq (drgnx-commit-message--kind default-directory) 'amend)))
  (cl-letf (((symbol-function 'magit-repository-local-get) (lambda (&rest _) 'magit-commit--all)))
    (should (eq (drgnx-commit-message--kind default-directory) 'all)))
  (cl-letf (((symbol-function 'magit-repository-local-get) (lambda (&rest _) 'magit-commit-reword)))
    (should (eq (drgnx-commit-message--kind default-directory) 'reword)))
  (let ((cmd nil))
    (cl-letf (((symbol-function 'process-list) (lambda () '(fake)))
              ((symbol-function 'process-live-p) (lambda (_) t))
              ((symbol-function 'process-buffer) (lambda (_) (current-buffer)))
              ((symbol-function 'process-command) (lambda (_) cmd)))
      (setq cmd '("git" "--no-pager" "commit" "--amend"))
      (should (eq (drgnx-commit-message--kind default-directory) 'amend))
      (setq cmd '("git" "commit" "--all"))
      (should (eq (drgnx-commit-message--kind default-directory) 'all))
      (setq cmd '("git" "commit" "--amend" "--all"))
      (should (eq (drgnx-commit-message--kind default-directory) 'amend-all))
      (setq cmd '("git" "commit" "--amend" "--only" "--allow-empty"))
      (should (eq (drgnx-commit-message--kind default-directory) 'reword))
      (setq cmd '("git" "commit" "-q"))
      (should-not (drgnx-commit-message--kind default-directory))
      ;; m1: a commit in another repository, or one with no buffer to say where, is not this one's
      (setq cmd '("git" "commit" "--amend"))
      (let ((other (make-temp-file "drgnx-other" t)))
        (unwind-protect
            (should-not (drgnx-commit-message--kind (file-name-as-directory other)))
          (delete-directory other t)))
      (cl-letf (((symbol-function 'process-buffer) (lambda (_) nil)))
        (should-not (drgnx-commit-message--kind default-directory)))
      (setq cmd '("git" "status"))
      (should-not (drgnx-commit-message--kind default-directory)))))

(ert-deftest drgnx-commit-message/reword-and-amend-all ()
  ;; m2/m3: reword commits HEAD's tree (the index is not part of it); amend with -a takes the working tree
  (drgnx-git-test-with-repo
    (drgnx-git-test-write repo "a.txt" "one\n")
    (drgnx-git-test repo "add" "-A") (drgnx-git-test repo "commit" "-q" "-m" "Start")
    (drgnx-git-test-write repo "b.txt" "head change\n")
    (drgnx-git-test repo "add" "-A") (drgnx-git-test repo "commit" "-q" "-m" "Add b")
    (drgnx-git-test-write repo "a.txt" "one\nstaged now\n")
    (drgnx-git-test repo "add" "-A")
    (drgnx-git-test-write repo "a.txt" "one\nstaged now\nunstaged\n")
    (let ((reword (drgnx-commit-message-test--kind 'reword (drgnx-commit-message--diff repo nil)))
          (amend-all (drgnx-commit-message-test--kind 'amend-all (drgnx-commit-message--diff repo nil))))
      (should (string-search "head change" reword))
      (should-not (string-search "staged now" reword))
      (should (string-search "head change" amend-all))
      (should (string-search "unstaged" amend-all)))))

;;; mod-commit-message-test.el ends here
