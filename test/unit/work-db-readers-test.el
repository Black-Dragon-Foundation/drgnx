;;; work-db-readers-test.el --- batch tests: every Lisp reader reads the hub's schema 7 -*- lexical-binding: t -*-
;; The readers that stay in Lisp (core/drgnx-work-db.el and the seed
;; fixture's reads of jobs, tasks, decisions and messages) read work.db
;; through the compatibility views of schema 7.  The fixture is a database the hub made (test/fixtures/work-db-7.sql,
;; generated by test/fixtures/work-db-7-gen.el from a small synthetic schema-6 database).  The file is built under
;; another name and copied to work.db, so the test never opens work.db read-write (the one-writer gate).
;; test-class: det
(require 'ert)
(require 'cl-lib)
(require 'subr-x)
(require 'drgnx-paths)
(require 'drgnx-work-db)
(load (expand-file-name "test/fixtures/coord-seed-fixture" drgnx-dir) nil t)   ; its readers of jobs, tasks, decisions and messages

(defconst drgnx-work-db-readers-test--fixture (expand-file-name "test/fixtures/work-db-7.sql" drgnx-dir))

(defun drgnx-work-db-readers-test--statements ()
  "The statements of the fixture: each ends in \";\" and a blank line; the leading comment lines are dropped."
  (with-temp-buffer
    (insert-file-contents drgnx-work-db-readers-test--fixture)
    (let ((text (replace-regexp-in-string "\\`\\(--.*\n\\)+" "" (buffer-string))))
      (cl-remove-if #'string-empty-p (mapcar #'string-trim (split-string text ";\n\n"))))))

(defmacro drgnx-work-db-readers-test--with (&rest body)
  "BODY with drgnx's data dir a fresh temp dir (`dir') whose work.db is the fixture, no handle open."
  (declare (indent 0))
  `(let* ((dir (file-name-as-directory (make-temp-file "drgnx-work-db-readers" t)))
          (process-environment (cons (concat "DRGNX_DATA_DIR=" dir) process-environment))
          (drgnx-work-db--handles nil)
          (drgnx-work-db--read-handles nil))
     (unwind-protect
         (progn
           (let ((db (sqlite-open (concat dir "fixture.db"))))
             (dolist (s (drgnx-work-db-readers-test--statements)) (sqlite-execute db s))
             (sqlite-close db))
           (rename-file (concat dir "fixture.db") (concat dir "work.db"))
           ,@body)
       (drgnx-work-db-close-all)
       (delete-directory dir t))))

(ert-deftest drgnx-work-db/every-reader-reads-schema-7 ()
  (drgnx-work-db-readers-test--with
    (should (file-exists-p drgnx-work-db-readers-test--fixture))
    ;; the oldest reader: Nidhogg's linked SQLite (storage §5.2: it links 3.51.3 or later)
    (should (version<= "3.51.3" (sqlite-version)))
    ;; drgnx-work-db.el: nodes, edges, files, spend
    (should (= (drgnx-work-db-version) 7))
    (should (equal (plist-get (drgnx-work-node "plan:p") :title) "The plan"))
    (should (equal (drgnx-work-edges-to "spec:s" 'derives) '(("plan:p" . parsed))))
    (should (equal (drgnx-work-edges-from "plan:p" 'derives) '(("spec:s" . parsed))))
    (should (consp (drgnx-work-children "plan:p")))
    (should (member "The spec" (mapcar (lambda (n) (plist-get n :title)) (drgnx-work-roots))))
    (should (= (length (drgnx-work-nodes 'plan)) 1))
    (should (= (length (drgnx-work-nodes-of-kinds '(spec plan))) 2))
    (should (equal (drgnx-work-file-mtime "/w/p.md") 1700000000.0))
    (should (equal (drgnx-work-files) '("/w/p.md")))
    (should (equal (drgnx-work-db-spend :job "j1") '(:input 10 :output 20 :cost 0.5 :requests 1)))
    ;; the seed fixture: jobs, tasks, decisions, messages
    (should (equal (drgnx-coord-jobs) '("j1")))
    (should (equal (mapcar (lambda (tk) (plist-get tk :id)) (drgnx-coord-tasks "j1")) '("j1#1" "j1#2")))
    (should (equal (plist-get (drgnx-coord-task "j1#2") :deps) '("j1#1")))
    (should (= (length (drgnx-coord-decisions-since 0)) 2))
    (should (= (length (drgnx-coord-queued)) 1))
    (should (= (length (drgnx-coord-inbox "user")) 1))
    (should (= (drgnx-coord-held "a1") 0))
    (should (= (drgnx-coord-seen "a1") 0))
    ;; …and none of it opened work.db for writing
    (should-not drgnx-work-db--handles)))

(ert-deftest drgnx-work-db/the-cli-reads-the-fixture-s-views ()
  :tags '(:cond)                        ; runs the sqlite3 CLI
  ;; the container's `sqlite3 -readonly' (when it has one) reads the compatibility views as Lisp does
  (skip-unless (executable-find "sqlite3"))
  (drgnx-work-db-readers-test--with
    (let ((out (with-temp-buffer
                 (call-process "sqlite3" nil t nil "-readonly" (concat dir "work.db")
                               "select (select count(*) from node), (select count(*) from edge), (select count(*) from jtask), (select count(*) from decision), (select value from meta where key = 'schema')")
                 (string-trim (buffer-string)))))
      (should (equal out "3|1|2|2|7")))))
