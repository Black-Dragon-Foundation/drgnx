# Batch test tier: Fedora 45 ships Emacs 31.1, drgnx's baseline. emacs-pgtk, named: Fedora's "emacs" may
# resolve to emacs-nw, which has no SVG (the Work graph tests); diffutils for the review tests.
FROM registry.fedoraproject.org/fedora:45
RUN dnf -y install emacs-pgtk diffutils git && dnf clean all
