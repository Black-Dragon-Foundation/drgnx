# Batch test tier: Nidhogg 31.1 (drgnx's own Emacs build: pgtk, SVG for the Work graph tests, native compilation),
# from its release tarball (nidhogg.sh pins the version and checksum; it also links it as emacs), on the base image of
# the Fedora packages (base/Containerfile; the build line `# base:` names it, image.sh and image-tag.sh read it).
# base: drgnx-base-test base/Containerfile
ARG BASE
FROM ${BASE}
COPY nidhogg.sh /tmp/nidhogg.sh
RUN bash /tmp/nidhogg.sh fedora-45 && rm /tmp/nidhogg.sh
ENV DRGNX_EMACS=/opt/nidhogg/31.1-nidhogg.5/bin/nidhogg
