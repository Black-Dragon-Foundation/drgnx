# GUI test tier in a container: headless mutter renders without a GPU ("surfaceless").
# Run with --security-opt seccomp=unconfined --security-opt label=disable (bin/drgnx does):
# GTK loads icons through glycin, whose bwrap sandbox needs namespaces the default policy denies.
# M12c: sway (headless, wlroots) and Xvfb + i3 (X11) for the window-manager adapters' tests.  emacs-lucid is the
# X11 build, started by name (emacs-lucid): unlike emacs-gtk+x11 it reads RandR 1.5 monitors (xrandr --setmonitor), the
# only way to get two monitors out of Xvfb (DEFERRED NIDHOGG-X11-1: Nidhogg has no X11 build yet).  "emacs" is Nidhogg
# (nidhogg.sh links it into /usr/local/bin, ahead of the alternatives' /usr/bin/emacs).  sway ships with a
# cap_sys_nice file capability that the container does not grant, so it would not exec; the capability is dropped.
# Docs on (tsflags=): the Emacs and Elisp manuals the command fuzz opens; findutils for project search.
FROM registry.fedoraproject.org/fedora:45
RUN dnf -y --setopt=tsflags= install info diffutils findutils git mutter python3-gobject-base sway i3 xorg-x11-server-Xvfb xrandr xprop emacs-lucid dbus-daemon mesa-dri-drivers ImageMagick procps-ng util-linux binutils \
    && dnf clean all
RUN setcap -r /usr/bin/sway
COPY nidhogg.sh /tmp/nidhogg.sh
RUN bash /tmp/nidhogg.sh fedora-45 && rm /tmp/nidhogg.sh
# The pinned child-frame packages (posframe, corfu, …) the chrome, parity and extra rows load, each checked out of its
# upstream git repository at the commit childframe-packages.eld names, whose git tree must match: a commit never moves,
# so a rebuild cannot fail by itself, and no ELPA archive is involved.  The pins file's own sha256 is written below and
# checked at build: a bump edits both (an edit of the pins alone fails the build and test/unit/ci-workflows-test.el);
# the image's tag hashes both (image-tag.sh).  The GUI tier reads the packages with DRGNX_CHILDFRAME_ELPA=/opt/childframe-elpa.
COPY childframe-packages.eld childframe-elpa.sh /tmp/childframe/
RUN echo "dc2200b525282f1543664979adec716bb922d82eec3087b89f199f89d3580be0  /tmp/childframe/childframe-packages.eld" | sha256sum -c - \
    && sh /tmp/childframe/childframe-elpa.sh /opt/childframe-elpa && rm -r /tmp/childframe
ENV DRGNX_EMACS=/opt/nidhogg/31.1-nidhogg.5/bin/nidhogg
