# GUI test tier in a container, on the base image of the Fedora packages (base/Containerfile.gui; the line `# base:`
# names it, image.sh and image-tag.sh read it).  "emacs" is Nidhogg (nidhogg.sh links it into /usr/local/bin, ahead
# of the alternatives' /usr/bin/emacs).  Run as the base says (bin/drgnx does).
# base: drgnx-base-gui base/Containerfile.gui
ARG BASE
FROM ${BASE}
COPY nidhogg.sh /tmp/nidhogg.sh
RUN bash /tmp/nidhogg.sh fedora-45 && rm /tmp/nidhogg.sh
# The pinned child-frame packages (posframe, corfu, …) the chrome, parity and extra rows load, each checked out of its
# upstream git repository at the commit childframe-packages.eld names, whose git tree must match: a commit never moves,
# so a rebuild cannot fail by itself, and no ELPA archive is involved.  The pins file's own sha256 is written below and
# checked at build: a bump edits both (an edit of the pins alone fails the build and test/unit/ci-workflows-test.el);
# the image's tag hashes both (image-tag.sh).  The GUI tier reads the packages with DRGNX_CHILDFRAME_ELPA=/opt/childframe-elpa.
COPY childframe-packages.eld childframe-elpa.sh /tmp/childframe/
RUN echo "dc2200b525282f1543664979adec716bb922d82eec3087b89f199f89d3580be0  /tmp/childframe/childframe-packages.eld" | sha256sum -c - \
    && sh /tmp/childframe/childframe-elpa.sh /opt/childframe-elpa && rm -r /tmp/childframe
ENV DRGNX_EMACS=/opt/nidhogg/31.1-nidhogg.5/bin/nidhogg
