;; drgnx's file reads and writes outside drgnx-file (core/drgnx-file.el), the baseline of
;; test/unit/lint-files-test.el.  Each row: :file, :fn and :what name the site; :why says what the
;; file is.  Every port of the config-layer plan is done, so :until is always `never' and :why starts
;; with its category: "a user's file", "a temporary file", "a directory move", "its own lock
;; protocol", "age writes it", "a developer tool" or "Lisp source".
(
 (:file "core/drgnx-bootstrap.el" :fn drgnx-bootstrap--git-clone :what rename-file :why "a directory move: a fresh clone renamed into the empty config dir" :until never)
 (:file "core/drgnx-work-db.el" :fn drgnx-work-db--keep-schema-5 :what rename-file :why "a directory move: the schema-5 copy built as work.db.schema5.tmp, then renamed" :until never)
 (:file "core/drgnx-fmt.el" :fn drgnx-fmt--learn :what read-site :why "a user's file: Lisp source read to learn indentation" :until never)
 (:file "core/drgnx-fmt.el" :fn drgnx-fmt-file :what write-region :why "a user's file: bin/drgnx fmt rewrites source" :until never)
 (:file "core/drgnx-build.el" :fn drgnx-build--read-forms :what read-site :why "Lisp source: drgnx's own files, read by the build's scan of the primitives they advise and never written" :until never)
 (:file "core/drgnx-keys.el" :fn drgnx-keys--read-file :what read-site :why "Lisp source: the shipped key profiles keys/*.eld, read from the checkout and never written" :until never)
 (:file "core/drgnx-macos.el" :fn drgnx-macos-install-app :what rename-file :why "a directory move: the app bundle" :until never)
 (:file "core/drgnx-modules-helpers.el" :fn drgnx-module--scan :what read-site :why "Lisp source: module source read, never run" :until never)
 (:file "core/drgnx-onboard.el" :fn drgnx-onboard--ask-test :what write-region :why "a temporary file: the greeting project of the ask test" :until never)
 (:file "core/drgnx-pkg.el" :fn drgnx-pkg--module-specs :what read-site :why "Lisp source: module source read for its package specs" :until never)
 (:file "core/drgnx-pkg.el" :fn drgnx-pkg--clear-stale-lock :what rename-file :why "its own lock protocol: the sync lock" :until never)
 (:file "core/drgnx-pkg.el" :fn drgnx-pkg--take-sync-lock :what write-region :why "its own lock protocol: the sync lock" :until never)
 (:file "core/drgnx-pkg.el" :fn drgnx-pkg--recover :what rename-file :why "a directory move: generations" :until never)
 (:file "core/drgnx-pkg.el" :fn drgnx-pkg--swap-in :what rename-file :why "a directory move: generations" :until never)
 (:file "core/drgnx-pkg.el" :fn drgnx-pkg-snapshot :what rename-file :why "a directory move: generations" :until never)
 (:file "core/drgnx-pkg.el" :fn drgnx-pkg--http-get :what write-region :why "a temporary file: a download body" :until never)
 (:file "core/drgnx-pkg.el" :fn drgnx-pkg--fetch :what rename-file :why "a directory move: the package cache" :until never)
 (:file "core/drgnx-portable.el" :fn drgnx-portable--copy-into-place :what rename-file :why "a directory move: a machine-local item copied to TO.drgnx-new, verified, then renamed to TO" :until never)
 (:file "core/drgnx-projects.el" :fn drgnx-projects--board-update :what write-region :why "a user's file: the org board" :until never)
 (:file "core/drgnx-projects.el" :fn drgnx-projects--board-update :what rename-file :why "a user's file: the org board" :until never)
 (:file "core/drgnx-projects.el" :fn drgnx-projects--write-plan :what write-region :why "a user's file: a plan file" :until never)
 (:file "core/drgnx-projects.el" :fn drgnx-projects--write-plan :what rename-file :why "a user's file: a plan file" :until never)
 (:file "core/drgnx-secrets.el" :fn drgnx-secrets-export :what rename-file :why "age writes it: secrets.age, encrypted by age into secrets.age.new, then renamed" :until never)
 (:file "core/drgnx-settings-workspace.el" :fn drgnx-settings-workspace--dir-locals-layers :what read-site :why "a user's file: a project's .dir-locals.el, read to explain where a value comes from, never written" :until never)
 (:file "core/drgnx-settings-trust.el" :fn drgnx-settings-trust--read-dir-locals :what read-site :why "a user's file: a project's .dir-locals.el, read to list its code for review, never written" :until never)
 (:file "core/drgnx-settings-trust.el" :fn drgnx-settings-trust--line :what read-site :why "a user's file: a project's .dir-locals.el, read for the line a value is on, never written" :until never)
 (:file "core/drgnx-settings-index.el" :fn drgnx-settings-index-scan-file :what read-site :why "Lisp source: an installed package's .el files, read for their defcustoms and never run or written" :until never)
 (:file "core/drgnx-settings-page.el" :fn drgnx-settings-page-convert :what rename-file :why "a directory move: a project's old .drgnx/*.eld moved into .drgnx/migrated-DATE/ after its entries are in settings.el" :until never)
 (:file "core/drgnx-settings-migrate.el" :fn drgnx-settings-migrate--move :what rename-file :why "a directory move: an old settings file moved into <config>/migrated-DATE/ after its copy in <state>/backups/" :until never)
 (:file "core/drgnx-shell.el" :fn drgnx-shell-install :what write-region :why "a user's file: the shell's rc file gains one line, only on a yes" :until never)
 (:file "core/drgnx-startup-trace.el" :fn drgnx-startup-trace--finish :what with-temp-file :why "a developer tool: the startup trace" :until never)
 (:file "core/drgnx-record.el" :fn drgnx-record--write :what with-temp-file :why "a developer tool: bin/drgnx record rewrites a run's manifest" :until never)
 (:file "core/drgnx-record.el" :fn drgnx-record--write :what rename-file :why "a developer tool: the manifest's temporary file renamed over it" :until never)
 (:file "core/drgnx-record.el" :fn drgnx-record--copy :what with-temp-file :why "a developer tool: bin/drgnx record export writes a fixture's normalized streams" :until never)
 (:file "core/drgnx-record.el" :fn drgnx-record-stop :what with-temp-file :why "a developer tool: bin/drgnx record stop writes a run's report.md" :until never)
 (:file "wb/drgnx-explorer.el" :fn drgnx-explorer-new-file :what write-region :why "a user's file: the Explorer" :until never)
 (:file "wb/drgnx-explorer.el" :fn drgnx-explorer-rename :what rename-file :why "a user's file: the Explorer" :until never)
 (:file "wb/drgnx-explorer.el" :fn drgnx-explorer-paste :what rename-file :why "a user's file: the Explorer" :until never)
 (:file "modules/lang/drgnx-markdown.el" :fn drgnx-markdown--draw :what write-region :why "a temporary file: a diagram's source for the renderer" :until never)
 (:file "modules/tools/drgnx-agents-ui.el" :fn drgnx-agents-ui--review-open :what with-temp-file :why "a temporary file: the review copy agents-ui opens" :until never)
 (:file "modules/tools/drgnx-agents-ui.el" :fn drgnx-agents-ui-review-done :what write-region :why "a user's file: agents-ui writes" :until never)
 (:file "modules/tools/drgnx-ai-ui.el" :fn drgnx-ai--edit-review :what write-region :why "a temporary file: a diff copy" :until never)
 (:file "core/drgnx-sandbox-vc.el" :fn drgnx-sandbox-vc--read :what read-site :why "its own lock protocol: the VC guard's folder list (sandbox/folders.eld)" :until never)
 (:file "core/drgnx-sandbox-vc.el" :fn drgnx-sandbox-vc--write :what write-region :why "its own lock protocol: the VC guard's folder list (sandbox/folders.eld)" :until never)
 (:file "core/drgnx-sandbox-vc.el" :fn drgnx-sandbox-vc--write :what rename-file :why "its own lock protocol: the VC guard's folder list (sandbox/folders.eld)" :until never))
