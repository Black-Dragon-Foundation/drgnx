{"scenario": "gateway/a-hang-up-stops-the-upstream", "requires": ["v1", "fake-backend"], "doc": "Task 24: an agent that hangs up in the middle of a stream drops the upstream connection with it: the provider's log says `closed` within 2 s (the answer had 5 s to go), and exactly one spend row and one request event are written for it."}
{"do": "root"}
{"do": "write_file", "path": "$ROOT/llm.json", "json": [{"path": "/v1/messages", "content_type": "text/event-stream", "chunks": [[0, "data: a\n\n"], [8000, "data: b\n\n"]]}]}
{"do": "spawn", "capture": "mock", "argv": ["$MOCK", "llm", "--script", "$ROOT/llm.json", "--log", "$ROOT/llm.log", "--parent", "$HARNESS_PID"], "capture_stdout": {"regex": "MOCK-LLM-PORT (\\d+)", "name": "port"}}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "config/providers", "params": {"providers": [{"id": "a", "kind": "anthropic", "base": "http://127.0.0.1:$port", "auth": "none", "messages": true, "caps": ["chat"]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"applied": 1}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "gateway/register", "params": {"chain": [["a", null]], "agent": "a1", "owner": "$HARNESS_PID"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"token": "$capture:tok"}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "status"}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"gateway": {"port": "$capture:gw"}}}}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "subscribe"}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": true}}
{"do": "http", "conn": "g", "to": "tcp:127.0.0.1:$gw", "method": "POST", "path": "/v1/messages", "headers": {"Host": "127.0.0.1:$gw", "Authorization": "Bearer $tok", "content-type": "application/json"}, "body": "{\"model\": \"m\", \"max_tokens\": 8, \"stream\": true, \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}", "read": {"bytes": 9}, "close_after": true}
{"do": "file", "path": "$ROOT/llm.log", "contains": "\"closed\":true", "within_ms": 2000}
{"do": "expect", "conn": "c", "json": {"event": "request", "data": {"agent": "a1", "provider": "a"}}, "within_ms": 2000}
{"do": "sql_expect", "sql": "select count(*), min(provider), min(agent) from spend", "rows": [[1, "a", "a1"]]}
