{"scenario": "gateway/editor-fim-through-the-gateway", "requires": ["v1", "fake-backend"], "doc": "Task 24, editor row: the fill-in-the-middle path /p/mock/completions reaches the provider's /completions with the editor's body unchanged; one spend row, no job, agent editor."}
{"do": "root"}
{"do": "spawn", "capture": "mock", "argv": ["$MOCK", "llm", "--script", "$SCENARIOS/fixtures/llm-openai.json", "--log", "$ROOT/llm.log", "--parent", "$HARNESS_PID"], "capture_stdout": {"regex": "MOCK-LLM-PORT (\\d+)", "name": "port"}}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do":"send","conn":"c","json":{"id":1,"method":"config/settings","params":{"overrides":[{"name":"drgnx-ai-providers","source":"row","value":{"mock":{"kind":"openai","url":"http://127.0.0.1:$port","caps":["chat","fim","embed"],"messages":false}}}]}}}
{"do":"expect","conn":"c","json":{"id":1,"result":{"applied":1}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "gateway/editor-token"}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"token": "$capture:tok", "url": "$string"}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "status"}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"gateway": {"port": "$capture:gw"}}}}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "subscribe"}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": true}}
{"do": "http", "conn": "e", "to": "tcp:127.0.0.1:$gw", "method": "POST", "path": "/p/mock/completions", "headers": {"Host": "127.0.0.1:$gw", "Authorization": "Bearer $tok", "content-type": "application/json"}, "body": "{\"model\":\"m\",\"prompt\":\"fn main() {\",\"suffix\":\"}\",\"max_tokens\":16}"}
{"do": "expect_http", "conn": "e", "status": 200, "body_json": {"id": "cmpl-1"}}
{"do": "file", "path": "$ROOT/llm.log", "contains": "\"path\":\"/completions\""}
{"do": "file", "path": "$ROOT/llm.log", "contains": "\"body\":\"{\\\"model\\\":\\\"m\\\",\\\"prompt\\\":\\\"fn main() {\\\",\\\"suffix\\\":\\\"}\\\",\\\"max_tokens\\\":16}\""}
{"do": "expect", "conn": "c", "json": {"event": "request", "data": {"agent": "editor", "provider": "mock", "status": 200}}}
{"do": "sql_expect", "sql": "select provider, agent, job is null, input, output from spend", "rows": [["mock", "editor", 1, 5, 1]]}
