{"scenario": "gateway/every-step-failing-says-why", "requires": ["v1", "fake-backend"], "doc": "Task 24: no step of the chain can answer (the first provider's port refuses the connection, the second is not configured): the agent gets 502 api_error whose message names each provider and why (`no provider answered: dead: no answer (…); ghost: not configured`), and no spend row is written for a request nothing answered."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "config/providers", "params": {"providers": [{"id": "dead", "kind": "anthropic", "base": "http://127.0.0.1:1", "auth": "none", "messages": true, "caps": ["chat"]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"applied": 1}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "gateway/register", "params": {"chain": [["dead", null], ["ghost", null]], "owner": "$HARNESS_PID"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"token": "$capture:tok"}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "status"}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"gateway": {"port": "$capture:gw"}}}}
{"do": "http", "conn": "g", "to": "tcp:127.0.0.1:$gw", "method": "POST", "path": "/v1/messages", "headers": {"Host": "127.0.0.1:$gw", "Authorization": "Bearer $tok", "content-type": "application/json"}, "body": "{\"model\": \"m\", \"max_tokens\": 8, \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}"}
{"do": "expect_http", "conn": "g", "status": 502, "body_json": {"type": "error", "error": {"type": "api_error"}}}
{"do": "expect_http", "conn": "g", "status": 502, "body_contains": "no provider answered: dead: no answer"}
{"do": "expect_http", "conn": "g", "status": 502, "body_contains": "ghost: not configured"}
{"do": "sql_expect", "sql": "select count(*) from spend", "rows": [[0]]}
