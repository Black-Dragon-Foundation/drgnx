{"scenario": "gateway/a-session-token-is-refused-on-tcp", "requires": ["v1", "fake-backend"], "doc": "Task 24: a token issued for a session's socket is no token on the loopback TCP listener (401 not a drgnx gateway token), and a loopback token is none on the session's socket; the provider saw neither request."}
{"do": "root"}
{"do": "spawn", "capture": "mock", "argv": ["$MOCK", "llm", "--script", "$SCENARIOS/fixtures/llm-messages.json", "--log", "$ROOT/llm.log", "--parent", "$HARNESS_PID"], "capture_stdout": {"regex": "MOCK-LLM-PORT (\\d+)", "name": "port"}}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do":"send","conn":"c","json":{"id":1,"method":"config/settings","params":{"overrides":[{"name":"drgnx-ai-providers","source":"row","value":{"a":{"kind":"anthropic","url":"http://127.0.0.1:$port","caps":["chat"],"messages":true}}}]}}}
{"do":"expect","conn":"c","json":{"id":1,"result":{"applied":1}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "mcp/session", "params": {"agent": "s-0000000a", "cwd": "$HOME", "owner": "$HARNESS_PID"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"sid": "$capture:sid"}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "gateway/register", "params": {"chain": [["a", null]], "agent": "s-0000000a", "sid": "$sid"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"token": "$capture:sess_tok", "socket": "$capture:gsock"}}}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "gateway/register", "params": {"chain": [["a", null]], "agent": "a2", "owner": "$HARNESS_PID"}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"token": "$capture:tcp_tok"}}}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "status"}}
{"do": "expect", "conn": "c", "json": {"id": 5, "result": {"gateway": {"port": "$capture:gw"}}}}
{"do": "http", "conn": "t", "to": "tcp:127.0.0.1:$gw", "method": "POST", "path": "/v1/messages", "headers": {"Host": "127.0.0.1:$gw", "Authorization": "Bearer $sess_tok", "content-type": "application/json"}, "body": "{\"model\": \"m\", \"max_tokens\": 8, \"messages\": []}"}
{"do": "expect_http", "conn": "t", "status": 401, "body_json": {"type": "error", "error": {"type": "authentication_error", "message": "not a drgnx gateway token"}}}
{"do": "http", "conn": "u", "to": "unix:$gsock", "method": "POST", "path": "/v1/messages", "headers": {"Host": "localhost", "Authorization": "Bearer $tcp_tok", "content-type": "application/json"}, "body": "{\"model\": \"m\", \"max_tokens\": 8, \"messages\": []}"}
{"do": "expect_http", "conn": "u", "status": 401, "body_json": {"type": "error", "error": {"type": "authentication_error", "message": "not a drgnx gateway token"}}}
{"do": "file", "path": "$ROOT/llm.log", "lacks": "request"}
