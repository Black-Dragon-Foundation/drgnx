{"scenario": "gateway/an-openrouter-base-keeps-its-v1", "requires": ["v1", "fake-backend"], "doc": "Task 24, editor row: a provider whose base is http://127.0.0.1:PORT/api/v1 (OpenRouter's shape) keeps that /v1 for the editor: /p/openrouter/chat/completions reaches the mock as /api/v1/chat/completions, not /api/chat/completions."}
{"do": "root"}
{"do": "write_file", "path": "$ROOT/llm.json", "json": [{"path": "/api/v1/chat/completions", "body": "{\"id\": \"chat-or\"}"}]}
{"do": "spawn", "capture": "mock", "argv": ["$MOCK", "llm", "--script", "$ROOT/llm.json", "--log", "$ROOT/llm.log", "--parent", "$HARNESS_PID"], "capture_stdout": {"regex": "MOCK-LLM-PORT (\\d+)", "name": "port"}}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "config/providers", "params": {"providers": [{"id": "openrouter", "kind": "openai", "base": "http://127.0.0.1:$port/api/v1", "auth": "none", "messages": false, "caps": ["chat"]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"applied": 1}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "gateway/editor-token"}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"token": "$capture:tok", "url": "$string"}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "status"}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"gateway": {"port": "$capture:gw"}}}}
{"do": "http", "conn": "e", "to": "tcp:127.0.0.1:$gw", "method": "POST", "path": "/p/openrouter/chat/completions", "headers": {"Host": "127.0.0.1:$gw", "Authorization": "Bearer $tok", "content-type": "application/json"}, "body": "{\"model\":\"m\",\"messages\":[]}"}
{"do": "expect_http", "conn": "e", "status": 200, "body_json": {"id": "chat-or"}}
{"do": "file", "path": "$ROOT/llm.log", "contains": "\"path\":\"/api/v1/chat/completions\""}
