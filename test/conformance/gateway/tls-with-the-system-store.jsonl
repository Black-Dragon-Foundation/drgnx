{"scenario": "gateway/tls-with-the-system-store", "requires": ["v1", "fake-backend", "linux"], "doc": "Task 24: the gateway verifies an https provider against the platform's store, which on Linux is read from SSL_CERT_FILE when it is set. ratatoskr-mock llm --tls makes a CA and a localhost leaf at start (nothing committed). A hub without the CA in its store refuses the provider (502, nothing reaches the mock); the same registration on a hub started with SSL_CERT_FILE naming the CA gets the answer."}
{"do": "root"}
{"do": "spawn", "capture": "mock", "argv": ["$MOCK", "llm", "--script", "$SCENARIOS/fixtures/llm-messages.json", "--log", "$ROOT/llm.log", "--tls", "$ROOT/ca.pem", "--parent", "$HARNESS_PID"], "capture_stdout": {"regex": "MOCK-LLM-PORT (\\d+)", "name": "port"}}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "config/providers", "params": {"providers": [{"id": "a", "kind": "anthropic", "base": "https://localhost:$port", "auth": "none", "messages": true, "caps": ["chat"]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"applied": 1}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "gateway/register", "params": {"chain": [["a", null]], "owner": "$HARNESS_PID"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"token": "$capture:tok"}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "status"}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"gateway": {"port": "$capture:gw"}}}}
{"do": "http", "conn": "g", "to": "tcp:127.0.0.1:$gw", "method": "POST", "path": "/v1/messages", "headers": {"Host": "127.0.0.1:$gw", "Authorization": "Bearer $tok", "content-type": "application/json"}, "body": "{\"model\": \"m\", \"max_tokens\": 8, \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}"}
{"do": "expect_http", "conn": "g", "status": 502, "body_contains": "no provider answered"}
{"do": "file", "path": "$ROOT/llm.log", "lacks": "\"request\""}
{"do": "kill", "hub": "h", "signal": "TERM"}
{"do": "expect_exit", "hub": "h", "code": 0}
{"do": "start", "hub": "h2", "same_root_as": "h", "env": {"SSL_CERT_FILE": "$ROOT/ca.pem"}}
{"do": "connect", "conn": "c2", "hub": "h2"}
{"do": "send", "conn": "c2", "json": {"id": 1, "method": "config/providers", "params": {"providers": [{"id": "a", "kind": "anthropic", "base": "https://localhost:$port", "auth": "none", "messages": true, "caps": ["chat"]}]}}}
{"do": "expect", "conn": "c2", "json": {"id": 1, "result": {"applied": 1}}}
{"do": "send", "conn": "c2", "json": {"id": 2, "method": "status"}}
{"do": "expect", "conn": "c2", "json": {"id": 2, "result": {"gateway": {"port": "$capture:gw2", "registrations": 1}}}}
{"do": "http", "conn": "g2", "to": "tcp:127.0.0.1:$gw2", "method": "POST", "path": "/v1/messages", "headers": {"Host": "127.0.0.1:$gw2", "Authorization": "Bearer $tok", "content-type": "application/json"}, "body": "{\"model\": \"m\", \"max_tokens\": 8, \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}"}
{"do": "expect_http", "conn": "g2", "status": 200, "body_json": {"id": "msg-1"}}
{"do": "file", "path": "$ROOT/llm.log", "contains": "\"request\"", "count": 1, "at_most": 1}
