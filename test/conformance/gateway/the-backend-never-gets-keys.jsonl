{"scenario": "gateway/the-backend-never-gets-keys", "requires": ["v1", "fake-backend"], "doc": "Keys stay in the hub's memory: gateway/keys and a registration's keys are answered by the front, and the backend log has no gateway/keys or gateway/register line and no canary (M9b1-6)."}
{"do": "start", "hub": "h", "env": {"DRGNX_FAKE_BACKEND_SCRIPT": "{\"gateway/keys\": {\"result\": true}}"}}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "gateway/keys", "params": {"keys": {"openrouter": "canary-key-1"}}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "config/providers", "params": {"providers": [{"id": "anthropic", "kind": "anthropic", "base": "https://api.anthropic.com", "auth": "x-api-key", "messages": true, "caps": ["chat"]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"applied": 1}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "gateway/register", "params": {"chain": [["anthropic", null]], "keys": {"anthropic": "canary-key-2"}}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"token": "$string"}}}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "status"}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"gateway": {"keys_held": ["anthropic", "openrouter"], "registrations": 1}}}}
{"do": "backend_log", "hub": "h", "expect_no_line": "gateway/", "for_ms": 500}
{"do": "backend_log", "hub": "h", "expect_no_line": "canary"}
{"do": "file_grep", "paths": ["$ROOT/**"], "absent": "canary"}
