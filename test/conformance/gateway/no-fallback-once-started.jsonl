{"scenario": "gateway/no-fallback-once-started", "requires": ["v1", "fake-backend"], "doc": "Task 24: once a provider's head is out the answer is that provider's: A sends a 200 head and one chunk and then drops the connection; B would have answered, but is never asked. The agent has A's first chunk, no fallback event is sent and B's log is empty."}
{"do": "root"}
{"do": "write_file", "path": "$ROOT/a.json", "json": [{"path": "/v1/messages", "content_type": "text/event-stream", "chunks": [[0, "data: a\n\n"]], "no_end": true}]}
{"do": "spawn", "capture": "mock_a", "argv": ["$MOCK", "llm", "--script", "$ROOT/a.json", "--parent", "$HARNESS_PID"], "capture_stdout": {"regex": "MOCK-LLM-PORT (\\d+)", "name": "port_a"}}
{"do": "spawn", "capture": "mock_b", "argv": ["$MOCK", "llm", "--script", "$SCENARIOS/fixtures/llm-messages.json", "--log", "$ROOT/b.log", "--parent", "$HARNESS_PID"], "capture_stdout": {"regex": "MOCK-LLM-PORT (\\d+)", "name": "port_b"}}
{"do": "start", "hub": "h"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "config/providers", "params": {"providers": [{"id": "a", "kind": "anthropic", "base": "http://127.0.0.1:$port_a", "auth": "none", "messages": true, "caps": ["chat"]}, {"id": "b", "kind": "anthropic", "base": "http://127.0.0.1:$port_b", "auth": "none", "messages": true, "caps": ["chat"]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"applied": 2}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "gateway/register", "params": {"chain": [["a", null], ["b", null]], "agent": "a1", "owner": "$HARNESS_PID"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"token": "$capture:tok"}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "status"}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"gateway": {"port": "$capture:gw"}}}}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "subscribe"}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": true}}
{"do": "http", "conn": "g", "to": "tcp:127.0.0.1:$gw", "method": "POST", "path": "/v1/messages", "headers": {"Host": "127.0.0.1:$gw", "Authorization": "Bearer $tok", "content-type": "application/json"}, "body": "{\"model\": \"m\", \"max_tokens\": 8, \"stream\": true, \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}", "read": {"bytes": 9}}
{"do": "expect_http", "conn": "g", "status": 200, "body_contains": "data: a"}
{"do": "expect", "conn": "c", "json": {"event": "request", "data": {"agent": "a1", "provider": "a", "status": 200}}}
{"do": "expect_silent", "conn": "c", "for_ms": 300}
{"do": "sql_expect", "sql": "select provider from spend", "rows": [["a"]]}
{"do": "file", "path": "$ROOT/b.log", "lacks": "request"}
