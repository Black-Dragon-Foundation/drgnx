{"scenario": "gateway/the-agent-never-sees-the-key", "requires": ["v1", "fake-backend"], "doc": "Task 24: the key goes upstream and nowhere else. The registration's answer has no `keys`; the answer the agent gets back carries no Authorization or x-api-key header (its own token is not echoed either) and the provider gets the canary key but never the agent's token."}
{"do": "root"}
{"do": "spawn", "capture": "mock", "argv": ["$MOCK", "llm", "--script", "$SCENARIOS/fixtures/llm-messages.json", "--log", "$ROOT/llm.log", "--parent", "$HARNESS_PID"], "capture_stdout": {"regex": "MOCK-LLM-PORT (\\d+)", "name": "port"}}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do":"send","conn":"c","json":{"id":1,"method":"config/settings","params":{"overrides":[{"name":"drgnx-ai-providers","source":"row","value":{"a":{"kind":"anthropic","url":"http://127.0.0.1:$port","caps":["chat"],"messages":true,"key_env":"KEY","auth":"x-api-key"}}}]}}}
{"do":"expect","conn":"c","json":{"id":1,"result":{"applied":1}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "gateway/keys", "params": {"keys": {"a": "canary-key-agent-1"}}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "gateway/register", "params": {"chain": [["a", null]], "owner": "$HARNESS_PID"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"token": "$capture:tok", "keys": "$absent"}}}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "status"}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"gateway": {"port": "$capture:gw"}}}}
{"do": "http", "conn": "g", "to": "tcp:127.0.0.1:$gw", "method": "POST", "path": "/v1/messages", "headers": {"Host": "127.0.0.1:$gw", "x-api-key": "$tok", "content-type": "application/json"}, "body": "{\"model\": \"m\", \"max_tokens\": 8, \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}"}
{"do": "expect_http", "conn": "g", "status": 200, "headers": {"authorization": "$absent", "x-api-key": "$absent"}, "body_json": {"id": "msg-1"}}
{"do": "file", "path": "$ROOT/llm.log", "contains": "\"x-api-key\":\"canary-key-agent-1\""}
{"do": "file", "path": "$ROOT/llm.log", "lacks": "$tok"}
