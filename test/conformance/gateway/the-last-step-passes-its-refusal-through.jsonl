{"scenario": "gateway/the-last-step-passes-its-refusal-through", "requires": ["v1", "fake-backend"], "doc": "Task 24: the chain's last step is not skipped over: provider A answers 500 (the agent's next step is tried), the last provider B answers 429 with Retry-After 7, and the agent gets that 429 as it is, with its Retry-After and body, not a 502. One fallback event (a to b, HTTP 500); the spend row is B's, status 429."}
{"do": "root"}
{"do": "spawn", "capture": "mock_a", "argv": ["$MOCK", "llm", "--script", "$SCENARIOS/fixtures/llm-messages-500.json", "--parent", "$HARNESS_PID"], "capture_stdout": {"regex": "MOCK-LLM-PORT (\\d+)", "name": "port_a"}}
{"do": "spawn", "capture": "mock_b", "argv": ["$MOCK", "llm", "--script", "$SCENARIOS/fixtures/llm-messages-429.json", "--parent", "$HARNESS_PID"], "capture_stdout": {"regex": "MOCK-LLM-PORT (\\d+)", "name": "port_b"}}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do":"send","conn":"c","json":{"id":1,"method":"config/settings","params":{"overrides":[{"name":"drgnx-ai-providers","source":"row","value":{"a":{"kind":"anthropic","url":"http://127.0.0.1:$port_a","caps":["chat"],"messages":true},"b":{"kind":"anthropic","url":"http://127.0.0.1:$port_b","caps":["chat"],"messages":true}}}]}}}
{"do":"expect","conn":"c","json":{"id":1,"result":{"applied":1}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "gateway/register", "params": {"chain": [["a", null], ["b", null]], "agent": "a1", "owner": "$HARNESS_PID"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"token": "$capture:tok"}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "status"}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"gateway": {"port": "$capture:gw"}}}}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "subscribe"}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": true}}
{"do": "http", "conn": "g", "to": "tcp:127.0.0.1:$gw", "method": "POST", "path": "/v1/messages", "headers": {"Host": "127.0.0.1:$gw", "Authorization": "Bearer $tok", "content-type": "application/json"}, "body": "{\"model\": \"m\", \"max_tokens\": 8, \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}"}
{"do": "expect_http", "conn": "g", "status": 429, "headers": {"retry-after": "7"}, "body_json": {"error": {"type": "rate_limit_error"}}}
{"do": "expect", "conn": "c", "json": {"event": "fallback", "data": {"from": "a", "to": "b", "why": "HTTP 500"}}}
{"do": "expect", "conn": "c", "json": {"event": "request", "data": {"provider": "b", "status": 429}}}
{"do": "sql_expect", "sql": "select provider, status from spend", "rows": [["b", 429]]}
