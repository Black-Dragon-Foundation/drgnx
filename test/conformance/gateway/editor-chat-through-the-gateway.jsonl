{"scenario": "gateway/editor-chat-through-the-gateway", "requires": ["v1", "fake-backend"], "doc": "Task 24, editor row: the editor's token carries POST /p/mock/chat/completions to the OpenAI-shape provider `mock`: the provider sees /chat/completions under its base, the hub's canary key in its Authorization header (never the editor's token) and the editor's body byte for byte."}
{"do": "root"}
{"do": "spawn", "capture": "mock", "argv": ["$MOCK", "llm", "--script", "$SCENARIOS/fixtures/llm-openai.json", "--log", "$ROOT/llm.log", "--parent", "$HARNESS_PID"], "capture_stdout": {"regex": "MOCK-LLM-PORT (\\d+)", "name": "port"}}
{"do": "start", "hub": "h"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "config/providers", "params": {"providers": [{"id": "mock", "kind": "openai", "base": "http://127.0.0.1:$port", "auth": "bearer", "messages": false, "caps": ["chat", "fim", "embed"]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"applied": 1}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "gateway/keys", "params": {"keys": {"mock": "canary-editor-key"}}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "gateway/editor-token"}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"token": "$capture:tok", "url": "$string"}}}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "status"}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"gateway": {"port": "$capture:gw"}}}}
{"do": "http", "conn": "e", "to": "tcp:127.0.0.1:$gw", "method": "POST", "path": "/p/mock/chat/completions", "headers": {"Host": "127.0.0.1:$gw", "Authorization": "Bearer $tok", "content-type": "application/json"}, "body": "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}],\"x\":  1}"}
{"do": "expect_http", "conn": "e", "status": 200, "body_json": {"id": "chat-1"}}
{"do": "file", "path": "$ROOT/llm.log", "contains": "\"path\":\"/chat/completions\""}
{"do": "file", "path": "$ROOT/llm.log", "contains": "Bearer canary-editor-key"}
{"do": "file", "path": "$ROOT/llm.log", "contains": "\"body\":\"{\\\"model\\\":\\\"m\\\",\\\"messages\\\":[{\\\"role\\\":\\\"user\\\",\\\"content\\\":\\\"hello\\\"}],\\\"x\\\":  1}\""}
{"do": "file", "path": "$ROOT/llm.log", "lacks": "$tok"}
