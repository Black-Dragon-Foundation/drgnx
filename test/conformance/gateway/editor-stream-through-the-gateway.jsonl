{"scenario": "gateway/editor-stream-through-the-gateway", "requires": ["v1", "fake-backend"], "doc": "Task 24, editor row: an SSE answer that opens with a `:` keep-alive comment and sends its data 1500 ms later reaches the editor chunk by chunk: the keep-alive is read within 1 s, the data after it."}
{"do": "root"}
{"do": "write_file", "path": "$ROOT/llm.json", "json": [{"path": "/chat/completions", "content_type": "text/event-stream", "chunks": [[0, ": keep-alive\n\n"], [1500, "data: {\"id\": \"chat-s\"}\n\n"]]}]}
{"do": "spawn", "capture": "mock", "argv": ["$MOCK", "llm", "--script", "$ROOT/llm.json", "--log", "$ROOT/llm.log", "--parent", "$HARNESS_PID"], "capture_stdout": {"regex": "MOCK-LLM-PORT (\\d+)", "name": "port"}}
{"do": "start", "hub": "h"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "config/providers", "params": {"providers": [{"id": "mock", "kind": "openai", "base": "http://127.0.0.1:$port", "auth": "none", "messages": false, "caps": ["chat"]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"applied": 1}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "gateway/editor-token"}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"token": "$capture:tok", "url": "$string"}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "status"}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"gateway": {"port": "$capture:gw"}}}}
{"do": "http", "conn": "e", "to": "tcp:127.0.0.1:$gw", "method": "POST", "path": "/p/mock/chat/completions", "headers": {"Host": "127.0.0.1:$gw", "Authorization": "Bearer $tok", "content-type": "application/json"}, "body": "{\"model\":\"m\",\"stream\":true,\"messages\":[]}", "read": {"bytes": 14}, "within_ms": 1000}
{"do": "expect_http", "conn": "e", "status": 200, "body_contains": ": keep-alive", "within_ms": 1000}
{"do": "expect_http", "conn": "e", "status": 200, "body_contains": "chat-s", "within_ms": 5000}
