{"scenario": "runner/order-and-block", "requires": ["v1", "fake-backend", "test-hooks"], "doc": "Task 16a: job/order moves a task in the run order among the open tasks, job/block keeps a task from getting an agent with its reason (control characters replaced, 500 characters) and job/unblock lets it run again; an unknown task is refused."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "write_file", "path": "$ROOT/plan.md", "text": "# Three\n\n**Repo:** $ROOT/repo\n\n### Task 1: One\n\nx\n\n### Task 2: Two\n\nx\n\n### Task 3: Three\n\nx\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "job/propose", "params": {"plan": "$ROOT/plan.md"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:job", "order": [1, 2, 3]}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "job/order", "params": {"task": "$job#3", "delta": -2}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"order": [3, 1, 2]}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "job/order", "params": {"task": "$job#3", "delta": 1}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"order": [1, 3, 2]}}}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "job/block", "params": {"task": "$job#2", "reason": "wait\nfor me"}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"tasks": {"$contains": [{"n": 2, "blocked": "wait for me"}]}}}}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "job/unblock", "params": {"task": "$job#2"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "result": {"id": "$job"}}}
{"do": "send", "conn": "c", "json": {"id": 6, "method": "job/status", "params": {"id": "$job"}}}
{"do": "expect", "conn": "c", "json": {"id": 6, "result": {"tasks": [{"n": 1}, {"n": 2}, {"n": 3}], "order": [1, 3, 2]}}}
{"do": "send", "conn": "c", "json": {"id": 8, "method": "job/order", "params": {"task": "$job#9", "delta": 1}}}
{"do": "expect", "conn": "c", "json": {"id": 8, "error": {"message": "$string"}}}
