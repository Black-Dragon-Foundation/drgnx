{"scenario": "runner/review-on-another-provider", "requires": ["v1", "fake-backend", "test-hooks"], "doc": "Task 16b: a task that completes goes to review once its worker's turn is over; the reviewer is started on the first profile of the review route (here a Gemini mock, another provider than the worker's Claude) in the task's tree with the review prompt; its last line VERDICT: pass (inside Markdown bold) lets the gate accept the task's files at their current diff and the task merges (--no-ff) into the job's branch: done, a review event, and the job is done."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/repo && cd $ROOT/repo && git init -q && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--script\" \"$ROOT/w.txt\" \"--log\" \"$ROOT/w.log\")) (\"mock-gemini\" :provider gemini :command (\"$MOCK\" \"acp\" \"--as\" \"gemini\" \"--script\" \"$ROOT/r.txt\" \"--log\" \"$ROOT/r.log\")))) (drgnx-agents-routes ((implement \"mock-claude\") (review \"mock-gemini\"))))\n"}
{"do": "write_file", "path": "$ROOT/plan.md", "text": "# Plan\n\n**Repo:** $ROOT/repo\n\n### Task 1: Add the note\n\n**Role:** implement\n\nAdd note.txt.\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "job/propose", "params": {"plan": "$ROOT/plan.md"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:job", "status": "proposed"}}, "within_ms": 10000}
{"do": "write_file", "path": "$ROOT/w.txt", "text": "tool:edit note.txt\\ncommit work\\ncall:complete_task {\"task\": \"$job#1\", \"seen_version\": 0}\n"}
{"do": "write_file", "path": "$ROOT/r.txt", "text": "say Looks fine.\\nsay **VERDICT: pass**\n"}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "job/approve", "params": {"id": "$job"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"id": "$job"}}, "within_ms": 10000}
{"do": "file", "path": "$ROOT/r.log", "contains": "[drgnx review $job#1]", "within_ms": 90000}
{"do": "file", "path": "$STATE/hub/runs/$job/_job/note.txt", "contains": "edited by ratatoskr-mock", "within_ms": 60000}
{"do": "connect", "conn": "q", "hub": "h"}
{"do": "expect_silent", "conn": "q", "for_ms": 4000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "job/status", "params": {"id": "$job"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"id": "$job", "status": "done", "tasks": [{"n": 1, "status": "done"}]}}, "within_ms": 10000}
{"do": "sql_expect", "sql": "select kind, summary from event where kind = 'review'", "rows": [["review", "pass"]]}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "git -C $ROOT/repo log --format=%s job/$job | head -1"], "expect_code": 0, "expect_stdout": "Merge job/$job-1"}
