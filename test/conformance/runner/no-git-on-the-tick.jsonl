{"scenario": "runner/no-git-on-the-tick", "requires": ["v1", "fake-backend", "test-hooks", "linux"], "doc": "Task 16a: the step never waits for git. With a git that takes 2 s per call, job/approve and job/status answer at once and show the task as starting (its worktree is being made by a task of its own); the worker arrives afterwards."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/repo $ROOT/slowbin && cd $ROOT/repo && git init -q && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m init && printf '#!/bin/sh\\ncase \"$*\" in *worktree*) sleep 3;; esac\\nexec /usr/bin/git \"$@\"\\n' > $ROOT/slowbin/git && chmod +x $ROOT/slowbin/git"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))) (drgnx-agents-routes ((implement . \"mock-claude\"))))\n"}
{"do": "write_file", "path": "$ROOT/plan.md", "text": "# Slow\n\n**Repo:** $ROOT/repo\n\n### Task 1: Do the thing\n\n**Role:** implement\n\nNothing to do.\n"}
{"do": "start", "hub": "h", "env": {"PATH": "$ROOT/slowbin:/usr/bin:/bin"}}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "job/propose", "params": {"plan": "$ROOT/plan.md"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:job"}}, "within_ms": 1500}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "job/approve", "params": {"id": "$job"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"status": "running"}}, "within_ms": 1500}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "ping"}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"pid": "$number"}}, "within_ms": 500}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "job/status", "params": {"id": "$job"}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"tasks": [{"n": 1, "status": "starting"}]}}, "within_ms": 1500}
{"do": "connect", "conn": "q", "hub": "h"}
{"do": "expect_silent", "conn": "q", "for_ms": 25000}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "job/status", "params": {"id": "$job"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "result": {"tasks": [{"n": 1, "status": "claimed"}]}}, "within_ms": 60000}
