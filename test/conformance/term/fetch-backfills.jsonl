{"scenario": "term/fetch-backfills", "requires": ["v1", "linux"], "doc": "term/fetch sends the rows above the screen the buffer lacks now, newest first and at most max_bytes of them, even while a patch waits for its view/ack; its answer is that patch's version."}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "term/open", "params": {"dir": "/", "command": ["/bin/sh", "-c", "seq 1 100; exec sleep 600"], "env": [["PATH", "/usr/bin:/bin"]], "cols": 40, "rows": 5, "cell_px": [8, 16], "class": "gui-1"}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": {"id": "$capture:t", "view": "$capture:tv"}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"view": "$tv", "base": 0, "ops": [{"reset": "$any"}]}}, "within_ms": 10000}
{"do": "poll", "conn": "e", "json": {"id": 3, "method": "term/search", "params": {"id": "$t", "query": "100"}}, "expect": {"id": 3, "result": {"found": 1, "held": "$any", "model": "$any"}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "view/resync", "params": {"view": "$tv", "class": "gui-1", "version": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"view": "$tv", "base": 0, "version": "$capture:v2", "ops": [{"reset": "$any"}]}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 5, "method": "term/fetch", "params": {"id": "$t", "max_bytes": 300}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"view": "$tv", "base": "$v2", "ops": [{"insert": {"rows": {"$contains": [{"text": "96"}]}}}]}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 5, "result": {"version": "$number"}}}
