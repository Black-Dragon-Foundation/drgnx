{"scenario": "bridge/survives-a-hub-restart", "requires": ["v1", "fake-backend"], "doc": "The gate row, initialize era (2025-06-18): an agent's bridge on its session socket outlives a hub restart. After a TERM and a start on the same root, the next tools/call works with no new handshake from the agent (the bridge replays it and drops the answer), and both report_test calls are events."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "start", "hub": "h"}
{"do": "install_bin", "to": "$ROOT/bin/ratatoskr"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "mcp/session", "params": {"agent": "s-0000000a", "cwd": "$HOME", "owner": "$HARNESS_PID"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"sid": "$capture:sid", "socket": "$capture:sock"}}}
{"do": "spawn_conn", "conn": "b", "argv": ["$ROOT/bin/ratatoskr", "mcp-bridge", "--socket", "$sock"], "env": {}}
{"do": "send", "conn": "b", "json": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "t", "version": "0"}}}}
{"do": "expect", "conn": "b", "json": {"jsonrpc": "2.0", "id": 1, "result": {"protocolVersion": "2025-06-18"}}}
{"do": "send", "conn": "b", "json": {"jsonrpc": "2.0", "method": "notifications/initialized"}}
{"do": "send", "conn": "b", "json": {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": "report_test", "arguments": {"command": "make check", "passed": 3, "failed": 0}}}}
{"do": "expect", "conn": "b", "json": {"jsonrpc": "2.0", "id": 2, "result": {"isError": "$absent"}}}
{"do": "kill", "hub": "h", "signal": "TERM"}
{"do": "expect_exit", "hub": "h", "code": 0}
{"do": "start", "hub": "h2", "same_root_as": "h"}
{"do": "send", "conn": "b", "json": {"jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": {"name": "report_test", "arguments": {"command": "make check", "passed": 4, "failed": 0}}}}
{"do": "expect_next", "conn": "b", "json": {"jsonrpc": "2.0", "id": 3, "result": {"isError": "$absent"}}, "within_ms": 12000}
{"do": "sql_expect", "sql": "select count(*), min(agent), max(agent) from event where kind = 'test'", "rows": [[2, "s-0000000a", "s-0000000a"]]}
