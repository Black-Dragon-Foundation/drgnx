{"scenario": "basics/ping", "requires": ["v0"], "doc": "ping answers the hub's pid."}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "ping"}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"pid": "$PID(h)"}}}
