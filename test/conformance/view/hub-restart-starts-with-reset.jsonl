{"scenario": "view/hub-restart-starts-with-reset", "requires": ["v1", "test-hooks"], "doc": "Every patch carries the hub's instance id. After a hub restart the restarted hub has no env and sends nothing; once the editor sends view/env again, the first patch is a reset (base 0) with a new hub id, so no patch of the old hub's versions can apply."}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "view/env", "params": {"view": "demo", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 400, "palette": [["accent", "#123456"]], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "__test_view_rows", "params": {"view": "demo", "rows": [{"key": "a", "text": "one"}]}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"hub": "$capture:old", "base": 0, "version": 1, "ops": [{"reset": [{"key": "a", "text": "one"}]}]}}, "within_ms": 10000}
{"do": "kill", "hub": "h", "signal": "TERM"}
{"do": "expect_exit", "hub": "h", "code": 0, "within_ms": 15000}
{"do": "start", "hub": "h2", "same_root_as": "h"}
{"do": "connect", "conn": "e2", "hub": "h2"}
{"do": "send", "conn": "e2", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e2", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e2", "json": {"id": 2, "method": "__test_view_rows", "params": {"view": "demo", "rows": [{"key": "a", "text": "one"}, {"key": "b", "text": "two"}]}}}
{"do": "expect", "conn": "e2", "json": {"id": 2, "result": true}}
{"do": "count_events", "conn": "e2", "for_ms": 300, "none": ["view-patch"]}
{"do": "send", "conn": "e2", "json": {"id": 3, "method": "view/env", "params": {"view": "demo", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 400, "palette": [["accent", "#123456"]], "epoch": 1}}}
{"do": "expect", "conn": "e2", "json": {"event": "view-patch", "data": {"hub": "$not:old", "base": 0, "version": 1, "env_epoch": 1, "ops": [{"reset": [{"key": "a", "text": "one"}, {"key": "b", "text": "two"}]}]}}, "within_ms": 10000}
{"do": "expect", "conn": "e2", "json": {"id": 3, "result": true}}
