{"scenario": "view/env-epoch-on-theme", "requires": ["v1", "test-hooks"], "doc": "The editor numbers its envs: a theme change is a view/env with a new epoch, and the next patch is a reset carrying it; an env with the same epoch (a width change) and the same rows sends nothing."}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "__test_view_rows", "params": {"view": "demo", "rows": [{"key": "a", "text": "one"}]}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "count_events", "conn": "e", "for_ms": 300, "none": ["view-patch"]}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "view/env", "params": {"view": "demo", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 400, "palette": [["accent", "#123456"]], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"base": 0, "version": 1, "env_epoch": 1, "ops": [{"reset": [{"key": "a", "text": "one"}]}]}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "view/env", "params": {"view": "demo", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 320, "palette": [["accent", "#123456"]], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": true}}
{"do": "count_events", "conn": "e", "for_ms": 300, "none": ["view-patch"]}
{"do": "send", "conn": "e", "json": {"id": 5, "method": "view/env", "params": {"view": "demo", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 400, "palette": [["accent", "#654321"]], "epoch": 2}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"base": 1, "version": 2, "env_epoch": 2, "ops": [{"reset": [{"key": "a", "text": "one"}]}]}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 5, "result": true}}
