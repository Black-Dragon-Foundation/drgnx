{"scenario": "view/missing-image-resyncs", "requires": ["v1", "test-hooks"], "doc": "A reset carries every image its rows name; an editor that lacks one asks view/resync, and the answer is a reset that carries it again."}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "view/env", "params": {"view": "demo", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 400, "palette": [["accent", "#123456"]], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "__test_view_rows", "params": {"view": "demo", "rows": [{"key": "a", "text": "  x", "images": [[0, "00000000000000ab-1", "*"]]}], "images": [["00000000000000ab-1", "<svg/>"]]}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"version": 1, "ops": [{"reset": [{"key": "a", "images": [[0, "00000000000000ab-1", "*"]]}]}], "images": [["00000000000000ab-1", "<svg/>"]]}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "view/resync", "params": {"view": "demo", "class": "gui-1", "version": 1}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"base": 1, "version": 2, "ops": [{"reset": [{"key": "a", "images": [[0, "00000000000000ab-1", "*"]]}]}], "images": [["00000000000000ab-1", "<svg/>"]]}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": true}}
