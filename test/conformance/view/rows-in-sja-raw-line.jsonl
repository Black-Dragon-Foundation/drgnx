{"scenario": "view/rows-in-sja-raw-line", "requires": ["v1", "test-hooks"], "doc": "An editor whose env says it holds a view's rows in Sjá (rows_in_sja) gets the view's patches on the raw view-model line {view, rows: PATCH}, any view; an env without it gets view-patch events again."}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "view/env", "params": {"view": "demo", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 400, "palette": [], "epoch": 1, "rows_in_sja": true}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "__test_view_rows", "params": {"view": "demo", "rows": [{"key": "a", "text": "one"}]}}}
{"do": "expect", "conn": "e", "json": {"event": "view-model", "data": {"view": "demo", "rows": {"view": "demo", "class": "gui-1", "hub": "$capture:hub", "base": 0, "version": 1, "env_epoch": 1, "ops": [{"reset": [{"key": "a", "text": "one"}]}]}}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "view/env", "params": {"view": "demo", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 400, "palette": [], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 5, "method": "__test_view_rows", "params": {"view": "demo", "rows": [{"key": "a", "text": "one"}, {"key": "b", "text": "two"}]}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"view": "demo", "class": "gui-1", "hub": "$hub", "base": 1, "version": 2, "ops": [{"insert": {"after": "a", "rows": [{"key": "b", "text": "two"}]}}]}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 5, "result": true}}
