{"scenario": "search/handoff", "requires": ["v1", "test-hooks"], "doc": "Ask an Agent: search/handoff hands a search's matches (all but the unticked) to a live session with a brief; the answer names the hand-off, the session, the ids handed off and how many lines the brief holds; search/handoff-state says it was sent and every match is still there; a hand-off to a session the hub does not hold is refused; a hand-off sent without a mark (a new worker's comes from its first snapshot) is marked later with search/handoff-mark, another window's or an unknown one refused; a hand-off to a new pair starts a chat in the checkout with pair mode on; while a hand-off to an agent editing this checkout is not done, search/edit-doc marks its lines held; search/handoff-context gives the card's context box: the first two places, the total and the brief's tokens."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "write_file", "path": "$ROOT/proj/a.txt", "text": "one needle\nctx\ntwo needle\n"}
{"do": "write_file", "path": "$ROOT/proj/b.txt", "text": "needle\n"}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/proj"}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": {"id": "$capture:sid", "name": "$string"}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "search/run", "params": {"view": "s", "root": "$ROOT/proj", "search": {"query": {"mode": "text", "text": "needle"}}, "context": false}}}
{"do": "expect", "conn": "e", "json": {"event": "search-run-done", "data": {"view": "s", "run": "$capture:run", "files": 2, "matches": 3}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 20, "method": "search/handoff-context", "params": {"view": "s"}}}
{"do": "expect", "conn": "e", "json": {"id": 20, "result": {"rows": [{"path": "a.txt", "line": 1, "text": "one needle"}, {"path": "a.txt", "line": 3, "text": "two needle"}], "total": 3, "tokens": "$number"}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "search/handoff", "params": {"view": "s", "instruction": "Rename needle to pin.", "to": {"session": {"id": "nosuch"}}}}}
{"do": "expect", "conn": "e", "json": {"id": 4, "error": "$any"}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 5, "method": "search/handoff", "params": {"view": "s", "instruction": "Rename needle to pin.", "to": {"session": {"id": "$sid"}}, "mark": {"face": "drgnx-agent-1", "glyph": "●"}}}}
{"do": "expect", "conn": "e", "json": {"id": 5, "result": {"handoff": "$capture:h", "session": "$sid", "ids": "$any", "sent": 3, "more": 0}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 6, "method": "search/handoff-state", "params": {"handoff": "$h"}}}
{"do": "expect", "conn": "e", "json": {"id": 6, "result": {"handoff": "$h", "view": "s", "session": "$sid", "phase": "sent", "done": [], "left": "$any"}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 7, "method": "search/handoff-state", "params": {"handoff": "h:999"}}}
{"do": "expect", "conn": "e", "json": {"id": 7, "error": "$any"}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 8, "method": "search/handoff", "params": {"view": "s", "instruction": "Rename needle to pin.", "to": {"session": {"id": "$sid"}}}}}
{"do": "expect", "conn": "e", "json": {"id": 8, "result": {"handoff": "$capture:h2", "session": "$sid", "ids": "$any", "sent": 3, "more": 0}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 9, "method": "search/handoff-mark", "params": {"handoff": "$h2", "mark": {"face": "drgnx-agent-2", "glyph": "\u25b2"}}}}
{"do": "expect", "conn": "e", "json": {"id": 9, "result": true}, "within_ms": 10000}
{"do": "connect", "conn": "o", "hub": "h"}
{"do": "send", "conn": "o", "json": {"id": 1, "method": "search/handoff-mark", "params": {"handoff": "$h2", "mark": {"face": "drgnx-agent-2", "glyph": "\u25b2"}}}}
{"do": "expect", "conn": "o", "json": {"id": 1, "error": "$any"}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 10, "method": "search/handoff", "params": {"view": "s", "instruction": "Rename needle to pin.", "to": {"pair": {"profile": "mock-claude"}}}}}
{"do": "expect", "conn": "e", "json": {"id": 10, "result": {"handoff": "$string", "session": "$capture:pid", "ids": "$any", "sent": 3, "more": 0}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "agent", "data": {"id": "$pid", "session": {"paired": true}}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 12, "method": "search/edit-doc", "params": {"view": "s"}}}
{"do": "expect", "conn": "e", "json": {"id": 12, "result": {"lines": [{"line_id": "l:0", "path": "$ROOT/proj/a.txt", "line": 1, "text": "one needle", "kind": "match", "eol": true, "held": true}, {"line_id": "l:1", "path": "$ROOT/proj/a.txt", "line": 3, "text": "two needle", "kind": "match", "eol": true, "held": true}, {"line_id": "l:2", "path": "$ROOT/proj/b.txt", "line": 1, "text": "needle", "kind": "match", "eol": true, "held": true}], "total": 3}}, "within_ms": 10000}
