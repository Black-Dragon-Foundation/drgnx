{"scenario": "search/run-window", "requires": ["v1", "test-hooks"], "doc": "search/run sends a view the first 200 rows of a 251-row result and no more; the totals come with search-run-done; search/grep-look asks for one window more (the last row), or for the rows up to a match, and answers false for a view with no search."}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "view/env", "params": {"view": "s", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 400, "palette": [], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/proj && seq 1 250 | sed 's/^/needle /' > $ROOT/proj/a.txt"]}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "search/run", "params": {"view": "s", "root": "$ROOT/proj", "search": {"query": {"mode": "text", "text": "needle"}}}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"view": "s", "class": "gui-1", "hub": "$capture:hub", "base": 0, "version": 1, "env_epoch": 1, "ops": [{"reset": []}]}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"hub": "$hub", "base": 1, "version": 2, "ops": "$any"}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "search-run-done", "data": {"view": "s", "run": "$number", "files": 1, "matches": 250}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": {"run": "$number"}}}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "search/grep-look", "params": {"view": "s", "more": true}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"hub": "$hub", "base": 2, "version": 3, "ops": "$any"}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 5, "method": "search/grep-look", "params": {"view": "nothing", "more": true}}}
{"do": "expect", "conn": "e", "json": {"id": 5, "result": false}}
