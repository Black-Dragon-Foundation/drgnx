{"scenario": "search/grep-streams-rows", "requires": ["v1", "test-hooks"], "doc": "search/grep sends a view a reset of no rows at once, then each file's header and matches as rows; search/grep-replace patches the rows' preview of a replacement without a new search; search-grep-done names the query, the files and the matches."}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "view/env", "params": {"view": "s", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 400, "palette": [], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "write_file", "path": "$ROOT/proj/a.txt", "text": "one needle\nneedle two\nnothing\n"}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "search/grep", "params": {"view": "s", "root": "$ROOT/proj", "text": "needle"}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"view": "s", "class": "gui-1", "hub": "$capture:hub", "base": 0, "version": 1, "env_epoch": 1, "ops": [{"reset": []}]}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"hub": "$hub", "base": 1, "version": 2, "ops": [{"insert": {"after": null, "rows": [{"key": "f:$ROOT/proj/a.txt", "text": "[x] a.txt"}, {"key": "m:$ROOT/proj/a.txt:1:4", "text": "  [x] one needle", "runs": [[10, 16, "drgnx-replace-match"]]}, {"key": "m:$ROOT/proj/a.txt:2:0", "text": "  [x] needle two"}]}}]}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "search-grep-done", "data": {"view": "s", "query": "$number", "files": 1, "matches": 2}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": {"query": "$number"}}}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "search/grep-replace", "params": {"view": "s", "replace": "pin"}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"hub": "$hub", "base": 2, "version": 3, "ops": [{"replace": [{"key": "m:$ROOT/proj/a.txt:1:4", "text": "  [x] one needlepin", "runs": [[10, 16, "drgnx-replace-old"], [16, 19, "drgnx-replace-new"]]}, {"key": "m:$ROOT/proj/a.txt:2:0", "text": "  [x] needlepin two", "runs": [[6, 12, "drgnx-replace-old"], [12, 15, "drgnx-replace-new"]]}]}]}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": true}}
