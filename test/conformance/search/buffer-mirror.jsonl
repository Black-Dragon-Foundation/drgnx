{"scenario": "search/buffer-mirror", "requires": ["v1", "test-hooks"], "doc": "search/buffer with mirror: the editor sends no text; the hub searches the text of the editor's tracked buffer (the edit history's mirror), once the mirror's version has reached the version the editor names. While the mirror is behind, or no buffer of the file is tracked, the answer is false and the search is unchanged."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/repo && cd $ROOT/repo && git init -q -b main && printf 'one needle\\n' > a.txt && git add a.txt && git -c user.email=t@example.invalid -c user.name=t commit -qm base"], "expect_code": 0}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "view/env", "params": {"view": "s", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 400, "palette": [], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "search/run", "params": {"view": "s", "root": "$ROOT/repo", "search": {"query": {"mode": "text", "text": "needle"}}}}}
{"do": "expect", "conn": "e", "json": {"event": "search-run-done", "data": {"view": "s", "run": "$capture:run", "files": 1, "matches": 1}}, "within_ms": 30000}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "history/register", "params": {"path": "a.txt", "worktree_root": "$ROOT/repo", "buffer_id": "b1"}}}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": {"tracked": true}}, "within_ms": 30000}
{"do": "send", "conn": "e", "json": {"id": 5, "method": "history/batch", "params": {"buffer_id": "b1", "changes": [{"start": 10, "old_len": 0, "inserted": " needle", "origin": "user"}], "version": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 5, "result": {"ok": true}}, "within_ms": 30000}
{"do": "send", "conn": "e", "json": {"id": 6, "method": "search/buffer", "params": {"view": "s", "path": "$ROOT/repo/a.txt", "tick": 3, "mirror": true, "version": 9}}}
{"do": "expect", "conn": "e", "json": {"id": 6, "result": false}, "within_ms": 30000}
{"do": "send", "conn": "e", "json": {"id": 7, "method": "search/buffer", "params": {"view": "s", "path": "$ROOT/repo/a.txt", "tick": 3, "mirror": true, "version": 1}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"view": "s", "ops": "$any"}}, "within_ms": 30000}
{"do": "expect", "conn": "e", "json": {"event": "search-run-done", "data": {"view": "s", "run": "$run", "files": 1, "matches": 2}}, "within_ms": 30000}
{"do": "expect", "conn": "e", "json": {"id": 7, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 8, "method": "search/buffer", "params": {"view": "s", "path": "$ROOT/repo/nothing-tracked.txt", "tick": 1, "mirror": true}}}
{"do": "expect", "conn": "e", "json": {"id": 8, "result": false}, "within_ms": 30000}
