{"do": "expect", "conn": "e", "json": {"id": 5, "result": true}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "debug-frame", "data": {"session": "$s", "line": 10, "top": true}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 108, "method": "agents/send", "params": {"id": "$a", "text": "call:debug_live {\"debug_session\": \"$s\", \"op\": \"next\", \"epoch\": 1}"}}}
{"do": "expect", "conn": "c", "json": {"id": 108, "result": true}}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "for i in $(seq 300); do grep -q 'call: session .* moved on since stop 1' $STATE/hub/transcripts/$a.jsonl && exit 0; sleep 0.1; done; grep -o 'call:[^\"]*' $STATE/hub/transcripts/$a.jsonl >&2; exit 1"], "expect_code": 0}
{"do": "send", "conn": "c", "json": {"id": 110, "method": "agents/send", "params": {"id": "$a", "text": "call:debug_live {\"debug_session\": \"$s\", \"op\": \"next\", \"epoch\": 2}"}}}
{"do": "expect", "conn": "c", "json": {"id": 110, "result": true}}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "for i in $(seq 300); do grep -q 'call: {.*done' $STATE/hub/transcripts/$a.jsonl && exit 0; sleep 0.1; done; grep -o 'call:[^\"]*' $STATE/hub/transcripts/$a.jsonl >&2; exit 1"], "expect_code": 0}
{"do": "expect", "conn": "e", "json": {"event": "debug-frame", "data": {"session": "$s", "line": 11, "top": true}}, "within_ms": 10000}
