{"do": "expect", "conn": "c", "json": {"id": 102, "result": true}}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "for i in $(seq 300); do grep -q 'call: {.*debug_session.*epoch.*1' $STATE/hub/transcripts/$a.jsonl && exit 0; sleep 0.1; done; grep -o 'call:[^\"]*' $STATE/hub/transcripts/$a.jsonl >&2; exit 1"], "expect_code": 0}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "debug/breakpoints", "params": {"root": "$ROOT/proj", "op": {"op": "add", "path": "$ROOT/proj/a.py", "line": 12}}}}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": {"added": 1}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 104, "method": "agents/send", "params": {"id": "$a", "text": "call:debug_probe {\"root\": \"$ROOT/proj\", \"op\": \"remove\", \"id\": \"b1\"}"}}}
{"do": "expect", "conn": "c", "json": {"id": 104, "result": true}}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "for i in $(seq 300); do grep -q 'call: breakpoint b1 is not yours' $STATE/hub/transcripts/$a.jsonl && exit 0; sleep 0.1; done; grep -o 'call:[^\"]*' $STATE/hub/transcripts/$a.jsonl >&2; exit 1"], "expect_code": 0}
{"do": "send", "conn": "c", "json": {"id": 106, "method": "agents/send", "params": {"id": "$a", "text": "call:debug_probe {\"root\": \"$ROOT/proj\", \"op\": \"breakpoint\", \"path\": \"$ROOT/proj/a.py\", \"line\": 14}"}}}
{"do": "expect", "conn": "c", "json": {"id": 106, "result": true}}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "for i in $(seq 300); do grep -q 'call: {.*b2' $STATE/hub/transcripts/$a.jsonl && exit 0; sleep 0.1; done; grep -o 'call:[^\"]*' $STATE/hub/transcripts/$a.jsonl >&2; exit 1"], "expect_code": 0}
{"do": "expect", "conn": "e", "json": {"event": "debug-breakpoints", "data": {"root": "$ROOT/proj", "breakpoints": {"$contains": [{"line": 14, "agent": "$a"}]}}}, "within_ms": 10000}
