{"scenario": "debug/inline-breakpoints", "requires": ["v1", "test-hooks"], "doc": "Inline (column) breakpoints: two breakpoints on one line, one at a column, are two; adding the column again names the one there; the adapter gets the column in UTF-16 units (a non-BMP character before it counts two), and `debug/breakpoint-locations` turns the adapter's `breakpointLocations` back into characters."}
{"do": "start", "hub": "h"}
{"do": "write_file", "path": "$ROOT/proj/.vscode/launch.json", "json": {"version": "0.2.0", "configurations": [{"type": "mocka", "request": "launch", "name": "App", "program": "p"}]}}
{"do": "write_file", "path": "$ROOT/proj/app.js", "text": "let a = 1\n\ud835\udc65\u00e9 = f(y)\n"}
{"do": "write_file", "path": "$ROOT/a.json", "json": [{"expect": "initialize", "ok": {"supportsConfigurationDoneRequest": true, "supportsBreakpointLocationsRequest": true}}, {"expect": "launch", "ok": {}}, {"event": "initialized"}, {"expect": "setBreakpoints", "args": {"source": {"path": "$ROOT/proj/app.js"}, "breakpoints": [{"line": 2}, {"line": 2, "column": 6}]}, "ok": {"breakpoints": [{"id": 11, "verified": true, "line": 2}, {"id": 12, "verified": true, "line": 2, "column": 6}]}}, {"expect": "configurationDone"}, {"expect": "breakpointLocations", "args": {"source": {"path": "$ROOT/proj/app.js"}, "line": 2}, "ok": {"breakpoints": [{"line": 2, "column": 1}, {"line": 2, "column": 6, "endColumn": 9}]}}, {"expect": "disconnect", "ok": {}}, {"die": true}]}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "debug/trust", "params": {"root": "$ROOT/proj", "trusted": true}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "debug/breakpoints", "params": {"root": "$ROOT/proj", "op": {"op": "add", "path": "$ROOT/proj/app.js", "line": 2}}}}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": {"added": "$capture:a"}}}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "debug/breakpoints", "params": {"root": "$ROOT/proj", "op": {"op": "add", "path": "$ROOT/proj/app.js", "line": 2, "column": 5}}}}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": {"added": "$capture:b", "breakpoints": [{"line": 2}, {"line": 2, "column": 5}]}}}
{"do": "send", "conn": "e", "json": {"id": 5, "method": "debug/breakpoints", "params": {"root": "$ROOT/proj", "op": {"op": "add", "path": "$ROOT/proj/app.js", "line": 2, "column": 5}}}}
{"do": "expect", "conn": "e", "json": {"id": 5, "result": {"added": "$b"}}}
{"do": "send", "conn": "e", "json": {"id": 6, "method": "debug/start", "params": {"root": "$ROOT/proj", "config": "launch:0", "adapters": [{"id": "mocka", "name": "Mock A", "types": ["mocka"], "find": {"path": "$HUB_BIN"}, "start": {"stdio": ["{program}", "debug-mock", "$ROOT/a.json"]}}]}}}
{"do": "expect", "conn": "e", "json": {"id": 6, "result": {"session": "$capture:s"}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "debug-breakpoints", "data": {"breakpoints": [{"line": 2, "verified": true}, {"line": 2, "column": 5, "verified": true}]}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 7, "method": "debug/breakpoint-locations", "params": {"session": "$s", "path": "$ROOT/proj/app.js", "line": 2}}}
{"do": "expect", "conn": "e", "json": {"id": 7, "result": {"locations": [{"line": 2, "column": 1}, {"line": 2, "column": 5, "end_column": 8}]}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 8, "method": "debug/control", "params": {"session": "$s", "op": "stop"}}}
{"do": "expect", "conn": "e", "json": {"id": 8, "result": true}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "debug-ended", "data": {"session": "$s"}}, "within_ms": 10000}
