{"scenario": "debug/memory-view", "requires": ["v1", "test-hooks"], "doc": "The memory view: `debug/read-memory` is the adapter's `readMemory` (address, base64 data, unreadable bytes), more than 64 KiB is refused before the adapter, and `debug/write-memory` is refused with words when the adapter cannot write memory. The editor offers it once the session's capabilities are in `debug-state`; asked before, it is refused as still starting."}
{"do": "start", "hub": "h"}
{"do": "write_file", "path": "$ROOT/proj/.vscode/launch.json", "json": {"version": "0.2.0", "configurations": [{"type": "mocka", "request": "launch", "name": "App", "program": "p"}]}}
{"do": "write_file", "path": "$ROOT/a.json", "json": [{"expect": "initialize", "ok": {"supportsConfigurationDoneRequest": true, "supportsReadMemoryRequest": true}}, {"expect": "launch", "ok": {}}, {"event": "initialized"}, {"expect": "configurationDone"}, {"expect": "readMemory", "args": {"memoryReference": "0x1000", "offset": 8, "count": 4}, "ok": {"address": "0x1008", "data": "AQID", "unreadableBytes": 1}}, {"expect": "disconnect", "ok": {}}, {"die": true}]}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "debug/trust", "params": {"root": "$ROOT/proj", "trusted": true}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "debug/start", "params": {"root": "$ROOT/proj", "config": "launch:0", "adapters": [{"id": "mocka", "name": "Mock A", "types": ["mocka"], "find": {"path": "$HUB_BIN"}, "start": {"stdio": ["{program}", "debug-mock", "$ROOT/a.json"]}}]}}}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": {"session": "$capture:s"}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "debug-state", "data": {"sessions": [{"id": "$s", "caps": {"supportsReadMemoryRequest": true}}]}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "debug/read-memory", "params": {"session": "$s", "reference": "0x1000", "offset": 8, "count": 4}}}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": {"address": "0x1008", "data": "AQID", "unreadable": 1}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 5, "method": "debug/read-memory", "params": {"session": "$s", "reference": "0x1000", "count": 65537}}}
{"do": "expect", "conn": "e", "json": {"id": 5, "error": {"code": "invalid-params"}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 6, "method": "debug/write-memory", "params": {"session": "$s", "reference": "0x1000", "data": "AQID"}}}
{"do": "expect", "conn": "e", "json": {"id": 6, "error": {"message": "this adapter cannot write memory"}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 7, "method": "debug/control", "params": {"session": "$s", "op": "stop"}}}
{"do": "expect", "conn": "e", "json": {"id": 7, "result": true}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "debug-ended", "data": {"session": "$s"}}, "within_ms": 10000}
