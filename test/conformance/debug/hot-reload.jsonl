{"do": "send", "conn": "e", "json": {"id": 7, "method": "debug/start", "params": {"root": "$ROOT/proj", "config": "launch:1", "adapters": [{"id": "mockc", "name": "Mock C", "types": ["mockc"], "find": {"path": "$HUB_BIN"}, "start": {"stdio": ["{program}", "debug-mock", "$ROOT/b.json"]}}]}}}
