{"scenario": "debug/hot-reload", "requires": ["v1", "test-hooks"], "doc": "Hot reload (D8, Python first): `debug/hot-reload` swaps the saved file's changed function bodies into the stopped Python program (one `evaluate`, its answer hex in a string), names what it could not, and restarts the frame where the adapter can; refused while running, for other adapters and for a relative path."}
{"do": "start", "hub": "h"}
{"do": "write_file", "path": "$ROOT/proj/.vscode/launch.json", "json": {"version": "0.2.0", "configurations": [{"type": "python", "request": "launch", "name": "App", "program": "app.py"}, {"type": "mockc", "request": "launch", "name": "Native", "program": "p"}]}}
{"do": "write_file", "path": "$ROOT/proj/app.py", "text": "def f():\n    return 2\n"}
{"do": "write_file", "path": "$ROOT/a.json", "json": [{"expect": "initialize", "ok": {"supportsConfigurationDoneRequest": true, "supportsRestartFrame": true}}, {"expect": "launch", "ok": {}}, {"event": "initialized"}, {"expect": "configurationDone"}, {"event": "stopped", "body": {"reason": "breakpoint", "threadId": 1, "allThreadsStopped": true}}, {"expect": "threads", "ok": {"threads": [{"id": 1, "name": "main"}]}}, {"expect": "stackTrace", "ok": {"stackFrames": [{"id": 5, "name": "f", "line": 5, "column": 1, "source": {"path": "$ROOT/proj/app.py"}}], "totalFrames": 1}}, {"expect": "scopes", "ok": {"scopes": [{"name": "Locals", "variablesReference": 9}]}}, {"expect": "variables", "ok": {"variables": []}}, {"expect": "evaluate", "args": {"frameId": 5, "context": "clipboard"}, "ok": {"result": "'7b2270617463686564223a5b22432e6d222c2266225d2c22736b6970706564223a5b7b226e616d65223a2267222c22776879223a226e65773a206974206578697374732066726f6d20746865206e6578742072756e227d5d7d'", "variablesReference": 0}}, {"expect": "restartFrame", "args": {"frameId": 5}, "ok": {}}, {"expect": "disconnect", "ok": {}}, {"die": true}]}
{"do": "write_file", "path": "$ROOT/b.json", "json": [{"expect": "initialize", "ok": {"supportsConfigurationDoneRequest": true}}, {"expect": "launch", "ok": {}}, {"event": "initialized"}, {"expect": "configurationDone"}, {"event": "stopped", "body": {"reason": "breakpoint", "threadId": 1, "allThreadsStopped": true}}, {"expect": "threads", "ok": {"threads": [{"id": 1, "name": "main"}]}}, {"expect": "stackTrace", "ok": {"stackFrames": [{"id": 5, "name": "f", "line": 5, "column": 1, "source": {"path": "$ROOT/proj/app.py"}}], "totalFrames": 1}}, {"expect": "scopes", "ok": {"scopes": [{"name": "Locals", "variablesReference": 9}]}}, {"expect": "variables", "ok": {"variables": []}}, {"expect": "disconnect", "ok": {}}, {"die": true}]}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "debug/trust", "params": {"root": "$ROOT/proj", "trusted": true}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "debug/start", "params": {"root": "$ROOT/proj", "config": "launch:0", "adapters": [{"id": "mockpy", "name": "Mock Python", "types": ["python"], "find": {"path": "$HUB_BIN"}, "start": {"stdio": ["{program}", "debug-mock", "$ROOT/a.json"]}}]}}}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": {"session": "$capture:s3"}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "debug-state", "data": {"sessions": [{"id": "$s3", "state": "stopped"}]}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "debug/hot-reload", "params": {"session": "$s3", "path": "app.py"}}}
{"do": "expect", "conn": "e", "json": {"id": 4, "error": {"code": "invalid-params"}}}
