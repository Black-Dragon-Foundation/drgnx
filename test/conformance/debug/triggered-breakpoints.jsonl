{"scenario": "debug/triggered-breakpoints", "requires": ["v1", "test-hooks"], "doc": "Triggered breakpoints: a breakpoint triggered by another is left out of a session's `setBreakpoints` until that session stops on its trigger (`hitBreakpointIds`); then the file is sent again with it, and the breakpoint no longer waits."}
{"do": "start", "hub": "h"}
{"do": "write_file", "path": "$ROOT/proj/.vscode/launch.json", "json": {"version": "0.2.0", "configurations": [{"type": "mocka", "request": "launch", "name": "App", "program": "p"}]}}
{"do": "write_file", "path": "$ROOT/proj/app.py", "text": "a = 1\nb = 2\nc = 3\nd = 4\n"}
{"do": "write_file", "path": "$ROOT/a.json", "json": [{"expect": "initialize", "ok": {"supportsConfigurationDoneRequest": true}}, {"expect": "launch", "ok": {}}, {"event": "initialized"}, {"expect": "setBreakpoints", "args": {"source": {"path": "$ROOT/proj/app.py"}, "breakpoints": [{"line": 2}]}, "ok": {"breakpoints": [{"id": 11, "verified": true, "line": 2}]}}, {"expect": "configurationDone"}, {"event": "stopped", "body": {"reason": "breakpoint", "threadId": 1, "allThreadsStopped": true, "hitBreakpointIds": [11]}}, {"expect": "threads", "ok": {"threads": [{"id": 1, "name": "main"}]}}, {"expect": "stackTrace", "ok": {"stackFrames": [{"id": 5, "name": "f", "line": 2, "column": 1, "source": {"path": "$ROOT/proj/app.py"}}], "totalFrames": 1}}, {"expect": "scopes", "ok": {"scopes": [{"name": "Locals", "variablesReference": 9}]}}, {"expect": "variables", "ok": {"variables": [{"name": "count", "value": "3", "variablesReference": 0}]}}, {"expect": "setBreakpoints", "args": {"source": {"path": "$ROOT/proj/app.py"}, "breakpoints": [{"line": 2}, {"line": 4}]}, "ok": {"breakpoints": [{"id": 11, "verified": true, "line": 2}, {"id": 12, "verified": true, "line": 4}]}}, {"expect": "disconnect", "ok": {}}, {"die": true}]}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "debug/trust", "params": {"root": "$ROOT/proj", "trusted": true}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "debug/breakpoints", "params": {"root": "$ROOT/proj", "op": {"op": "add", "path": "$ROOT/proj/app.py", "line": 2}}}}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": {"added": "$capture:a"}}}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "debug/breakpoints", "params": {"root": "$ROOT/proj", "op": {"op": "add", "path": "$ROOT/proj/app.py", "line": 4}}}}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": {"added": "$capture:b"}}}
{"do": "send", "conn": "e", "json": {"id": 5, "method": "debug/breakpoints", "params": {"root": "$ROOT/proj", "op": {"op": "trigger", "id": "$b", "triggered_by": "$a"}}}}
{"do": "expect", "conn": "e", "json": {"id": 5, "result": {"breakpoints": [{"line": 2, "waiting": false}, {"line": 4, "triggered_by": "$a", "waiting": true}]}}}
{"do": "send", "conn": "e", "json": {"id": 6, "method": "debug/start", "params": {"root": "$ROOT/proj", "config": "launch:0", "adapters": [{"id": "mocka", "name": "Mock A", "types": ["mocka"], "find": {"path": "$HUB_BIN"}, "start": {"stdio": ["{program}", "debug-mock", "$ROOT/a.json"]}}]}}}
{"do": "expect", "conn": "e", "json": {"id": 6, "result": {"session": "$capture:s"}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "debug-breakpoints", "data": {"breakpoints": [{"line": 2}, {"line": 4, "waiting": false, "verified": true}]}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 7, "method": "debug/control", "params": {"session": "$s", "op": "stop"}}}
{"do": "expect", "conn": "e", "json": {"id": 7, "result": true}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "debug-ended", "data": {"session": "$s"}}, "within_ms": 10000}
