{"scenario": "debug/configs-name-missing-adapters", "requires": ["v1", "test-hooks"], "doc": "debug/configs marks a configuration whose adapter is not found here with `missing`: the adapter, its name and how it installs (download, pip, system with its command, none); a found adapter, and a configuration that connects to a running adapter (debugServer), carry none."}
{"do": "start", "hub": "h"}
{"do": "write_file", "path": "$ROOT/proj/.vscode/launch.json", "json": {"version": "0.2.0", "configurations": [{"type": "mock", "request": "launch", "name": "Found"}, {"type": "ghostdl", "request": "launch", "name": "Download"}, {"type": "ghostpip", "request": "launch", "name": "Pip"}, {"type": "ghostsys", "request": "launch", "name": "System"}, {"type": "ghostown", "request": "launch", "name": "Own"}, {"type": "ghostdl", "request": "attach", "name": "Server", "debugServer": 4711}]}}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "debug/configs", "params": {"root": "$ROOT/proj", "adapters": [{"id": "mock", "name": "Mock", "types": ["mock"], "find": {"path": "$HUB_BIN"}, "start": {"stdio": ["{program}", "debug-mock", "$ROOT/s.json"]}}, {"id": "ghost-dl", "name": "Ghost Download", "types": ["ghostdl"], "find": {"path": "drgnx-no-such-adapter-a"}, "start": {"stdio": ["{program}"]}, "install": {"url": "https://example.invalid/g.tar.gz", "sha256": "00", "into": "ghost"}}, {"id": "ghost-pip", "name": "Ghost Pip", "types": ["ghostpip"], "find": {"path": "drgnx-no-such-adapter-b"}, "start": {"stdio": ["{program}"]}, "install": {"pip": "ghost==1", "hash": "sha256:00"}}, {"id": "ghost-sys", "name": "Ghost System", "types": ["ghostsys"], "find": {"path": "drgnx-no-such-adapter-c"}, "start": {"stdio": ["{program}"]}, "install": {"system": "dnf install ghost"}}, {"id": "ghost-own", "name": "Ghost Own", "types": ["ghostown"], "find": {"path": "drgnx-no-such-adapter-d"}, "start": {"stdio": ["{program}"]}}]}}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": {"configs": [{"id": "launch:0", "name": "Found", "missing": "$absent"}, {"id": "launch:1", "name": "Download", "missing": {"adapter": "ghost-dl", "name": "Ghost Download", "install": "download", "command": "$absent"}}, {"id": "launch:2", "name": "Pip", "missing": {"adapter": "ghost-pip", "name": "Ghost Pip", "install": "pip"}}, {"id": "launch:3", "name": "System", "missing": {"adapter": "ghost-sys", "name": "Ghost System", "install": "system", "command": "dnf install ghost"}}, {"id": "launch:4", "name": "Own", "missing": {"adapter": "ghost-own", "name": "Ghost Own", "install": "none"}}, {"id": "launch:5", "name": "Server", "missing": "$absent"}]}}}
