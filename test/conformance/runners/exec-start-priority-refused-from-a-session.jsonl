{"scenario": "runners/exec-start-priority-refused-from-a-session", "requires": ["v1", "test-hooks"], "doc": "[B] A job's priority is the hub's to set: a session (an agent) that asks job_start for a priority is refused (an unknown field) and no job starts; the user's connection may set one (exec/get shows it), and one outside 1-5 is refused with invalid-params at priority."}
{"do": "root"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkfifo $ROOT/gate"], "expect_code": 0}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "mcp/session", "params": {"agent": "s-0000000a", "job": "j1", "cwd": "$HOME", "owner": "$HARNESS_PID"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"sid": "$capture:sid", "socket": "$capture:sock"}}}
{"do": "connect", "conn": "m", "hub": "h", "socket": "path:$sock", "as": "raw"}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "t", "version": "0"}}}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 1, "result": {"protocolVersion": "2025-06-18"}}}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": "job_start", "arguments": {"argv": ["true"], "priority": 1}}}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 2, "result": {"content": [{"type": "text", "text": "$string"}], "isError": true}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "exec/list", "params": {}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"jobs": []}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "exec/start", "params": {"argv": ["true"], "cwd": "$ROOT", "priority": 9}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "error": {"code": "invalid-params", "path": "priority"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "exec/start", "params": {"argv": ["sh", "-c", "cat $ROOT/gate"], "cwd": "$ROOT", "priority": 2}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"id": "$capture:job", "text": "$string"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "exec/get", "params": {"id": "$job"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "result": {"id": "$job", "priority": 2, "machine": "local"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 6, "method": "exec/stop", "params": {"id": "$job"}}}
{"do": "expect", "conn": "c", "json": {"id": 6, "result": {"id": "$job", "status": "stopped"}}, "within_ms": 10000}
