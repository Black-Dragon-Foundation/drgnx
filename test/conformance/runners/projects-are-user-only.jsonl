{"scenario": "runners/projects-are-user-only", "requires": ["v1", "test-hooks"], "doc": "[B] the project registry is the user's: jobs/project-list answers the user's connection (none registered yet); jobs/project-add, -list and -remove are not-allowed on an agent's connection, which registers nothing."}
{"do": "root"}
{"do": "start", "hub": "h", "args": ["--agent-socket", "s1:j1"]}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "a", "hub": "h", "socket": "agent:s1", "as": "service"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "jobs/project-list", "params": {}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"projects": []}}, "within_ms": 10000}
{"do": "send", "conn": "a", "json": {"id": 1, "method": "jobs/project-add", "params": {"path": "/tmp"}}}
{"do": "expect", "conn": "a", "json": {"id": 1, "error": {"code": "not-allowed"}}, "within_ms": 10000}
{"do": "send", "conn": "a", "json": {"id": 2, "method": "jobs/project-list", "params": {}}}
{"do": "expect", "conn": "a", "json": {"id": 2, "error": {"code": "not-allowed"}}, "within_ms": 10000}
{"do": "send", "conn": "a", "json": {"id": 3, "method": "jobs/project-remove", "params": {"id": "p000000000000"}}}
{"do": "expect", "conn": "a", "json": {"id": 3, "error": {"code": "not-allowed"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "jobs/project-list", "params": {}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"projects": []}}, "within_ms": 10000}
