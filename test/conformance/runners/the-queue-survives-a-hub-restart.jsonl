{"scenario": "runners/the-queue-survives-a-hub-restart", "requires": ["v1", "test-hooks"], "doc": "[B] The queue is in runtime.db: after a hub restart the queued job is still queued with its priority and its reason, the running job (parked on a FIFO) still holds the one slot (DRGNX_TEST_JOB_SLOTS=1), and when that job ends the queued one runs. (Attempts on a runner become detached at a restart: Rust rows, there being no runner here.)"}
{"do": "root"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkfifo $ROOT/gate"], "expect_code": 0}
{"do": "start", "hub": "h", "env": {"DRGNX_TEST_JOB_SLOTS": "1"}}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "exec/start", "params": {"argv": ["sh", "-c", "cat $ROOT/gate"], "cwd": "$ROOT"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:first", "text": "$string"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "exec/start", "params": {"argv": ["sh", "-c", "echo after-restart"], "cwd": "$ROOT", "priority": 2}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"id": "$capture:second", "text": "$string"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "exec/get", "params": {"id": "$second"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"id": "$second", "status": "queued", "priority": 2, "waiting": "$string"}}, "within_ms": 10000}
{"do": "kill", "hub": "h", "signal": "TERM"}
{"do": "expect_exit", "hub": "h", "code": 0, "within_ms": 15000}
{"do": "start", "hub": "h2", "same_root_as": "h", "env": {"DRGNX_TEST_JOB_SLOTS": "1"}}
{"do": "connect", "conn": "c2", "hub": "h2"}
{"do": "connect", "conn": "e2", "hub": "h2"}
{"do": "send", "conn": "e2", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e2", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c2", "json": {"id": 1, "method": "exec/get", "params": {"id": "$first"}}}
{"do": "expect", "conn": "c2", "json": {"id": 1, "result": {"id": "$first", "status": "running"}}, "within_ms": 10000}
{"do": "send", "conn": "c2", "json": {"id": 2, "method": "exec/get", "params": {"id": "$second"}}}
{"do": "expect", "conn": "c2", "json": {"id": 2, "result": {"id": "$second", "status": "queued", "priority": 2, "waiting": "$string"}}, "within_ms": 10000}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "echo go > $ROOT/gate"], "expect_code": 0}
{"do": "expect", "conn": "e2", "json": {"event": "exec-done", "data": {"id": "$second", "status": "done"}}, "within_ms": 20000}
{"do": "send", "conn": "c2", "json": {"id": 3, "method": "exec/log", "params": {"id": "$second"}}}
{"do": "expect", "conn": "c2", "json": {"id": 3, "result": {"id": "$second", "lines": ["after-restart"]}}, "within_ms": 10000}
