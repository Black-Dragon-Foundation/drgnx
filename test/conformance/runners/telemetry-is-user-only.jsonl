{"scenario": "runners/telemetry-is-user-only", "requires": ["v1", "test-hooks"], "doc": "[B] runners/telemetry/subscribe and runners/telemetry/range are the user's only (not-allowed on an agent's connection); on the user's a level that does not exist, a span that runs backward and a runner that is not there are invalid-params."}
{"do": "root"}
{"do": "start", "hub": "h", "args": ["--agent-socket", "s1:j1"]}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "a", "hub": "h", "socket": "agent:s1", "as": "service"}
{"do": "send", "conn": "a", "json": {"id": 1, "method": "runners/telemetry/subscribe", "params": {"runner": "desktop", "level": "job"}}}
{"do": "expect", "conn": "a", "json": {"id": 1, "error": {"code": "not-allowed"}}, "within_ms": 10000}
{"do": "send", "conn": "a", "json": {"id": 2, "method": "runners/telemetry/range", "params": {"runner": "desktop", "level": "job", "from": 1, "to": 2}}}
{"do": "expect", "conn": "a", "json": {"id": 2, "error": {"code": "not-allowed"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "runners/telemetry/subscribe", "params": {"runner": "desktop", "level": "disk"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "error": {"code": "invalid-params"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "runners/telemetry/subscribe", "params": {"runner": "desktop", "level": "job", "every_ms": 5}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "error": {"code": "invalid-params"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "runners/telemetry/range", "params": {"runner": "desktop", "level": "job", "from": 5, "to": 5}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "error": {"code": "invalid-params"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "runners/telemetry/range", "params": {"runner": "desktop", "level": "job", "from": 1, "to": 2}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "error": {"code": "invalid-params"}}, "within_ms": 10000}
