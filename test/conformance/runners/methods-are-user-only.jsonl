{"scenario": "runners/methods-are-user-only", "requires": ["v1", "test-hooks"], "doc": "[B] every runners/* method answers the user's connection (runners/list: no runner yet) and is not-allowed on an agent's connection, which changes nothing: the list stays empty."}
{"do": "root"}
{"do": "start", "hub": "h", "args": ["--agent-socket", "s1:j1"]}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "a", "hub": "h", "socket": "agent:s1", "as": "service"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "runners/list", "params": {}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"runners": []}}, "within_ms": 10000}
{"do": "send", "conn": "a", "json": {"id": 1, "method": "runners/list", "params": {}}}
{"do": "expect", "conn": "a", "json": {"id": 1, "error": {"code": "not-allowed"}}, "within_ms": 10000}
{"do": "send", "conn": "a", "json": {"id": 2, "method": "runners/probe-host", "params": {"host": "desktop"}}}
{"do": "expect", "conn": "a", "json": {"id": 2, "error": {"code": "not-allowed"}}, "within_ms": 10000}
{"do": "send", "conn": "a", "json": {"id": 3, "method": "runners/add", "params": {"host": "desktop", "trust": "mine"}}}
{"do": "expect", "conn": "a", "json": {"id": 3, "error": {"code": "not-allowed"}}, "within_ms": 10000}
{"do": "send", "conn": "a", "json": {"id": 4, "method": "runners/check", "params": {"name": "desktop"}}}
{"do": "expect", "conn": "a", "json": {"id": 4, "error": {"code": "not-allowed"}}, "within_ms": 10000}
{"do": "send", "conn": "a", "json": {"id": 5, "method": "runners/bench", "params": {"name": "desktop"}}}
{"do": "expect", "conn": "a", "json": {"id": 5, "error": {"code": "not-allowed"}}, "within_ms": 10000}
{"do": "send", "conn": "a", "json": {"id": 6, "method": "runners/set", "params": {"name": "desktop", "trust": "shared"}}}
{"do": "expect", "conn": "a", "json": {"id": 6, "error": {"code": "not-allowed"}}, "within_ms": 10000}
{"do": "send", "conn": "a", "json": {"id": 7, "method": "runners/unbench", "params": {"name": "desktop"}}}
{"do": "expect", "conn": "a", "json": {"id": 7, "error": {"code": "not-allowed"}}, "within_ms": 10000}
{"do": "send", "conn": "a", "json": {"id": 8, "method": "runners/remove", "params": {"name": "desktop", "confirm": true}}}
{"do": "expect", "conn": "a", "json": {"id": 8, "error": {"code": "not-allowed"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "runners/list", "params": {}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"runners": []}}, "within_ms": 10000}
