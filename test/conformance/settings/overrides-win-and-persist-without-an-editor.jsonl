{"do": "send", "conn": "c2", "json": {"id": 2, "method": "config/settings", "params": {"overrides": []}}}
{"do": "expect", "conn": "c2", "json": {"id": 2, "result": {"applied": 0}}}
{"do": "send", "conn": "c2", "json": {"id": 3, "method": "status"}}
