{"scenario": "budget/tree", "requires": ["v1", "test-hooks"], "doc": "A plan limited to 5 usd-est has one approved run (a second is only proposed: a run joins the tree at approval); the run spends 0.01 (the mock's report). budget/tree rooted at the plan lists the plan (state ok) and the run, labelled run 1, whose share of the plan is a number (all of its spend: 1); depth 0 lists the plan alone. Before there was no way to list the scopes, so a budget page could not be drawn."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/repo && cd $ROOT/repo && git init -q && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--script\" \"$ROOT/w.txt\" \"--log\" \"$ROOT/w.log\")))) (drgnx-agents-routes ((implement \"mock-claude\"))))\n"}
{"do": "write_file", "path": "$ROOT/p.md", "text": "# Plan\n\n**Repo:** $ROOT/repo\n\n### Task 1: Add the note\n\n**Role:** implement\n\nAdd note.txt.\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 10, "method": "job/propose", "params": {"plan": "$ROOT/p.md"}}}
{"do": "expect", "conn": "c", "json": {"id": 10, "result": {"id": "$capture:ja", "status": "proposed"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 11, "method": "job/propose", "params": {"plan": "$ROOT/p.md"}}}
{"do": "expect", "conn": "c", "json": {"id": 11, "result": {"id": "$capture:jb", "status": "proposed"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 12, "method": "budget/set", "params": {"scope": {"plan": "plan:$ROOT/p.md"}, "limits": [{"amount": 5, "unit": "usd-est"}]}}}
{"do": "expect", "conn": "c", "json": {"id": 12, "result": {"scope": {"plan": "plan:$ROOT/p.md"}, "limits": [{"amount": 5, "unit": "usd-est"}]}}}
{"do": "write_file", "path": "$ROOT/w.txt", "text": "tool:edit note.txt\nsilent 120\n"}
{"do": "send", "conn": "c", "json": {"id": 13, "method": "job/approve", "params": {"id": "$ja"}}}
{"do": "expect", "conn": "c", "json": {"id": 13, "result": {"id": "$ja"}}, "within_ms": 10000}
{"do": "poll", "conn": "c", "json": {"id": 14, "method": "budget/get", "params": {"scope": {"run": "$ja"}}}, "expect": {"id": 14, "result": {"spent": {"$contains": [{"amount": 0.01, "unit": "usd-est"}]}}}, "within_ms": 90000, "every_ms": 200}
{"do": "send", "conn": "c", "json": {"id": 30, "method": "budget/tree", "params": {"root": {"plan": "plan:$ROOT/p.md"}}}}
{"do": "expect", "conn": "c", "json": {"id": 30, "result": {"nodes": {"$contains": [{"scope": {"plan": "plan:$ROOT/p.md"}, "state": "ok"}, {"scope": {"run": "$ja"}, "label": "run 1", "share_of_parent": "$number"}]}}}}
{"do": "send", "conn": "c", "json": {"id": 31, "method": "budget/tree", "params": {"root": {"plan": "plan:$ROOT/p.md"}, "depth": 0}}}
{"do": "expect", "conn": "c", "json": {"id": 31, "result": {"nodes": [{"scope": {"plan": "plan:$ROOT/p.md"}}]}}}
