{"scenario": "budget/budget-event-coalesces", "requires": ["v1", "test-hooks"], "doc": "A plan on a subscription profile is approved with a 5 dollar limit; the mock reports 0.01 after its turn. Each scope whose spend moved gets one 'budget' event a second, carrying spent, remaining, a state and an empty burn (under ten minutes of spend). Before there was no such event: a card read the budget only when it asked. The state is ok well under the limit."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/repo && cd $ROOT/repo && git init -q && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--script\" \"$ROOT/w.txt\" \"--log\" \"$ROOT/w.log\")))) (drgnx-agents-routes ((implement \"mock-claude\"))))\n"}
{"do": "write_file", "path": "$ROOT/plan.md", "text": "# Plan\n\n**Repo:** $ROOT/repo\n\n### Task 1: Add the note\n\n**Role:** implement\n\nAdd note.txt.\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "job/propose", "params": {"plan": "$ROOT/plan.md", "limits": [{"amount": 5, "unit": "usd"}]}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:job", "status": "proposed", "limits": [{"amount": 5, "unit": "usd"}]}}, "within_ms": 10000}
{"do": "write_file", "path": "$ROOT/w.txt", "text": "tool:edit note.txt\n"}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "job/approve", "params": {"id": "$job"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"id": "$job"}}, "within_ms": 10000}
{"do": "file", "path": "$ROOT/w.log", "contains": "\"prompt\"", "within_ms": 90000}
{"do": "expect", "conn": "e", "json": {"event": "budget", "data": {"scope": {"run": "$job"}, "spent": {"$contains": [{"amount": "$number", "unit": "usd-est"}]}, "state": "ok", "burn_per_hour": []}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "budget/get", "params": {"scope": {"run": "$job"}}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"scope": {"run": "$job"}, "spent": {"$contains": [{"amount": "$number", "unit": "usd-est"}]}}}}
