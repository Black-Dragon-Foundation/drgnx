{"scenario": "budget/a-plan-limit-covers-its-runs", "requires": ["v1", "test-hooks"], "doc": "Spec G1, Q4: a plan's limit spans every run of the plan. Two runs (jobs) of one plan file; the plan's usd-est limit is 0.015. The first run's mock reports 0.01: under the limit, the run goes on. The second run spends from what the first left: its 0.01 reaches the plan's limit, both runs pause with one budget card each, budget/get on the second run gives its own 0.01 and on the plan nothing left (the first run may finish one more turn before its pause lands, so the plan's total is not pinned here; the Rust test pins the sum)."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/repo && cd $ROOT/repo && git init -q && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--script\" \"$ROOT/w.txt\" \"--log\" \"$ROOT/w.log\")))) (drgnx-agents-routes ((implement \"mock-claude\"))))\n"}
{"do": "write_file", "path": "$ROOT/p.md", "text": "# Plan\n\n**Repo:** $ROOT/repo\n\n### Task 1: Add the note\n\n**Role:** implement\n\nAdd note.txt.\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 10, "method": "job/propose", "params": {"plan": "$ROOT/p.md"}}}
{"do": "expect", "conn": "c", "json": {"id": 10, "result": {"id": "$capture:ja", "status": "proposed"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 11, "method": "job/propose", "params": {"plan": "$ROOT/p.md"}}}
{"do": "expect", "conn": "c", "json": {"id": 11, "result": {"id": "$capture:jb", "status": "proposed"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 12, "method": "budget/set", "params": {"scope": {"plan": "plan:$ROOT/p.md"}, "limits": [{"amount": 0.015, "unit": "usd-est"}]}}}
{"do": "expect", "conn": "c", "json": {"id": 12, "result": {"scope": {"plan": "plan:$ROOT/p.md"}, "limits": [{"amount": 0.015, "unit": "usd-est"}]}}}
{"do": "write_file", "path": "$ROOT/w.txt", "text": "tool:edit note.txt\n"}
{"do": "send", "conn": "c", "json": {"id": 13, "method": "job/approve", "params": {"id": "$ja"}}}
{"do": "expect", "conn": "c", "json": {"id": 13, "result": {"id": "$ja"}}, "within_ms": 10000}
{"do": "poll", "conn": "c", "json": {"id": 14, "method": "budget/get", "params": {"scope": {"run": "$ja"}}}, "expect": {"id": 14, "result": {"spent": {"$contains": [{"amount": 0.01, "unit": "usd-est"}]}}}, "within_ms": 90000, "every_ms": 200}
{"do": "send", "conn": "c", "json": {"id": 15, "method": "job/status", "params": {"id": "$ja"}}}
{"do": "expect", "conn": "c", "json": {"id": 15, "result": {"id": "$ja", "status": "running"}}, "within_ms": 5000}
{"do": "send", "conn": "c", "json": {"id": 16, "method": "job/approve", "params": {"id": "$jb"}}}
{"do": "expect", "conn": "c", "json": {"id": 16, "result": {"id": "$jb"}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "budget-limit", "data": {"data": {"scope": {"plan": "plan:$ROOT/p.md"}, "unit": "usd-est"}}}, "within_ms": 90000}
{"do": "poll", "conn": "c", "json": {"id": 17, "method": "job/status", "params": {"id": "$ja"}}, "expect": {"id": 17, "result": {"id": "$ja", "status": "paused"}}, "within_ms": 10000, "every_ms": 200}
{"do": "poll", "conn": "c", "json": {"id": 18, "method": "job/status", "params": {"id": "$jb"}}, "expect": {"id": 18, "result": {"id": "$jb", "status": "paused"}}, "within_ms": 10000, "every_ms": 200}
{"do": "sql_expect", "sql": "select job, count(*) from card where kind = 'budget' group by job order by job = '$ja' desc", "rows": [["$ja", 1], ["$jb", 1]]}
{"do": "send", "conn": "c", "json": {"id": 19, "method": "budget/get", "params": {"scope": {"run": "$jb"}}}}
{"do": "expect", "conn": "c", "json": {"id": 19, "result": {"scope": {"run": "$jb"}, "spent": {"$contains": [{"amount": 0.01, "unit": "usd-est"}]}}}}
{"do": "send", "conn": "c", "json": {"id": 20, "method": "budget/get", "params": {"scope": {"plan": "plan:$ROOT/p.md"}}}}
{"do": "expect", "conn": "c", "json": {"id": 20, "result": {"spent": {"$contains": [{"amount": "$number", "unit": "usd-est"}]}, "remaining": [{"amount": 0.0, "unit": "usd-est"}]}}}
