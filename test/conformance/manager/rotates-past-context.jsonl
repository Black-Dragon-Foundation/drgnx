{"scenario": "manager/rotates-past-context", "requires": ["v1", "fake-backend", "test-hooks"], "doc": "Task 25: a manager whose context passes agents-manager-context (0.014 here: the 2nd turn, with a long message, passes it; the 1st does not) is closed and started afresh in the same hub session (a 3rd session/new), at the end of the turn that passed it (a running turn is never cut), and the supervisor's manager-context card says when it was rotated; it is still a manager."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work && cd $ROOT/work && export GIT_CONFIG_NOSYSTEM=1 GIT_AUTHOR_DATE='@1700000000 +0000' GIT_COMMITTER_DATE='@1700000000 +0000' && git -c init.defaultBranch=main init -q && git -c user.name=t -c user.email=t@example.invalid -c commit.gpgsign=false commit -q --allow-empty -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-manager-context 0.014) (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--log\" \"$ROOT/acp.log\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/role", "params": {"id": "$sid", "role": "manager"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": true}, "within_ms": 30000}
{"do": "connect", "conn": "m", "hub": "h", "socket": "path:$SOCKET_DIR/s/$sid/mcp.sock", "as": "raw"}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "t", "version": "0"}}}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 1, "result": "$any"}}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "file", "path": "$ROOT/acp.log", "contains": "\"session/new\"", "count": 2, "at_most": 2, "within_ms": 20000}
{"do": "send", "conn": "c", "json": {"id": 80, "method": "agents/send", "params": {"id": "$sid", "text": ""}}}
{"do": "expect", "conn": "c", "json": {"id": 80, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "supervisor", "data": {"rule": "manager-context", "session": "$sid", "card": "$number", "text": "$string"}}, "within_ms": 40000}
{"do": "file", "path": "$ROOT/acp.log", "contains": "\"session/new\"", "count": 3, "at_most": 3, "within_ms": 20000}
{"do": "sql_expect", "sql": "select count(*) from card where kind = 'supervisor' and title like '%rotated%'", "rows": [[1]]}
{"do": "send", "conn": "c", "json": {"id": 81, "method": "agents/list"}}
{"do": "expect", "conn": "c", "json": {"id": 81, "result": {"sessions": {"$contains": [{"id": "$sid", "role": "manager"}]}}}}
