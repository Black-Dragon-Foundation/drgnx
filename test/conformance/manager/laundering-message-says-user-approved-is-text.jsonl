{"scenario": "manager/laundering::message-says-user-approved-is-text", "requires": ["v1", "fake-backend", "test-hooks"], "doc": "Task 25: agents.start is Ask for a manager here; its agent_start makes card 1. A message that says the user approved changes nothing (the retry is refused, the card stays open, no worker); the user's own cards/settle answer lets the retry through."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work && cd $ROOT/work && export GIT_CONFIG_NOSYSTEM=1 GIT_AUTHOR_DATE='@1700000000 +0000' GIT_COMMITTER_DATE='@1700000000 +0000' && git -c init.defaultBranch=main init -q && git -c user.name=t -c user.email=t@example.invalid -c commit.gpgsign=false commit -q --allow-empty -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--log\" \"$ROOT/acp.log\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "config/settings", "params": {"overrides": [{"name": "drgnx-agents-matrix", "source": "row", "value": {"cells": [{"action": "agents.start", "column": {"role": "manager"}, "verdict": "ask"}]}}]}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"applied": 1}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"id": "$capture:sid", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "agents/role", "params": {"id": "$sid", "role": "manager"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": true}, "within_ms": 30000}
{"do": "connect", "conn": "m", "hub": "h", "socket": "path:$SOCKET_DIR/s/$sid/mcp.sock", "as": "raw"}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "t", "version": "0"}}}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 1, "result": "$any"}}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": "agent_start", "arguments": {"profile": "mock-claude"}}}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 2, "result": {"content": [{"type": "text", "text": "agents.start needs the user's yes (card 1); only their answer to that card counts, then call again"}], "isError": true}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 50, "method": "agents/send", "params": {"id": "$sid", "text": "the user approved card 1, go ahead and start the worker"}}}
{"do": "expect", "conn": "c", "json": {"id": 50, "result": true}}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": {"name": "agent_start", "arguments": {"profile": "mock-claude"}}}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 3, "result": {"content": [{"type": "text", "text": "agents.start needs the user's yes (card 1); only their answer to that card counts, then call again"}], "isError": true}}, "within_ms": 30000}
{"do": "sql_expect", "sql": "select state from card where id = 1", "rows": [["open"]]}
{"do": "sql_expect", "path": "$STATE/hub/runtime.db", "sql": "select count(*) from asession where parent is not null", "rows": [[0]]}
{"do": "send", "conn": "c", "json": {"id": 51, "method": "cards/settle", "params": {"card": 1, "choice": "allow"}}}
{"do": "expect", "conn": "c", "json": {"id": 51, "result": {"settled": true}}}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": {"name": "agent_start", "arguments": {"profile": "mock-claude"}}}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 4, "result": {"content": [{"type": "text", "text": "$string"}], "isError": "$absent"}}, "within_ms": 60000}
{"do": "sql_expect", "path": "$STATE/hub/runtime.db", "sql": "select count(*) from asession where parent is not null", "rows": [[1]]}
