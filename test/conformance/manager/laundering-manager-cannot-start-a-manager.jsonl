{"scenario": "manager/laundering::manager-cannot-start-a-manager", "requires": ["v1", "fake-backend", "test-hooks"], "doc": "Task 25: one level only. agent_start with role manager is refused; agents/start cannot make a manager; a worker the manager started has no agent_start (unknown tool) and cannot be made a manager (agents/role on it is refused)."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work && cd $ROOT/work && export GIT_CONFIG_NOSYSTEM=1 GIT_AUTHOR_DATE='@1700000000 +0000' GIT_COMMITTER_DATE='@1700000000 +0000' && git -c init.defaultBranch=main init -q && git -c user.name=t -c user.email=t@example.invalid -c commit.gpgsign=false commit -q --allow-empty -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--log\" \"$ROOT/acp.log\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/role", "params": {"id": "$sid", "role": "manager"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": true}, "within_ms": 30000}
{"do": "connect", "conn": "m", "hub": "h", "socket": "path:$SOCKET_DIR/s/$sid/mcp.sock", "as": "raw"}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "t", "version": "0"}}}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 1, "result": "$any"}}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": "agent_start", "arguments": {"profile": "mock-claude", "role": "manager"}}}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 2, "result": {"content": [{"type": "text", "text": "a manager does not start a manager: one level only"}], "isError": true}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 60, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work", "role": "manager"}}}
{"do": "expect", "conn": "c", "json": {"id": 60, "error": {"code": "invalid-params", "message": "$string"}}}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": {"name": "agent_start", "arguments": {"profile": "mock-claude"}}}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 3, "result": {"content": [{"type": "text", "text": "$string"}], "isError": "$absent"}}, "within_ms": 60000}
{"do": "send", "conn": "c", "json": {"id": 61, "method": "agents/list"}}
{"do": "expect", "conn": "c", "json": {"id": 61, "result": {"sessions": {"$contains": [{"id": "$capture:wsid", "parent": "$sid", "role": "worker"}]}}}}
{"do": "connect", "conn": "w", "hub": "h", "socket": "path:$SOCKET_DIR/s/$wsid/mcp.sock", "as": "raw"}
{"do": "send", "conn": "w", "json": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "t", "version": "0"}}}}
{"do": "expect", "conn": "w", "json": {"jsonrpc": "2.0", "id": 1, "result": "$any"}}
{"do": "send", "conn": "w", "json": {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": "agent_start", "arguments": {"profile": "mock-claude"}}}}
{"do": "expect", "conn": "w", "json": {"jsonrpc": "2.0", "id": 2, "error": {"code": -32602, "message": "$string"}}}
{"do": "send", "conn": "c", "json": {"id": 62, "method": "agents/role", "params": {"id": "$wsid", "role": "manager"}}}
{"do": "expect", "conn": "c", "json": {"id": 62, "error": {"code": "not-allowed", "message": "$string"}}}
