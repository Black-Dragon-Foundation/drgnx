{"scenario": "edit-history/consumer-hunks-for-a-branch", "requires": ["v1", "test-hooks"], "doc": "The frozen shape of history/hunks as the Work space and the runners read it: for a worktree's branch, since a record, the files that changed in path order, each with hunks that carry git's four numbers (the @@ line of git diff --unified=0). The second write adds a line after the first, so the hunk after record 1 is one new line at line 2."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work $ROOT/state && cd $ROOT/work && git init -q && echo base > a.txt && git add -A && git -c user.name=t -c user.email=t@t commit -q -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--state\" \"$ROOT/state\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work", "role": "worker"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid"}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/send", "params": {"id": "$sid", "text": "say first\nfs:write b.txt one\\n"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent-step", "data": {"session": "$sid", "step": {"seq": "$capture:s1", "class": "think", "turn_id": "t1"}}}, "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "agents/send", "params": {"id": "$sid", "text": "say second\nfs:write b.txt one\\ntwo\\n"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent-step", "data": {"session": "$sid", "step": {"class": "think", "turn_id": "t2"}}}, "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "history/fork", "params": {"session": "$sid", "seq": "$s1", "message": "say forked"}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"source_branch": "$capture:sbranch"}}, "within_ms": 30000}
{"do": "poll", "conn": "c", "json": {"id": 5, "method": "history/hunks", "params": {"branch": "$sbranch", "since": 1}}, "expect": {"id": 5, "result": {"files": [{"path": "b.txt", "hunks": [{"old_start": 1, "old_count": 0, "new_start": 2, "new_count": 1}]}]}}, "within_ms": 30000, "every_ms": 200}
