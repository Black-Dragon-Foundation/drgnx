{"scenario": "edit-history/second-revert-reads-the-history", "requires": ["v1", "test-hooks"], "doc": "An agent added a line to a.txt; the user then added a line of their own at the top in the editor; the agent's next turn added another line. A revert to the end of the first turn takes that line away, and the agent goes on in another file. A second revert, to before the first turn, in keep-mine mode, is decided by the history only if the first revert's writes are in it: the history then says the user's line is the user's, and it stays, while the agent's lines and its other file go. Decided by the checkpoints alone, the user's line goes too, since the agent's newest checkpoint holds it."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work $ROOT/state && cd $ROOT/work && git init -q && echo base > a.txt && git add -A && git -c user.name=t -c user.email=t@t commit -q -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--state\" \"$ROOT/state\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work", "role": "worker"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid"}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/send", "params": {"id": "$sid", "text": "say first\nfs:write a.txt base\\nA\\n"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent-step", "data": {"session": "$sid", "step": {"seq": "$capture:s0", "class": "think"}}}, "within_ms": 15000}
{"do": "expect", "conn": "e", "json": {"event": "agent-step", "data": {"session": "$sid", "step": {"seq": "$capture:s1", "class": "think", "turn_id": "t1"}}}, "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "history/register", "params": {"path": "a.txt", "worktree_root": "$ROOT/work", "buffer_id": "b1"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"tracked": true}}, "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "history/batch", "params": {"buffer_id": "b1", "changes": [{"start": 0, "old_len": 0, "inserted": "user\n"}], "region_hash": "b01a4dbad9b171811c834837f82d215854178dcb2244cf7dd1c76228b9461278", "version": 1}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"ok": true}}, "within_ms": 15000}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "cd $ROOT/work && printf 'user\\nbase\\nA\\n' > a.new && mv a.new a.txt"], "expect_code": 0}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "agents/send", "params": {"id": "$sid", "text": "say second\nfs:write a.txt user\\nbase\\nA\\nB\\n"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent-step", "data": {"session": "$sid", "step": {"class": "think", "turn_id": "t2"}}}, "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 6, "method": "history/revert/preview", "params": {"session": "$sid", "seq": "$s1"}}}
{"do": "expect", "conn": "c", "json": {"id": 6, "result": {"preview_id": "$capture:pid1", "session": "$sid", "seq": "$s1", "blocked": []}}, "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 7, "method": "history/revert/apply", "params": {"preview_id": "$pid1", "mode": "keep-mine", "choices": []}}}
{"do": "expect", "conn": "c", "json": {"id": 7, "result": {"session": "$sid", "op": "$number", "skipped": []}}, "within_ms": 30000}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "cd $ROOT/work && echo \"a=[$(cat a.txt)]\" && test \"$(cat a.txt)\" = \"$(printf 'user\\nbase\\nA')\""], "expect_code": 0}
{"do": "connect", "conn": "e2", "hub": "h"}
{"do": "send", "conn": "e2", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e2", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 8, "method": "agents/send", "params": {"id": "$sid", "text": "say third\nfs:write c.txt other\\n"}}}
{"do": "expect", "conn": "c", "json": {"id": 8, "result": true}}
{"do": "expect", "conn": "e2", "json": {"event": "agent-step", "data": {"session": "$sid", "step": {"class": "think", "turn_id": "$string"}}}, "within_ms": 15000}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "test \"$(cat $ROOT/work/c.txt)\" = other"], "expect_code": 0}
{"do": "send", "conn": "c", "json": {"id": 9, "method": "history/revert/preview", "params": {"session": "$sid", "seq": "$s0"}}}
{"do": "expect", "conn": "c", "json": {"id": 9, "result": {"preview_id": "$capture:pid2", "session": "$sid", "seq": "$s0", "blocked": []}}, "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 10, "method": "history/revert/apply", "params": {"preview_id": "$pid2", "mode": "keep-mine", "choices": []}}}
{"do": "expect", "conn": "c", "json": {"id": 10, "result": {"session": "$sid", "op": "$number", "skipped": []}}, "within_ms": 30000}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "cd $ROOT/work && echo \"a=[$(cat a.txt)] files=[$(ls)]\" && test \"$(cat a.txt)\" = \"$(printf 'user\\nbase')\" && test ! -e c.txt"], "expect_code": 0}
