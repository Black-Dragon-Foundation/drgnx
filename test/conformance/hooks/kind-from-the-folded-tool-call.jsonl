{"scenario": "hooks/kind-from-the-folded-tool-call", "requires": ["v1", "test-hooks"], "doc": "[C] Kimi Code and DeepSeek Harness send a permission request with no `kind`. The seam takes it from the session's folded `tool_call` of the same id, so a rule on `read` sees the step and refuses it; and DeepSeek Harness's snake-case `grep`, reported as `other`, reaches a rule on `search` by its name."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--log\" \"$ROOT/acp.log\")))) (drgnx-agents-matrix (:cells ((:action code.edit :column (:role worker) :verdict allow) (:action code.read :column (:role worker) :verdict allow)))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "config/settings", "params": {"overrides": [{"name": "drgnx-agents-hook-rules", "source": "row", "value": [{"id": "no-reads", "point": "before-tool", "tool-kinds": ["read"], "verdict": "deny", "reason": "no reads"}, {"id": "no-search", "point": "before-tool", "tool-kinds": ["search"], "verdict": "deny", "reason": "no searches"}]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"applied": 1}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work", "role": "worker"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"id": "$capture:sid", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "agents/send", "params": {"id": "$sid", "text": "ask:folded {\"kind\": \"read\", \"title\": \"Read a.txt\", \"locations\": [{\"path\": \"$ROOT/work/a.txt\"}], \"rawInput\": {\"path\": \"a.txt\"}}"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": true}}
{"do": "file", "path": "$ROOT/acp.log", "contains": "{\"permission\":{\"kind\":\"read\",\"answer\":\"reject_once\"}}", "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "agents/send", "params": {"id": "$sid", "text": "ask:tool {\"kind\": \"other\", \"title\": \"grep\", \"rawInput\": {\"pattern\": \"TODO\"}}"}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": true}}
{"do": "file", "path": "$ROOT/acp.log", "contains": "{\"permission\":{\"kind\":\"other\",\"answer\":\"reject_once\"}}", "within_ms": 15000}
{"do": "sql_expect", "path": "$DATA/work.db", "sql": "select json_extract(e.data, '$.records[0].source') from event e join tx t on t.id = e.tx where t.actor = 'hub:hooks' order by e.id", "rows": [["rule:no-reads"], ["rule:no-search"]]}
