{"scenario": "hooks/annotate-shows-under-the-step", "requires": ["v1", "test-hooks"], "doc": "[C] A rule that annotates `make` adds a `note` entry under the step in the session's transcript (the rule's text, its source), the step goes on (allowed), and the hook row keeps the annotation."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--log\" \"$ROOT/acp.log\")))) (drgnx-agents-matrix (:cells ((:action code.edit :column (:role worker) :verdict allow)))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "config/settings", "params": {"overrides": [{"name": "drgnx-agents-hook-rules", "source": "row", "value": [{"id": "builds", "point": "before-tool", "tool-kinds": ["execute"], "command": "^make", "verdict": "annotate", "reason": "a build: it takes a while"}]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"applied": 1}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work", "role": "worker"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"id": "$capture:sid", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "e", "json": {"id": 901, "method": "agents/entries/subscribe", "params": {"session": "$sid"}}}
{"do": "expect", "conn": "e", "json": {"id": 901, "result": {"seq": "$number"}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "agents/send", "params": {"id": "$sid", "text": "ask:tool {\"kind\": \"execute\", \"title\": \"make all\", \"rawInput\": {\"command\": \"make all\"}, \"_meta\": {\"claudeCode\": {\"toolName\": \"Bash\"}}}"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent-entries", "data": {"id": "$sid", "entries": {"$contains": [["$any", {"type": "note", "text": "a build: it takes a while", "source": "rule:builds"}]]}}}, "within_ms": 15000}
{"do": "file", "path": "$ROOT/acp.log", "contains": "{\"permission\":{\"kind\":\"execute\",\"answer\":\"allow_once\"}}", "within_ms": 15000}
{"do": "sql_expect", "path": "$DATA/work.db", "sql": "select json_extract(e.data, '$.outcome'), json_extract(e.data, '$.records[0].verdict'), json_extract(e.data, '$.records[0].reason') from event e join tx t on t.id = e.tx where t.actor = 'hub:hooks'", "rows": [["allow", "annotate", "a build: it takes a while"]]}
