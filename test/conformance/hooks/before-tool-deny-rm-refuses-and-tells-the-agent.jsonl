{"scenario": "hooks/before-tool-deny-rm-refuses-and-tells-the-agent", "requires": ["v1", "test-hooks"], "doc": "[C] The deny-rm-hook fixture (a real WASM plugin, installed and approved) refuses the agent's `rm -rf x` at the permission seam: the request is answered with its reject option and no card is made, the refusal is steered into the turn in the hub's words with the hook's quoted, and one hook row of the hub's own records it. The fixtures are built by brokkr's tests (runtime/target/plugin-fixtures)."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--log\" \"$ROOT/acp.log\")))) (drgnx-agents-matrix (:cells ((:action code.edit :column (:role worker) :verdict allow)))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "run", "args": ["plugins", "install", "$SCENARIOS/../../runtime/target/plugin-fixtures/plugins/deny-rm-hook"], "expect_code": 0}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "plugins/list", "params": {}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"plugins": [{"name": "deny-rm-hook", "state": "unapproved", "hash": "$capture:h"}]}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "plugins/approve", "params": {"name": "deny-rm-hook", "hash": "$h"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"name": "deny-rm-hook", "state": "approved"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "config/settings", "params": {"overrides": [{"name": "drgnx-agents-plugins", "source": "row", "value": ["deny-rm-hook"]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"applied": 1}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work", "role": "worker"}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"id": "$capture:sid", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "agents/send", "params": {"id": "$sid", "text": "ask:tool {\"kind\": \"execute\", \"title\": \"rm -rf x\", \"rawInput\": {\"command\": \"rm -rf x\"}, \"_meta\": {\"claudeCode\": {\"toolName\": \"Bash\"}}}"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "result": true}}
{"do": "file", "path": "$ROOT/acp.log", "contains": "{\"permission\":{\"kind\":\"execute\",\"answer\":\"reject_once\"}}", "within_ms": 30000}
{"do": "file", "path": "$ROOT/acp.log", "contains": "drgnx refused Bash; the hook deny-rm-hook said: «no rm -rf»", "within_ms": 30000}
{"do": "sql_expect", "path": "$DATA/work.db", "sql": "select count(*) from card where kind = 'matrix'", "rows": [[0]]}
{"do": "sql_expect", "path": "$DATA/work.db", "sql": "select json_extract(e.data, '$.outcome'), json_extract(e.data, '$.records[0].verdict'), json_extract(e.data, '$.records[0].reason'), e.summary from event e join tx t on t.id = e.tx where t.actor = 'hub:hooks'", "rows": [["deny", "deny", "no rm -rf", "hook: deny-rm-hook refused Bash"]]}
