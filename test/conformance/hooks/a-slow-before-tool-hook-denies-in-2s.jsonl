{"scenario": "hooks/a-slow-before-tool-hook-denies-in-2s", "requires": ["v1", "test-hooks"], "doc": "[C] The slow-hook fixture spins forever. The point's 2 s budget stops it on the host's epoch deadline, the step takes the fail-closed verdict (the request's reject option, \"timed out\" in the row, the hub's words steered to the agent), and the session goes on: its next prompt reaches the agent."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--log\" \"$ROOT/acp.log\")))) (drgnx-agents-matrix (:cells ((:action code.edit :column (:role worker) :verdict allow)))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "run", "args": ["plugins", "install", "$SCENARIOS/../../runtime/target/plugin-fixtures/plugins/slow-hook"], "expect_code": 0}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "plugins/list", "params": {}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"plugins": [{"name": "slow-hook", "hash": "$capture:h"}]}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "plugins/approve", "params": {"name": "slow-hook", "hash": "$h"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"state": "approved"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "config/settings", "params": {"overrides": [{"name": "drgnx-agents-plugins", "source": "row", "value": ["slow-hook"]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"applied": 1}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work", "role": "worker"}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"id": "$capture:sid", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "agents/send", "params": {"id": "$sid", "text": "ask:tool {\"kind\": \"execute\", \"title\": \"make\", \"rawInput\": {\"command\": \"make\"}, \"_meta\": {\"claudeCode\": {\"toolName\": \"Bash\"}}}"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "result": true}}
{"do": "file", "path": "$ROOT/acp.log", "contains": "{\"permission\":{\"kind\":\"execute\",\"answer\":\"reject_once\"}}", "within_ms": 15000}
{"do": "sql_expect", "path": "$DATA/work.db", "sql": "select json_extract(e.data, '$.outcome'), json_extract(e.data, '$.records[0].verdict'), json_extract(e.data, '$.records[0].reason') like 'hook slow-hook failed: timed out (%' from event e join tx t on t.id = e.tx where t.actor = 'hub:hooks'", "rows": [["deny", "error", 1]]}
{"do": "file", "path": "$ROOT/acp.log", "contains": "the hook slow-hook said: «hook slow-hook failed: timed out", "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 6, "method": "agents/send", "params": {"id": "$sid", "text": "say still here"}}}
{"do": "expect", "conn": "c", "json": {"id": 6, "result": true}}
{"do": "file", "path": "$ROOT/acp.log", "contains": "say still here", "within_ms": 15000}
