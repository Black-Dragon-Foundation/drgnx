{"scenario": "cli/job-resume", "requires": ["v1", "fake-backend", "test-hooks"], "doc": "ratatoskr job resume: an approved job that was stopped goes on from the command line, with a new --budget; a job the hub does not know is exit 1 (its text on stderr); a budget that is not a number is a usage error (exit 2). The job is stopped at the end."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/repo && cd $ROOT/repo && git init -q && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--script\" \"$ROOT/w.txt\" \"--log\" \"$ROOT/w.log\")))) (drgnx-agents-routes ((implement \"mock-claude\") (review \"mock-claude\"))))\n"}
{"do": "write_file", "path": "$ROOT/w.txt", "text": "silent 600\n"}
{"do": "start", "hub": "h"}
{"do": "run", "args": ["job", "resume", "job-nope"], "expect_code": 1, "expect_stderr": "ratatoskr job:"}
{"do": "run", "args": ["job", "propose", "$SCENARIOS/../fixtures/plans/job-cli.md", "--repo", "$ROOT/repo", "--auto", "--json"], "expect_code": 0, "expect_stdout": {"id": "$capture:job"}}
{"do": "file", "path": "$ROOT/w.log", "contains": "\"prompt\"", "within_ms": 90000}
{"do": "run", "args": ["job", "stop", "$job"], "expect_code": 0, "expect_stdout": "[stopped]"}
{"do": "run", "args": ["job", "resume", "$job", "--budget", "lots"], "expect_code": 2, "expect_stderr": "--budget"}
{"do": "run", "args": ["job", "resume", "$job", "--budget", "10"], "expect_code": 0, "expect_stdout": "budget 10.0 USD"}
{"do": "run", "args": ["job", "status", "$job", "--json"], "expect_code": 0, "expect_stdout": {"id": "$job", "status": "running", "budget": 10.0}}
{"do": "run", "args": ["job", "stop", "$job"], "expect_code": 0, "expect_stdout": "[stopped]"}
