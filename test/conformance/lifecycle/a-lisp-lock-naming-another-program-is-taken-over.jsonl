{"scenario": "lifecycle/a-lisp-lock-naming-another-program-is-taken-over", "requires": ["v1"], "doc": "A lock directory an older Lisp hub left, whose pid is alive but is not a drgnx hub (a reused pid; here the harness's own), is taken over."}
{"do": "root"}
{"do": "write_file", "path": "$LOCK/pid", "text": "$HARNESS_PID"}
{"do": "start", "hub": "r"}
{"do": "connect", "conn": "c", "hub": "r"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "ping"}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"pid": "$PID(r)"}}}
{"do": "file", "path": "$LOCK", "contains": "$PID(r)"}
