{"scenario": "lifecycle/a-stale-lisp-lock-directory-is-taken-over", "requires": ["v1"], "doc": "A Lisp hub that died left its lock directory (its pid gone) and its socket: Ratatoskr takes both over and serves."}
{"do": "root"}
{"do": "spawn", "capture": "gone", "argv": ["true"]}
{"do": "pid", "capture": "gone", "alive": false, "within_ms": 4000}
{"do": "write_file", "path": "$LOCK/pid", "text": "$gone"}
{"do": "write_file", "path": "$SOCKET", "text": "left behind"}
{"do": "start", "hub": "r"}
{"do": "connect", "conn": "c", "hub": "r"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "ping"}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"pid": "$PID(r)"}}}
{"do": "file", "path": "$LOCK", "contains": "$PID(r)"}
