{"scenario": "mcp/tool-writes-are-broadcast-as-events", "requires": ["v1", "fake-backend"], "doc": "A report_test over a session socket writes one event row as that agent, and a subscribed user gets it as one events event."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "mcp/session", "params": {"agent": "s-0000000a", "cwd": "$HOME", "owner": "$HARNESS_PID"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"sid": "$capture:sid", "socket": "$capture:sock"}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "subscribe"}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": true}}
{"do": "connect", "conn": "m", "hub": "h", "socket": "path:$sock", "as": "raw"}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "t", "version": "0"}}}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 1, "result": "$any"}}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": "report_test", "arguments": {"command": "make check", "passed": 3, "failed": 0}}}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 2, "result": {"isError": "$absent"}}}
{"do": "expect", "conn": "c", "json": {"event": "events", "data": {"events": [{"id": "$capture:ev", "kind": "test", "agent": "s-0000000a", "summary": "3 passed, 0 failed: make check"}]}}}
{"do": "sql_expect", "sql": "select kind, agent from event", "rows": [["test", "s-0000000a"]]}
{"do": "expect_silent", "conn": "c", "for_ms": 1000}
