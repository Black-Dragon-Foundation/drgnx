{"scenario": "mcp/an-unknown-tool-is-32602", "requires": ["v1"], "doc": "Over a session socket, tools/call of a tool the hub does not have is a JSON-RPC error -32602 (Unknown tool), and the connection goes on."}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "mcp/session", "params": {"agent": "s-0000000a", "owner": "$HARNESS_PID"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"sid": "$capture:sid", "socket": "$capture:sock"}}}
{"do": "connect", "conn": "m", "hub": "h", "socket": "path:$sock", "as": "raw"}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "t", "version": "0"}}}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 1, "result": "$any"}}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": "nope", "arguments": {}}}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 2, "error": {"code": -32602, "message": "Unknown tool: nope"}}}
{"do": "send", "conn": "m", "json": {"jsonrpc": "2.0", "id": 3, "method": "ping"}}
{"do": "expect", "conn": "m", "json": {"jsonrpc": "2.0", "id": 3, "result": {}}}
