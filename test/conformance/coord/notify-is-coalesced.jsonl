{"scenario": "coord/notify-is-coalesced", "requires": ["v1", "fake-backend"], "doc": "coord/notify is the front's (SB-T12-5): 100 within a few milliseconds reach the backend as at most 2 notifications (one each 0.25 s, no id, never answered), and at least 1."}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/list"}}
{"do": "expect", "conn": "c", "json": {"id": 1}}
{"do": "measure", "name": "coord-notify-100", "repeat": 100, "steps": [{"do": "send", "conn": "c", "json": {"method": "coord/notify"}}]}
{"do": "backend_log", "count": "notification {\"method\":\"coord/notify\"", "at_least": 1, "at_most": 2, "for_ms": 1000}
{"do": "backend_log", "expect_no_line": {"id": "$any", "method": "coord/notify"}, "for_ms": 100}
