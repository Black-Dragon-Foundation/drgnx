{"scenario": "restart/a-changed-binary-sends-the-notice", "requires": ["v1", "test-hooks"], "doc": "The hub runs from a copy in $ROOT/bin. A different build is renamed over that path (a rename-replace, which a stat of /proc/self/exe would never see); at the next idle tick the hub runs `<path> version --json`, sees another commit and sends the `restart-when-idle` notice with the number of turns it waits for. A session has a turn running, so the hub keeps serving."}
{"do": "root"}
{"do": "install_bin", "to": "$ROOT/bin/ratatoskr"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h", "bin": "$ROOT/bin/ratatoskr", "args": ["--idle-tick-ms", "200"]}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "result": {"id": "$capture:sid", "name": "$string"}}}
{"do": "send", "conn": "c", "json": {"id": 6, "method": "agents/send", "params": {"id": "$sid", "text": "silent 8"}}}
{"do": "expect", "conn": "c", "json": {"id": 6, "result": true}}
{"do": "write_file", "path": "$ROOT/bin/ratatoskr.new", "text": "#!/bin/sh\necho '{\"commit\": \"another-build\"}'\n", "mode": "755"}
{"do": "rename", "from": "$ROOT/bin/ratatoskr.new", "to": "$ROOT/bin/ratatoskr"}
{"do": "expect", "conn": "c", "json": {"event": "notice", "data": {"source": "hub", "severity": "warn", "id": "restart-when-idle", "life": "condition", "command": "hub-restart-now", "text": "drgnx was updated; the hub restarts when its 1 running turn finishes"}}, "within_ms": 5000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "ping"}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"pid": "$PID(h)"}}}
