{"scenario": "restart/restart-mid-wake-wakes-once", "requires": ["v1", "fake-backend", "test-hooks"], "doc": "Task 24: a wake the hub went down with (a wake row of runtime.db left sending, the prompt already in the session transcript) is not delivered again at the next start, and a wake row of a job that is gone is dropped; the table is empty and the session was woken once."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--log\" \"$ROOT/acp.log\")))))\n"}
{"do": "start", "hub": "h", "env": {"DRGNX_TEST_PLAIN_JOBS": "1"}}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work", "role": "worker"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid", "name": "$string"}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/send", "params": {"id": "$sid", "text": "call:job_start {\"argv\": [\"sh\", \"-c\", \"echo hi\"]}"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": true}}
{"do": "file", "path": "$ROOT/acp.log", "contains": "[job", "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "exec/list", "params": {}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"jobs": [{"id": "$capture:job"}]}}}
{"do": "connect", "conn": "q0", "hub": "h"}
{"do": "expect_silent", "conn": "q0", "for_ms": 2000}
{"do": "sql_expect", "path": "$STATE/hub/runtime.db", "sql": "select count(*) from wake", "rows": [[0]]}
{"do": "kill", "hub": "h", "signal": "TERM"}
{"do": "expect_exit", "hub": "h", "code": 0, "within_ms": 15000}
{"do": "sqlite", "path": "$STATE/hub/runtime.db", "sql": ["insert into wake(job, session, state, at) values ('$job', '$sid', 'sending', 1.0)", "insert into wake(job, session, state, at) values ('gone', '$sid', 'pending', 1.0)"]}
{"do": "start", "hub": "h2", "same_root_as": "h", "env": {"DRGNX_TEST_PLAIN_JOBS": "1"}}
{"do": "connect", "conn": "c2", "hub": "h2"}
{"do": "file", "path": "$ROOT/acp.log", "contains": "\"session/resume\"", "within_ms": 30000}
{"do": "connect", "conn": "q", "hub": "h2"}
{"do": "expect_silent", "conn": "q", "for_ms": 5000}
{"do": "file", "path": "$ROOT/acp.log", "contains": "[job", "count": 1, "at_most": 1}
{"do": "sql_expect", "path": "$STATE/hub/runtime.db", "sql": "select count(*) from wake", "rows": [[0]]}
