{"scenario": "agents/parity-context-and-slash-commands", "requires": ["v1", "fake-backend", "test-hooks"], "doc": "Task 8b: a subscription profile and a gateway (OpenRouter-style, :ai) profile behave alike: the snapshot carries the context usage (used and size, for the context %), and a slash command such as /compact is an ordinary prompt that reaches the agent word for word."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-sub\" :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")) (\"mock-gateway\" :command (\"$MOCK\" \"acp\" \"--as\" \"claude\") :ai \"openrouter-env\"))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-sub", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid", "name": "$string"}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/start", "params": {"profile": "mock-gateway", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"id": "$capture:gid", "name": "$string"}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "agents/send", "params": {"id": "$sid", "text": "hello"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent", "data": {"id": "$sid", "session": {"via": "direct", "usage": {"used": "$number", "size": "$number"}}}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "agents/send", "params": {"id": "$gid", "text": "hello"}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent", "data": {"id": "$gid", "session": {"via": "gateway", "usage": {"used": "$number", "size": "$number"}}}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "agents/send", "params": {"id": "$sid", "text": "/compact"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent-entries", "data": {"id": "$sid", "entries": {"$contains": [["$any", {"type": "agent", "text": "You said: /compact"}]]}}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 6, "method": "agents/send", "params": {"id": "$gid", "text": "/compact"}}}
{"do": "expect", "conn": "c", "json": {"id": 6, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent-entries", "data": {"id": "$gid", "entries": {"$contains": [["$any", {"type": "agent", "text": "You said: /compact"}]]}}}, "within_ms": 10000}
