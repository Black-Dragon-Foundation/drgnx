{"scenario": "pair/disk-write-is-the-agents-op", "requires": ["v1", "test-hooks"], "doc": "Gated (B). A paired chat (Autonomous) writes a file no editor has open: after read_file, its write_file lands on disk (the hub writes it, atomically, in the file's form), the agent is told it went to disk, and the edit history holds the new text as the agent's (history/blame names the session), not as an outside edit."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/project && cd $ROOT/project && git init -q && printf 'one\\r\\n' > README && git add -A && git -c user.name=t -c user.email=t@t commit -q -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-matrix (:preset autonomous)) (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/project"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid"}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/send", "params": {"id": "$sid", "text": "call:read_file {\"path\": \"$ROOT/project/README\"}\ncall:write_file {\"path\": \"$ROOT/project/README\", \"content\": \"one\\ntwo\\n\"}"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": true}}
{"do": "poll", "conn": "c", "json": {"id": 3, "method": "agents/get", "params": {"id": "$sid"}}, "expect": {"id": 3, "result": {"session": {"id": "$sid", "status": "idle"}, "entries": {"$contains": [{"type": "agent", "text": "call: one\r\ncall: written to the file on disk (no editor has it open)"}]}}}, "within_ms": 20000}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "cat -v $ROOT/project/README"], "expect_code": 0, "expect_stdout": "one^M\ntwo^M\n"}
{"do": "poll", "conn": "c", "json": {"id": 4, "method": "history/blame", "params": {"path": "README", "worktree_root": "$ROOT/project", "start": 4, "end": 8}}, "expect": {"id": 4, "result": {"spans": {"$contains": [{"author": {"kind": "agent", "session": "$sid"}, "session": "$sid"}]}}}, "within_ms": 30000, "every_ms": 200}
