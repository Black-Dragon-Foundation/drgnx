{"scenario": "pair/off-cancels-nothing", "requires": ["v1", "test-hooks"], "doc": "Gated (B). The user turns pair off (agents/pair) while a write waits in the editor: the editor is told to drop that session's queued writes (pair-drop), the agent learns it from the write's answer, its turn goes on (nothing is cancelled: its next tool call runs and is answered pair mode is off), and the snapshot says paired false. Turned on again, writes go through."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/project && echo readme > $ROOT/project/README"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-matrix (:preset autonomous)) (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "pair/open", "params": {"file": "$ROOT/project/README", "kind": "normal"}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/project"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid"}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/get", "params": {"id": "$sid"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"session": {"id": "$sid", "paired": true}}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "agents/send", "params": {"id": "$sid", "text": "call:edit_file {\"path\": \"$ROOT/project/README\", \"old\": \"readme\", \"new\": \"README\"}\ncall:edit_file {\"path\": \"$ROOT/project/README\", \"old\": \"readme\", \"new\": \"README\"}"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "pair-apply", "data": {"write": "$capture:w", "session": "$sid"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "agents/pair", "params": {"id": "$sid", "on": false}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "pair-drop", "data": {"session": "$sid"}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "pair/answer", "params": {"write": "$w", "result": "dropped", "reason": "pair-off"}}}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": true}}
{"do": "poll", "conn": "c", "json": {"id": 5, "method": "agents/get", "params": {"id": "$sid"}}, "expect": {"id": 5, "result": {"session": {"status": "idle", "paired": false}, "entries": {"$contains": [{"type": "agent", "text": "call: pair mode was turned off by the usercall: pair mode is off; ask the user to turn it on"}, {"type": "stop"}]}}}, "within_ms": 20000}
{"do": "send", "conn": "c", "json": {"id": 6, "method": "agents/pair", "params": {"id": "$sid", "on": true}}}
{"do": "expect", "conn": "c", "json": {"id": 6, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 7, "method": "agents/send", "params": {"id": "$sid", "text": "call:edit_file {\"path\": \"$ROOT/project/README\", \"old\": \"readme\", \"new\": \"README\"}"}}}
{"do": "expect", "conn": "c", "json": {"id": 7, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "pair-apply", "data": {"write": "$capture:w2", "session": "$sid"}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "pair/answer", "params": {"write": "$w2", "result": "applied", "version": 2, "saved": true}}}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": true}}
