{"scenario": "rewind/claude-subagent-step-rounds-down", "requires": ["v1", "test-hooks"], "doc": "A step made by a subagent (a Read inside a Task call) cannot be a cut point: Claude's conversation would end inside a tool call that has no result. The revert to that step cuts the conversation at the message before the one holding the Task call; what the cut leaves out is carried by a summary, which goes with the user's message, and the answer says the level that landed is a message."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work $ROOT/state && cd $ROOT/work && git init -q && echo base > a.txt && git add -A && git -c user.name=t -c user.email=t@t commit -q -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--state\" \"$ROOT/state\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work", "role": "worker"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid"}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/send", "params": {"id": "$sid", "text": "say first\nfs:write b.txt one\\n"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent-step", "data": {"session": "$sid", "step": {"seq": "$capture:s1", "class": "think", "turn_id": "t1"}}}, "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "agents/send", "params": {"id": "$sid", "text": "say second\nprovider:task look\nfs:write b.txt one\\ntwo\\n"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent-step", "data": {"session": "$sid", "step": {"seq": "$capture:sub", "class": "tool", "tool": "Read README.md"}}}, "within_ms": 15000}
{"do": "expect", "conn": "e", "json": {"event": "agent-step", "data": {"session": "$sid", "step": {"seq": "$capture:s2", "class": "think", "turn_id": "t2"}}}, "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "history/revert/preview", "params": {"session": "$sid", "seq": "$sub"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "result": {"preview_id": "$capture:pid", "session": "$sid", "seq": "$sub", "files": "$any", "level": "message", "needs_message": true, "blocked": []}}, "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 6, "method": "history/revert/apply", "params": {"preview_id": "$pid", "mode": "keep-mine", "choices": [], "message": "carry on without the subagent"}}}
{"do": "expect", "conn": "c", "json": {"id": 6, "result": {"session": "$sid", "level": "message", "conversation": {"state": "restored"}, "op": "$number"}}, "within_ms": 30000}
