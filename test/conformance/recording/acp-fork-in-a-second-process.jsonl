{"scenario": "recording/acp-fork-in-a-second-process", "requires": ["v1"], "doc": "Pattern C (each answer is awaited before the next line is sent). A recording of two agent processes (made from the mocks: the second opens by session/fork of the first's session at a message) is replayed by three ratatoskr-mock acp --replay processes, the row playing the hub. The first claims connection 1 at its session/new and answers with the hub's own ids; the second, started after, skips the claimed one: its initialize is answered from connection 2 and its fork claims it; a third finds no unclaimed connection that opens like that: -32099, a misses line, exit 3."}
{"do": "root"}
{"do": "write_file", "path": "$ROOT/rec/manifest.json", "json": {"format": "drgnx-recording", "version": 1, "normalize": 1, "scrub": 1, "status": "complete", "provenance": "mock", "roots": {}, "connections": [{"n": 1, "profile": "mock-claude", "opens_with": "session/new"}, {"n": 2, "profile": "mock-claude", "opens_with": "session/fork", "forked_from": {"n": 1, "session": "s1"}}]}}
{"do": "write_file", "path": "$ROOT/rec/acp/1.jsonl", "text": "{\"seq\":1,\"t_ms\":0,\"dir\":\"in\",\"msg\":{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":1}}}\n{\"seq\":2,\"t_ms\":1,\"dir\":\"out\",\"msg\":{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"protocolVersion\":1,\"agentInfo\":{\"name\":\"first\",\"version\":\"1\"}}}}\n{\"seq\":3,\"t_ms\":2,\"dir\":\"in\",\"msg\":{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"session/new\",\"params\":{\"cwd\":\"/w\",\"mcpServers\":[]}}}\n{\"seq\":4,\"t_ms\":3,\"dir\":\"out\",\"msg\":{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"sessionId\":\"s1\"}}}\n"}
{"do": "write_file", "path": "$ROOT/rec/acp/2.jsonl", "text": "{\"seq\":5,\"t_ms\":10,\"dir\":\"in\",\"msg\":{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":1}}}\n{\"seq\":6,\"t_ms\":11,\"dir\":\"out\",\"msg\":{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"protocolVersion\":1,\"agentInfo\":{\"name\":\"second\",\"version\":\"1\"}}}}\n{\"seq\":7,\"t_ms\":12,\"dir\":\"in\",\"msg\":{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"session/fork\",\"params\":{\"sessionId\":\"s1\",\"cwd\":\"/w\",\"mcpServers\":[],\"_meta\":{\"jetbrains\":{\"air\":{\"fork\":{\"version\":1,\"messageId\":\"a-1-1\"}}}}}}}\n{\"seq\":8,\"t_ms\":13,\"dir\":\"out\",\"msg\":{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"sessionId\":\"s2\"}}}\n{\"seq\":9,\"t_ms\":14,\"dir\":\"in\",\"msg\":{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"session/prompt\",\"params\":{\"sessionId\":\"s2\",\"prompt\":[{\"type\":\"text\",\"text\":\"Say only: forked.\"}]}}}\n{\"seq\":10,\"t_ms\":15,\"dir\":\"out\",\"msg\":{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s2\",\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"forked.\"}}}}}\n{\"seq\":11,\"t_ms\":16,\"dir\":\"out\",\"msg\":{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"stopReason\":\"end_turn\"}}}\n"}
{"do": "spawn_conn", "conn": "a", "argv": ["$MOCK", "acp", "--replay", "$ROOT/rec", "--as", "claude", "--misses", "$ROOT/replay/misses.jsonl"]}
{"do": "send", "conn": "a", "json": {"jsonrpc": "2.0", "id": 7, "method": "initialize", "params": {"protocolVersion": 1}}}
{"do": "expect", "conn": "a", "json": {"id": 7, "result": {"agentInfo": {"name": "first"}}}}
{"do": "send", "conn": "a", "json": {"jsonrpc": "2.0", "id": 8, "method": "session/new", "params": {"cwd": "/w", "mcpServers": []}}}
{"do": "expect", "conn": "a", "json": {"id": 8, "result": {"sessionId": "s1"}}}
{"do": "file", "path": "$ROOT/replay/claims/1", "exists": true}
{"do": "spawn_conn", "conn": "b", "argv": ["$MOCK", "acp", "--replay", "$ROOT/rec", "--as", "claude", "--misses", "$ROOT/replay/misses.jsonl"]}
{"do": "send", "conn": "b", "json": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": 1}}}
{"do": "expect", "conn": "b", "json": {"id": 1, "result": {"agentInfo": {"name": "second"}}}}
{"do": "send", "conn": "b", "json": {"jsonrpc": "2.0", "id": 2, "method": "session/fork", "params": {"sessionId": "s1", "cwd": "/w", "mcpServers": [], "_meta": {"jetbrains": {"air": {"fork": {"version": 1, "messageId": "a-1-1"}}}}}}}
{"do": "expect", "conn": "b", "json": {"id": 2, "result": {"sessionId": "s2"}}}
{"do": "send", "conn": "b", "json": {"jsonrpc": "2.0", "id": 3, "method": "session/prompt", "params": {"sessionId": "s2", "prompt": [{"type": "text", "text": "Say only: forked."}]}}}
{"do": "expect", "conn": "b", "json": {"method": "session/update", "params": {"sessionId": "s2", "update": {"content": {"text": "forked."}}}}}
{"do": "expect", "conn": "b", "json": {"id": 3, "result": {"stopReason": "end_turn"}}}
{"do": "file", "path": "$ROOT/replay/claims/2", "exists": true}
{"do": "spawn_conn", "conn": "x", "argv": ["$MOCK", "acp", "--replay", "$ROOT/rec", "--as", "claude", "--misses", "$ROOT/replay/misses.jsonl"]}
{"do": "send", "conn": "x", "json": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": 1}}}
{"do": "expect", "conn": "x", "json": {"id": 1, "error": {"code": -32099}}}
{"do": "expect_closed", "conn": "x"}
{"do": "file", "path": "$ROOT/replay/misses.jsonl", "contains": "no unclaimed connection", "count": 1, "at_most": 1}
