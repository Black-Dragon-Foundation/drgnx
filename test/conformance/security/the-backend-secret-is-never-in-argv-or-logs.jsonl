{"scenario": "security/the-backend-secret-is-never-in-argv-or-logs", "requires": ["v1", "fake-backend"], "doc": "Review M10: the backend's secret reaches it only through its environment (DRGNX_HUB_SERVE_SECRET, 64 hex, new at each start): never in its argv or Ratatoskr's, never in Ratatoskr's environment or its log (at debug), never in the lines the backend gets. The fake backend's env file is how the row learns it."}
{"do": "start", "hub": "h", "env": {"DRGNX_RATATOSKR_LOG": "debug"}}
{"do": "backend_log", "hub": "h", "expect_line": {"method": "subscribe"}}
{"do": "file", "path": "$STATE/fake-backend.env", "json": {"DRGNX_HUB_SERVE_SECRET": "$hex64"}}
{"do": "file", "path": "$STATE/fake-backend.env", "json": {"DRGNX_HUB_SERVE_SECRET": "$capture:secret"}}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "status"}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"backend": {"state": "running", "pid": "$capture:backend"}}}}
{"do": "file", "path": "/proc/$backend/cmdline", "lacks": "$secret"}
{"do": "file", "path": "/proc/$PID(h)/cmdline", "lacks": "$secret"}
{"do": "file", "path": "/proc/$PID(h)/environ", "lacks": "$secret"}
{"do": "file", "path": "$STATE/fake-backend.log", "lacks": "$secret"}
{"do": "file", "path": "$STATE/hub/log/hub-*.jsonl", "contains": "serves on", "lacks": "$secret"}
