{"scenario": "say/a-question-comes-back", "requires": ["v1", "test-hooks"], "doc": "The planning chat needs to know more and asks, with no block: say-message carries its words to the editor, the hub prompts nothing more, and no job is made. Pattern B: a virtual clock; the absence of a job is read after say-message, which the hub sends once it has read the turn."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/repo && cd $ROOT/repo && git init -q && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m init"], "expect_code": 0}
{"do": "write_file", "path": "$ROOT/s.txt", "text": "say Which settings do you mean: the hub's or the editor's?\n"}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--script\" \"$ROOT/s.txt\" \"--log\" \"$ROOT/s.log\")))) (drgnx-agents-routes ((implement \"mock-claude\"))))\n"}
{"do": "start", "hub": "h", "args": ["--test-clock"]}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "say/start", "params": {"text": "fix the settings", "repo": "$ROOT/repo"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid"}}, "within_ms": 30000}
{"do": "expect", "conn": "e", "json": {"event": "say-message", "data": {"id": "$sid", "text": "Which settings do you mean: the hub's or the editor's?\n"}}, "within_ms": 30000}
{"do": "file", "path": "$ROOT/s.log", "contains": "\"prompt\"", "count": 1, "at_most": 1}
{"do": "sql_expect", "sql": "select count(*) from job", "rows": [[0]]}
