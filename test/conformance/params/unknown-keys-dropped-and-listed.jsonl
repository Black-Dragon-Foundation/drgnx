{"scenario": "params/unknown-keys-dropped-and-listed", "requires": ["v1"], "doc": "Keys a method does not know are dropped, never fatal, and listed in the answer's ignored; a call without any has no ignored."}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "events/since", "params": {"since": 0, "colour": "red"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"since": 0, "events": []}, "ignored": ["colour"]}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "ping", "params": {"verbose": true}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"pid": "$PID(h)"}, "ignored": ["verbose"]}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "ping"}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"pid": "$PID(h)"}, "ignored": "$absent"}}
