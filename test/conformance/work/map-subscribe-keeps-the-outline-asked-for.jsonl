{"scenario": "work/map-subscribe-keeps-the-outline-asked-for", "requires": ["v1", "test-hooks"], "doc": "The form the user asked for (`work/map/set {outline}`) is kept by the editor and sent again when it subscribes anew: a rows view subscribed with outline on is drawn as the outline from its first reset (an agent's block, its `why:` line), though its cards fit; a word the hub does not know is refused at the field."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work && cd $ROOT/work && git init -q -b main && echo one > a.rs && git add a.rs && git -c user.name=t -c user.email=t@t commit -q -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h", "args": ["--test-clock"]}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:a", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "view/env", "params": {"view": "m", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 8, 8]], "cell": [8, 17], "width_px": 1000, "palette": [["accent", "#123456"], ["edge", "#654321"]], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "work/map/subscribe", "params": {"view": "m", "workspace": {"id": "workspace:000000000000", "roots": ["$ROOT/work"]}, "width_units": 250, "rows": true, "outline": "sideways"}}}
{"do": "expect", "conn": "e", "json": {"id": 3, "error": {"path": "outline"}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "work/map/subscribe", "params": {"view": "m", "workspace": {"id": "workspace:000000000000", "roots": ["$ROOT/work"]}, "width_units": 250, "rows": true, "outline": "on"}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"view": "m", "class": "gui-1", "base": 0, "ops": [{"reset": {"$contains": [{"text": "   why:      "}]}}]}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": {"hub": "$number", "version": "$number"}}, "within_ms": 10000}
