{"scenario": "work/a-finished-edit-shows-as-an-overlap", "requires": ["v1", "test-hooks"], "doc": "Two agents on two branches of one repository (the main tree and a git worktree of it) each edit the same file and then read it, so the presence model holds no edit of it any more: the overlap comes from each worktree's changed files against its base (the step snapshot after the edit). Within 1 s of hub time one work-map delta flags both branches and names the overlap edge. Pattern B on the hub's virtual clock: work/files answering [] is the gate for each session's base, each turn's last step the gate for its edit, one __test_advance of 250 ms for the delta."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work/src && cd $ROOT/work && git init -q -b main && echo one > src/a.rs && git add src/a.rs && git -c user.name=t -c user.email=t@t commit -q -m init && git worktree add -q -b b $ROOT/wt-b"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h", "args": ["--test-clock"]}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "work/map/subscribe", "params": {"view": "a", "workspace": {"id": "workspace:000000000000", "roots": ["$ROOT/work"]}, "width_units": 250}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": {"version": 1}}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:a", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/wt-b"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"id": "$capture:b", "name": "$string"}}, "within_ms": 30000}
{"do": "poll", "conn": "c", "json": {"id": 3, "method": "work/files", "params": {"session": "$a"}}, "expect": {"id": 3, "result": {"files": []}}, "within_ms": 15000, "every_ms": 50}
{"do": "poll", "conn": "c", "json": {"id": 4, "method": "work/files", "params": {"session": "$b"}}, "expect": {"id": 4, "result": {"files": []}}, "within_ms": 15000, "every_ms": 50}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "agents/send", "params": {"id": "$a", "text": "tool:edit src/a.rs\nprovider:read src/a.rs\nsay done"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent-step", "data": {"session": "$a", "step": {"turn_id": "t1"}}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 6, "method": "agents/send", "params": {"id": "$b", "text": "tool:edit src/a.rs\nprovider:read src/a.rs\nsay done"}}}
{"do": "expect", "conn": "c", "json": {"id": 6, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent-step", "data": {"session": "$b", "step": {"turn_id": "t1"}}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 7, "method": "__test_advance", "params": {"ms": 250}}}
{"do": "expect", "conn": "c", "json": {"id": 7, "result": {"now_ms": "$number"}}, "within_ms": 30000}
{"do": "expect", "conn": "e", "json": {"event": "work-map", "data": {"view": "a", "changed": {"$contains": [{"id": "branch:work/main", "warn": true}, {"id": "branch:work/b", "warn": true}, {"id": "file:work/src/a.rs", "shared": true}]}, "edges": {"$contains": [{"from": "branch:work/b", "to": "branch:work/main", "kind": "overlap"}]}}}, "within_ms": 10000}
