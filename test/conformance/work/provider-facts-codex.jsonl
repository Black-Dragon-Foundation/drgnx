{"scenario": "work/provider-facts-codex", "requires": ["v1", "test-hooks"], "doc": "A Codex session sends no tool name: a parsed read has its path and no line, a web search is classified from rawInput.action (kind fetch on the wire, a search in the detail), an opened page keeps its URL. Read back from timeline/get. Pattern B."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-codex\" :provider codex :command (\"$MOCK\" \"acp\" \"--as\" \"codex\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-codex", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid", "name": "$string"}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/send", "params": {"id": "$sid", "text": "provider:read src/a.rs\nprovider:web-search tokio select\nprovider:web-fetch https://example.test/p\nsay done"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent-step", "data": {"session": "$sid", "step": {"turn_id": "t1", "class": "think"}}}, "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "timeline/get", "params": {"scope": "session", "id": "$sid"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"steps": {"$contains": [{"class": "tool", "tool_kind": "read", "detail": {"tool": "$absent", "kind": "read", "path": "src/a.rs", "line_start": "$absent", "origin": "acp"}}, {"class": "tool", "tool_kind": "fetch", "detail": {"kind": "search", "query": "tokio select", "origin": "acp"}}, {"class": "tool", "tool_kind": "fetch", "detail": {"kind": "fetch", "url": "https://example.test/p", "origin": "acp"}}]}}}}
