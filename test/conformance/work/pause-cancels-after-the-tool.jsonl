{"scenario": "work/pause-cancels-after-the-tool", "requires": ["v1", "test-hooks"], "doc": "agents/pause on a busy session: the tool call running now completes (its entry says so), then the turn is cancelled and the words after it never run. Only the user may pause."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid", "name": "$string"}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/send", "params": {"id": "$sid", "text": "tool:exec sleep 1\nsilent 20\ntool:exec touch $ROOT/work/never"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent", "data": {"id": "$sid", "session": {"status": "busy"}}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "agents/pause", "params": {"id": "$sid"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent", "data": {"id": "$sid", "session": {"status": "idle"}}}, "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "agents/get", "params": {"id": "$sid"}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"session": {"status": "idle"}, "seq": "$number", "entries": {"$contains": [{"type": "tool", "title": "sleep 1", "status": "completed"}, {"type": "stop", "stop": "Cancelled"}]}}}}
{"do": "file", "path": "$ROOT/work/never", "exists": false}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "agents/pause", "params": {"id": "nope"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "error": {"code": "$string"}}}
