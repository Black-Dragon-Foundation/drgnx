{"scenario": "work/hidden-view-gets-stale-only", "requires": ["v1", "test-hooks"], "doc": "A hidden map (work/map/set shown false) gets no deltas: one work-map that only says stale, then nothing however much changes; shown again, it gets one full frame with what changed meanwhile. Pattern B on the hub's virtual clock: each answer is the gate, __test_advance for the events."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h", "args": ["--test-clock"]}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "work/map/subscribe", "params": {"view": "a", "workspace": {"id": "workspace:000000000000", "roots": ["$ROOT/work"]}, "width_units": 250}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": {"version": 1}}}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "work/map/set", "params": {"view": "a", "shown": false}}}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": {"version": 1}}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "__test_advance", "params": {"ms": 250}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"now_ms": "$number"}}, "within_ms": 30000}
{"do": "expect", "conn": "e", "json": {"event": "work-map", "data": {"view": "a", "stale": true, "changed": [], "layout": "$absent"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "agents/send", "params": {"id": "$sid", "text": "say one\nsay two"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent-step", "data": {"session": "$sid", "step": {"turn_id": "t1"}}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "__test_advance", "params": {"ms": 250}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"now_ms": "$number"}}, "within_ms": 30000}
{"do": "count_events", "conn": "e", "for_ms": 300, "none": ["work-map"]}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "work/map/set", "params": {"view": "a", "shown": true}}}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": {"version": "$number"}}}
{"do": "expect", "conn": "e", "json": {"event": "work-map", "data": {"view": "a", "full": true, "layout": {"width_units": 250}, "changed": {"$contains": [{"kind": "agent", "fields": {"activity": "$string"}}]}}}, "within_ms": 10000}
