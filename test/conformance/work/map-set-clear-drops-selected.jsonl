{"scenario": "work/map-set-clear-drops-selected", "requires": ["v1", "test-hooks"], "doc": "work/map/set with clear drops the hub's selection: selecting an agent draws its chain (a view-patch), and clear draws the map as it was before the selection (another view-patch); each names a model version. That neither changes the model is the unit tests' (the mock session may still change it here). Pattern B on the hub's virtual clock: each answer and event is the gate."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work && cd $ROOT/work && git init -q -b main && echo one > a.rs && git add a.rs && git -c user.name=t -c user.email=t@t commit -q -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h", "args": ["--test-clock"]}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "view/env", "params": {"view": "m", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 8, 8]], "cell": [8, 17], "width_px": 1000, "palette": [["accent", "#123456"], ["edge", "#654321"]], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "work/map/subscribe", "params": {"view": "m", "workspace": {"id": "workspace:000000000000", "roots": ["$ROOT/work"]}, "width_units": 250, "rows": true}}}
{"do": "expect", "conn": "e", "json": {"event": "view-model", "data": {"view": "m", "hub": "$capture:hub", "base": 0, "version": 1}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"view": "m", "hub": "$hub", "model": 1, "ops": [{"reset": "$any"}]}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": {"hub": "$hub", "version": "$number"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:a", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "__test_advance", "params": {"ms": 1500}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"now_ms": "$number"}}, "within_ms": 30000}
{"do": "expect", "conn": "e", "json": {"event": "view-model", "data": {"view": "m", "version": "$capture:mv"}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"view": "m", "hub": "$hub", "model": "$mv", "ops": {"$contains": [{"insert": "$any"}]}}}, "within_ms": 10000}
{"do": "count_events", "conn": "e", "for_ms": 300, "none": ["work-map"]}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "work/map/set", "params": {"view": "m", "selected": "agent:$a"}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"view": "m", "hub": "$hub", "model": "$number"}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": {"version": "$number"}}, "within_ms": 10000}
{"do": "count_events", "conn": "e", "for_ms": 300}
{"do": "send", "conn": "e", "json": {"id": 5, "method": "work/map/set", "params": {"view": "m", "clear": true}}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"view": "m", "hub": "$hub", "model": "$number"}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"id": 5, "result": {"version": "$number"}}, "within_ms": 10000}
