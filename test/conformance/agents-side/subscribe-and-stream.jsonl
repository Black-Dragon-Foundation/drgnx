{"scenario": "agents-side/subscribe-and-stream", "requires": ["v1", "test-hooks"], "doc": "The Agents side shows a card per session and follows them: with three mock agents, one asking permission makes its card say needs you with an Answer button. Pattern B."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work $ROOT/state && cd $ROOT/work && git init -q -b main && echo one > a.rs && git add a.rs && git -c user.name=t -c user.email=t@t commit -q -m init"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--state\" \"$ROOT/state\")))) (drgnx-agents-matrix (:cells ((:action code.edit :column (:role worker) :verdict ask)))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "view/env", "params": {"view": "a1", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 8, 8]], "cell": [8, 17], "width_px": 1000, "palette": [["accent", "#123456"], ["edge", "#654321"]], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "agents/side/subscribe", "params": {"view": "a1"}}}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": true}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work", "role": "worker"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:s1"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work", "role": "worker"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"id": "$capture:s2"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work", "role": "worker"}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"id": "$capture:s3"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "agents/send", "params": {"id": "$s2", "text": "ask:permission edit"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"view": "a1", "ops": {"$text": ["needs you", "Answer"]}}}, "within_ms": 30000}
