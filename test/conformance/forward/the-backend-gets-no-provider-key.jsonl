{"scenario": "forward/the-backend-gets-no-provider-key", "requires": ["v1", "fake-backend"], "doc": "A provider key in the hub's environment never reaches the backend: its environment is an allowlist."}
{"do": "start", "hub": "h", "env": {"OPENROUTER_API_KEY": "canary-or", "ANTHROPIC_API_KEY": "canary-an", "OPENAI_API_KEY": "canary-oa"}}
{"do": "backend_log", "hub": "h", "expect_line": {"method": "subscribe"}}
{"do": "file", "path": "$STATE/fake-backend.env", "json": {"OPENROUTER_API_KEY": "$absent", "ANTHROPIC_API_KEY": "$absent", "OPENAI_API_KEY": "$absent", "HOME": "$HOME"}, "lacks": "canary"}
