{"scenario": "forward/a-malformed-backend-answer-is-internal", "requires": ["v1", "fake-backend"], "doc": "A backend result that does not fit the method's result type is internal (logged with its path), never passed on; the backend's error is internal with its message; the hub keeps serving."}
{"do": "start", "hub": "h", "env": {"DRGNX_FAKE_BACKEND_SCRIPT": "{\"job/status\": {\"result\": {\"jobs\": [{\"id\": \"j\", \"bogus\": 1}]}}, \"agents/list\": \"{\\\"id\\\": $ID, \\\"result\\\": {\\\"sessions\\\": [{\\\"name\\\": \\\"no id\\\"}]}}\", \"job/stop\": {\"error\": {\"message\": \"No job j\"}}}"}}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "job/status"}}
{"do": "expect", "conn": "c", "json": {"id": 1, "error": {"code": "internal", "message": "$string"}, "result": "$absent"}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/list"}}
{"do": "expect", "conn": "c", "json": {"id": 2, "error": {"code": "internal", "message": "the backend's answer to agents/list does not match its schema: sessions[0].id"}}}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "job/stop", "params": {"id": "j"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "error": {"code": "internal", "message": "No job j"}}}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "ping"}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"pid": "$PID(h)"}}}
{"do": "file", "path": "$STATE/hub/log/hub-*.jsonl", "contains": "does not match its schema"}
