{"scenario": "forward/a-tramp-path-never-reaches-the-backend", "requires": ["v1", "fake-backend"], "doc": "A remote (TRAMP) name in a path param is invalid-params with its path, and nothing of it reaches the backend (review I5)."}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "backend_log", "hub": "h", "expect_line": {"method": "subscribe"}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "job/propose", "params": {"plan": "/ssh:canary:/x"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "error": {"code": "invalid-params", "path": "plan"}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/start", "params": {"profile": "p", "cwd": "/ssh:canary:/x"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "error": {"code": "invalid-params", "path": "cwd"}}}
{"do": "backend_log", "hub": "h", "expect_no_line": "canary"}
