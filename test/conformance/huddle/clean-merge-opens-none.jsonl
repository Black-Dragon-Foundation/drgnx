{"scenario": "huddle/clean-merge-opens-none", "requires": ["v1", "test-hooks"], "doc": "Gated (B). B's tree changes the first line of a ten-line src/a.rs (uncommitted), A's edit appends at its end: the two merge cleanly, so after __test_barrier settles the prediction there is no clash card (and no huddle). Then B's tree also appends a line; 31 s of hub time later (the check runs at most once per pair and file per 30 s) A's next edit conflicts with it: one card, so the first check did run. Pattern B on the sequencer's clock: work/files gates each edit, __test_barrier settles the prediction job."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work/src && cd $ROOT/work && git init -q -b main && seq 1 10 | sed 's/^/line /' > src/a.rs && git add src && git -c user.name=t -c user.email=t@t commit -q -m init && git worktree add -q -b b $ROOT/wt-b && sed 's/^line 1$/line one by b/' $ROOT/wt-b/src/a.rs > $ROOT/a.rs.new && mv $ROOT/a.rs.new $ROOT/wt-b/src/a.rs"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h", "args": ["--test-sequencer"]}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:a", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/wt-b"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"id": "$capture:b", "name": "$string"}}, "within_ms": 30000}
{"do": "poll", "conn": "c", "json": {"id": 3, "method": "work/files", "params": {"session": "$a"}}, "expect": {"id": 3, "result": {"files": "$any"}}, "within_ms": 15000, "every_ms": 50}
{"do": "poll", "conn": "c", "json": {"id": 4, "method": "work/files", "params": {"session": "$b"}}, "expect": {"id": 4, "result": {"files": "$any"}}, "within_ms": 15000, "every_ms": 50}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "agents/send", "params": {"id": "$a", "text": "tool:edit src/a.rs\nsay done"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "result": true}}
{"do": "poll", "conn": "c", "json": {"id": 101, "method": "work/files", "params": {"session": "$a"}}, "expect": {"id": 101, "result": {"files": {"$contains": [{"path": "src/a.rs", "plus": 1}]}}}, "within_ms": 30000, "every_ms": 50}
{"do": "send", "conn": "c", "json": {"id": 6, "method": "__test_barrier", "params": {}}}
{"do": "expect", "conn": "c", "json": {"id": 6, "result": {"marker": "$number"}}, "within_ms": 15000}
{"do": "sql_expect", "sql": "select count(*) from card where kind = 'clash' and json_extract(data, '$.rule') = 'conflict'", "rows": [[0]]}
{"do": "sql_expect", "sql": "select count(*) from entity where kind = 'huddle' and retired_tx is null", "rows": [[0]]}
{"do": "sql_expect", "sql": "select count(*) from card where job is null", "rows": [[0]]}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "echo from-b >> $ROOT/wt-b/src/a.rs"], "expect_code": 0}
{"do": "send", "conn": "c", "json": {"id": 7, "method": "__test_advance", "params": {"ms": 31000}}}
{"do": "expect", "conn": "c", "json": {"id": 7, "result": {"now_ms": "$number"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 8, "method": "agents/send", "params": {"id": "$a", "text": "tool:edit src/a.rs\nsay done"}}}
{"do": "expect", "conn": "c", "json": {"id": 8, "result": true}}
{"do": "poll", "conn": "c", "json": {"id": 102, "method": "work/files", "params": {"session": "$a"}}, "expect": {"id": 102, "result": {"files": {"$contains": [{"path": "src/a.rs", "plus": 2}]}}}, "within_ms": 30000, "every_ms": 50}
{"do": "send", "conn": "c", "json": {"id": 9, "method": "__test_barrier", "params": {}}}
{"do": "expect", "conn": "c", "json": {"id": 9, "result": {"marker": "$number"}}, "within_ms": 15000}
{"do": "sql_expect", "sql": "select count(*) from card where kind = 'clash' and json_extract(data, '$.rule') = 'conflict'", "rows": [[1]]}
