{"scenario": "huddle/reply-to-a-huddle-you-are-not-in-is-refused", "requires": ["v1", "test-hooks"], "doc": "Gated (B). A huddle between sessions A and B; a third session's huddle_reply in it is refused with its reason and nothing is added to the huddle. Pattern B: the third session's turn, idle with an agent entry, gates the reads: the refusal in its transcript, the huddle unchanged."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:a", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"id": "$capture:b", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"id": "$capture:c", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 10, "method": "agents/huddle/start", "params": {"sessions": ["$a", "$b"]}}}
{"do": "expect", "conn": "c", "json": {"id": 10, "result": {"id": "$capture:h", "state": "open", "participants": ["$a", "$b"]}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "huddle", "data": {"id": "$h", "state": "open"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 20, "method": "agents/send", "params": {"id": "$c", "text": "call:huddle_reply {\"huddle\": \"$h\", \"text\": \"I want in too.\"}"}}}
{"do": "expect", "conn": "c", "json": {"id": 20, "result": true}}
{"do": "poll", "conn": "c", "json": {"id": 21, "method": "agents/get", "params": {"id": "$c"}}, "expect": {"id": 21, "result": {"session": {"status": "idle"}, "entries": {"$contains": [{"type": "agent", "text": "$string"}]}}}, "within_ms": 30000, "every_ms": 100}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "grep -q 'call: you are not in huddle $h' $STATE/hub/transcripts/$c.jsonl || { grep -o 'call:[^\"]*' $STATE/hub/transcripts/$c.jsonl >&2; exit 1; }"], "expect_code": 0}
{"do": "poll", "conn": "c", "json": {"id": 22, "method": "agents/huddle/get", "params": {"id": "$h"}}, "expect": {"id": 22, "result": {"state": "open", "replies": []}}, "within_ms": 30000, "every_ms": 100}
