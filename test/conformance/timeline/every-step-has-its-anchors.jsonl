{"scenario": "timeline/every-step-has-its-anchors", "requires": ["v1", "fake-backend", "test-hooks"], "doc": "Task 19: every step of a turn (a think, an edit tool call, the turn's last think) is on the timeline with its message, the turn id (given to the turn's earlier steps when the turn ends) and the decision log version."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid", "name": "$string"}}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/send", "params": {"id": "$sid", "text": "hello\ntool:edit note.txt"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent-step", "data": {"session": "$sid", "step": {"turn_id": "t1", "class": "think"}}}, "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "timeline/get", "params": {"scope": "session", "id": "$sid"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"steps": [{"seq": 1, "class": "think", "message_id": "$string", "turn_id": "t1", "log_version": "$number"}, {"seq": 2, "class": "tool", "tool_kind": "edit", "message_id": "$string", "turn_id": "t1", "log_version": "$number"}, {"seq": 3, "class": "think", "turn_id": "t1", "log_version": "$number"}]}}}
