{"scenario": "panel/rows-patch-only-changed-entries", "requires": ["v1", "test-hooks"], "doc": "An editor that sends view/env for agent-panel/SID gets the session's transcript as rows: a reset first, then each turn's entries as an insert after the rows it already holds, never the earlier turns' rows again; agents/panel/look changes what one connection's panel shows."}
{"do": "root"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid", "name": "$string"}}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "view/env", "params": {"view": "agent-panel/$sid", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 400, "palette": [], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"class": "gui-1", "hub": "$capture:hub", "base": 0, "version": 1, "env_epoch": 1, "ops": [{"reset": "$any"}]}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/send", "params": {"id": "$sid", "text": "say one"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"class": "gui-1", "hub": "$hub", "ops": [{"insert": {"after": "$any", "rows": {"$contains": [{"key": "e:0", "text": "  ▍ you  say one"}, {"key": "b:1:0", "text": "  one"}]}}}]}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "agents/send", "params": {"id": "$sid", "text": "say two"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"class": "gui-1", "ops": [{"insert": {"after": "$string", "rows": {"$contains": [{"key": "$string", "text": "  ▍ you  say two"}]}}}]}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "agents/panel/look", "params": {"view": "agent-panel/$sid", "open": ["thinking"]}}}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": true}}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "agents/panel/look", "params": {"view": "elsewhere"}}}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": false}}
