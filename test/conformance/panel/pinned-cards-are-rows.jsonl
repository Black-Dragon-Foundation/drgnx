{"scenario": "panel/pinned-cards-are-rows", "requires": ["v1", "test-hooks"], "doc": "A card the user pinned (agents/panel/look pins: the cards' texts, oldest first) is a hub row at the top of the transcript view (the header window holds the strip), keyed p:pin0:0, in the card face with its text and the pin's number as a property; unpinning (an empty list) takes it away again."}
{"do": "root"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid", "name": "$string"}}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "view/env", "params": {"view": "agent-panel/$sid", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 400, "palette": [], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"class": "gui-1", "base": 0, "version": 1, "ops": [{"reset": "$any"}]}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "agents/panel/look", "params": {"view": "agent-panel/$sid", "pins": ["Run the tests"]}}}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"class": "gui-1", "ops": {"$contains": [{"insert": {"after": "$any", "rows": {"$contains": [{"key": "p:pin0:0", "text": "$string"}]}}}]}}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 4, "method": "agents/panel/look", "params": {"view": "agent-panel/$sid", "pins": []}}}
{"do": "expect", "conn": "e", "json": {"id": 4, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"class": "gui-1", "ops": {"$contains": [{"remove": {"$contains": ["p:pin0:0"]}}]}}}, "within_ms": 10000}
