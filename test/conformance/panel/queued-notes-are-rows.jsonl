{"scenario": "panel/queued-notes-are-rows", "requires": ["v1", "test-hooks"], "doc": "A note queued for the agent (a message sent while its turn runs) is a hub row under the transcript, c:q:N, in the subtle face with its number as drgnx-agent-panel-queued; when the queue empties the row goes."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid", "name": "$string"}}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "view/env", "params": {"view": "agent-panel/$sid", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 400, "palette": [], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"class": "gui-1", "base": 0, "version": 1, "ops": [{"reset": "$any"}]}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 12, "method": "agents/send", "params": {"id": "$sid", "text": "silent 3"}}}
{"do": "expect", "conn": "c", "json": {"id": 12, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 13, "method": "agents/send", "params": {"id": "$sid", "text": "second"}}}
{"do": "expect", "conn": "c", "json": {"id": 13, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"class": "gui-1", "ops": {"$contains": [{"insert": {"after": "$any", "rows": {"$contains": [{"key": "c:q:0", "text": "$string"}]}}}]}}}, "within_ms": 10000}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"class": "gui-1", "ops": {"$contains": [{"remove": {"$contains": ["c:q:0"]}}]}}}, "within_ms": 20000}
