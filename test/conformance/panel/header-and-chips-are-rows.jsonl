{"scenario": "panel/header-and-chips-are-rows", "requires": ["v1", "test-hooks"], "doc": "The panel's header (the agent's icon and name, what it does, the lens, pin and more) is a row of the hub, keyed p:head, first in the view's rows; the lens the editor chose (agents/panel/look lens and lens_on) is in it as clickable segments (drgnx-agent-panel-action lens:N), and its pin and more buttons carry their action. An idle agent with no usage has no chips row."}
{"do": "root"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid", "name": "$string"}}}
{"do": "send", "conn": "e", "json": {"id": 2, "method": "view/env", "params": {"view": "agent-panel/$sid", "class": "gui-1", "display": "gui", "scale": 1, "fonts": [["ui", null, 0, 13, 12, 3, 7, 4]], "cell": [8, 17], "width_px": 400, "palette": [], "epoch": 1}}}
{"do": "expect", "conn": "e", "json": {"id": 2, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"class": "gui-1", "base": 0, "version": 1, "ops": [{"reset": {"$contains": [{"key": "p:head", "text": "$string"}]}}]}}, "within_ms": 10000}
{"do": "send", "conn": "e", "json": {"id": 3, "method": "agents/panel/look", "params": {"view": "agent-panel/$sid", "lens": ["watch", "review", "debug"], "lens_on": 2}}}
{"do": "expect", "conn": "e", "json": {"id": 3, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "view-patch", "data": {"class": "gui-1", "version": 2, "ops": "$any"}}, "within_ms": 10000}
