{"scenario": "panel/absent-feature-is-refused", "requires": ["v1", "test-hooks"], "doc": "[C] A user action the agent does not offer is refused with invalid-params \"this agent does not offer it\" and never reaches the agent: drop and the preview on an agent offering only context, the preview on one offering nothing."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-panel\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--panel\" \"context\" \"--log\" \"$ROOT/acp.log\")) (\"mock-plain\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\" \"--log\" \"$ROOT/plain.log\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "agents/start", "params": {"profile": "mock-panel", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"id": "$capture:sid", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/context-drop", "params": {"id": "$sid", "item": "t1"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "error": {"code": "invalid-params", "message": "this agent does not offer it"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "agents/compact-preview", "params": {"id": "$sid"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "error": {"code": "invalid-params", "message": "this agent does not offer it"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "agents/start", "params": {"profile": "mock-plain", "cwd": "$ROOT/work"}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"id": "$capture:plain", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "agents/compact-preview", "params": {"id": "$plain"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "error": {"code": "invalid-params", "message": "this agent does not offer it"}}, "within_ms": 10000}
{"do": "file_grep", "paths": ["$ROOT/acp.log", "$ROOT/plain.log"], "absent": "\"panel\":"}
