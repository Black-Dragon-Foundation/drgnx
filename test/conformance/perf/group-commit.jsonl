{"scenario": "perf/group-commit", "requires": ["v1", "perf"], "doc": "Eight connections each send an events/add at once and wait for all eight answers, 500 rounds (8 x 500 = 4,000 writes through the hub's one writer, which group-commits what arrives together): a sample is one round, so the fsyncs per second a round costs are 1000 / mean ms at best (the design's reference is about 1,000 per second unbatched). The writer-level number with secure_delete on and off is urdr's benches/group_commit.rs."}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c1", "hub": "h"}
{"do": "connect", "conn": "c2", "hub": "h"}
{"do": "connect", "conn": "c3", "hub": "h"}
{"do": "connect", "conn": "c4", "hub": "h"}
{"do": "connect", "conn": "c5", "hub": "h"}
{"do": "connect", "conn": "c6", "hub": "h"}
{"do": "connect", "conn": "c7", "hub": "h"}
{"do": "connect", "conn": "c8", "hub": "h"}
{"do": "measure", "name": "eight-writers-round", "repeat": 500, "steps": [{"do": "send", "conn": "c1", "json": {"id": 1, "method": "events/add", "params": {"kind": "comment", "agent": "user", "summary": "write 1"}}}, {"do": "send", "conn": "c2", "json": {"id": 1, "method": "events/add", "params": {"kind": "comment", "agent": "user", "summary": "write 2"}}}, {"do": "send", "conn": "c3", "json": {"id": 1, "method": "events/add", "params": {"kind": "comment", "agent": "user", "summary": "write 3"}}}, {"do": "send", "conn": "c4", "json": {"id": 1, "method": "events/add", "params": {"kind": "comment", "agent": "user", "summary": "write 4"}}}, {"do": "send", "conn": "c5", "json": {"id": 1, "method": "events/add", "params": {"kind": "comment", "agent": "user", "summary": "write 5"}}}, {"do": "send", "conn": "c6", "json": {"id": 1, "method": "events/add", "params": {"kind": "comment", "agent": "user", "summary": "write 6"}}}, {"do": "send", "conn": "c7", "json": {"id": 1, "method": "events/add", "params": {"kind": "comment", "agent": "user", "summary": "write 7"}}}, {"do": "send", "conn": "c8", "json": {"id": 1, "method": "events/add", "params": {"kind": "comment", "agent": "user", "summary": "write 8"}}}, {"do": "expect", "conn": "c1", "json": {"id": 1, "result": {"id": "$number"}}, "within_ms": 10000}, {"do": "expect", "conn": "c2", "json": {"id": 1, "result": {"id": "$number"}}, "within_ms": 10000}, {"do": "expect", "conn": "c3", "json": {"id": 1, "result": {"id": "$number"}}, "within_ms": 10000}, {"do": "expect", "conn": "c4", "json": {"id": 1, "result": {"id": "$number"}}, "within_ms": 10000}, {"do": "expect", "conn": "c5", "json": {"id": 1, "result": {"id": "$number"}}, "within_ms": 10000}, {"do": "expect", "conn": "c6", "json": {"id": 1, "result": {"id": "$number"}}, "within_ms": 10000}, {"do": "expect", "conn": "c7", "json": {"id": 1, "result": {"id": "$number"}}, "within_ms": 10000}, {"do": "expect", "conn": "c8", "json": {"id": 1, "result": {"id": "$number"}}, "within_ms": 10000}]}
