{"scenario": "perf/a-1-mib-request-line", "requires": ["v1", "perf"], "doc": "The baseline of the largest request: a line of about 1 MiB (the client limit) read, decoded and answered by the front, 20 times (--perf records every sample, no budget). The vehicle is env/set: 16 values of 32 KiB (its limits) and a 500 KB key it does not know, dropped and listed in the answer."}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "measure", "name": "request-line-1-mib", "repeat": 20, "steps": [{"do": "send", "conn": "c", "json": {"id": 1, "method": "env/set", "params": {"env": [{"name": "DRGNX_PERF_0", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_1", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_2", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_3", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_4", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_5", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_6", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_7", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_8", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_9", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_10", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_11", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_12", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_13", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_14", "value": {"$repeat": "x", "times": 32768}}, {"name": "DRGNX_PERF_15", "value": {"$repeat": "x", "times": 32768}}], "pad": {"$repeat": "x", "times": 500000}}}}, {"do": "expect", "conn": "c", "json": {"id": 1, "result": {"applied": ["DRGNX_PERF_0", "DRGNX_PERF_1", "DRGNX_PERF_2", "DRGNX_PERF_3", "DRGNX_PERF_4", "DRGNX_PERF_5", "DRGNX_PERF_6", "DRGNX_PERF_7", "DRGNX_PERF_8", "DRGNX_PERF_9", "DRGNX_PERF_10", "DRGNX_PERF_11", "DRGNX_PERF_12", "DRGNX_PERF_13", "DRGNX_PERF_14", "DRGNX_PERF_15"]}, "ignored": ["pad"]}, "within_ms": 10000}]}
