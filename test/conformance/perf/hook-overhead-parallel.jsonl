{"scenario": "perf/hook-overhead-parallel", "requires": ["v1", "test-hooks", "perf"], "doc": "Eight permission requests at once, as Claude issues parallel tool calls (the mock sends all eight before it reads an answer), first with no rule (`burst-bare`), then with one annotating rule on edits (`burst-hooked`), 50 bursts each. Every request is answered allow: none is refused as busy, the turn says `burst: 8/8 allowed`. The added cost is the difference of the two p95s, bound 5 ms as for one request (--perf records every sample; the gate judges it, pinned with DRGNX_PERF_CPUS=4)."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))) (drgnx-agents-matrix (:cells ((:action code.edit :column (:role chat) :verdict allow)))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work", "role": "chat"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"id": "$capture:sid", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "e", "json": {"id": 901, "method": "agents/entries/subscribe", "params": {"session": "$sid"}}}
{"do": "expect", "conn": "e", "json": {"id": 901, "result": {"seq": "$number"}}}
{"do": "measure", "name": "burst-bare", "repeat": 50, "steps": [{"do": "send", "conn": "c", "json": {"id": 3, "method": "agents/send", "params": {"id": "$sid", "text": "ask:burst 8 {\"kind\": \"edit\", \"title\": \"Edit a.txt\", \"rawInput\": {\"path\": \"a.txt\"}}"}}}, {"do": "expect", "conn": "c", "json": {"id": 3, "result": true}}, {"do": "expect", "conn": "e", "json": {"event": "agent-entries", "data": {"id": "$sid", "entries": {"$contains": [["$any", {"type": "agent", "text": "burst: 8/8 allowed"}]]}}}, "within_ms": 30000}]}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "config/settings", "params": {"overrides": [{"name": "drgnx-agents-hook-rules", "source": "row", "value": [{"id": "note-edits", "point": "before-tool", "tool-kinds": ["edit"], "verdict": "annotate", "reason": "noted"}]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": {"applied": 1}}, "within_ms": 10000}
{"do": "measure", "name": "burst-hooked", "repeat": 50, "steps": [{"do": "send", "conn": "c", "json": {"id": 5, "method": "agents/send", "params": {"id": "$sid", "text": "ask:burst 8 {\"kind\": \"edit\", \"title\": \"Edit a.txt\", \"rawInput\": {\"path\": \"a.txt\"}}"}}}, {"do": "expect", "conn": "c", "json": {"id": 5, "result": true}}, {"do": "expect", "conn": "e", "json": {"event": "agent-entries", "data": {"id": "$sid", "entries": {"$contains": [["$any", {"type": "agent", "text": "burst: 8/8 allowed"}]]}}}, "within_ms": 30000}]}
