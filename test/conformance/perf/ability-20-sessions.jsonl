{"scenario": "perf/ability-20-sessions", "requires": ["v1", "test-hooks", "perf"], "doc": "Tick lag with 20 sessions that each started with a plugin ability (each holds a `drgnx-plugins` server open): the round trip of a `ping` to the hub, 200 times, while all 20 sit idle (`ping-20-ability-sessions`), after the same 200 with none started (`ping-no-sessions`). The bound on the first is 100 ms (--perf records every sample; the gate judges it, pinned with DRGNX_PERF_CPUS=4)."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$ROOT/src/plugin.json", "json": {"name": "echo-ability", "version": "0.1.0", "abilities": [{"name": "echo", "description": "Returns its arguments.", "input_schema": {"type": "object"}}]}}
{"do": "write_file", "path": "$ROOT/src/plugin.wasm", "text": "wasm-one"}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"mock-claude\" :provider claude :command (\"$MOCK\" \"acp\" \"--as\" \"claude\")))) (drgnx-agents-matrix (:cells ((:action plugin.abilities :column (:role chat) :verdict allow)))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "q", "hub": "h"}
{"do": "run", "args": ["plugins", "install", "$ROOT/src"], "expect_code": 0, "expect_stdout": "installed echo-ability 0.1.0"}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "plugins/list", "params": {}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"plugins": [{"name": "echo-ability", "state": "unapproved", "hash": "$capture:hash"}]}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "plugins/approve", "params": {"name": "echo-ability", "hash": "$hash"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"name": "echo-ability", "state": "approved"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "config/settings", "params": {"overrides": [{"name": "drgnx-agents-plugins", "source": "row", "value": ["echo-ability"]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"applied": 1}}, "within_ms": 10000}
{"do": "measure", "name": "ping-no-sessions", "repeat": 200, "steps": [{"do": "send", "conn": "q", "json": {"id": 4, "method": "ping"}}, {"do": "expect", "conn": "q", "json": {"id": 4, "result": "$any"}, "within_ms": 5000}]}
{"do": "send", "conn": "c", "json": {"id": 101, "method": "agents/start", "params": {"profile": "mock-claude", "cwd": "$ROOT/work", "role": "chat"}}}
