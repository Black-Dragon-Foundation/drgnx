{"do": "run", "bin": "/bin/sh", "args": ["-c", "set -- $(cat /proc/$PID(h)/stat); echo $((${14} + ${15})) > $ROOT/cpu0; date +%s%N > $ROOT/t0"], "expect_code": 0}
{"do": "expect_silent", "conn": "q", "for_ms": 10000}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "set -- $(cat /proc/$PID(h)/stat); end=$((${14} + ${15})); start=$(cat $ROOT/cpu0); ms=$(( ($(date +%s%N) - $(cat $ROOT/t0)) / 1000000 )); used=$((end - start)); echo \"hub cpu: $used ticks in $ms ms\"; [ $((used * 1000)) -le $((ms * 3)) ]"], "expect_code": 0}
