{"scenario": "adapters/kimi-rebase", "requires": ["v1", "test-hooks"], "doc": "[C] The check of a rebase of the org's kimi-code fork: against the personality that mirrors it, the fork advertises context, compact-preview and before-tool (drop and pin arrive with its second wave and are refused as not offered until then), its permission request carries the tool's kind through the folded call, and its `_drgnx/before_tool` is answered by the hooks and vetoes the step: a refused read never reaches the confirmation. A feature that drops out or a method the fork stops answering fails here by name."}
{"do": "root"}
{"do": "sqlite", "path": "$DATA/work.db", "sql_file": "$SCENARIOS/../fixtures/work-db-6.sql"}
{"do": "run", "bin": "/bin/sh", "args": ["-c", "mkdir -p $ROOT/work"], "expect_code": 0}
{"do": "write_file", "path": "$CONFIG/settings.el", "mode": "600", "text": "(drgnx-settings :version 1 (drgnx-agents-profiles ((\"fork\" :provider kimi :command (\"$MOCK\" \"acp\" \"--as\" \"kimi\" \"--panel\" \"before-tool,context,compact-preview\" \"--log\" \"$ROOT/acp.log\")))))\n"}
{"do": "start", "hub": "h"}
{"do": "connect", "conn": "c", "hub": "h"}
{"do": "connect", "conn": "e", "hub": "h"}
{"do": "send", "conn": "e", "json": {"id": 1, "method": "subscribe"}}
{"do": "expect", "conn": "e", "json": {"id": 1, "result": true}}
{"do": "send", "conn": "c", "json": {"id": 1, "method": "config/settings", "params": {"overrides": [{"name": "drgnx-agents-hook-rules", "source": "row", "value": [{"id": "no-reads", "point": "before-tool", "tool-kinds": ["read"], "verdict": "deny", "reason": "no reads"}]}]}}}
{"do": "expect", "conn": "c", "json": {"id": 1, "result": {"applied": 1}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 2, "method": "agents/start", "params": {"profile": "fork", "cwd": "$ROOT/work", "role": "chat"}}}
{"do": "expect", "conn": "c", "json": {"id": 2, "result": {"id": "$capture:sid", "name": "$string"}}, "within_ms": 30000}
{"do": "send", "conn": "c", "json": {"id": 3, "method": "agents/get", "params": {"id": "$sid"}}}
{"do": "expect", "conn": "c", "json": {"id": 3, "result": {"session": {"id": "$sid", "panel": {"features": ["context", "compact-preview", "before-tool"]}}}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 4, "method": "agents/send", "params": {"id": "$sid", "text": "panel:context {\"used\": 700, \"size\": 256000, \"parts\": [{\"kind\": \"conversation\", \"tokens\": 700}]}"}}}
{"do": "expect", "conn": "c", "json": {"id": 4, "result": true}}
{"do": "expect", "conn": "e", "json": {"event": "agent", "data": {"id": "$sid", "session": {"panel": {"context": {"used": 700}}}}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 5, "method": "agents/compact-preview", "params": {"id": "$sid"}}}
{"do": "expect", "conn": "c", "json": {"id": 5, "result": {"frees": "$number"}}, "within_ms": 15000}
{"do": "send", "conn": "c", "json": {"id": 6, "method": "agents/context-drop", "params": {"id": "$sid", "item": "t1"}}}
{"do": "expect", "conn": "c", "json": {"id": 6, "error": {"code": "invalid-params", "message": "this agent does not offer it"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 7, "method": "agents/context-pin", "params": {"id": "$sid", "item": "f1", "pinned": true}}}
{"do": "expect", "conn": "c", "json": {"id": 7, "error": {"code": "invalid-params", "message": "this agent does not offer it"}}, "within_ms": 10000}
{"do": "send", "conn": "c", "json": {"id": 8, "method": "agents/send", "params": {"id": "$sid", "text": "provider:read a.txt"}}}
{"do": "expect", "conn": "c", "json": {"id": 8, "result": true}}
{"do": "file", "path": "$ROOT/acp.log", "contains": "{\"vetoed\":\"read\"}", "within_ms": 30000}
{"do": "file_grep", "paths": ["$ROOT/acp.log"], "absent": "{\"ran\":\"Read\"}"}
{"do": "file", "path": "$ROOT/acp.log", "contains": "\"method\":\"_drgnx/compact/preview\"", "within_ms": 10000}
