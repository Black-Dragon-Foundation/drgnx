{
  "version": 1,
  "about": [
    "The personal-notes deny-list's shared cases: norn::deny (Rust) and core/drgnx-deny.el (Lisp) both run them.",
    "Each case runs in its own temp HOME. $HOME stands for it (canonical); nothing reaches the real ~.",
    "Setup: dirs and files (HOME-relative; files hold fixture text), links ([at, target], target as written),",
    "deny and allow (the config dir's personal-notes-deny.json / personal-notes-allow.json: json or raw text,",
    "mode in octal, default 600).",
    "Probe, one of: check (a path), root (a project root), record (source, id, data: a door's input).",
    "Expect: verdict (check: allowed, board, opted-in, denied; root: allowed, denied, contains; record: allowed,",
    "denied), tier (hard, soft) when denied, contains (root), paths (how many paths_of finds), warnings (count,",
    "default 0). os: run only on that system (Rust's std::env::consts::OS)."
  ],
  "cases": [
    {"name": "notes.org is hard", "files": ["org/notes.org"],
     "check": "$HOME/org/notes.org", "verdict": "denied", "tier": "hard"},
    {"name": "a file in a subfolder is soft", "files": ["org/sub/x.md"],
     "check": "$HOME/org/sub/x.md", "verdict": "denied", "tier": "soft"},
    {"name": "the board is read", "files": ["org/board.org"],
     "check": "$HOME/org/board.org", "verdict": "board"},
    {"name": "board.org.bak is not the board", "files": ["org/board.org", "org/board.org.bak"],
     "check": "$HOME/org/board.org.bak", "verdict": "denied", "tier": "soft"},
    {"name": "a link from a project to notes.org", "files": ["org/notes.org"], "dirs": ["proj"],
     "links": [["proj/n.org", "$HOME/org/notes.org"]],
     "check": "$HOME/proj/n.org", "verdict": "denied", "tier": "hard"},
    {"name": "a linked folder into org", "files": ["org/sub/x.md"], "links": [["proj/o", "../org"]],
     "check": "$HOME/proj/o/sub/x.md", "verdict": "denied", "tier": "soft"},
    {"name": "dot-dot back into org", "files": ["org/notes.org"],
     "check": "$HOME/org/../org/notes.org", "verdict": "denied", "tier": "hard"},
    {"name": "dot-dot through a folder not made", "files": ["org/notes.org"],
     "check": "$HOME/org/missing/../notes.org", "verdict": "denied", "tier": "hard"},
    {"name": "a doubled slash", "files": ["org/notes.org"],
     "check": "$HOME/org//notes.org", "verdict": "denied", "tier": "hard"},
    {"name": "a trailing slash", "files": ["org/sub/x.md"],
     "check": "$HOME/org/sub/", "verdict": "denied", "tier": "soft"},
    {"name": "a path not made yet", "dirs": ["org"],
     "check": "$HOME/org/new/later.md", "verdict": "denied", "tier": "soft"},
    {"name": "no org folder at all",
     "check": "$HOME/org/notes.org", "verdict": "denied", "tier": "hard"},
    {"name": "a dangling link into org", "dirs": ["org"], "links": [["proj/later", "../org/later.org"]],
     "check": "$HOME/proj/later", "verdict": "denied", "tier": "soft"},
    {"name": "org itself is a link", "files": ["sync/org/notes.org", "sync/org/x.md"],
     "links": [["org", "$HOME/sync/org"]],
     "check": "$HOME/sync/org/x.md", "verdict": "denied", "tier": "soft"},
    {"name": "a link out of org keeps its name denied", "files": ["proj/x.md"],
     "links": [["org/alias.md", "$HOME/proj/x.md"]],
     "check": "$HOME/org/alias.md", "verdict": "denied", "tier": "soft"},
    {"name": "a file outside org", "files": ["proj/readme.md"],
     "check": "$HOME/proj/readme.md", "verdict": "allowed"},
    {"name": "a relative path is denied", "files": ["org/sub/x.md"],
     "check": "org/sub/x.md", "verdict": "denied", "tier": "hard"},
    {"name": "hard names fold case", "files": ["org/NOTES-old.org"],
     "check": "$HOME/org/NOTES-old.org", "verdict": "denied", "tier": "hard"},
    {"name": "a file under a Diary folder", "files": ["org/Diary/day.org"],
     "check": "$HOME/org/Diary/day.org", "verdict": "denied", "tier": "hard"},
    {"name": "on macOS ORG/Notes.org is notes.org", "os": "macos", "files": ["org/notes.org"],
     "check": "$HOME/ORG/Notes.org", "verdict": "denied", "tier": "hard"},

    {"name": "a project inside org", "dirs": ["org/proj"],
     "root": "$HOME/org/proj", "verdict": "denied"},
    {"name": "a project root at HOME", "files": ["org/notes.org"], "dirs": ["proj"],
     "root": "$HOME", "verdict": "contains", "contains": ["$HOME/org"]},
    {"name": "a project outside org", "dirs": ["proj", "org"],
     "root": "$HOME/proj", "verdict": "allowed"},

    {"name": "an opt-in opens one file", "files": ["org/reading.org"],
     "allow": {"json": {"version": 1, "paths": ["$HOME/org/reading.org"]}},
     "check": "$HOME/org/reading.org", "verdict": "opted-in"},
    {"name": "an opt-in written with ~", "files": ["org/reading.org"],
     "allow": {"json": {"version": 1, "paths": ["~/org/reading.org"]}},
     "check": "$HOME/org/reading.org", "verdict": "opted-in"},
    {"name": "an opt-in opens only its file", "files": ["org/reading.org", "org/other.org"],
     "allow": {"json": {"version": 1, "paths": ["$HOME/org/reading.org"]}},
     "check": "$HOME/org/other.org", "verdict": "denied", "tier": "soft"},
    {"name": "a world-writable opt-in file opens nothing", "files": ["org/reading.org"],
     "allow": {"mode": "666", "json": {"version": 1, "paths": ["$HOME/org/reading.org"]}},
     "check": "$HOME/org/reading.org", "verdict": "denied", "tier": "soft", "warnings": 1},
    {"name": "a malformed opt-in file opens nothing", "files": ["org/reading.org"],
     "allow": {"raw": "[\"$HOME/org/reading.org\"]"},
     "check": "$HOME/org/reading.org", "verdict": "denied", "tier": "soft", "warnings": 1},
    {"name": "an opt-in of notes.org", "files": ["org/notes.org"],
     "allow": {"json": {"version": 1, "paths": ["$HOME/org/notes.org"]}},
     "check": "$HOME/org/notes.org", "verdict": "denied", "tier": "hard", "warnings": 1},
    {"name": "an opt-in of Journal-2026.org", "files": ["org/Journal-2026.org"],
     "allow": {"json": {"version": 1, "paths": ["$HOME/org/Journal-2026.org"]}},
     "check": "$HOME/org/Journal-2026.org", "verdict": "denied", "tier": "hard", "warnings": 1},
    {"name": "an opt-in under personal/", "files": ["org/personal/x.md"],
     "allow": {"json": {"version": 1, "paths": ["$HOME/org/personal/x.md"]}},
     "check": "$HOME/org/personal/x.md", "verdict": "denied", "tier": "hard", "warnings": 1},
    {"name": "an opt-in of a folder", "files": ["org/sub/x.md"],
     "allow": {"json": {"version": 1, "paths": ["$HOME/org/sub/"]}},
     "check": "$HOME/org/sub/x.md", "verdict": "denied", "tier": "soft", "warnings": 1},
    {"name": "an opt-in glob", "files": ["org/reading.org"],
     "allow": {"json": {"version": 1, "paths": ["$HOME/org/*.org"]}},
     "check": "$HOME/org/reading.org", "verdict": "denied", "tier": "soft", "warnings": 1},
    {"name": "an opt-in outside org", "files": ["proj/a.md"],
     "allow": {"json": {"version": 1, "paths": ["$HOME/proj/a.md"]}},
     "check": "$HOME/proj/a.md", "verdict": "allowed", "warnings": 1},
    {"name": "an opt-in of a file not made", "dirs": ["org"],
     "allow": {"json": {"version": 1, "paths": ["$HOME/org/later.org"]}},
     "check": "$HOME/org/later.org", "verdict": "denied", "tier": "soft", "warnings": 1},

    {"name": "a spec source naming notes.org", "files": ["org/notes.org"],
     "record": {"source": "spec $HOME/org/notes.org", "id": "spec:$HOME/org/notes.org", "data": {}},
     "paths": 1, "verdict": "denied", "tier": "hard"},
    {"name": "a plan whose spec id is notes.org", "files": ["org/notes.org", "proj/plan.md"],
     "record": {"source": "$HOME/proj/plan.md", "id": "spec:$HOME/org/notes.org", "data": {}},
     "paths": 2, "verdict": "denied", "tier": "hard"},
    {"name": "data.path into org under a project source", "files": ["org/sub/x.md", "proj/plan.md"],
     "record": {"source": "$HOME/proj/plan.md", "id": "task:$HOME/proj/plan.md#2",
                "data": {"path": "$HOME/org/sub/x.md"}},
     "paths": 2, "verdict": "denied", "tier": "soft"},
    {"name": "a project record", "files": ["proj/plan.md"],
     "record": {"source": "$HOME/proj/plan.md", "id": "step:$HOME/proj/plan.md#2.1", "data": {}},
     "paths": 1, "verdict": "allowed"},
    {"name": "a commit in a project", "dirs": ["proj"],
     "record": {"source": "commit", "id": "commit:0123abc", "data": {"path": "$HOME/proj"}},
     "paths": 1, "verdict": "allowed"},
    {"name": "an unknown source form", "files": ["org/notes.org"],
     "record": {"source": "notes", "id": "spec:x", "data": {}},
     "verdict": "denied", "tier": "hard"},

    {"name": "a user file entry", "files": ["docs/private.txt", "docs/other.txt"],
     "deny": {"json": {"version": 1, "entries": [{"kind": "file", "path": "~/docs/private.txt"}]}},
     "check": "$HOME/docs/private.txt", "verdict": "denied", "tier": "hard"},
    {"name": "a user file entry denies only its file", "files": ["docs/private.txt", "docs/other.txt"],
     "deny": {"json": {"version": 1, "entries": [{"kind": "file", "path": "~/docs/private.txt"}]}},
     "check": "$HOME/docs/other.txt", "verdict": "allowed"},
    {"name": "a user folder entry", "files": ["docs/private/a/b.txt"],
     "deny": {"json": {"version": 1, "entries": [{"kind": "folder", "path": "~/docs/private"}]}},
     "check": "$HOME/docs/private/a/b.txt", "verdict": "denied", "tier": "hard"},
    {"name": "a user glob entry", "files": ["docs/x.secret"],
     "deny": {"json": {"version": 1, "entries": [{"kind": "glob", "path": "~/docs/*.secret"}]}},
     "check": "$HOME/docs/x.secret", "verdict": "denied", "tier": "hard"},
    {"name": "a user glob is one folder deep", "files": ["docs/sub/x.secret"],
     "deny": {"json": {"version": 1, "entries": [{"kind": "glob", "path": "~/docs/*.secret"}]}},
     "check": "$HOME/docs/sub/x.secret", "verdict": "allowed"},
    {"name": "a user glob covers a folder it matches", "files": ["docs/keys.secret/a.txt"],
     "deny": {"json": {"version": 1, "entries": [{"kind": "glob", "path": "~/docs/*.secret"}]}},
     "check": "$HOME/docs/keys.secret/a.txt", "verdict": "denied", "tier": "hard"},
    {"name": "a glob with a wildcard folder is ignored", "files": ["docs/x.txt"],
     "deny": {"json": {"version": 1, "entries": [{"kind": "glob", "path": "~/*/x.txt"}]}},
     "check": "$HOME/docs/x.txt", "verdict": "allowed", "warnings": 1},
    {"name": "an opt-in on a user-denied path", "files": ["org/reading.org"],
     "deny": {"json": {"version": 1, "entries": [{"kind": "file", "path": "~/org/reading.org"}]}},
     "allow": {"json": {"version": 1, "paths": ["$HOME/org/reading.org"]}},
     "check": "$HOME/org/reading.org", "verdict": "denied", "tier": "hard", "warnings": 1},
    {"name": "the built-ins cannot be removed", "files": ["org/notes.org"],
     "deny": {"json": {"version": 1, "entries": [{"kind": "allow", "path": "~/org/notes.org"}]}},
     "check": "$HOME/org/notes.org", "verdict": "denied", "tier": "hard", "warnings": 1},
    {"name": "a broken deny file keeps the built-ins and opens nothing", "files": ["org/reading.org"],
     "deny": {"raw": "{not json"},
     "allow": {"json": {"version": 1, "paths": ["$HOME/org/reading.org"]}},
     "check": "$HOME/org/reading.org", "verdict": "denied", "tier": "soft", "warnings": 2},
    {"name": "a group-writable deny file still denies", "files": ["docs/private.txt", "org/reading.org"],
     "deny": {"mode": "620", "json": {"version": 1, "entries": [{"kind": "file", "path": "~/docs/private.txt"}]}},
     "allow": {"json": {"version": 1, "paths": ["$HOME/org/reading.org"]}},
     "check": "$HOME/docs/private.txt", "verdict": "denied", "tier": "hard", "warnings": 2},
    {"name": "a user entry covers the board", "files": ["org/board.org"],
     "deny": {"json": {"version": 1, "entries": [{"kind": "folder", "path": "~/org"}]}},
     "check": "$HOME/org/board.org", "verdict": "denied", "tier": "hard"},
    {"name": "a project root at HOME with user entries",
     "files": ["org/notes.org", "docs/private/a.txt", "docs/k.secret", "docs/plain.txt"],
     "deny": {"json": {"version": 1, "entries": [{"kind": "folder", "path": "~/docs/private"},
                                                 {"kind": "glob", "path": "~/docs/*.secret"}]}},
     "root": "$HOME", "verdict": "contains",
     "contains": ["$HOME/docs/k.secret", "$HOME/docs/private", "$HOME/org"]},
    {"name": "a project inside a user folder", "dirs": ["docs/private/proj"],
     "deny": {"json": {"version": 1, "entries": [{"kind": "folder", "path": "~/docs/private"}]}},
     "root": "$HOME/docs/private/proj", "verdict": "denied"}
  ]
}
