{
  "version": 1,
  "about": [
    "runstav::secrets::looks_like_secret's shared cases: text (a string, or parts to join, so this public",
    "repository's leak hook never sees a whole key) and rule (the rule's name, or null for no secret).",
    "Every key here is made up."
  ],
  "cases": [
    {"name": "an RSA private key", "text": ["-----BEGIN RSA PRIVATE KEY", "-----\nMIIEowIBAAKCAQEA"], "rule": "private-key"},
    {"name": "an OpenSSH private key", "text": ["-----BEGIN OPENSSH PRIVATE KEY", "-----"], "rule": "private-key"},
    {"name": "a PKCS#8 private key", "text": ["-----BEGIN PRIVATE KEY", "-----"], "rule": "private-key"},
    {"name": "an AWS key id", "text": ["aws_access_key_id = AKIA", "IOSFODNN7EXAMPLE"], "rule": "aws-key-id"},
    {"name": "an Anthropic key", "text": ["export KEY=sk-ant-", "api03-Xy7Kp2Qm9Rt4Vw8Zb3Nc6Hd1Jf5Lg0Ps"], "rule": "key-prefix"},
    {"name": "an OpenRouter key", "text": ["sk-or-", "v1-0a1b2c3d4e5f60718293a4b5c6d7e8f9"], "rule": "key-prefix"},
    {"name": "an OpenAI project key", "text": ["sk-", "proj-Ab3dEf6hIj9kLm2nOp5q"], "rule": "key-prefix"},
    {"name": "a GitHub token", "text": ["ghp_", "aB3dE6gH9jK2mN5pQ8sT1vW4yZ7bC0eF3h"], "rule": "key-prefix"},
