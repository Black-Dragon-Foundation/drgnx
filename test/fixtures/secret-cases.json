    {"name": "passwd=", "text": "passwd=correct-horse", "rule": "assignment"},
    {"name": "a token in a URL", "text": "https://example.org/hook?token=abc123def456", "rule": "assignment"},
    {"name": "a long random token in prose", "text": "the key is Zq3+K8vN_wX2pL9rT5mY7bH1jD4fG6sA0cE8uQ-iO here", "rule": "high-entropy"},
    {"name": "40 random base62 characters", "text": "aB3dE6gH9jK2mN5pQ8sT1vW4yZ7bC0eF3hJ6kL9n", "rule": "high-entropy"},

