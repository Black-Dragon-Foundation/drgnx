    {"name": "a GitHub fine-grained token", "text": ["github_pat_", "11ABCDEFG0123456789_abcdefghijklmnop"], "rule": "key-prefix"},
    {"name": "a GitLab token", "text": ["glpat-", "x8Yz3Kp9Qr2Wm5Nt7Vb1"], "rule": "key-prefix"},
    {"name": "a Slack bot token", "text": ["xoxb-", "123456789012-1234567890123-AbCdEfGhIjKlMnOpQrStUvWx"], "rule": "key-prefix"},
    {"name": "a Slack user token", "text": ["xoxp-", "2468013579-1357924680-9876543210-abc123def456"], "rule": "key-prefix"},
    {"name": "a Slack app token", "text": ["xoxa-", "2-1234567890-abcdefABCDEF1234"], "rule": "key-prefix"},
    {"name": "password=", "text": "password=hunter2hunter2", "rule": "assignment"},
