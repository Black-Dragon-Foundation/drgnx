;;; work-db-7-gen.el --- test tooling: generates test/fixtures/work-db-7.sql -*- lexical-binding: t -*-

;; SPDX-License-Identifier: GPL-3.0-or-later

;;; Commentary:
;; work-db-7.sql is a work.db of schema 7 as the hub makes it: a small schema-6 database (work-db-6.sql plus the rows
;; below, synthetic) is migrated by `ratatoskr store migrate-check', then dumped.  The readers' conformance test
;; (test/unit/work-db-readers-test.el) loads the dump into a file and reads it with every reader.
;;
;; Regenerate (the migration is Ratatoskr's, so it needs a Ratatoskr build):
;;   emacs --batch -Q -l test/fixtures/work-db-7-gen.el \
;;     --eval '(drgnx-work-db-7-gen "runtime/target/debug/ratatoskr" "test/fixtures/work-db-7.sql")'
;;
;; The dump is one statement after another, each ending in ";" and a blank line (`drgnx-work-db-7-statements' splits
;; on that).  Full-text and other virtual tables, and their shadow tables, are left out: no reader needs them.

;;; Code:
(require 'cl-lib)
(require 'subr-x)

(defconst drgnx-work-db-7-gen--dir (file-name-directory (or load-file-name buffer-file-name)))

(defconst drgnx-work-db-7-gen--seed
  '("insert into node values ('spec:s', 'spec', 'The spec', '/w/s.md', null, null, null, null, '/w/s.md', null, 1700000001.0)"
    "insert into node values ('plan:p', 'plan', 'The plan', '/w/p.md', 1, 'open', null, 1, '/w/p.md', null, 1700000002.0)"
    "insert into node values ('task:/w/p.md#1', 'task', 'First task', '/w/p.md', 3, 'open', 'plan:p', 1, '/w/p.md', null, 1700000003.0)"
    "insert into edge values ('plan:p', 'spec:s', 'derives', 'parsed', '/w/p.md')"
    "insert into file values ('/w/p.md', 1700000000.0)"
    "insert into job values ('j1', 'One job', '/w/p.md', '/w', 'running', 1700000010.0, null)"
    "insert into jtask values ('j1#1', 'j1', 1, 'the first', 'implement', 'done', 'a1', null, null)"
    "insert into jtask values ('j1#2', 'j1', 2, 'the second', 'implement', 'running', 'a1', 1700009999.0, '{\"note\":\"x\"}')"
    "insert into jdep values ('j1#2', 'j1#1')"
    "insert into agent values ('a1', 'claude', 'one', '/w', '/w/wt', 'b', 'main', '/w/p.md', 'j1#2', 4242, 1700000020.0, 1700000030.0)"
    "insert into decision values (1, 'design', 'Use one writer', 'j1#1', '[\"src/a.rs\"]', 'Simpler', 'user', 'active', null, 1700000040.0, 1, 'j1')"
    "insert into decision values (2, 'design', 'Use one writer, checked', 'j1#1', null, 'Safer', 'user', 'active', 1, 1700000041.0, 2, 'j1')"
    "insert into message values (1, 'j1', 'a1', 'user', 'Done', 'queued', null, 1700000050.0, null, null, null, null)"
    "insert into card values (1, 'j1', 'j1#1', 'ask', 'Which one?', '{\"x\":1}', 'open', 1700000060.0, null, null, null)"
    "insert into event values (1, 1700000070.0, 'a1', 'j1', 'j1#2', 'start', 'began', null, null)"
    "insert into event values (2, 1700000071.0, 'a1', 'j1', 'j1#2', 'question', 'why?', null, null)"
    "insert into review_mark values ('a1', 'src/a.rs', 'seen', 'h1', 1700000080.0)"
    "insert into spend values (1700000090.0, 'j1', 'j1#2', 'a1', 'p', 'm', 10, 20, 0.5, 200)")
  "The rows added to work-db-6.sql's empty tables before the migration.")

(defun drgnx-work-db-7-gen--sql-file (file)
  "The statements of the SQL FILE (comment lines dropped; a statement ends at \";\" and a newline)."
  (with-temp-buffer
    (insert-file-contents file)
    (let ((text (replace-regexp-in-string "^--.*\n" "" (buffer-string))))
      (cl-remove-if #'string-empty-p (mapcar #'string-trim (split-string text ";\n"))))))

(defun drgnx-work-db-7-gen--dump (db out)
  "Write DB (a schema-7 database) to OUT in the format of `drgnx-work-db-7-statements'."
  (let* ((master (sqlite-select db "select type, name, tbl_name, sql from sqlite_master where sql is not null
                                    and name not like 'sqlite_%' order by rowid"))
         (virtual (cl-loop for (_ name _ sql) in master
                           when (string-match-p "\\`CREATE VIRTUAL TABLE" sql) collect name))
         (skip (lambda (name)
                 (cl-some (lambda (v) (or (equal name v) (string-prefix-p (concat v "_") name))) virtual)))
         (kept (cl-remove-if (lambda (r) (funcall skip (nth 2 r))) master)))
    (with-temp-file out
      (insert "-- work.db schema 7 as the hub makes it: a small synthetic schema-6 database migrated by\n"
              "-- `ratatoskr store migrate-check`, then dumped.  Generated by test/fixtures/work-db-7-gen.el; do not edit.\n"
              "-- Statements end in \";\" and a blank line.\n\n")
      (dolist (type '("table" "index" "view" "trigger"))
        (cl-loop for (ty _ _ sql) in kept when (equal ty type) do (insert sql ";\n\n")))
      (cl-loop for (ty name _ _) in kept
               when (equal ty "table")
               do (let* ((cols (mapcar (lambda (r) (nth 1 r)) (sqlite-select db (format "pragma table_info(\"%s\")" name))))
                         (expr (mapconcat (lambda (c) (format "quote(\"%s\")" c)) cols " || ',' || ")))
                    (dolist (row (sqlite-select db (format "select %s from \"%s\"" expr name)))
                      (insert (format "insert into \"%s\" values (%s);\n\n" name (car row)))))))))

(defun drgnx-work-db-7-gen (ratatoskr out)
  "Make OUT, the schema-7 dump, by migrating a seeded schema-6 database with the RATATOSKR binary."
  (let* ((tmp (make-temp-file "work-db-7-gen" t))
         (file (expand-file-name "work.db" tmp))
         (data (expand-file-name "data" tmp))
         (scratch (expand-file-name "scratch" tmp)))
    (make-directory data) (make-directory scratch)
    (unwind-protect
        (progn
          (let ((db (sqlite-open file)))
            (dolist (s (append (drgnx-work-db-7-gen--sql-file (expand-file-name "work-db-6.sql" drgnx-work-db-7-gen--dir))
                               drgnx-work-db-7-gen--seed))
              (sqlite-execute db s))
            (sqlite-close db))
          (let ((process-environment (append (list (concat "DRGNX_DATA_DIR=" data) (concat "HOME=" tmp)) process-environment)))
            (with-temp-buffer
              (unless (zerop (call-process (expand-file-name ratatoskr) nil t nil
                                           "store" "migrate-check" "--db" file "--scratch" scratch))
                (error "migrate-check failed: %s" (buffer-string)))))
          (let ((db (sqlite-open file t)))
            (drgnx-work-db-7-gen--dump db (expand-file-name out))
            (sqlite-close db)))
      (delete-directory tmp t))))

(provide 'work-db-7-gen)
;;; work-db-7-gen.el ends here
