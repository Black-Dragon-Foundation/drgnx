;; The I8 fuzz (docs/workbench.md): 50 built-in commands that display a buffer, each a form with
;; explicit arguments — never prompting, never touching the network.  Run one by one in a GUI
;; session with the left dock, the panel and the right dock open: no window may split or resize,
;; and every buffer must be routed by a rule.
((describe-function 'car)
 (describe-variable 'fill-column)
 (describe-key (kbd "C-f"))
 (describe-mode)
 (describe-bindings)
 (describe-face 'default)
 (describe-char (point-min))
 (describe-symbol 'car)
 (describe-syntax)
 (describe-categories)
 (describe-coding-system 'utf-8)
 (describe-language-environment "English")
 (describe-copying)
 (describe-no-warranty)
 (shortdoc-display-group 'string)
 (apropos-command "buffer-list")
 (apropos-variable "fill-column")
 (apropos "car-safe")
 (info "(emacs)Top")
 (info "(elisp)Cons Cells")
 (view-lossage)
 (view-echo-area-messages)
 (view-emacs-news)
 (list-buffers)
 (list-processes)
 (list-timers)
 (list-abbrevs)
 (list-character-sets nil)
 (list-colors-display)
 (list-faces-display)
 (list-command-history)
 (list-holidays 2026)
 (bookmark-bmenu-list)
 (finder-by-keyword)
 (ibuffer)
 (occur "Lisp")
 (compile "true")
 (grep "grep -n frobnicate /dev/null")
 (xref-find-references "car")
 (progn (flymake-mode 1) (flymake-show-buffer-diagnostics))
 (shell)
 (eshell)
 (ielm)
 (calendar)
 (ert "\\`drgnx-no-such-test\\'")
 (customize-group 'editing)
 (customize-variable 'fill-column)
 (proced)
 (dired temporary-file-directory)
 (find-file (expand-file-name "drgnx-fuzz.txt" temporary-file-directory)))
