(drgnx-theme :version 1 :name "high-contrast"
 ;; colours: #rrggbb, or #rrggbbaa with an alpha; from docs/specs/drgnx/the-look (the approved look)
 (gap "#000000")
 (editor "#000000")
 (panel "#000000")
 (raised "#0b0b0b")
 (overlay "#0b0b0b")
 (hover "#1a1a1a")
 (sel "#1f3a7a")
 (sel-quiet "#1a1a1a")
 (current-line "#0d0d0d")
 (fg "#ffffff")
 (muted "#d6d8de")
 (subtle "#bfc2ca")
 (disabled "#8c909a")
 (border "#8c909a")
 (border-subtle "#6b6f78")
 (border-strong "#c9ccd3")
 (accent "#a8c6ff")
 (accent-fill "#a8c6ff")
 (on-accent "#000000")
 (focus "#ffd36b")
 (ok "#7ff0ad")
 (warn "#ffd36b")
 (error "#ff9a92")
 (info "#8fdcff")
 (attention "#ffb38a")
 (ok-tint "#00000000")
 (warn-tint "#00000000")
 (error-tint "#00000000")
 (info-tint "#00000000")
 (attention-tint "#00000000")
 (accent-tint "#00000000")
 (add-bg "#0f2e1b")
 (del-bg "#3a1210")
 (add-fg "#b9f0b9")
 (del-fg "#ffc2bd")
 (kw "#dcc0ff")
 (fn "#a8c6ff")
 (str "#b9f0b9")
 (ty "#96ece6")
 (const "#ffc49c")
 (comment "#bfc2ca")
 (punct "#d6d8de")
 (a1 "#a8c6ff")
 (a2 "#ffc49c")
 (a3 "#b9f0b9")
 (a4 "#dcc0ff")
 (a5 "#ffb0d3")
 (a6 "#96ece6")
 ;; metrics: logical px
 (s1 4)
 (s2 8)
 (s3 12)
 (s4 16)
 (s6 24)
 (r-chip 4)
 (r-btn 6)
 (r-pop 8)
 (r-card 10)
 (r-modal 12)
 (row 26)
 (tab-h 34)
 (title-h 38)
 (status-h 24)
 (code-lh 21)
)
