(drgnx-tokens :version 1
 ;; one entry per token: (name kind "what it is"). The Token enum is generated from this file.
 (gap colour "the gap between panels, and the window behind them")
 (editor colour "the editor surface")
 (panel colour "a side panel or card surface")
 (raised colour "a raised surface: a popover, a menu")
 (overlay colour "a modal overlay, translucent")
 (hover colour "a hovered row or control")
 (sel colour "the selected row in the focused view")
 (sel-quiet colour "the selected row in an unfocused view")
 (current-line colour "the editor's current line")
 (fg colour "normal text")
 (muted colour "secondary text")
 (subtle colour "tertiary text and icons")
 (disabled colour "disabled text")
 (border colour "a border")
 (border-subtle colour "a quiet divider")
 (border-strong colour "a strong border, a keycap edge")
 (accent colour "the accent, as text or a line")
 (accent-fill colour "the accent as a fill")
 (on-accent colour "text on an accent fill")
 (focus colour "the focus ring")
 (ok colour "success")
 (warn colour "a warning")
 (error colour "an error")
 (info colour "information")
 (attention colour "something that needs the user")
 (ok-tint colour "success chip background")
 (warn-tint colour "warning chip background")
 (error-tint colour "error chip background")
 (info-tint colour "information chip background")
 (attention-tint colour "attention chip background")
 (accent-tint colour "accent chip background")
 (add-bg colour "an added line's background")
 (del-bg colour "a removed line's background")
 (add-fg colour "an added line's text")
 (del-fg colour "a removed line's text")
 (kw colour "syntax: keyword")
 (fn colour "syntax: function")
 (str colour "syntax: string")
 (ty colour "syntax: type")
 (const colour "syntax: constant")
 (comment colour "syntax: comment")
 (punct colour "syntax: punctuation")
 (a1 colour "agent colour 1")
 (a2 colour "agent colour 2")
 (a3 colour "agent colour 3")
 (a4 colour "agent colour 4")
 (a5 colour "agent colour 5")
 (a6 colour "agent colour 6")
 (s1 metric "spacing step 1 (logical px)")
 (s2 metric "spacing step 2")
 (s3 metric "spacing step 3")
 (s4 metric "spacing step 4")
 (s6 metric "spacing step 6")
 (r-chip metric "corner radius of a chip")
 (r-btn metric "corner radius of a button or row")
 (r-pop metric "corner radius of a popover")
 (r-card metric "corner radius of a card")
 (r-modal metric "corner radius of a modal")
 (row metric "the height of a list row")
 (tab-h metric "the height of the tab strip")
 (title-h metric "the height of the title bar")
 (status-h metric "the height of the status bar")
 (code-lh metric "the editor's line height")
)
