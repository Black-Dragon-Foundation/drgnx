(drgnx-theme :version 1 :name "light"
 ;; colours: #rrggbb, or #rrggbbaa with an alpha; from docs/specs/drgnx/the-look (the approved look)
 (gap "#dfe0e6")
 (editor "#ffffff")
 (panel "#f6f6f8")
 (raised "#ffffff")
 (overlay "#ffffffe6")
 (hover "#eeeff2")
 (sel "#dbe5fb")
 (sel-quiet "#ececf0")
 (current-line "#f7f8fa")
 (fg "#1c1e23")
 (muted "#545866")
 (subtle "#656977")
 (disabled "#a9adb8")
 (border "#dcdee4")
 (border-subtle "#e9eaee")
 (border-strong "#c2c5ce")
 (accent "#2c5fd4")
 (accent-fill "#2c5fd4")
 (on-accent "#ffffff")
 (focus "#2c5fd4")
 (ok "#1b7f45")
 (warn "#8a5d00")
 (error "#c22f28")
 (info "#0b6f99")
 (attention "#b8461a")
 (ok-tint "#1b7f451a")
 (warn-tint "#c48c0024")
 (error-tint "#c22f2817")
 (info-tint "#0b6f9917")
 (attention-tint "#b8461a1a")
 (accent-tint "#2c5fd41a")
 (add-bg "#1b7f4517")
 (del-bg "#c22f2814")
 (add-fg "#1b6b3a")
 (del-fg "#a3271f")
 (kw "#7a3ccf")
 (fn "#2255c2")
 (str "#2b7339")
 (ty "#0b7470")
 (const "#a5501a")
 (comment "#686c7a")
 (punct "#545866")
 (a1 "#2255c2")
 (a2 "#a5501a")
 (a3 "#2b7339")
 (a4 "#7a3ccf")
 (a5 "#b0306c")
 (a6 "#0b7470")
 ;; metrics: logical px
 (s1 4)
 (s2 8)
 (s3 12)
 (s4 16)
 (s6 24)
 (r-chip 4)
 (r-btn 6)
 (r-pop 8)
 (r-card 10)
 (r-modal 12)
 (row 26)
 (tab-h 34)
 (title-h 38)
 (status-h 24)
 (code-lh 21)
)
