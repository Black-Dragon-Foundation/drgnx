(drgnx-theme :version 1 :name "dark"
 ;; colours: #rrggbb, or #rrggbbaa with an alpha; from docs/specs/drgnx/the-look (the approved look)
 (gap "#0a0b0d")
 (editor "#15161a")
 (panel "#18191e")
 (raised "#1e1f25")
 (overlay "#1e1f25e6")
 (hover "#202128")
 (sel "#243150")
 (sel-quiet "#23252c")
 (current-line "#1a1b20")
 (fg "#e4e5ea")
 (muted "#a2a5b2")
 (subtle "#878b98")
 (disabled "#4f525d")
 (border "#2b2d35")
 (border-subtle "#212228")
 (border-strong "#3b3e49")
 (accent "#7aa5ff")
 (accent-fill "#3d6fe0")
 (on-accent "#ffffff")
 (focus "#7aa5ff")
 (ok "#62d394")
 (warn "#e9bc5c")
 (error "#f47a72")
 (info "#6fc6ea")
 (attention "#ff9566")
 (ok-tint "#62d3941f")
 (warn-tint "#e9bc5c21")
 (error-tint "#f47a7221")
 (info-tint "#6fc6ea1f")
 (attention-tint "#ff956626")
 (accent-tint "#7aa5ff24")
 (add-bg "#62d3941c")
 (del-bg "#f47a721c")
 (add-fg "#a3dba3")
 (del-fg "#f6a39d")
 (kw "#c6a0ff")
 (fn "#80b6ff")
 (str "#a3dba3")
 (ty "#7fd6d1")
 (const "#f2ac7e")
 (comment "#858996")
 (punct "#a2a5b2")
 (a1 "#80b6ff")
 (a2 "#f2ac7e")
 (a3 "#a3dba3")
 (a4 "#c6a0ff")
 (a5 "#f592bb")
 (a6 "#7fd6d1")
 ;; metrics: logical px
 (s1 4)
 (s2 8)
 (s3 12)
 (s4 16)
 (s6 24)
 (r-chip 4)
 (r-btn 6)
 (r-pop 8)
 (r-card 10)
 (r-modal 12)
 (row 26)
 (tab-h 34)
 (title-h 38)
 (status-h 24)
 (code-lh 21)
)
