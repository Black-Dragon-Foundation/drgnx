// The extension API: one WIT package, two hosts (WebAssembly components and Luau), both generated from this file.
// The rules (crates/ext/mal-gen): only bool, integers, floats, string, enum and `result<T?, enum>` are used so far; a
// 64-bit integer is exact up to 2^53 in Luau; a function that can fail returns `result<_, error-kind>`. Anything
// changed or removed here needs a version bump (the xtask's wit-check).
package drgnx:api@0.1.0;

/// The kinds of failure every interface shares (villa's wire names).
interface types {
  enum error-kind {
    not-found,
    conflict,
    unavailable,
    refused,
    invalid,
    cancelled,
    internal,
  }
}

/// The command registry (bod): what an extension offers and what it can run.
interface commands {
  use types.{error-kind};

  /// Offer a command: its id, the title the palette shows, and its doc.
  register: func(id: string, title: string, doc: string) -> result<_, error-kind>;
  /// Run a command by id with its arguments as one JSON text; the result is JSON text too.
  run: func(id: string, args: string) -> result<string, error-kind>;
  /// Where a command is defined, as `file:line`.
  find-source: func(id: string) -> result<string, error-kind>;
}

/// The key engine (lykill): chords as text (`C-x C-f`), contexts as the design's expression.
interface keys {
  use types.{error-kind};

  /// Bind a chord to a command where the context expression holds (an empty context binds everywhere).
  bind: func(chord: string, command: string, context: string) -> result<_, error-kind>;
  /// The command id a chord resolves to in a context, or `prefix` when more keys are needed.
  resolve: func(chord: string, context: string) -> result<string, error-kind>;
}

/// The settings stack (skipan). An extension sets the scoped levels only: the user's files and the built-in level are not
/// its to change.
interface settings {
  use types.{error-kind};

  /// The levels that belong to one stream, language, document or pane.
  enum scoped-level {
    %stream,
    language,
    document,
    pane,
  }

  /// A setting's value as JSON text.
  get: func(key: string) -> result<string, error-kind>;
  /// Set a setting, as JSON text, at a scoped level for the stream, language, document or pane named SCOPE-ID.
  set: func(key: string, value: string, at: scoped-level, scope-id: string) -> result<_, error-kind>;
  /// Why the setting has its value: the level and, for a file, `file:line`.
  provenance: func(key: string) -> result<string, error-kind>;
}

/// The one non-blocking question API (spurn). Choices are separated by newlines until lists are supported.
interface ask {
  use types.{error-kind};

  /// Ask: the call returns the question's id at once and never waits. The answer comes later, to `entry.answered`. The
  /// timeout is in milliseconds, from 1 to 300000: an extension's question always has one; at its end the default is the
  /// answer.
  choose: func(title: string, body: string, choices: string, default-choice: string, timeout-ms: u32) -> result<u64, error-kind>;
}

/// Notices (tidindi): the same key updates a notice instead of adding one. Keys and ids belong to the extension that
/// posted them: another extension's notice cannot be touched.
interface notices {
  use types.{error-kind};

  enum level {
    info,
    warning,
    error,
  }

  /// Post a notice; the result is its id.
  post: func(at: level, title: string, body: string, key: string) -> result<u64, error-kind>;
  /// Remove one of the caller's own notices by its id.
  dismiss: func(id: u64) -> result<_, error-kind>;
}

/// Declared empty until the editing model lands.
interface buffers {}

/// Declared empty until the editing model lands.
interface views {}

interface entry {
  use types.{error-kind};

  /// Called once after instantiation: the extension registers its commands.
  init: func();
  /// Run a command the extension registered.
  run: func(name: string) -> result<_, error-kind>;
  /// An answer to a question the extension asked with `ask.choose`.
  answered: func(question: u64, choice: string);
}

world extension {
  import types;
  import commands;
  import keys;
  import settings;
  import ask;
  import notices;
  import buffers;
  import views;
  export entry;
}
