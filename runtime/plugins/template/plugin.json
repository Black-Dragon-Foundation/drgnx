{
  "name": "my-plugin",
  "version": "0.1.0",
  "abilities": [
    {
      "name": "shout",
      "description": "Returns the text it is given, in capitals.",
      "input_schema": {
        "type": "object",
        "properties": {"text": {"type": "string"}},
        "required": ["text"],
        "additionalProperties": false
      }
