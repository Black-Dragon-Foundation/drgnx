  ],
  "hooks": [
    {
      "point": "before-tool",
      "verdicts": ["deny", "annotate"],
      "filter": {"tool_kinds": ["execute"]},
      "deadline_ms": 500
    }
  ],
  "hosts": [],
  "kv_bytes": 65536
}
