#!/usr/bin/env bash
# drgnx — command-line entry point (pre-release).
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
. "$here/bin/drgnx-paths.sh"   # drgnx_dir KIND: where drgnx keeps its files (as core/drgnx-paths.el)

emacs_bin() { # the one Emacs every subcommand runs in: $DRGNX_EMACS, else the one install.sh recorded (an absolute path), else PATH's nidhogg, else an error (never a bare emacs)
  if [[ -n "${DRGNX_EMACS:-}" ]]; then printf '%s\n' "$DRGNX_EMACS"; return; fi
  local file line
  # the record is machine-local, so it lives in the data dir; the config dir's is where older installs wrote it
  for file in "$(drgnx_dir data)/emacs" "$(drgnx_dir config)/emacs"; do
    [[ -f "$file" ]] || continue   # first line only, as a path: never evaluated
    line=""
    IFS= read -r line <"$file" || true
    line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
    if [[ "$line" == /* && -f "$line" && -x "$line" ]]; then printf '%s\n' "$line"; return; fi
  done
  if command -v nidhogg >/dev/null 2>&1; then echo nidhogg; return; fi
  echo "drgnx: no Nidhogg found (not on PATH, none recorded): run install.sh, or set DRGNX_EMACS" >&2
  return 1
}

emacsclient_bin() { # the emacsclient of emacs_bin's Emacs: beside it (Emacs.app: Contents/MacOS/bin/), else PATH's
  local emacs real dir
  emacs="$(emacs_bin)"
  [[ "$emacs" == */* ]] || emacs="$(command -v "$emacs" 2>/dev/null || true)"
  if [[ -n "$emacs" ]]; then
    real="$(readlink -f "$emacs" 2>/dev/null || true)"
    for dir in "${emacs%/*}" "${real%/*}"; do
      [[ -n "$dir" ]] || continue
      if [[ -x "$dir/emacsclient" ]]; then printf '%s\n' "$dir/emacsclient"; return; fi
      if [[ -x "$dir/bin/emacsclient" ]]; then printf '%s\n' "$dir/bin/emacsclient"; return; fi
    done
  fi
  echo emacsclient
}

cmd_doctor() { # [--json] [--dev] — checks run inside the Emacs drgnx uses (core/drgnx-doctor.el)
  local emacs rc=0
  emacs="$(emacs_bin 2>/dev/null)" || emacs=nidhogg   # none found: the check below says so
  if ! command -v "$emacs" >/dev/null 2>&1; then
    printf 'FAIL  %-20s %s\n      fix: %s\n' "emacs" "no Emacs found ($emacs)" \
      "run the installer: curl -fsSL https://raw.githubusercontent.com/Black-Dragon-Foundation/drgnx/main/install.sh | bash  (see docs/guide/install.md)"
    return 1
  fi
  "$emacs" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" -l drgnx-doctor -f drgnx-doctor-cli "$@" || rc=1
  if [[ " $* " == *" --dev "* && " $* " != *" --json "* ]]; then
    local env rt launcher
    env="$(env_eval '(drgnx-env-container)')"
    rt="${DRGNX_CONTAINER:-$(env_eval '(drgnx-env-container-runtime)')}"   # set: no host Emacs needed (CI)
    launcher="$("$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/harness" -l drgnx-ui --eval '(princ (drgnx-ui-launcher))')"
    printf 'INFO  %-20s %s\n' "environment" "${env:-host}" "container-runtime" "${rt:-none}" \
      "session-launcher" "$launcher$([ "$launcher" = detached ] && echo ' (process group, no systemd unit)')"
  fi
  return "$rc"
}

cmd_build() { # byte-compile core/, wb/, modules/ in place (core/drgnx-build.el)
  "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" -l drgnx-build -f drgnx-build-cli
}

ui() { # the harness controller, in batch Emacs (harness/drgnx-ui.el)
  "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/harness" -L "$here/core" -L "$here/wb" \
        -l drgnx-ui -f drgnx-ui-cli -- "$@"
}

ui_exec() { # ui, as the Emacs itself (run_in_tmp signals and waits for that process, not for a subshell around it)
  exec "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/harness" -L "$here/core" -L "$here/wb" \
        -l drgnx-ui -f drgnx-ui-cli -- "$@"
}

run_in_tmp() { # CMD… — run CMD with a TMPDIR of its own (so temporary-file-directory and libgccjit use it); on every exit
  # (end, error, INT, TERM, HUP) CMD and what it started are stopped and the directory removed: /tmp is RAM, a run leaves nothing
  # there.  The runner (harness/run-ert.el) is told the directory in DRGNX_RUN_TMP and never deletes it: only this trap does.
  # --shards (see run_in_tmp_shards): the children make dirs of their own in it instead.
  local shards=""
  if [[ "${1:-}" == --shards ]]; then shards=1; shift; fi
  RUN_TMP="" RUN_PID=""
  trap run_tmp_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  RUN_TMP="$(mktemp -d "${TMPDIR:-/tmp}/drgnx-run.XXXXXX")"
  RUN_TMP="$(cd "$RUN_TMP" && pwd -P)"      # absolute, whatever TMPDIR was
  local rc=0
  set -m                                    # the child leads a process group of its own: signalled as a whole
  ( export TMPDIR="$RUN_TMP" DRGNX_RUN_TMP="$RUN_TMP"
    if [[ -n "$shards" ]]; then unset DRGNX_RUN_TMP; fi
    "$@" ) <&0 &                            # not exec'd: this shell stays to clean up
  RUN_PID=$!
  set +m
  wait "$RUN_PID" || rc=$?
  RUN_PID=""
  return "$rc"
}

run_in_tmp_shards() { # CMD… — like run_in_tmp, for a CMD that starts several test runs (drgnx check): each makes its own dir in it
  run_in_tmp --shards "$@"
}

run_tmp_cleanup() {
  local i grace="${DRGNX_RUN_GRACE:-30}"
  trap '' INT TERM HUP                      # a second signal does not cut the cleanup short
  [[ "$grace" =~ ^[0-9]+$ ]] || grace=30
  if [[ -n "${RUN_PID:-}" ]]; then
    # TERM to the group, then the command itself gets $DRGNX_RUN_GRACE s (default 30) to end: it stops what it
    # started outside the group (check's jobs: up to 15 s; the GUI tiers' sessions: ~8 s each) before we
    # KILL what is left and delete the directory those still use.
    kill -TERM -- "-$RUN_PID" 2>/dev/null || true
    for ((i = 0; i < grace * 10; i++)); do kill -0 "$RUN_PID" 2>/dev/null || break; sleep 0.1; done
    kill -KILL -- "-$RUN_PID" 2>/dev/null || true
    wait "$RUN_PID" 2>/dev/null || true
  fi
  if [[ -n "${RUN_TMP:-}" ]]; then run_tmp_stop_pause; rm -rf -- "$RUN_TMP"; fi
  return 0
}

run_tmp_stop_pause() { # Rootless podman run by a test under the run's private XDG_RUNTIME_DIR finds no pause process
  # (it looks for RUNTIME/libpod/tmp/pause.pid), so it starts a `catatonit -P' of its own, in a `podman-pause-*.scope'
  # of its own, that outlives the run (TEST-PODMAN-PAUSE-1).  Stop exactly the ones this run made: the pid files under
  # RUN_TMP, only when the pid is a catatonit.  Never another catatonit (the user's has its pid file in their runtime dir).
  local f pid
  while IFS= read -r f; do
    pid="$(head -n1 -- "$f" 2>/dev/null)"
    [[ "$pid" =~ ^[0-9]+$ ]] && [[ "$(cat "/proc/$pid/comm" 2>/dev/null)" == catatonit ]] && kill -TERM "$pid" 2>/dev/null
  done < <(find "$RUN_TMP" -path '*/libpod/tmp/pause.pid' -type f 2>/dev/null)
  # Rootless podman storage holds sub-UID files a plain rm -rf cannot remove (it stops half way, gigabytes stay in /tmp):
  # only under RUN_TMP, only when there is some.
  if command -v podman >/dev/null 2>&1; then
    while IFS= read -r f; do podman unshare rm -rf -- "$f" >/dev/null 2>&1 || true
    done < <(find "$RUN_TMP" -maxdepth 6 -type d -name containers \( -path '*/.local/share/containers' -o -path '*/xdg-data/containers' \) -prune -print 2>/dev/null)
  fi
  return 0
}

check_emacs() { # the CI check (core/drgnx-check.el); exec'd, see ui_exec
  exec "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" \
        -l drgnx-check -f drgnx-check-cli -- "$@"
}

test_batch_emacs() { # [FUNCTION ARGS…] — SIGPIPE ignored, as the hub runs (tests serve one in-process): a test may fail, never end the run
  local fn="${1:-drgnx-run-ert-batch}"; shift || true   # --find-polluter runs its own entry point of the runner
  trap '' PIPE
  # The unit tier never reaches the user's desktop: dbus.el connects to the bus in the C environment (a dead
  # address, so nothing answers), no display or compositor socket, a runtime directory of its own.
  # (The runner binds the same inside Emacs, for Lisp code and the children it starts.)
  local run="${TMPDIR:-/tmp}/run"; mkdir -p "$run" && chmod 700 "$run"
  # DRGNX_TEST_DIR: a smaller suite (the test of the temp-dir cleanup runs one)
  exec env -u DISPLAY -u WAYLAND_DISPLAY -u SWAYSOCK -u I3SOCK -u HYPRLAND_INSTANCE_SIGNATURE -u NIRI_SOCKET \
       DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent/drgnx-unit-test XDG_RUNTIME_DIR="$run" \
       "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/harness" -L "$here/core" -L "$here/wb" \
       -l "$here/harness/run-ert.el" \
       -f "$fn" "${@:-${DRGNX_TEST_DIR:-$here/test/unit}}"
}

test_batch() { run_in_tmp test_batch_emacs; }

test_tty_emacs() { # the terminal tier (test/tty): each file in an Emacs of its own, SIGPIPE ignored as test_batch_emacs;
  # its sessions run in private tmux servers (harness/drgnx-tty-session.el, which start Emacs with `env -i'); this Emacs
  # never reaches the user's desktop either: a dead session bus (dbus.el reads the C environment), no display or compositor
  trap '' PIPE
  exec env -u DISPLAY -u WAYLAND_DISPLAY -u SWAYSOCK -u I3SOCK -u HYPRLAND_INSTANCE_SIGNATURE -u NIRI_SOCKET \
       DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent/drgnx-unit-test \
       "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/harness" -L "$here/core" -L "$here/wb" \
       -l "$here/harness/run-ert.el" -f drgnx-run-ert-batch "$here/test/tty"
}

test_tty() { run_in_tmp test_tty_emacs; }

env_eval() { # FORM — evaluate with harness/drgnx-env.el loaded, print the result
  "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/harness" -l drgnx-env --eval "(princ (or $1 \"\"))"
}

test_container() { # [--ui [--compositor C] | --scenario | --perf | --tty [--fedora 45]] — the batch (GUI, scenario, perf, terminal) tier inside a fedora:45 / Nidhogg 31.1 container
  # DRGNX_TEST_IMAGE / DRGNX_TEST_GUI_IMAGE / DRGNX_TEST_TTY_IMAGE: use that image (CI pulls a prebuilt one) instead of building it
  # --tty --fedora 45 (the default): Fedora 44's Emacs is 30.2, which drgnx no longer supports
  local rt mount image file elpa prebuilt="${DRGNX_TEST_IMAGE:-}" args=() cmd=(bin/drgnx test) build=() tier="" fedora="" compositor=""
  while (($#)); do
    case "$1" in
      --ui|--tty|--scenario|--perf)
        if [[ -n "$tier" && "$tier" != "${1#--}" ]]; then echo "drgnx: test --container takes one of --ui, --scenario, --perf, --tty" >&2; return 2; fi
        tier="${1#--}" ;;
      --fedora) fedora="${2:-?}"; if (($# > 1)); then shift; fi ;;
      --compositor) compositor="${2:-}"; ui_compositor_ok "$compositor" || return 2; shift ;;
      *) echo "drgnx: unknown option for test --container: $1 (--ui [--compositor C] | --scenario | --perf | --tty [--fedora 45])" >&2; return 2 ;;
    esac
    shift
  done
  if [ -n "$fedora" ] && { [ "$tier" != tty ] || [[ ! "$fedora" =~ ^45$ ]]; }; then
    echo "drgnx: --fedora 45 goes with --tty (the terminal tier's image); got: $fedora" >&2; return 2
  fi
  if [ -n "$compositor" ] && [ "$tier" != ui ]; then
    echo "drgnx: --compositor goes with --ui (the GUI tier)" >&2; return 2
  fi
  rt="${DRGNX_CONTAINER:-$(env_eval '(drgnx-env-container-runtime)')}"   # set: no host Emacs needed (CI)
  [ -n "$rt" ] || { echo "drgnx: no container runtime found (podman, docker, nerdctl); set DRGNX_CONTAINER" >&2; return 1; }
  mount="$here:/src:ro"; [ "$rt" = podman ] && mount="$mount,Z"
  image=drgnx-test:f45; file=Containerfile
  if [ "$tier" = ui ] || [ "$tier" = scenario ] || [ "$tier" = perf ]; then   # the GUI image: sessions under headless mutter
    image=drgnx-test-gui:f45; file=Containerfile.gui; cmd=(bin/drgnx test --ui); prebuilt="${DRGNX_TEST_GUI_IMAGE:-}"
    [ "$tier" = scenario ] && cmd=(bin/drgnx test --scenario --config drgnx)
    [ "$tier" = perf ] && cmd=(bin/drgnx test --perf)
    local comp="${DRGNX_UI_COMPOSITOR:-}"
    if [ -n "$compositor" ]; then cmd+=(--compositor "$compositor"); comp="$compositor"; fi
    # KWin and niri are in an image of their own (Containerfile.wm); DRGNX_TEST_WM_IMAGE: a prebuilt one
    case "$comp" in kwin|niri) image=drgnx-test-wm:f45; file=Containerfile.wm; prebuilt="${DRGNX_TEST_WM_IMAGE:-}" ;; esac
    # --memory: a GUI run (sessions, compositors, the X11 Emacs) must never push the host into the OOM killer;
    # --memory-swap the same: no swap on top.  DRGNX_TEST_GUI_MEMORY (default 3g) for a bigger run
    local mem="${DRGNX_TEST_GUI_MEMORY:-3g}"
    args=(--memory "$mem" --memory-swap "$mem" --security-opt seccomp=unconfined --security-opt label=disable)
    mount="$here:/src:ro"
    if [ -n "${DRGNX_UI_COMPOSITOR:-}" ]; then args+=(-e "DRGNX_UI_COMPOSITOR=$DRGNX_UI_COMPOSITOR"); fi
  elif [ "$tier" = tty ]; then
    fedora="${fedora:-45}"
    image="drgnx-test-tty:f$fedora"; file=Containerfile.tty; cmd=(bin/drgnx test --tty); prebuilt="${DRGNX_TEST_TTY_IMAGE:-}"
    build=(--build-arg "FEDORA=$fedora")
    args=(--security-opt seccomp=unconfined --security-opt label=disable --memory 3g)   # the GUI tier's options; tmux and Emacs sessions
    mount="$here:/src:ro"
    # packages the key and popup tests load (kkp, corfu), read-only; without them those tests skip
    if [ -n "${DRGNX_USER_ELPA:-}" ] && [ -d "$DRGNX_USER_ELPA" ]; then
      elpa="$(cd "$DRGNX_USER_ELPA" && pwd)"
      # a `:' would split -v's SOURCE:TARGET:OPTIONS (and could add options)
      case "$elpa" in *:*) echo "drgnx: DRGNX_USER_ELPA must not contain ':' (it is mounted with -v): $elpa" >&2; return 2 ;; esac
      args+=(-v "$elpa:/elpa:ro" -e DRGNX_USER_ELPA=/elpa)
    fi
  fi
  echo "container runtime: $rt" >&2
  if [ -n "$prebuilt" ]; then
    # an image reference, never an option: it follows the run's options on the command line
    [[ $prebuilt =~ ^[A-Za-z0-9][A-Za-z0-9._/:@-]*$ ]] || { echo "drgnx: '$prebuilt' is not an image reference" >&2; return 2; }
    image="$prebuilt"; echo "image: $image (prebuilt)" >&2
  else
    # an image build is capped too: an uncapped one once pushed the host into the OOM killer
    # (DRGNX_TEST_BUILD_MEMORY, default 3g; podman only, as docker's buildx ignores --memory)
    local bmem="${DRGNX_TEST_BUILD_MEMORY:-3g}" bargs=()
    [ "$rt" = podman ] && bargs=(--memory "$bmem" --memory-swap "$bmem")
    "$rt" build ${bargs[@]+"${bargs[@]}"} -q -t "$image" ${build[@]+"${build[@]}"} -f "$here/test/container/$file" "$here/test/container" >/dev/null
  fi
  # the run-control variables go in with their values when set: a narrowed run stays narrow, the files run at once
  # (CI: the runner's cores), a failed file reruns once, wall clock is skipped, the perf run's results and factors
  local v pass=(DRGNX_TEST_SELECTOR DRGNX_TEST_JOBS DRGNX_TEST_RERUN DRGNX_TEST_NO_TIMING DRGNX_PERF_RESULTS
                DRGNX_PERF_CPU_FACTOR DRGNX_PERF_WORKLOADS DRGNX_UITEST_SETTLE_SCALE)
  for v in "${pass[@]}"; do
    [ "$v" = DRGNX_PERF_RESULTS ] && continue   # below: the checkout is read-only, so the file goes through a mount
    if [ -n "${!v:-}" ]; then args+=(-e "$v=${!v}"); fi
  done
  if [ -n "${DRGNX_PERF_RESULTS:-}" ]; then   # FILE on the host (relative: to here), written through /out
    local res="$DRGNX_PERF_RESULTS" resdir
    case "$res" in /*) ;; *) res="$PWD/$res" ;; esac
    resdir="$(dirname "$res")"; mkdir -p "$resdir"; resdir="$(cd "$resdir" && pwd -P)"
    case "$resdir" in *:*) echo "drgnx: DRGNX_PERF_RESULTS must not be under a directory with ':' (it is mounted with -v): $resdir" >&2; return 2 ;; esac
    args+=(-v "$resdir:/out" -e "DRGNX_PERF_RESULTS=/out/$(basename "$res")")
  fi
  # Ratatoskr for the client's binary tests: one in this checkout is seen at /src, any other is mounted read-only
  if [ -n "${DRGNX_RATATOSKR_BIN:-}" ] && [ -x "$DRGNX_RATATOSKR_BIN" ]; then
    local rbin; rbin="$(cd "$(dirname "$DRGNX_RATATOSKR_BIN")" && pwd -P)/$(basename "$DRGNX_RATATOSKR_BIN")"
    case "$rbin" in
      "$(cd "$here" && pwd -P)"/*) args+=(-e "DRGNX_RATATOSKR_BIN=/src/${rbin#"$(cd "$here" && pwd -P)"/}") ;;
      *:*) echo "drgnx: DRGNX_RATATOSKR_BIN must not contain ':' (it is mounted with -v): $rbin" >&2; return 2 ;;
      *) args+=(-v "$rbin:/opt/ratatoskr/ratatoskr:ro" -e DRGNX_RATATOSKR_BIN=/opt/ratatoskr/ratatoskr) ;;
    esac
  fi
  args+=(-e DRGNX_LEASE=off)   # the host's lease is not the container's: one run owns it
  # the image's own Emacs, named: drgnx never falls back to a bare `emacs' (Nidhogg, which test/container/nidhogg.sh links
  # into /usr/local/bin; the Containerfiles' ENV names the same build)
  args+=(-e DRGNX_EMACS=/usr/local/bin/emacs)
  # evil for the modal tests (DRGNX_MODAL_ELPA), read-only; ,z: a shared label, other containers may read it too
  if [ -n "${DRGNX_MODAL_ELPA:-}" ] && [ -d "$DRGNX_MODAL_ELPA" ]; then
    local elpa; elpa="$(cd "$DRGNX_MODAL_ELPA" && pwd -P):/modal-elpa:ro"
    [ "$rt" = podman ] && [ "${1:-}" != --ui ] && elpa="$elpa,z"
    args+=(-v "$elpa" -e DRGNX_MODAL_ELPA=/modal-elpa)
  fi
  "$rt" run --rm ${args[@]+"${args[@]}"} -v "$mount" -w /src "$image" "${cmd[@]}"
}

INSTALL_IMAGES=( # name=image; source builds first (slow), then distribution packages
  fedora-44=registry.fedoraproject.org/fedora:44
  debian-trixie=docker.io/library/debian:trixie
  ubuntu-26.04=docker.io/library/ubuntu:26.04
  fedora-45=registry.fedoraproject.org/fedora:45
  archlinux=docker.io/library/archlinux:latest
)

test_snapshot() { # DIR — a snapshot of the working tree (edits during a run cannot reach it), committed and bundled so the
  # containers clone and update drgnx the way users do: DRGNX_INSTALL_REPO=/src/drgnx.bundle
  local snap="$1"
  rm -rf "$snap" && mkdir -p "$snap"
  (cd "$here" && git ls-files -z -co --exclude-standard | tar --null -T - -cf -) | tar -C "$snap" -xf -
  git -C "$snap" init -q -b main
  git -C "$snap" add -A
  git -C "$snap" -c user.name=drgnx-test -c user.email=test@drgnx.invalid commit -q -m snapshot
  git -C "$snap" bundle create -q "$snap/drgnx.bundle" main
}

test_time_limit() { # SECONDS — sets limit (the caller's array): timeout (GNU coreutils), gtimeout (Homebrew's coreutils on macOS), else none
  # -k 30: a container client that ignores the TERM is killed 30 s later (test_run then removes its container)
  if command -v timeout >/dev/null 2>&1; then limit=(timeout -k 30 "$1")
  elif command -v gtimeout >/dev/null 2>&1; then limit=(gtimeout -k 30 "$1")
  else echo "drgnx: neither timeout nor gtimeout found (macOS: brew install coreutils): running without a time limit" >&2; fi
}

test_names=() test_rt=""
test_remove_containers() { # [NAME…] — remove these containers (default: every one this run started), running or not
  local name
  (($#)) || set -- ${test_names[@]+"${test_names[@]}"}
  for name in "$@"; do
    if [ "$test_rt" = podman ]; then "$test_rt" rm -f -t 0 "$name" >/dev/null 2>&1 || true
    else "$test_rt" rm -f "$name" >/dev/null 2>&1 || true; fi
  done
}

test_run() { # NAME RUN-ARG… — "$rt" run --rm --name NAME RUN-ARG… within the caller's limit, then the container removed.
  # The container's bash (PID 1) ignores the TERM a time-out or Ctrl-C makes podman forward, so it is removed by name:
  # after the run, and on any exit of this script.  The run waits in the background: bash runs a trap only after a
  # foreground child ends, and timeout leaves the terminal's process group, so Ctrl-C would otherwise wait for the hour.
  local name="$1" rc=0; shift
  test_rt="$rt"; test_names+=("$name")
  trap test_remove_containers EXIT; trap 'exit 130' INT; trap 'exit 143' TERM
  ${limit[@]+"${limit[@]}"} "$rt" run --rm --name "$name" "$@" &
  wait "$!" || rc=$?
  test_remove_containers "$name"
  return "$rc"
}

test_install() { # [NAME…] — install.sh end to end in fresh containers (slow: source builds take ~10 min each)
  local rt names=("$@") entry name image log logs failed=() known=()
  for entry in "${INSTALL_IMAGES[@]}"; do known+=("${entry%%=*}"); done
  ((${#names[@]})) || names=("${known[@]}")
  for name in "${names[@]}"; do
    [[ " ${known[*]} " == *" $name "* ]] || { echo "drgnx: unknown image $name (known: ${known[*]})" >&2; return 2; }
  done
  rt="${DRGNX_CONTAINER:-$(env_eval '(drgnx-env-container-runtime)')}"   # set: no host Emacs needed (CI)
  [ -n "$rt" ] || { echo "drgnx: no container runtime found (podman, docker, nerdctl); set DRGNX_CONTAINER" >&2; return 1; }
  logs="$(drgnx_dir state)/install-tests"
  local snap="$logs/src"
  test_snapshot "$snap"
  local limit=()   # an hour per image: timeout (GNU coreutils), gtimeout (Homebrew's coreutils on macOS), else none
  test_time_limit 3600
  local nidhogg=()   # DRGNX_INSTALL_NIDHOGG_REPO (a local directory) and _COMMIT: Nidhogg from there, not from GitHub
  if [[ -d "${DRGNX_INSTALL_NIDHOGG_REPO:-}" ]]; then
    nidhogg=(-v "$DRGNX_INSTALL_NIDHOGG_REPO:/nidhogg-src:ro" -e DRGNX_INSTALL_NIDHOGG_REPO=/nidhogg-src)
    [ "$rt" = podman ] && nidhogg+=(--security-opt label=disable)
    if [[ -n "${DRGNX_INSTALL_NIDHOGG_COMMIT:-}" ]]; then nidhogg+=(-e "DRGNX_INSTALL_NIDHOGG_COMMIT=$DRGNX_INSTALL_NIDHOGG_COMMIT"); fi
  fi
  for name in "${names[@]}"; do
    for entry in "${INSTALL_IMAGES[@]}"; do [[ "${entry%%=*}" == "$name" ]] && image="${entry#*=}"; done
    log="$logs/$name.log"
    printf '%-14s %s … ' "$name" "$image" >&2
    # --memory: a test must never push the host into the OOM killer (install.sh sizes make -j from the limit)
    if test_run "drgnx-install-$$-$name" --memory 6g -v "$snap:/src:ro$([ "$rt" = podman ] && echo ,Z)" ${nidhogg[@]+"${nidhogg[@]}"} "$image" \
         bash /src/test/install/in-container.sh >"$log" 2>&1; then
      echo "ok" >&2
    else
      echo "FAILED (log: $log)" >&2; failed+=("$name")
    fi
  done
  ((${#failed[@]} == 0)) || { echo "install tests failed: ${failed[*]}" >&2; return 1; }
}

ui_compositor_ok() { # C — is C a compositor a GUI session can run under (harness/drgnx-ui.el)?
  case "$1" in
    mutter|sway|x11|i3|kwin|niri) return 0 ;;
    *) echo "drgnx: --compositor takes mutter, sway, x11, i3, kwin or niri, not '$1'" >&2; return 1 ;;
  esac
}

test_bootstrap() { # [--fedora 44|45] — the exit test of a second machine: one command on a fresh Fedora reaches a green doctor
  # Container 1 makes the encrypted key bundle (age) and commits it into a bare copy of the fixture configuration;
  # container 2, a fresh Fedora with only what a desktop has, runs install.sh --yes --config … --identity … and checks
  # the outcome (test/bootstrap/in-container.sh; docs/develop/harness.md).  Fedora 44 builds Emacs from source (slow).
  local rt fedora=45 logs snap fixture log image rcc=0 mount tmproot home
  while (($#)); do
    case "$1" in
      --fedora) fedora="${2:-}"; shift; shift || true ;;
      *) echo "usage: drgnx test --bootstrap [--fedora 44|45]" >&2; return 2 ;;
    esac
  done
  [[ "$fedora" == 44 || "$fedora" == 45 ]] || { echo "drgnx: --fedora is 44 or 45, not '$fedora'" >&2; return 2; }
  rt="${DRGNX_CONTAINER:-$(env_eval '(drgnx-env-container-runtime)')}"   # set: no host Emacs needed (CI)
  [ -n "$rt" ] || { echo "drgnx: no container runtime found (podman, docker, nerdctl); set DRGNX_CONTAINER" >&2; return 1; }
  # a test never touches the user's home: the snapshot, the configuration, the keys' scratch and the logs live in a fresh
  # temporary directory (kept when the run fails, so the log can be read; the run says where)
  tmproot="$(cd -P "${TMPDIR:-/tmp}" 2>/dev/null && pwd -P)" || { echo "drgnx: TMPDIR '${TMPDIR:-/tmp}' is not a directory" >&2; return 1; }
  home="$(cd -P "${HOME:-/nonexistent}" 2>/dev/null && pwd -P)" || home=
  if [ -n "$home" ] && [[ "$tmproot/" == "$home"/* ]]; then
    echo "drgnx: test --bootstrap refuses to run under \$HOME ($tmproot): set TMPDIR to a directory outside your home" >&2; return 1
  fi
  logs="$(mktemp -d "$tmproot/drgnx-bootstrap.XXXXXX")" || return 1
  snap="$logs/src" fixture="$logs/config" log="$logs/f$fedora.log"
  image="registry.fedoraproject.org/fedora:$fedora"
  mount="$snap:/src"; [ "$rt" = podman ] && mount="$mount:Z"
  test_snapshot "$snap"
  chmod -R a+rX "$snap"   # container 2 reads it as another user (a file written by an atomic rename, like the lock, is mode 600)
  # the configuration being carried over: the fixture with the current lock, a git repository, cloned --bare beside the
  # snapshot (a git host's copy: the second machine clones it, container 1 adds the encrypted keys to it)
  mkdir -p "$fixture"
  cp -R "$here/test/fixtures/bootstrap/config/." "$fixture/"
  cp "$here/etc/drgnx.lock.eld" "$fixture/drgnx.lock.eld"
  git -C "$fixture" init -q -b main
  git -C "$fixture" add -A
  git -C "$fixture" -c user.name=drgnx-test -c user.email=test@drgnx.invalid -c commit.gpgsign=false -c core.hooksPath=/dev/null commit -q -m config
  git clone -q --bare "$fixture" "$snap/config.git"
  local limit=()
  test_time_limit 3600
  # --memory: a test must never push the host into the OOM killer (install.sh sizes make -j from the limit); no swap beyond it
  printf 'bootstrap  fedora %s: the keys (container 1) … ' "$fedora" >&2
  if ! test_run "drgnx-bootstrap-$$-keys" --memory 3g --memory-swap 3g -v "$mount" "$image" \
         bash /src/test/bootstrap/make-secrets.sh >"$log" 2>&1; then
    echo "FAILED (log: $log)" >&2; tail -n 25 "$log" >&2; return 1
  fi
  echo "ok" >&2
  printf 'bootstrap  fedora %s: a second machine (container 2) … ' "$fedora" >&2
  mount="${mount%:Z}:ro"; [ "$rt" = podman ] && mount="$mount,Z"
  test_run "drgnx-bootstrap-$$-machine" --memory 6g --memory-swap 6g -v "$mount" "$image" \
    bash /src/test/bootstrap/in-container.sh >>"$log" 2>&1 || rcc=$?
  if ((rcc == 0)); then echo "ok" >&2; rm -rf "$logs"
  else echo "FAILED (exit $rcc; log: $log)" >&2; tail -n 25 "$log" >&2; return 1; fi
}

stress_loops_stop() { # the busy loops this stress run started (their pids, in STRESS_LOOPS): ended with it, on every exit
  local p
  for p in ${STRESS_LOOPS[@]+"${STRESS_LOOPS[@]}"}; do kill "$p" 2>/dev/null || true; done
  for p in ${STRESS_LOOPS[@]+"${STRESS_LOOPS[@]}"}; do wait "$p" 2>/dev/null || true; done
  STRESS_LOOPS=()
}

stress_run() { # N LOAD [TIER-FLAG ARGS…] — N runs of the selected tests beside LOAD busy loops (runs inside run_in_tmp)
  local n="$1" load="$2" i k fails=0 out names
  shift 2
  STRESS_LOOPS=()
  trap stress_loops_stop EXIT
  trap 'exit 143' TERM
  trap 'exit 130' INT
  trap 'exit 129' HUP
  # $0 of each loop names it (and DRGNX_STRESS_TAG, for a test that counts its own): the loops are found by that
  for ((k = 0; k < load; k++)); do
    sh -c 'while :; do :; done' "drgnx-stress-loop${DRGNX_STRESS_TAG:+ $DRGNX_STRESS_TAG}" &
    STRESS_LOOPS+=("$!")
  done
  if (($# == 0)); then
    # the unit tier: the runner repeats it (harness/run-ert.el, drgnx-run-ert-stress) and counts per test
    # (a subshell: test_batch_emacs execs, and this shell must stay to end the loops)
    (DRGNX_TEST_STRESS="$n" DRGNX_TEST_LOAD="$load" test_batch_emacs drgnx-run-ert-stress-batch "${DRGNX_TEST_DIR:-$here/test/unit}")
    return
  fi
  # a GUI, terminal or scenario tier: one session for each repeat; the failed tests are the FAILED lines of its output
  names="$(mktemp)"
  for ((i = 1; i <= n; i++)); do
    out="$(mktemp)"
    if "$here/bin/drgnx" test "$@" >"$out" 2>&1; then :; else fails=$((fails + 1)); fi
    sed -n 's/^ *FAILED  *\([^ ]*\).*/\1/p' "$out" | sort -u >>"$names"
    rm -f -- "$out"
  done
  echo "stress: $n runs at load $load: $((n - fails)) passed, $fails failed" >&2
  sort "$names" | uniq -c | sort -rn | while read -r c name; do echo "   $name  failed $c of $n" >&2; done
  rm -f -- "$names"
  ((fails == 0))
}

test_stress() { # N [--load K] [--ui|--tty|--scenario [ARGS…]] — the selected tests N times beside K busy loops (a flake closes with this)
  local n="${1:-}" load=0
  [[ "$n" =~ ^[1-9][0-9]*$ ]] || { echo "usage: drgnx test --stress N [--load K] [--ui|--tty|--scenario]" >&2; exit 2; }
  shift
  if [[ "${1:-}" == --load ]]; then
    [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "usage: drgnx test --stress N [--load K] [--ui|--tty|--scenario]" >&2; exit 2; }
    load="$2"; shift 2
  fi
  case "${1:-}" in ""|--ui|--tty|--scenario) ;; *) echo "usage: drgnx test --stress N [--load K] [--ui|--tty|--scenario]" >&2; exit 2 ;; esac
  [[ -n "${DRGNX_TEST_SELECTOR:-}" ]] || { echo "drgnx: --stress needs DRGNX_TEST_SELECTOR (the tests to run again and again)" >&2; exit 2; }
  run_in_tmp stress_run "$n" "$load" "$@"
}

cmd_test() {
  case "${1:-}" in
    "") test_batch ;;
    # batch flags, in any order: --one-process (every test file in one Emacs: hunting a leak across files),
    # --leaks (the leak census, harness/run-ert.el: report only), --shuffle[=SEED] (each file's tests in a random order
    # the seed fixes), --find-polluter TEST [FILE…] (last: takes the rest; bisects the tests before TEST)
    --one-process|--leaks|--shuffle|--shuffle=*|--find-polluter)
      local polluter=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --one-process) export DRGNX_TEST_ONE_PROCESS=1 ;;
          --leaks) export DRGNX_TEST_LEAKS=1 ;;
          --shuffle) export DRGNX_TEST_SHUFFLE="$((RANDOM * 32768 + RANDOM))" ;;
          --shuffle=*)   # a seed is a word: letters, digits, . _ - (it ends up in a file name and a command line)
            [[ "${1#--shuffle=}" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "usage: drgnx test --shuffle[=SEED] (SEED: letters, digits, . _ -)" >&2; exit 2; }
            export DRGNX_TEST_SHUFFLE="${1#--shuffle=}" ;;
          --find-polluter)
            shift; polluter=("$@")
            [ ${#polluter[@]} -gt 0 ] && [[ "${polluter[0]}" != -* ]] || { echo "usage: drgnx test --find-polluter TEST [FILE…]" >&2; exit 2; }
            break ;;
          *) echo "usage: drgnx test [--one-process] [--leaks] [--shuffle[=SEED]] | drgnx test [--shuffle=SEED] --find-polluter TEST [FILE…]" >&2; exit 2 ;;
        esac
        shift
      done
      if [ ${#polluter[@]} -gt 0 ]; then
        run_in_tmp test_batch_emacs drgnx-run-ert-find-polluter-batch "${DRGNX_TEST_DIR:-$here/test/unit}" "${polluter[@]}"
      else
        test_batch
      fi ;;
    --stress) shift; test_stress "$@" ;;
    --install) shift; test_install "$@" ;;
    --tty) test_tty ;;
    --ui) if [ "${2:-}" = --compositor ]; then ui_compositor_ok "${3:-}" || exit 2; export DRGNX_UI_COMPOSITOR="$3"; fi
          run_in_tmp ui_exec test-ui ;;
    --bootstrap) shift; test_bootstrap "$@" ;;
    --scenario) shift; run_in_tmp ui_exec test-scenario "$@" ;;
    --bench) run_in_tmp ui_exec test-bench ;;
    --perf) shift
            case "${1:-}" in
              --audit) export DRGNX_PERF_AUDIT=1 ;;
              --ab) [ -n "${2:-}" ] || { echo "usage: drgnx test --perf --ab REF [--n N]" >&2; exit 2; }
                    export DRGNX_PERF_AB="$2"
                    if [ "${3:-}" = --n ]; then [[ "${4:-}" =~ ^[0-9]+$ ]] || { echo "usage: drgnx test --perf --ab REF [--n N]" >&2; exit 2; }; export DRGNX_PERF_AB_N="$4"; fi ;;
            esac
            run_in_tmp ui_exec test-perf ;;
    --soak) shift; run_in_tmp ui_exec test-soak "${1:-30}" ;;
    --container) shift; test_container "$@" ;;
    --podman) shift; DRGNX_CONTAINER=podman test_container "$@" ;;
    *) echo "usage: drgnx test [--one-process] [--leaks] [--shuffle[=SEED]] | drgnx test [--shuffle=SEED] --find-polluter TEST [FILE…] | drgnx test --stress N [--load K] [--ui|--tty|--scenario] | drgnx test [--ui [--compositor C] | --tty | --scenario [--config C] | --bench | --perf [--audit | --ab REF [--n N]] | --soak [MIN] | --container [--ui [--compositor C] | --scenario | --perf | --tty [--fedora 45]] | --install [NAME…] | --bootstrap [--fedora 44|45]]" >&2; exit 2 ;;
  esac
}

## drgnx lease — the host lease: how many test runs the machine carries at once (docs/develop/check.md, "The host lease")

lease_dir() { # the directory of the lock files; empty: no lease
  if [[ -n "${DRGNX_LEASE_DIR:-}" ]]; then printf '%s\n'  "$DRGNX_LEASE_DIR"
  elif [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then printf '%s\n' "$XDG_RUNTIME_DIR/drgnx/lease"; fi
}

lease_off() { # true: CMD runs directly (CI, DRGNX_LEASE=off, no flock, a nested call inside a lease, no directory)
  [[ "${CI:-}" == true || "${DRGNX_LEASE:-}" == off || -n "${DRGNX_LEASE_HELD:-}" ]] && return 0
  command -v flock >/dev/null 2>&1 || return 0
  ((BASH_VERSINFO[0] >= 4)) || return 0                   # {fd}> redirections
  [[ -z "$(lease_dir)" ]]
}

lease_slots() { # sets LEASE_L and LEASE_H: light and heavy slots from the memory and cores (DRGNX_LEASE_LIGHT/HEAVY override)
  local kb gib cores
  kb="$(awk '/^MemTotal:/ {print $2; exit}' "${DRGNX_LEASE_MEMINFO:-/proc/meminfo}" 2>/dev/null || true)"
  [[ "$kb" =~ ^[0-9]+$ ]] || kb=0
  gib=$((kb / 1048576))
  cores="${DRGNX_LEASE_NPROC:-$(nproc 2>/dev/null || echo 1)}"
  LEASE_L=$((cores / 3)); ((LEASE_L <= (gib - 4) / 2)) || LEASE_L=$(((gib - 4) / 2)); ((LEASE_L >= 1)) || LEASE_L=1
  LEASE_H=$(((gib - 8) / 4)); ((LEASE_H >= 1)) || LEASE_H=1
  [[ "${DRGNX_LEASE_LIGHT:-}" =~ ^[0-9]+$ ]] && LEASE_L="$DRGNX_LEASE_LIGHT"
  [[ "${DRGNX_LEASE_HEAVY:-}" =~ ^[0-9]+$ ]] && LEASE_H="$DRGNX_LEASE_HEAVY"
  return 0
}

lease_release() { # close the lock fds: the kernel drops the locks
  local fd
  for fd in ${LEASE_FDS[@]+"${LEASE_FDS[@]}"}; do eval "exec $fd>&-"; done
  LEASE_FDS=()
}

lease_grab() { # PREFIX N — lock the first free PREFIX-k, k in 1..N (fd kept in LEASE_FDS, k in LEASE_GOT); false: all taken
  local k
  for ((k = 1; k <= $2; k++)); do
    exec {LEASE_FD}>>"$LEASE_DIR/$1-$k"
    if flock -n "$LEASE_FD"; then LEASE_FDS+=("$LEASE_FD"); LEASE_GOT="$k"; return 0; fi
    eval "exec $LEASE_FD>&-"
  done
  return 1
}

lease_try() { # CLASS — one non-blocking pass for every lock the class needs; all or none
  local class="$1"
  LEASE_FDS=() LEASE_SLOT=0
  exec {LEASE_FD}>>"$LEASE_DIR/host"; LEASE_FDS+=("$LEASE_FD")
  if [[ "$class" == exclusive ]]; then
    flock -x -n "$LEASE_FD" || { lease_release; return 1; }
    return 0
  fi
  flock -s -n "$LEASE_FD" || { lease_release; return 1; }
  if [[ "$class" == heavy ]]; then
    lease_grab heavy "$LEASE_H" || { lease_release; return 1; }
    LEASE_SLOT="$LEASE_GOT"
    lease_grab light "$LEASE_L" || { lease_release; return 1; }
  else
    lease_grab light "$LEASE_L" || { lease_release; return 1; }
    LEASE_SLOT="$LEASE_GOT"
  fi
}

lease_prune_and_list() { # one line per live holder: class slot pid worktree command since; files of dead pids are removed
  local f pid class slot tree cmd since
  for f in "$LEASE_DIR"/holders/*.eld; do
    [[ -e "$f" ]] || continue
    pid="${f##*/}"; pid="${pid%.eld}"
    if ! kill -0 "$pid" 2>/dev/null; then rm -f -- "$f"; continue; fi
    class="$(sed -n 's/.*:class \([a-z]*\).*/\1/p' "$f")"; slot="$(sed -n 's/.*:slot \([0-9]*\).*/\1/p' "$f")"
    tree="$(sed -n 's/.*:worktree "\([^"]*\)".*/\1/p' "$f")"; cmd="$(sed -n 's/.*:command "\(.*\)" :since.*/\1/p' "$f")"
    since="$(sed -n 's/.*:since "\([^"]*\)".*/\1/p' "$f")"
    printf '%s %s %s %s %s since %s\n' "$class" "$slot" "$pid" "$tree" "$cmd" "$since"
  done
}

lease_status() {
  LEASE_DIR="$(lease_dir)"
  lease_slots
  if [[ -z "$LEASE_DIR" ]]; then echo "lease off (no XDG_RUNTIME_DIR or DRGNX_LEASE_DIR)"; return 0; fi
  printf 'slots light=%s heavy=%s\n' "$LEASE_L" "$LEASE_H"
  lease_prune_and_list
}

lease_self() { # CLASS ARGS… — take the lease for this command: re-exec as `drgnx lease CLASS -- drgnx ARGS…`, whose child
  # runs with DRGNX_LEASE_HELD set (so it takes nothing again); with the lease off, go on
  local class="$1"; shift
  if lease_off; then return 0; fi
  exec "$here/bin/drgnx" lease "$class" -- "$here/bin/drgnx" "$@"
}

lease_test_class() { # ARGS of `drgnx test` → light (the batch tier), heavy (the GUI, tty and container tiers), exclusive (A/B perf)
  case "${1:-}" in
    --ui|--tty|--scenario|--bench|--soak|--container|--podman|--install|--bootstrap|--stress) echo heavy ;;
    --perf) case " $* " in *" --ab "*) echo exclusive ;; *) echo heavy ;; esac ;;
    *) echo light ;;
  esac
}

lease_holder_done() { # EXIT trap of a lease: the holder file goes, the locks go with the process
  [[ -z "${LEASE_HOLDER:-}" ]] || rm -f -- "$LEASE_HOLDER"
  return 0
}

cmd_lease() { # light|heavy|exclusive [--wait SECS] -- CMD… | status
  local class maxwait="" lcap=() child rc since started
  case "${1:-}" in
    status) lease_status; return ;;
    light|heavy|exclusive) class="$1"; shift ;;
    *) echo "usage: drgnx lease light|heavy|exclusive [--wait SECS] -- CMD… | drgnx lease status" >&2; exit 2 ;;
  esac
  if [[ "${1:-}" == --wait ]]; then
    [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "drgnx lease: --wait takes whole seconds" >&2; exit 2; }
    maxwait="$2"; shift 2
  fi
  [[ "${1:-}" == -- ]] && shift
  [[ $# -gt 0 ]] || { echo "usage: drgnx lease CLASS [--wait SECS] -- CMD…" >&2; exit 2; }
  if lease_off; then exec "$@"; fi
  LEASE_DIR="$(lease_dir)"
  mkdir -p "$LEASE_DIR/holders" && chmod 700 "$LEASE_DIR" "${LEASE_DIR%/*}" 2>/dev/null || true
  lease_slots
  # No wait is endless: exclusive gives up after 10 minutes (and runs anyway), light and heavy after DRGNX_LEASE_WAIT
  # seconds (default 30 minutes: a queue of test runs; a longer wait is a hung holder) with the holders listed
  if [[ -z "$maxwait" ]]; then
    if [[ "$class" == exclusive ]]; then maxwait=600
    else maxwait="${DRGNX_LEASE_WAIT:-1800}"; [[ "$maxwait" =~ ^[0-9]+$ ]] || maxwait=1800; fi
  fi
  started=$SECONDS
  while ! lease_try "$class"; do
    if [[ -n "$maxwait" ]] && ((SECONDS - started >= maxwait)); then
      if [[ "$class" == exclusive ]]; then
        echo "drgnx lease: wall clock not judged: host busy; holders:" >&2; lease_prune_and_list >&2
        DRGNX_LEASE_BUSY=1 DRGNX_LEASE_HELD="exclusive:0" exec "$@"
      fi
      echo "drgnx lease: no $class slot free in $maxwait s (--wait SECS or DRGNX_LEASE_WAIT waits longer); holders:" >&2
      lease_prune_and_list >&2
      exit 75
    fi
    sleep "${DRGNX_LEASE_POLL:-2}"
  done
  since="$(date +%Y-%m-%dT%H:%M:%S)"
  LEASE_HOLDER="$LEASE_DIR/holders/$$.eld"
  trap lease_holder_done EXIT
  printf '(:class %s :slot %s :pid %s :worktree "%s" :command "%s" :since "%s")\n' "$class" "$LEASE_SLOT" "$$" "$here" \
    "$(printf '%s' "$*" | tr -d '"\\' | cut -c1-200)" "$since" >"$LEASE_HOLDER"
  if [[ "$class" != exclusive && "${DRGNX_LEASE_CAP:-}" != off ]] && command -v systemd-run >/dev/null 2>&1 \
     && [[ "$(timeout 5 systemctl --user is-system-running 2>/dev/null || true)" =~ ^(running|degraded|starting)$ ]]; then
    lcap=(systemd-run --user --scope -q -p "MemoryMax=$([[ "$class" == heavy ]] && echo 4G || echo 2G)" -p MemorySwapMax=0 --)
  fi
  # CMD inherits the lock fds: the slot is held by the command itself, so killing this shell (the OOM killer, a scope
  # kill) does not free it while CMD runs.  A daemon CMD leaves behind keeps the slot until it ends.
  (
    export DRGNX_LEASE_HELD="$class:$LEASE_SLOT"
    exec ${lcap[@]+"${lcap[@]}"} "$@"
  ) <&0 &
  child=$!
  trap 'kill -TERM "$child" 2>/dev/null || true' INT TERM HUP
  rc=0
  while kill -0 "$child" 2>/dev/null; do wait "$child" && rc=0 || rc=$?; done
  return "$rc"
}

## drgnx open / drgnx PATH — one drgnx, a daemon started on the first open (core/drgnx-session.el)

emacsclient_cmd() { # EC: the emacsclient command; on macOS without XDG_RUNTIME_DIR (a shell exports it, Finder does not:
  # the daemon's socket is in Emacs' non-XDG directory under $TMPDIR either way, core/drgnx-session.el)
  EC=("$(emacsclient_bin)")
  if [[ "$(uname -s)" == Darwin ]]; then EC=(env -u XDG_RUNTIME_DIR "${EC[@]}"); fi
}

client() { # emacsclient to drgnx's server ($DRGNX_SERVER_NAME, default drgnx); -a false: never starts an Emacs itself
  local EC; emacsclient_cmd
  "${EC[@]}" -a false -s "${DRGNX_SERVER_NAME:-drgnx}" "$@"
}

open_wait_init() { # OPEN_WAIT: seconds to wait for a starting daemon, $DRGNX_OPEN_WAIT, default 30 (a cold start natively compiles)
  [[ -z "${OPEN_WAIT:-}" ]] || return 0
  local w="${DRGNX_OPEN_WAIT:-30}"
  if [[ "$w" =~ ^[0-9]+$ ]] && ((10#$w > 0)); then OPEN_WAIT=$((10#$w))     # 10#: "08" is eight, not a bad octal
  else echo "drgnx: DRGNX_OPEN_WAIT must be a whole number of seconds above 0, not '$w': using 30" >&2; OPEN_WAIT=30; fi
}

probe() { # emacsclient for a question to the daemon: it answers within 5 s or it counts as not answering
  client --timeout=5 "$@"
}

open_lock() { # one `drgnx open' at a time decides whether to start the daemon and open a window (a mkdir lock)
  local stale deadline token since owner nostamp="" lock
  lock="$(drgnx_dir state)/open-${DRGNX_SERVER_NAME:-drgnx}.lock"
  mkdir -p "${lock%/*}" 2>/dev/null || return 0     # nowhere to keep a lock: go on without
  open_wait_init
  stale=$((OPEN_WAIT + 15))                         # a holder is done within the wait; older: its owner is gone
  deadline=$((SECONDS + stale + 10))
  token="$$.$RANDOM$RANDOM"
  while ((SECONDS < deadline)); do
    # the owner file is the lock: made with O_EXCL (noclobber), as uutils' mkdir (Ubuntu 26.04's) lets two
    # commands that race both "make" the directory
    if mkdir "$lock" 2>/dev/null && (set -C; printf '%s\n' "$token" >"$lock/owner") 2>/dev/null; then
      date +%s >"$lock/since"
      OPEN_LOCK="$lock" OPEN_TOKEN="$token"; return 0
    fi
    since="$(cat "$lock/since" 2>/dev/null || true)" owner="$(cat "$lock/owner" 2>/dev/null || true)"
    if [[ "$since" =~ ^[0-9]+$ ]]; then
      nostamp=""
      if (($(date +%s) - since > stale)); then open_steal "$lock" "$owner"; fi
    else   # made a moment ago, or its owner died before stamping it: stale after 5 s without a stamp
      [[ -n "$nostamp" ]] || nostamp=$SECONDS
      if ((SECONDS - nostamp >= 5)); then open_steal "$lock" "$owner"; nostamp=""; fi
    fi
    sleep 0.1
  done
}

open_steal() { # LOCK OWNER — remove a stale lock, but only the one seen (OWNER's); a fresh lock made meanwhile stays
  local lock="$1" owner="$2" grab="$1.stale.$$"
  mv "$lock" "$grab" 2>/dev/null || return 0         # one winner among those who find it stale
  if [[ "$(cat "$grab/owner" 2>/dev/null || true)" == "$owner" ]]; then rm -rf "$grab" || true
  elif [[ ! -e "$lock" ]] && mv "$grab" "$lock" 2>/dev/null; then :   # someone's fresh lock: put it back
  else rm -rf "$grab" || true; fi
}

open_unlock() { # only the lock this command made: a stolen one is another command's now
  if [[ -n "${OPEN_LOCK:-}" ]]; then
    if [[ "$(cat "$OPEN_LOCK/owner" 2>/dev/null || true)" == "${OPEN_TOKEN:-}" ]]; then rm -rf "$OPEN_LOCK" || true; fi
    OPEN_LOCK=""
  fi
}

open_ensure_window() { # drgnx's daemon is running and has a window; under the lock, so two opens make one of each
  local deadline
  probe -e t >/dev/null 2>&1 || open_start || return 1
  if [[ "$(probe -e '(drgnx-session-gui-frame-p)' 2>/dev/null)" != t ]]; then
    client -n -c >/dev/null || return 1
    deadline=$((SECONDS + 10))
    while ((SECONDS < deadline)); do   # -n returns before the window exists: the next open must see it
      [[ "$(probe -e '(drgnx-session-gui-frame-p)' 2>/dev/null)" == t ]] && break
      sleep 0.1
    done
  fi
}

open_gtk_theme() { # GTK_THEME for a daemon this starts: the title bar's variant from face.eld, else the environment's own
  [[ -n "${GTK_THEME:-}" ]] && return 0
  local file variant theme
  file="$(drgnx_dir state)/face.eld"
  [[ -r "$file" ]] || return 0   # sed, not Emacs: the daemon is not up yet, and GTK reads the variable once at its start
  variant="$(sed -n -E 's/.*:variant[[:space:]]+(dark|light)[[:space:])].*/\1/p' "$file" | head -n 1)"
  theme="$(sed -n -E 's/.*:gtk-theme[[:space:]]+"([A-Za-z0-9._+-]+)".*/\1/p' "$file" | head -n 1)"
  if [[ -n "$variant" && -n "$theme" ]]; then export GTK_THEME="$theme:$variant"; fi
  return 0
}

open_start() { # start drgnx's daemon (the systemd unit when it is enabled), wait for its server (OPEN_WAIT seconds)
  local name="${DRGNX_SERVER_NAME:-drgnx}" log deadline notice noticed=""
  open_wait_init
  open_gtk_theme
  if [[ "$name" == drgnx ]] && command -v systemctl >/dev/null 2>&1 && systemctl --user is-enabled --quiet drgnx 2>/dev/null; then
    systemctl --user start drgnx || return 1
  else
    log="$(drgnx_dir state)/daemon.log"
    mkdir -p "${log%/*}"
    # in its own session, outliving this shell: setsid, else perl (macOS), as core/drgnx-jobs.el does
    emacs_bin >/dev/null || return 1   # none found: say so, start nothing
    if command -v setsid >/dev/null 2>&1; then
      setsid -f "$(emacs_bin || echo false)" --bg-daemon="$name" --init-directory="$here/init" </dev/null >>"$log" 2>&1
    else
      perl -MPOSIX -e 'fork and exit; POSIX::setsid(); exec @ARGV' \
           "$(emacs_bin || echo false)" --bg-daemon="$name" --init-directory="$here/init" </dev/null >>"$log" 2>&1
    fi
  fi
  deadline=$((SECONDS + OPEN_WAIT)) notice=$((SECONDS + OPEN_WAIT / 3))   # wall-clock seconds: a poll takes more than its sleep
  while ((SECONDS < deadline)); do
    probe -e t >/dev/null 2>&1 && return 0
    if [[ -z "$noticed" ]] && ((SECONDS >= notice)); then
      echo "drgnx: drgnx is still starting (waiting up to $OPEN_WAIT s)…" >&2; noticed=1
    fi
    sleep 0.1
  done
  echo "drgnx: drgnx did not start within $OPEN_WAIT s (its messages: ${log:-journalctl --user -u drgnx}; try: drgnx doctor)" >&2
  return 1
}

elisp_string() { # $1 as the inside of an Emacs Lisp string literal
  local s="${1//\\/\\\\}"
  printf '%s' "${s//\"/\\\"}"
}

open_check() { # CI: start the daemon if needed, print its Emacs version, stop it again if this started it
  local started="" out i
  if ! probe -e t >/dev/null 2>&1; then open_start || return 1; started=1; fi
  if ! out="$(client -e '(emacs-version)' 2>&1)"; then
    echo "drgnx: drgnx's server did not answer: $out" >&2
    [[ -n "$started" ]] && client -e '(kill-emacs)' >/dev/null 2>&1
    return 1
  fi
  out="${out#\"}"; printf '%s\n' "${out%\"}"
  if [[ -n "$started" ]]; then
    client -e '(kill-emacs)' >/dev/null 2>&1 || true
    for ((i = 0; i < 50; i++)); do probe -e t >/dev/null 2>&1 || return 0; sleep 0.1; done
    echo "drgnx: the daemon this started did not stop" >&2; return 1
  fi
}

open_wants_terminal() { # no -t given: the terminal when this is an SSH session, or (Linux) there is no display at all
  [[ -n "${SSH_CONNECTION:-}" || -n "${SSH_TTY:-}" ]] && return 0
  [[ "$(uname -s)" == Linux && -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]
}

open_terminfo_check() { # a terminal frame needs this terminal's description (terminfo); say how to get it when it is missing
  command -v infocmp >/dev/null 2>&1 || return 0         # cannot tell: Emacs will
  if [[ -n "${TERM:-}" ]] && infocmp "$TERM" >/dev/null 2>&1; then return 0; fi
  cat >&2 <<EOF
drgnx: this machine does not know the terminal type "${TERM:-}", so a terminal frame would draw wrongly.
Fix it in one of these ways:
  kitten ssh HOST                          (kitty: copies kitty's terminal description to HOST)
  infocmp -x | ssh HOST -- tic -x -        (any terminal: run it where the terminal works; HOST is this machine)
  TERM=xterm-256color drgnx -t             (this once, with a terminal type this machine knows)
EOF
  return 1
}

open_terminal_limited() { # a terminal that cannot send every key: GNOME's VTE, Apple's Terminal, the Linux console
  [[ -n "${VTE_VERSION:-}" || "${TERM_PROGRAM:-}" == Apple_Terminal || "${TERM:-}" == linux ]]
}

lisp_strings() { # a printed list of strings, e.g. ("kitty" "--") → the array LISP_STRINGS
  local s="$1" item re='^[^"]*"(([^"\\]|\\.)*)"(.*)$'
  LISP_STRINGS=()
  while [[ "$s" =~ $re ]]; do
    item="${BASH_REMATCH[1]}"; s="${BASH_REMATCH[3]}"
    item="${item//\\\\/$'\001'}"; item="${item//\\\"/\"}"; item="${item//$'\001'/\\}"
    LISP_STRINGS+=("$item")
  done
}

detach() { # CMD… — start CMD in a session of its own, outliving this shell and its terminal (as open_start does)
  if command -v setsid >/dev/null 2>&1; then setsid -f "$@" </dev/null >/dev/null 2>&1
  else perl -MPOSIX -e 'fork and exit; POSIX::setsid(); exec @ARGV' "$@" </dev/null >/dev/null 2>&1; fi
}

open_terminal() { # FORM — a terminal frame of the daemon here; in the terminal that Task 5c's opt-in names, when this one is limited
  local form="$1" server="${DRGNX_SERVER_NAME:-drgnx}" capable
  local EC ec eform=(); emacsclient_cmd; ec=("${EC[@]}" -t -s "$server")
  [[ -z "$form" ]] || eform=(-e "$form")
  # off by default: the daemon answers nil unless the user chose a terminal (drgnx-tty-open-in).  Never over SSH or
  # without a display, as this caller sees it: the daemon's own environment is the desktop's
  if open_terminal_limited && ! open_wants_terminal; then
    capable="$(probe -e "(progn (require 'drgnx-tty-recommend nil t) (and (fboundp 'drgnx-tty-capable-terminal-argv) (drgnx-tty-capable-terminal-argv)))" 2>/dev/null)" || capable=""
    lisp_strings "$capable"
    if ((${#LISP_STRINGS[@]})); then detach "${LISP_STRINGS[@]}" "${ec[@]}" ${eform[@]+"${eform[@]}"}; return 0; fi
  fi
  open_terminfo_check || return 1   # this terminal's: not needed when the frame opens in another one (above)
  exec "${ec[@]}" ${eform[@]+"${eform[@]}"}
}

open_here() { # [--wait] [-t | --gui] [--] [PATH…] — in drgnx's own terminal: open in the drgnx hosting it, in its selected frame
  local wait="" p dir files=() dirs=()
  while true; do   # -t / --gui name a frame kind: here it is the hosting drgnx's frame either way
    case "${1:-}" in
      --wait) wait=1; shift ;;
      -t|--gui) shift ;;
      *) break ;;
    esac
  done
  [[ "${1:-}" == -- ]] && shift
  for p in "$@"; do   # as cmd_open: absolute, from here; a folder is the Explorer's, a file an editor's
    if [[ -d "$p" ]]; then
      dirs+=("$(CDPATH='' cd -- "$p" && pwd)")
    else
      dir="$(dirname -- "$p")"
      if [[ -d "$dir" ]]; then dir="$(CDPATH='' cd -- "$dir" && pwd)"; elif [[ "$dir" != /* ]]; then dir="$PWD/$dir"; fi
      files+=("${dir%/}/$(basename -- "$p")")
    fi
  done
  if [[ -n "$wait" ]]; then
    if ((${#dirs[@]})) || ! ((${#files[@]})); then
      echo "drgnx: open --wait opens files, not folders: it returns when you are done with them (C-x #)" >&2; return 2
    fi
    client -- "${files[@]}" >/dev/null; return   # until C-x #
  fi
  if ((${#files[@]})); then client -n -- "${files[@]}" >/dev/null || return 1; fi
  for p in ${dirs[@]+"${dirs[@]}"}; do
    client -n -e "(drgnx-session-open-folder \"$(elisp_string "$p")\")" >/dev/null || return 1
  done
}

cmd_open() { # [--check] [--wait] [-t | --gui] [PATH…] — open PATHs (none: the windows as you left them) in drgnx, like code .
  # In drgnx's terminal (eat; DRGNX_SERVER_NAME is its Emacs's socket): that drgnx, never a new window or frame
  if [[ "${INSIDE_EMACS:-}" == *eat* && -n "${DRGNX_SERVER_NAME:-}" && "${1:-}" != --check ]]; then open_here "$@"; return; fi
  if [[ "${1:-}" == --check ]]; then open_check; return; fi
  local wait="" term="" gui=""
  while true; do   # -t: a frame in this terminal; --gui: a window, whatever the terminal; --wait: until C-x #
    case "${1:-}" in
      --wait) wait=1; shift ;;
      -t) term=1; shift ;;
      --gui) gui=1; shift ;;
      *) break ;;
    esac
  done
  if [[ -n "$term" && -n "$gui" ]]; then echo "drgnx: -t (a terminal frame) and --gui (a window) exclude each other" >&2; return 2; fi
  [[ "${1:-}" == -- ]] && shift
  local p dir files=() dirs=()
  for p in "$@"; do   # absolute, from here; a folder is the Explorer's, a file (new or not) an editor's
    if [[ -d "$p" ]]; then
      dirs+=("$(CDPATH='' cd -- "$p" && pwd)")
    else
      dir="$(dirname -- "$p")"
      if [[ -d "$dir" ]]; then dir="$(CDPATH='' cd -- "$dir" && pwd)"; elif [[ "$dir" != /* ]]; then dir="$PWD/$dir"; fi
      files+=("${dir%/}/$(basename -- "$p")")
    fi
  done
  if [[ -n "$wait" ]] && { ((${#dirs[@]})) || ! ((${#files[@]})); }; then
    echo "drgnx: open --wait opens files, not folders: it returns when you are done with them (C-x #)" >&2; return 2
  fi
  # ssh, or no display: the terminal by itself, but only for a person at one (not a script, a launcher, an editor hook)
  if [[ -z "$term" && -z "$gui" && -t 0 && -t 1 ]] && open_wants_terminal; then term=1; fi
  OPEN_LOCK=""
  trap open_unlock EXIT; trap 'exit 130' INT TERM; trap 'exit 129' HUP    # the lock never outlives this command
  open_lock
  if [[ -n "$term" ]]; then   # a frame of the daemon in this terminal: no window is made, none raised
    probe -e t >/dev/null 2>&1 || open_start || return 1
    open_unlock
    if [[ -n "$wait" ]]; then open_terminfo_check || return 1; client -t -- "${files[@]}"; return; fi
    client -n -e "(progn (require 'drgnx-ai) (drgnx-ai-load-keys-soon))" >/dev/null 2>&1 || true   # once per daemon, as below
    local form=""
    for p in ${files[@]+"${files[@]}"}; do form+=" (drgnx-session-open-file \"$(elisp_string "$p")\")"; done
    for p in ${dirs[@]+"${dirs[@]}"}; do form+=" (drgnx-session-open-folder \"$(elisp_string "$p")\")"; done
    open_terminal "${form:+(progn$form)}"; return
  fi
  open_ensure_window || return 1
  open_unlock
  client -n -e '(drgnx-session-raise)' >/dev/null 2>&1 || true
  client -n -e "(progn (require 'drgnx-ai) (drgnx-ai-load-keys-soon))" >/dev/null 2>&1 || true   # once per daemon, from a timer
  if [[ -n "$wait" ]]; then client -- "${files[@]}" >/dev/null; return; fi   # no -n: until C-x # (drgnx as $EDITOR)
  if ((${#files[@]})); then client -n -- "${files[@]}" >/dev/null || return 1; fi
  for p in ${dirs[@]+"${dirs[@]}"}; do
    client -n -e "(drgnx-session-open-folder \"$(elisp_string "$p")\")" >/dev/null || return 1
  done
}

# ---- drgnx update: the install updates itself from GitHub main (docs/guide/install.md#staying-up-to-date) ----
# Plain bash on purpose: it must work when the Emacs side is what an update broke.  Test hooks: DRGNX_UPDATE_SYNC_CMD and
# DRGNX_UPDATE_BUILD_CMD (run with bash -c in the checkout instead of `drgnx sync' / `drgnx build'), DRGNX_UPDATE_PLATFORM
# (Linux | Darwin, instead of uname -s).
UPD_UNIT=drgnx-update
UPD_LABEL=org.blackdragonfoundation.drgnx-update

update_state_dir() { printf '%s/update' "$(drgnx_dir state)"; }
update_platform() { printf '%s' "${DRGNX_UPDATE_PLATFORM:-$(uname -s)}"; }
update_say() { if [[ "${UPD_QUIET:-0}" != 1 ]]; then printf '%s\n' "$*"; fi; }
update_err() { printf 'drgnx update: %s\n' "$*" >&2; }
ugit() { git -C "$here" "$@"; }

update_write_atomic() { # FILE TEXT — a temp file in the same directory, then rename: a reader never sees half a line
  local t; t="$(mktemp "$1.XXXXXX")"
  printf '%s\n' "$2" >"$t"
  mv -f "$t" "$1"
}

update_record_run() { # TEXT — the line `drgnx update --auto status' shows as the last run
  local mode=manual
  if [[ "${UPD_QUIET:-0}" == 1 ]]; then mode=auto; fi
  mkdir -p "$(update_state_dir)"
  update_write_atomic "$(update_state_dir)/last-run" "$(date '+%Y-%m-%d %H:%M:%S%z') $mode: $1"
}

update_lock() { # one update at a time (the timer and a person): a mkdir lock holding the owner's pid
  local lock owner=""
  lock="$(update_state_dir)/lock"
  mkdir -p "$(update_state_dir)"
  if ! mkdir "$lock" 2>/dev/null; then
    owner="$(cat "$lock/pid" 2>/dev/null || true)"
    if [[ -n "$owner" ]] && kill -0 "$owner" 2>/dev/null; then update_err "another update is running (pid $owner)"; return 1; fi
    rm -rf "${lock:?}"; mkdir "$lock" 2>/dev/null || { update_err "cannot take the update lock ($lock)"; return 1; }
  fi
  printf '%s\n' "$$" >"$lock/pid"
  UPD_LOCK="$lock"
  trap update_on_exit EXIT
  trap 'UPD_SIGNALED=1; exit 130' INT       # Ctrl-C, the timer's timeout, logout: leave through the EXIT handler, which rolls back
  trap 'UPD_SIGNALED=1; exit 143' TERM
  trap 'UPD_SIGNALED=1; exit 129' HUP
  : >"$(update_state_dir)/last.log"         # this run's sync/build output only
}

update_on_exit() { # whatever ends the script: an update that did not finish is rolled back, then the lock is released
  local rc=$?
  trap - EXIT INT TERM HUP
  if [[ -n "${UPD_ROLLBACK_TO:-}" ]]; then
    update_err "interrupted before the update finished"
    update_rollback "$UPD_ROLLBACK_TO" || true
    update_err "$UPD_BACK_NOTE"
  fi
  if [[ -n "${UPD_SIGNALED:-}" ]]; then update_record_run "interrupted${UPD_BACK_NOTE:+: $UPD_BACK_NOTE}"; fi
  if [[ -n "${UPD_LOCK:-}" ]]; then rm -rf "${UPD_LOCK:?}"; fi
  exit "$rc"
}

update_is_checkout() { # is $here the top of a git checkout?
  local top
  top="$(ugit rev-parse --show-toplevel 2>/dev/null)" || return 1
  [[ "$(cd "$top" && pwd -P)" == "$(cd "$here" && pwd -P)" ]]
}

update_check_checkout() { # refuse (return 1, message on stderr, UPD_WHY set) unless an update may touch the checkout
  local branch
  if ! update_is_checkout; then
    UPD_WHY="not a git checkout"
    update_err "$here is not a git checkout, so it cannot update itself. Reinstall with install.sh (docs/guide/install.md). Nothing changed."
    return 1
  fi
  branch="$(ugit symbolic-ref --short -q HEAD 2>/dev/null || true)"
  if [[ "$branch" != main ]]; then
    UPD_WHY="not on main"
    update_err "the checkout is on '${branch:-a detached HEAD}', not main. Fix: git -C $here switch main. Nothing changed."
    return 1
  fi
  if [[ -n "$(ugit status --porcelain --untracked-files=no 2>/dev/null)" ]]; then
    UPD_WHY="local changes"
    update_err "the checkout has local changes (git -C $here status). Commit, stash or discard them first. Nothing changed."
    return 1
  fi
}

update_fetch() { # origin's main, bounded in time and never asking anything (no terminal, no credential helper, no ssh prompt)
  local t=() e=(GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true SSH_ASKPASS=true)
  if command -v timeout >/dev/null 2>&1; then t=(timeout 120); elif command -v gtimeout >/dev/null 2>&1; then t=(gtimeout 120); fi
  # ssh: never ask, give up connecting; but the user's own GIT_SSH_COMMAND or core.sshCommand wins
  if [[ -z "${GIT_SSH_COMMAND:-}" && -z "$(ugit config --get core.sshCommand 2>/dev/null || true)" ]]; then
    e+=("GIT_SSH_COMMAND=ssh -o BatchMode=yes -o ConnectTimeout=30")
  fi
  env "${e[@]}" ${t[@]+"${t[@]}"} git -C "$here" -c credential.helper= -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30 \
    fetch --quiet origin main </dev/null
}

update_step() { # NAME HOOK [ARG…] — `drgnx NAME ARG…' (or the test hook HOOK, given ARG…) in the checkout; its output is
  # always kept in last.log (quiet: only there)
  local name="$1" hook="$2" log; shift 2
  log="$(update_state_dir)/last.log"
  update_say "drgnx update: ${name}…"   # braces: macOS's bash would read the first byte of … as part of the name
  if [[ "${UPD_QUIET:-0}" == 1 ]]; then
    if [[ -n "$hook" ]]; then (cd "$here" && bash -c "$hook" _ "$@") >>"$log" 2>&1; else (cd "$here" && "$here/bin/drgnx" "$name" "$@") >>"$log" 2>&1; fi
  elif [[ -n "$hook" ]]; then (cd "$here" && bash -c "$hook" _ "$@") 2>&1 | tee -a "$log"
  else (cd "$here" && "$here/bin/drgnx" "$name" "$@") 2>&1 | tee -a "$log"
  fi
}

update_apply() { # sync + build for the checkout as it is now; 0 when both worked, else 1 with UPD_WHY naming the step
  update_step sync "${DRGNX_UPDATE_SYNC_CMD:-}" || { UPD_WHY="sync failed"; return 1; }
  update_step build "${DRGNX_UPDATE_BUILD_CMD:-}" || { UPD_WHY="build failed"; return 1; }
}

update_rollback() { # OLD — put the checkout, its packages and its build back at OLD; UPD_BACK_NOTE says how far that got
  local old="$1" log; log="$(update_state_dir)/last.log"
  UPD_ROLLBACK_TO=""
  if ! ugit reset --hard --quiet "$old" >>"$log" 2>&1; then
    UPD_BACK_NOTE="git reset failed: the checkout is still on the new commit; fix: git -C $here reset --hard ${old:0:7}, then drgnx sync and drgnx build"
    return 1
  fi
  UPD_BACK_NOTE="moved the checkout back to ${old:0:7}"
  # the old lock's packages: from the cache first (its versions are there), else from the archives
  if update_step sync "${DRGNX_UPDATE_SYNC_CMD:-}" --offline >/dev/null 2>&1 || update_step sync "${DRGNX_UPDATE_SYNC_CMD:-}" >/dev/null 2>&1; then
    UPD_BACK_NOTE+=" and re-synced its packages"
  else
    UPD_BACK_NOTE+="; its packages could not be re-synced, so they may be newer than this commit (run drgnx sync, or drgnx rollback)"
  fi
  if update_step build "${DRGNX_UPDATE_BUILD_CMD:-}" >/dev/null 2>&1; then UPD_BACK_NOTE+=" and rebuilt it"
  else UPD_BACK_NOTE+="; its build failed (run drgnx build)"; fi
  UPD_BACK_NOTE+=". Log: $log"
}

update_fail() { # MESSAGE — the one line a failure gets (quiet or not), and the run record
  update_err "$1"
  update_record_run "failed: $1"
}

update_restart_note() { if [[ "${UPD_RESTART:-0}" == 1 ]]; then return 0; fi; update_say "Restart drgnx to use it (a running drgnx keeps the old version until then)."; }

update_summary() { # OLD NEW — what changed, one line per commit, capped
  local old="$1" new="$2" n cap=15 s=s
  n="$(ugit rev-list --count "$old..$new" 2>/dev/null || echo 0)"
  if [[ "$n" == 1 ]]; then s=""; fi
  if [[ "${UPD_QUIET:-0}" == 1 ]]; then
    printf 'drgnx updated %s..%s (%s commit%s); restart drgnx to use it\n' "${old:0:7}" "${new:0:7}" "$n" "$s"
    return
  fi
  printf 'drgnx updated %s..%s (%s commit%s):\n' "${old:0:7}" "${new:0:7}" "$n" "$s"
  ugit log --oneline --no-decorate -n "$cap" "$old..$new" | sed 's/^/  /'
  if ((n > cap)); then printf '  … and %s more\n' "$((n - cap))"; fi
}

update_run() { # the update itself (UPD_QUIET: the timer's way)
  local state old new held
  state="$(update_state_dir)"
  update_check_checkout || { update_record_run "refused: $UPD_WHY"; return 1; }
  old="$(ugit rev-parse HEAD)"
  if ! update_fetch; then update_fail "could not fetch origin main (network? check: git -C $here remote -v)"; return 1; fi
  new="$(ugit rev-parse 'FETCH_HEAD^{commit}')"
  if [[ "$new" == "$old" ]] || ugit merge-base --is-ancestor "$new" "$old" 2>/dev/null; then
    update_say "drgnx is already up to date (${old:0:7})."
    update_record_run "already current (${old:0:7})"
    return 0
  fi
  held="$(cat "$state/held" 2>/dev/null || true)"
  if [[ "${UPD_QUIET:-0}" == 1 && "$held" == "$new" ]]; then   # --back or a failed update set this commit aside: the timer waits for a newer one
    update_record_run "skipped ${new:0:7} (set aside by update --back or a failed update; drgnx update takes it)"
    return 0
  fi
  if ! ugit merge-base --is-ancestor "$old" "$new"; then
    update_err "this checkout has diverged from origin main (local commits not on main). Nothing changed. Fix: git -C $here rebase origin/main, or discard them with git -C $here reset --hard origin/main."
    update_record_run "refused: diverged"
    return 1
  fi
  if ! ugit merge --ff-only --quiet "$new" </dev/null; then update_fail "could not fast-forward to ${new:0:7}; nothing else changed"; return 1; fi
  UPD_ROLLBACK_TO="$old"    # from here until sync and build are done, any way out of the script puts the old commit back
  if ! update_apply; then
    update_rollback "$old" || true
    update_write_atomic "$state/held" "$new"
    update_fail "$UPD_WHY for ${new:0:7}; $UPD_BACK_NOTE"
    return 1
  fi
  UPD_ROLLBACK_TO=""
  update_write_atomic "$state/previous" "$old"
  rm -f "${state:?}/held"
  update_summary "$old" "$new"
  update_restart_note
  update_record_run "updated ${old:0:7}..${new:0:7}"
}

update_back() { # return to the commit before the last update, then sync + build
  local state old prev
  state="$(update_state_dir)"
  update_check_checkout || { update_record_run "refused: $UPD_WHY"; return 1; }
  prev="$(cat "$state/previous" 2>/dev/null || true)"
  if [[ -z "$prev" ]] || ! ugit cat-file -e "$prev^{commit}" 2>/dev/null; then
    update_err "there is no earlier update to go back to. Nothing changed."
    return 1
  fi
  old="$(ugit rev-parse HEAD)"
  if [[ "$prev" == "$old" ]]; then update_err "already at ${prev:0:7}, the commit before the last update. Nothing changed."; return 1; fi
  if ! ugit merge-base --is-ancestor "$prev" "$old" 2>/dev/null && ! ugit merge-base --is-ancestor "$old" "$prev" 2>/dev/null; then
    update_err "the commit before the last update (${prev:0:7}) is unrelated to this checkout's history (you changed it since). Nothing changed."
    return 1
  fi
  if ! ugit reset --hard --quiet "$prev"; then update_err "git reset to ${prev:0:7} failed. Nothing else changed."; return 1; fi
  update_write_atomic "$state/held" "$old"        # the timer does not redo what you undid
  update_write_atomic "$state/previous" "$old"    # a second --back goes forward again
  if ! update_apply; then
    update_fail "$UPD_WHY after going back to ${prev:0:7}: the checkout stays there, but its packages or build are not in step (run drgnx sync, then drgnx build). Log: $state/last.log"
    return 1
  fi
  update_say "drgnx went back ${old:0:7} -> ${prev:0:7}. The timer skips ${old:0:7}; drgnx update takes it again."
  update_restart_note
  update_record_run "went back ${old:0:7} -> ${prev:0:7}"
}

systemd_word() { # $1 as one quoted word of a systemd unit's ExecStart/Environment line
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//%/%%}"; s="${s//\$/\$\$}"
  printf '"%s"' "$s"
}

xml_escape() { local s="$1"; s="${s//&/&amp;}"; s="${s//</&lt;}"; s="${s//>/&gt;}"; printf '%s' "$s"; }

update_systemd_dir() { printf '%s/systemd/user' "$(xdg_dir XDG_CONFIG_HOME "$HOME/.config")"; }
update_plist() { printf '%s/Library/LaunchAgents/%s.plist' "$HOME" "$UPD_LABEL"; }

update_service_text() { # the oneshot service the timer starts
  printf '[Unit]\nDescription=Update drgnx to the newest main\nDocumentation=https://github.com/Black-Dragon-Foundation/drgnx\n\n'
  printf '[Service]\nType=oneshot\nNice=10\nTimeoutStartSec=1h\nTimeoutStopSec=30min\n'
  printf 'Environment=%s\n' "$(systemd_word "PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin")"
  local v   # what makes the timer's run find the same Emacs, config and state as yours
  for v in DRGNX_EMACS DRGNX_CONFIG_DIR XDG_CONFIG_HOME XDG_STATE_HOME; do
    if [[ "${!v:-}" == /* ]]; then printf 'Environment=%s\n' "$(systemd_word "$v=${!v}")"; fi
  done
  printf 'ExecStart=%s update --quiet\n' "$(systemd_word "$here/bin/drgnx")"
}

update_timer_text() {
  printf '[Unit]\nDescription=Update drgnx daily\n\n[Timer]\nOnCalendar=daily\nRandomizedDelaySec=1h\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n'
}

update_plist_env() { # DRGNX_EMACS, DRGNX_CONFIG_DIR, XDG_CONFIG_HOME, XDG_STATE_HOME as plist keys, when set
  local v
  for v in DRGNX_EMACS DRGNX_CONFIG_DIR XDG_CONFIG_HOME XDG_STATE_HOME; do
    if [[ "${!v:-}" == /* ]]; then printf '<key>%s</key><string>%s</string>' "$v" "$(xml_escape "${!v}")"; fi
  done
}

update_plist_text() { # HOUR MINUTE — launchd has no randomized delay: the install picks a time of day
  local log; log="$(xml_escape "$(update_state_dir)/launchd.log")"
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$UPD_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml_escape "$here/bin/drgnx")</string>
    <string>update</string>
    <string>--quiet</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>$(xml_escape "$HOME")/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>$(update_plist_env)</dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>$1</integer><key>Minute</key><integer>$2</integer></dict>
  <key>ProcessType</key><string>Background</string>
  <key>ExitTimeOut</key><integer>1800</integer>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>$log</string>
  <key>StandardErrorPath</key><string>$log</string>
</dict>
</plist>
PLIST
}

update_auto_darwin() { # on | off | status
  local plist uid
  plist="$(update_plist)"
  uid="$(id -u)"
  case "$1" in
    on)
      update_is_checkout || { update_err "$here is not a git checkout, so it cannot update itself; no timer set."; return 1; }
      command -v launchctl >/dev/null 2>&1 || { update_err "launchctl not found; no timer set."; return 1; }
      mkdir -p "${plist%/*}"
      update_plist_text "$((10 + RANDOM % 8))" "$((RANDOM % 60))" >"$plist.tmp" && mv -f "$plist.tmp" "$plist"
      launchctl bootout "gui/$uid" "$plist" >/dev/null 2>&1 || true
      launchctl bootstrap "gui/$uid" "$plist" || { update_err "launchctl could not load $plist"; return 1; }
      echo "drgnx update: automatic updates on (a launchd agent, daily; $plist)." ;;
    off)
      if [[ -f "$plist" ]]; then launchctl bootout "gui/$uid" "$plist" >/dev/null 2>&1 || true; rm -f "$plist"; fi
      echo "drgnx update: automatic updates off." ;;
    status)
      if [[ -f "$plist" ]]; then echo "automatic updates: on (launchd agent $UPD_LABEL, daily)"; else echo "automatic updates: off"; fi ;;
  esac
}

update_auto_systemd() { # on | off | status
  local dir next=""
  dir="$(update_systemd_dir)"
  case "$1" in
    on)
      update_is_checkout || { update_err "$here is not a git checkout, so it cannot update itself; no timer set."; return 1; }
      command -v systemctl >/dev/null 2>&1 || { update_err "systemctl not found: automatic updates need a systemd user session. Run drgnx update by hand, or from your own cron."; return 1; }
      mkdir -p "$dir"
      update_service_text >"$dir/$UPD_UNIT.service.tmp" && mv -f "$dir/$UPD_UNIT.service.tmp" "$dir/$UPD_UNIT.service"
      update_timer_text >"$dir/$UPD_UNIT.timer.tmp" && mv -f "$dir/$UPD_UNIT.timer.tmp" "$dir/$UPD_UNIT.timer"
      systemctl --user daemon-reload || true
      systemctl --user enable --now "$UPD_UNIT.timer" || { update_err "systemctl could not enable $UPD_UNIT.timer (units are in $dir)"; return 1; }
      echo "drgnx update: automatic updates on (systemd user timer $UPD_UNIT.timer, daily; units in $dir)." ;;
    off)
      if [[ -f "$dir/$UPD_UNIT.timer" ]] && command -v systemctl >/dev/null 2>&1; then systemctl --user disable --now "$UPD_UNIT.timer" >/dev/null 2>&1 || true; fi
      rm -f "$dir/$UPD_UNIT.timer"
      rm -f "$dir/$UPD_UNIT.service"
      if command -v systemctl >/dev/null 2>&1; then systemctl --user daemon-reload >/dev/null 2>&1 || true; fi
      echo "drgnx update: automatic updates off." ;;
    status)
      if [[ ! -f "$dir/$UPD_UNIT.timer" ]]; then echo "automatic updates: off"
      elif command -v systemctl >/dev/null 2>&1 && ! systemctl --user is-enabled "$UPD_UNIT.timer" >/dev/null 2>&1; then
        echo "automatic updates: off (units exist in $dir but the timer is not enabled: drgnx update --auto on)"
      else
        echo "automatic updates: on (systemd user timer $UPD_UNIT.timer, daily)"
        next="$(systemctl --user show "$UPD_UNIT.timer" -p NextElapseUSecRealtime --value 2>/dev/null || true)"
        if [[ -n "$next" ]]; then echo "next run: $next"; fi
      fi ;;
  esac
}

update_auto() { # on | off | status
  local rc=0
  mkdir -p "$(update_state_dir)"
  if [[ "$(update_platform)" == Darwin ]]; then update_auto_darwin "$1" || rc=$?; else update_auto_systemd "$1" || rc=$?; fi
  if [[ "$1" == status && "$rc" == 0 ]]; then
    if [[ -f "$(update_state_dir)/last-run" ]]; then echo "last run: $(cat "$(update_state_dir)/last-run")"; else echo "last run: never"; fi
  fi
  return "$rc"
}

secrets_emacs() { # the Emacs side of drgnx secrets (core/drgnx-secrets.el)
  "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" \
        -l drgnx-secrets -f drgnx-secrets-cli -- "$@"
}

cmd_secrets() { # export|import|ls — provider keys through age (docs/guide/second-machine.md).  age asks for a passphrase
  # on this terminal, which a program Emacs starts never has (Emacs gives each child a session of its own): so after
  # Emacs's checks (exit 10) age runs here, in a pipe with Emacs, and the plaintext crosses only that pipe.
  local rc=0 file
  unset DRGNX_SECRETS_PIPE
  DRGNX_STDIN_TTY=""; if [ -t 0 ]; then DRGNX_STDIN_TTY=1; fi   # the keyring is opened only from a terminal
  export DRGNX_STDIN_TTY
  secrets_emacs "$@" || rc=$?
  [ "$rc" -eq 10 ] || return "$rc"
  rc=0
  file="$(drgnx_dir config)/secrets.age"
  if [ "${1:-}" = export ]; then
    mkdir -p -- "${file%/*}"
    trap 'rm -f -- "$file.new"' EXIT   # an interrupt during age's prompt leaves no secrets.age.new
    DRGNX_SECRETS_PIPE=bundle secrets_emacs export | age -e -p -o "$file.new" || rc=$?
    if [ "$rc" -eq 0 ]; then mv -f -- "$file.new" "$file"; echo "drgnx secrets: wrote $file"
    else rm -f -- "$file.new"; echo "drgnx secrets: nothing written ($file is unchanged)" >&2; fi
  else
    age -d "$file" | DRGNX_SECRETS_PIPE=stdin secrets_emacs "$@" || rc=$?   # import --replace
  fi
  return "$rc"
}

update_restart() { # after a successful update or --back: restart drgnx's own daemon service, nothing else
  if [[ "$(update_platform)" == Darwin ]]; then
    echo "drgnx update: no drgnx service is installed here (on macOS drgnx runs from its app or drgnx open), so nothing was restarted; quit and reopen drgnx."
    return 0
  fi
  if command -v systemctl >/dev/null 2>&1 && systemctl --user is-enabled --quiet drgnx 2>/dev/null; then
    if systemctl --user restart drgnx; then
      echo "drgnx update: restarted the drgnx service (systemctl --user restart drgnx). Its windows closed and emacsclient sessions lost their server; run drgnx to open a window again."
    else
      update_err "systemctl --user restart drgnx failed; restart drgnx yourself."
      return 1
    fi
  else
    echo "drgnx update: no drgnx service is installed (systemd user unit drgnx), so nothing was restarted. Restart drgnx yourself."
  fi
}

update_refresh_unit() { # an installed drgnx.service starts the Emacs drgnx uses now (core/drgnx-pkg.el); never restarts it
  if [[ "$(update_platform)" == Darwin ]]; then return 0; fi
  if ! update_step service-unit "${DRGNX_UPDATE_UNIT_CMD:-}" --refresh; then
    update_err "could not check drgnx.service (log: $(update_state_dir)/last.log)"
  fi
  return 0
}

cmd_update() { # [--quiet] [--back] [--restart] [--auto on|off|status]
  local back=0 auto="" restart=0 rc=0
  UPD_QUIET=0 UPD_RESTART=0
  while (($#)); do
    case "$1" in
      --quiet|-q) UPD_QUIET=1 ;;
      --back) back=1 ;;
      --restart) restart=1; UPD_RESTART=1 ;;
      --auto) shift; auto="${1:-}"
              case "$auto" in on|off|status) ;; *) echo "usage: drgnx update --auto on|off|status" >&2; return 2 ;; esac ;;
      *) echo "usage: drgnx update [--quiet] [--restart] | --back [--restart] | --auto on|off|status" >&2; return 2 ;;
    esac
    shift
  done
  if [[ -n "$auto" && "$restart" == 1 ]]; then echo "usage: drgnx update --auto on|off|status (no --restart: the timer never restarts)" >&2; return 2; fi
  if [[ -n "$auto" ]]; then update_auto "$auto"; return; fi
  command -v git >/dev/null 2>&1 || { update_err "git not found"; return 1; }
  update_lock || return 1
  if ((back)); then update_back || rc=$?; else update_run || rc=$?; fi
  if [[ "$rc" == 0 ]]; then update_refresh_unit; fi
  if [[ "$rc" == 0 && "$restart" == 1 ]]; then update_restart || rc=$?; fi
  return "$rc"
}

bootstrap_dir=""
cmd_bootstrap() { # [--config URL | --chezmoi URL] [--identity FILE] [--step NAME]… [--dry-run] [--yes] [--replace]
  # This machine set up from your configuration (core/drgnx-bootstrap.el; docs/guide/second-machine.md).  What needs
  # this terminal — sudo for the announced age/chezmoi install, age's passphrase — Emacs cannot run (its children
  # have no terminal): it stops with exit 10 and the command in DIR/argv; this runs it if it is one of the few below,
  # writes DIR/rc (and DIR/out), and runs bootstrap again, which goes on from that step.
  local rc=0 n=0 w out joined
  local -a words
  DRGNX_STDIN_TTY=""; if [ -t 0 ]; then DRGNX_STDIN_TTY=1; fi   # questions (and the keyring) only from a terminal
  export DRGNX_STDIN_TTY
  bootstrap_dir="$(mktemp -d "${TMPDIR:-/tmp}/drgnx-bootstrap.XXXXXX")"
  trap 'rm -rf -- "$bootstrap_dir"' EXIT
  while :; do
    rc=0
    DRGNX_BOOTSTRAP_HANDBACK="$bootstrap_dir" "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' \
      -L "$here/core" -L "$here/wb" -l drgnx-bootstrap -f drgnx-bootstrap-cli -- "$@" || rc=$?
    [ "$rc" -eq 10 ] || return "$rc"
    n=$((n + 1))
    if [ "$n" -gt 8 ] || [ ! -f "$bootstrap_dir/argv" ]; then
      echo "drgnx bootstrap: stopped (no command to run, or too many)" >&2; return 1
    fi
    words=()
    while IFS= read -r w; do
      case "$w" in ""|*[[:space:]]*) echo "drgnx bootstrap: refused a command it does not know (nothing was run)" >&2; return 1 ;; esac
      words+=("$w")
    done <"$bootstrap_dir/argv"
    rm -f -- "$bootstrap_dir/argv" "$bootstrap_dir/out"
    joined="${words[*]-}"
    rc=0
    case "$joined" in   # the recipes' root lines (drgnx-onboard-install-recipes) and the passphrase import, nothing else
      "sudo dnf install -y age"|"sudo dnf install -y chezmoi"|"sudo apt-get install -y age"|\
      "sudo pacman -S --noconfirm age"|"sudo pacman -S --noconfirm chezmoi")
        "${words[@]}" || rc=$? ;;
      "secrets import"|"secrets import --replace")
        out="$(cmd_secrets "${words[@]:1}")" || rc=$?   # its lines are hosts and what happened to them, never a key
        [ -z "$out" ] || printf '%s\n' "$out"
        printf '%s\n' "$out" >"$bootstrap_dir/out" ;;
      *) echo "drgnx bootstrap: refused a command it does not know (nothing was run)" >&2; return 1 ;;
    esac
    printf '%s\n' "$rc" >"$bootstrap_dir/rc"
  done
}

usage() {
  cat <<'USAGE'
usage: drgnx PATH…             open folders and files in drgnx, like code . (docs/guide/opening.md)
       drgnx open [PATH…]      the same; no PATH: drgnx with your windows (started in the background if needed)
       drgnx -t [PATH…]        the same in this terminal (also `drgnx open -t'); chosen by itself, when you
                               type it in a terminal, over SSH or with no display (docs/guide/opening.md)
       drgnx --gui [PATH…]     a window, even over SSH or without a display (also `drgnx open --gui')
       drgnx open --wait FILE… open FILEs and return when you are done with them (C-x #): drgnx as $EDITOR
       drgnx open --check      start drgnx's daemon if needed, print its Emacs version, stop it if this started it
       drgnx macos-app         macOS: install drgnx.app into ~/Applications (Finder, Spotlight, Dock, Open With)
       drgnx build             byte-compile drgnx (core, wb, modules); native compilation follows on load
       drgnx update [--quiet]  update this install to GitHub main: fast-forward, then sync and build; the previous
                               commit is kept and comes back if sync or build fails (docs/guide/install.md)
       drgnx update --restart  after a successful update (or --back), restart the drgnx service (systemd)
       drgnx update --back     return to the commit before the last update (re-sync, rebuild)
       drgnx update --auto on|off|status
                               a daily timer (systemd user timer; launchd agent on macOS) running update --quiet
       drgnx doctor [--json] [--dev]
                               is this machine ready for drgnx? (--dev: also the tools to develop it)
       drgnx test [--one-process] [--leaks] [--shuffle[=SEED]]
                               batch tests, each test file in an Emacs of its own
                               (--one-process: all in one Emacs, to find a leak across files;
                               --leaks: the leak census, which names each leak's test and source file;
                               --shuffle: each file's tests in a random order, the seed printed and kept)
       drgnx test [--shuffle=SEED] --find-polluter TEST [FILE…]
                               which test before TEST makes it fail? (halves them, in one Emacs per run)
       drgnx test --stress N [--load K] [--ui|--tty|--scenario]
                               the tests DRGNX_TEST_SELECTOR picks, N times in fresh Emacsen, while K busy loops
                               run; prints the runs that failed and how often each test did (heavy lease)
       drgnx test --ui [--compositor mutter|sway|x11|i3|kwin|niri]
                               GUI tests in a headless session (mutter; or sway, Xvfb, Xvfb with i3, KWin, niri)
       drgnx test --tty        terminal tests: Emacs in private tmux servers (needs tmux; docs/develop/harness.md)
       drgnx test --bench      the workbench vs treemacs and ibuffer, timed in a GUI session
       drgnx test --perf [--audit | --ab REF [--n N]]
                               input latency, redisplay, frames, GC, startup, memory against budgets
                               (--audit: what each hook function costs, not judged)
       drgnx test --soak [MIN] the workloads in a loop for MIN minutes (30); memory must hold
       drgnx test --scenario [--config drgnx|gryphn|DIR]
                               behaviour scenarios in a session of that configuration
       drgnx test --container [--ui [--compositor C]]
                               the same inside a fedora:45 / Nidhogg 31.1 container (GUI: capped at 3 GB, no swap;
                               DRGNX_TEST_GUI_MEMORY overrides; image builds 3 GB, DRGNX_TEST_BUILD_MEMORY)
                               (podman, else docker, else nerdctl; DRGNX_CONTAINER overrides)
       drgnx test --container --tty [--fedora 45]
                               the terminal tier in a container (45: Nidhogg 31.1, the default; 44's 30.2 is no longer supported)
       drgnx test --install [NAME…]
                               install.sh end to end in fresh distribution containers (slow;
                               names: fedora-44 debian-trixie ubuntu-26.04 fedora-45 archlinux)
       drgnx test --bootstrap [--fedora 44|45]
                               the exit test of a second machine: install.sh --yes --config … --identity …
                               in a fresh Fedora container (default 45) must end in a green doctor,
                               with the keys in the keyring and a second run changing nothing (slow, network)
       drgnx sync [--offline] [--seed DIR] [--prune [--dry-run]]
                               install the packages drgnx needs (the only thing that installs);
                               --offline: from the lock and the cache; --seed: copy another elpa first;
                               --prune: remove the packages the manifest no longer needs (listed);
                               --prune --dry-run: only list them
       drgnx upgrade           newest packages; the previous generation comes back if they break
       drgnx rollback [N]      the packages of generation N (default: the one before)
       drgnx generations | lock
       drgnx lock --ship       (maintainers) write etc/drgnx.lock.eld, the known-good lock a first sync
                               starts from, from your lock (it must cover every module's packages)
       drgnx onboard [--non-interactive] [--again] [--preset minimal|ide|full-ai] [--keys NAME] [--theme THEME]
                     [--roots DIR…] [--todos] [--step ID]
                               set drgnx up: environment, keys, projects onto the board, daemon unit (docs/guide/onboarding.md)
       drgnx check [--no-perf] [--no-gui] [--leaks] [--jobs N] [--shards N]
                               build, then every test tier at once where it is safe (unit and live tests
                               sharded; GUI jobs as memory allows; bench, then perf, alone); one summary
       drgnx fmt [--check] [FILE…]
                               format drgnx's Emacs Lisp (all of it, or FILEs); --check: only report
       drgnx work record [--task ID] [SHA…]
                               link commits (default HEAD) to a task (default $DRGNX_TASK); no commit message changes
       drgnx work scan [--board FILE] [DIR…]
                               read specs, plans, ledgers and the board into the work tracker (docs/guide/work.md)
       drgnx work status [--json]
                               every plan: tasks, steps, TODOs and commits done, branch, merged
       drgnx hub start|stop|status [--json]
                               the hub: the durable process behind agents and their gateway (docs/guide/agents.md)
       drgnx job propose PLAN [--repo DIR] [--budget USD] [--auto]
                               a job from a plan: tasks, routes, estimate; nothing starts before approve
       drgnx job approve|resume ID [--budget USD] | stop ID | status [ID] [--json]
                               run, pause and inspect jobs in the hub (docs/guide/jobs.md)
       drgnx search index ROOT [--rebuild]
                               build or refresh a project's semantic search index (docs/guide/search.md)
       drgnx search query ROOT QUESTION… [-k N]
                               the best chunks as PATH:LINE: first line (the notice, if any, on stderr)
       drgnx search mcp [ROOT] serve the `search' tool to an agent over stdio (MCP; ROOT default: here)
       drgnx coord mcp --kind KIND
                               serve the coordination tools to an agent outside drgnx (claude, codex, zed…)
                               over stdio (MCP), started in its project folder (docs/guide/agents.md)
       drgnx secrets export [--recipient R]… | import [--identity FILE] [--replace] | ls [--identity FILE]
                               your provider keys to a second machine: secrets.age (age), then into its
                               keyring (a passphrase, or age keys; docs/guide/second-machine.md)
       drgnx bootstrap [--config URL | --chezmoi URL] [--identity FILE] [--step NAME]… [--dry-run] [--yes] [--replace]
                               this machine from your configuration: preflight, config (cloned into an
                               empty config dir), keys, sync, onboard, desktop, shell, doctor; asks before
                               keys, desktop and shell (--yes: never the rc line or the desktop entry)
       drgnx safe              Emacs with drgnx's core only: no modules, no packages
       drgnx bisect [-- CMD…]  find the module that breaks (CMD fails, or you say so)
       drgnx service-unit [DIR | --refresh]
                               the systemd user unit (printed, or written to DIR; never installed);
                               --refresh points an installed unit at the Emacs drgnx uses
       drgnx shell install [--shell zsh|bash|fish] [--yes]
                               add one line to your shell's rc file, after you say yes (--yes: print it,
                               write nothing); drgnx shell line prints the line (docs/guide/shell.md)
       drgnx lease light|heavy|exclusive [--wait SECS] -- CMD…
                               run CMD in a slot of the host lease, shared by every checkout (drgnx lease status
                               lists the holders; docs/develop/check.md)
       drgnx ui COMMAND        headless GUI Emacs sessions: start, stop, ls, reap, state, shot,
                               click, keys, type, measure (drgnx ui --help; docs/develop/harness.md)
USAGE
}

case "${1:-help}" in
  doctor) shift; cmd_doctor "$@" ;;
  build) cmd_build ;;
  test) shift; lease_self "$(lease_test_class "$@")" test "$@"; cmd_test "$@" ;;
  lease) shift; cmd_lease "$@" ;;
  ui) shift; ui "$@" ;;
  sync|upgrade|rollback|generations|lock|bisect|service-unit)
        "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" \
              -l drgnx-pkg -f drgnx-pkg-cli -- "$@" ;;
  onboard) shift
        "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" -L "$here/wb" \
              -l drgnx-onboard -f drgnx-onboard-cli -- "$@" ;;
  safe) shift; DRGNX_SAFE=1 exec "$(emacs_bin || echo false)" --init-directory="$here/init" "$@" ;;
  hub) shift   # Ratatoskr's own CLI: start is ensure; no Emacs runs, but a hub it starts serves this Emacs and checkout
        sub="${1:-}"; [ "$#" -gt 0 ] && shift
        case "$sub" in start) sub=ensure ;; stop | status) ;; *) echo "usage: drgnx hub start|stop|status [--json]" >&2; exit 2 ;; esac
        rtsk="${DRGNX_RATATOSKR_BIN:-}"
        if [[ "$rtsk" != /* || ! -f "$rtsk" || ! -x "$rtsk" ]]; then rtsk="$(drgnx_dir data)/bin/ratatoskr"; fi
        if [[ ! -f "$rtsk" || ! -x "$rtsk" ]]; then echo "drgnx: Ratatoskr is not built: run \`drgnx runtime build'" >&2; exit 1; fi
        if [[ -z "${DRGNX_EMACS:-}" ]] && DRGNX_EMACS="$(emacs_bin 2>/dev/null)"; then export DRGNX_EMACS; fi
        DRGNX_DIR="$here" exec "$rtsk" "$sub" "$@" ;;
  job) shift
        "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" \
              -l drgnx-hub -f drgnx-job-cli -- "$@" ;;
  work) shift
        "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" \
              -l drgnx-work -f drgnx-work-cli -- "$@" ;;
  search) shift
        sub="${1:-}"; [ "$#" -gt 0 ] && shift
        case "$sub" in
          index) "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" \
                       -l drgnx-search-index -f drgnx-search-index-cli "$@" ;;
          query) "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" \
                       -l drgnx-search-mcp -f drgnx-search-mcp-query-cli -- "$@" ;;
          mcp) "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" \
                     -l drgnx-search-mcp -f drgnx-search-mcp-main -- "$@" ;;
          *) echo "usage: drgnx search index ROOT [--rebuild] | query ROOT QUESTION… [-k N] | mcp [ROOT]" >&2; exit 2 ;;
        esac ;;
  coord) shift
        # an agent outside drgnx: exec, so the server's parent is the agent (its identity); no cd (the folder it
        # starts in is where the agent works); a drgnx session's identity in the agent's shell is not inherited
        if [[ "${1:-}" == mcp && "${2:-}" == --kind && "$#" -eq 3 && "$3" =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]]; then
          unset DRGNX_AGENT DRGNX_JOB DRGNX_TASK
          trap '' PIPE
          DRGNX_AGENT_KIND="$3" exec "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" \
               -l drgnx-coord-mcp -f drgnx-coord-mcp-main
        fi
        echo "usage: drgnx coord mcp --kind KIND   (KIND: a short lower-case name: claude, codex, zed…)" >&2; exit 2 ;;
  keys) shift
        if [[ "${1:-}" != diff ]]; then
          echo "usage: drgnx keys diff --against gryphn DIR   (or set DRGNX_GRYPHN_DIR to gryphn's emacs/ directory)" >&2
          exit 2
        fi
        shift
        "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/harness" -L "$here/core" -L "$here/wb" \
              -l drgnx-keys-diff -f drgnx-keys-diff-cli -- "$@" ;;
  shell) shift
        DRGNX_STDIN_TTY=$([ -t 0 ] && echo 1 || echo 0) \
        "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" \
              -l drgnx-shell -f drgnx-shell-cli -- "$@" ;;
  check) shift; lease_self exclusive check "$@"; run_in_tmp_shards check_emacs "$@" ;;
  fmt) shift
        "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" \
              -l drgnx-fmt -f drgnx-fmt-cli -- "$@" ;;
  update) shift; cmd_update "$@" ;;
  open) shift; cmd_open "$@" ;;
  -t|--gui) cmd_open "$@" ;;
  macos-app) "$(emacs_bin || echo false)" --batch -Q --eval '(setq load-prefer-newer t)' -L "$here/core" -l drgnx-macos -f drgnx-macos-cli ;;
  secrets) shift; cmd_secrets "$@" ;;
  bootstrap) shift; cmd_bootstrap "$@" ;;
  help|-h|--help) usage ;;
  *) if [[ "$1" == . || "$1" == .. || "$1" == */* || -e "$1" ]]; then cmd_open "$@"; exit; fi   # drgnx PATH…
     echo "drgnx: unknown command '$1' (try: drgnx help)" >&2; exit 2 ;;
esac
