#!/usr/bin/env bash
# drgnx — command-line entry point (pre-release; see docs/roadmap.md).
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

check() { # NAME CMD FIX
  if bash -c "$2" >/dev/null 2>&1; then printf '%-24s ok\n' "$1"; else printf '%-24s FAIL  %s\n' "$1" "$3"; return 1; fi
}

cmd_doctor() {
  local rc=0
  check "emacs >= 30.2" \
    "emacs --batch -Q --eval '(kill-emacs (if (version<= \"30.2\" emacs-version) 0 1))'" \
    "install GNU Emacs 31.1+ (30.2 works until every platform ships 31.1)" || rc=1
  check "ui: mutter" "command -v mutter" "install mutter (headless compositor for drgnx test --ui)" || rc=1
  check "ui: dbus-run-session" "command -v dbus-run-session" "install dbus-daemon" || rc=1
  check "ui: magick" "command -v magick" "install ImageMagick 7 (screenshot compositing)" || rc=1
  check "ui: systemd --user" "systemctl --user list-units --no-legend" \
    "a systemd user session is needed for drgnx ui start" || rc=1
  check "ui: pgtk emacs" \
    "${DRGNX_EMACS:-emacs-pgtk} --batch -Q --eval '(kill-emacs (if (featurep (quote pgtk)) 0 1))'" \
    "install emacs-pgtk (or set DRGNX_EMACS to a pgtk build)" || rc=1
  return "$rc"
}

ui() { # the harness controller, in batch Emacs (harness/drgnx-ui.el)
  emacs --batch -Q -L "$here/harness" -l drgnx-ui -f drgnx-ui-cli -- "$@"
}

test_batch() {
  emacs --batch -Q -L "$here/harness" -l "$here/harness/run-ert.el" \
        -f drgnx-run-ert-batch "$here/test/unit"
}

test_podman() {
  podman build -q -t drgnx-test:f45 "$here/test/podman" >/dev/null
  podman run --rm -v "$here:/src:ro,Z" -w /src drgnx-test:f45 bin/drgnx test
}

cmd_test() {
  case "${1:-}" in
    "") test_batch ;;
    --ui) ui test-ui ;;
    --podman) test_podman ;;
    *) echo "usage: drgnx test [--ui|--podman]" >&2; exit 2 ;;
  esac
}

usage() {
  cat <<'USAGE'
usage: drgnx doctor            check this machine
       drgnx test [--podman]   batch tests (on the host, or in a fedora:45 / Emacs 31.1 container)
       drgnx test --ui         GUI tests in a headless session (mutter)
       drgnx ui COMMAND        headless GUI Emacs sessions: start, stop, ls, reap, state, shot,
                               click, keys, type, measure (drgnx ui --help; docs/harness.md)
USAGE
}

case "${1:-help}" in
  doctor) shift; cmd_doctor "$@" ;;
  test) shift; cmd_test "$@" ;;
  ui) shift; ui "$@" ;;
  help|-h|--help) usage ;;
  *) echo "drgnx: unknown command '$1' (try: drgnx help)" >&2; exit 2 ;;
esac
