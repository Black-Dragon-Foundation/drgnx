        (replace-undo :none "the view's Undo button; the palette")
        (replace-next "<f4>")
        (replace-prev "S-<f4>" "S-<return>" :map (drgnx-replace . drgnx-replace-keys-map))
        (replace-bar-close "<escape>" :map (drgnx-replace . drgnx-replace-bar-keys-map))
        (layout-next "C-k C-l")
