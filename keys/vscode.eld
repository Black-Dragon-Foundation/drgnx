;; VS Code key profile — command id → keys (docs/keys.md).  On macOS, C- becomes s- (Cmd).
(:name "VS Code"
 :doc "Visual Studio Code's default keys"
 :mac-cmd t
 :bind ((palette "C-S-p" "<f1>")
        (keys-sheet "C-k C-s")
        (keyboard-profile "C-k C-p")
        (open-file "C-o")
        (save-file "C-s")
        (line-numbers :none "VS Code has no default key for line numbers")
        (modules-report :none "drgnx-only; in the palette")
        (toggle-sidebar "C-b")
        (wb-unrouted :none "in the palette")
        (onboarding :none "Help → Welcome; the palette")
        (onboarding-environment :none "the Welcome list; the palette")
        (onboarding-look-and-keys :none "the Welcome list; the palette")
        (onboarding-projects :none "the Welcome list; the palette")
        (onboarding-ai :none "the Welcome list; the palette")
        (onboarding-search :none "the Welcome list; the palette")
        (onboarding-agents :none "the Welcome list; the palette")
        (onboarding-daemon :none "the Welcome list; the palette")
        (onboarding-portability :none "the Welcome list; the palette")
        (onboarding-finish :none "the Welcome list; the palette")
        (file-save-as "C-S-s")
        (file-new "C-n")
        (file-reopen-tab "C-S-t")
        (file-new-window "C-S-n")
        (file-close-window "C-q")
        (go-recent "C-<tab>")
        (go-symbol-project "C-t")
        (go-back "M-<left>")
        (go-forward "M-<right>")
        (search-file "C-f")
        (search-replace "C-S-h")
        (edit-select-all "C-S-a")
        (edit-select-line "C-l")
        (edit-next-occurrence "C-d")
        (edit-all-occurrences "C-S-l")
        (edit-redo "C-S-z")
        (edit-comment "C-/")
        (edit-delete-line "C-S-k")
        (edit-move-up "M-<up>")
        (edit-move-down "M-<down>")
        (edit-duplicate "M-S-<down>")
        (edit-line-below "C-<return>")
        (edit-line-above "C-S-<return>")
        (code-quick-fix "C-.")
        (code-problems "C-S-m")
        (code-format :none "in the palette (VS Code's C-S-i is the LLM Menu here, as in gryphn)")
        (view-zoom-in "C-=" "C-+")
        (view-zoom-out "C--")
        (view-zoom-reset "C-0")
        (view-escape "<escape>")
        (buffers-save :none "the Buffers right-click menu")
        (buffers-copy-path :none "the Buffers right-click menu")
        (buffers-reveal :none "the Buffers right-click menu")
        (buffers-full-view :none "in the palette")
        (explorer-reveal-in-buffers :none "the Explorer's right-click menu")
        (explorer-open-in-dired :none "the Explorer's right-click menu")
        (explorer-other-window :none "the Explorer's right-click menu")
        (view-panel-next "M-`")
        (help-mode-menu "C-'")
        (go-window-pick "M-o")
        (go-jump "C-;")
        (edit-undo-tree :none "in the palette")
        (search-edit-results "C-c C-p" :map (grep . grep-mode-map))
        (search-apply-edits "C-s" :map (wgrep . wgrep-mode-map))
        (git-hunk-show :none "in the palette")
        (git-hunk-revert :none "in the palette")
        (git-hunk-stage :none "in the palette")
        (view-keycast :none "in the palette")
        (llm-menu "C-S-i")
        (llm-send "C-c RET")
        (code-definition "<f12>")
        (code-references "S-<f12>")
        (code-rename "<f2>")
        (code-hover "C-S-SPC")
        (scm-view "C-S-g")
        (buffers-diff :none "in the palette and the Buffers right-click menu")
        (scm-blame :none "in the palette")
        (terminal-new "C-S-`")
        (explorer-terminal-here :none "the Explorer's right-click menu")
        (go-quick-open "C-p")
        (search-project "C-S-f")
        (go-symbol "C-S-o")
        (org-capture "C-c c")
        (org-agenda "C-c a")
        (edit-fold "C-{")
        (edit-unfold "C-}")
        (edit-case-cycle :none "in the palette")
        (edit-case-camel :none "in the palette")
        (edit-case-snake :none "in the palette")
        (edit-case-kebab :none "in the palette")
        (edit-expand "M-S-<right>")
        (edit-shrink "M-S-<left>")
        (go-line :none "M-g g (C-g is quit in Emacs)")
        (preferences-theme :none "in the palette and the Options menu")
        (view-zen "C-k z" "<f11>")
        (preferences-modules "C-,")
        (modules-toggle "RET")
        (move-editor-to-new-window :none "in the palette")
        (open-editor-in-new-window "C-k o")
        (move-group-to-new-window :none "in the palette")
        (buffers-toggle-all-windows :none "in the palette")
        (focus-outline "C-M-o")
        (outline-open "RET")
        (wb-save-layout :none "in the palette (also on exit)")
        (wb-restore-layout :none "in the palette (also at start)")
        (split-editor-right "C-\\")
        (split-editor-down "C-k C-\\")
        (close-group "C-k w")
        (focus-group-1 "C-1" "M-1")
        (focus-group-2 "C-2" "M-2")
        (focus-group-3 "C-3" "M-3")
        (move-editor-to-next-group "C-M-<right>")
        (close-tab "C-w" "C-<f4>")
        (next-tab "C-<next>")
        (previous-tab "C-<prior>")
        (toggle-panel "C-`" "M-j")
        (focus-panel :none "in the palette")
        (toggle-right-dock "C-M-b")
        (focus-editor :none "C-1 focuses group 1 (the editor, with one group)")
        (dock-back "<escape>")
        (focus-explorer "C-S-e")
        (explorer-next "<down>")
        (explorer-previous "<up>")
        (explorer-expand "<right>")
        (explorer-collapse "<left>")
        (explorer-open "RET")
        (explorer-preview "SPC")
        (explorer-toggle :none "a click or <right>/<left>")
        (explorer-refresh :none "the title bar's refresh (M3b); in the palette")
        (explorer-select-down "S-<down>")
        (explorer-select-up "S-<up>")
        (explorer-mark "C-SPC")
        (explorer-find "C-M-f")
        (explorer-find-clear :none "Find with an empty text; the palette")
        (explorer-new-file :none "the Explorer's right-click menu and the palette")
        (explorer-rename "<f2>")
        (explorer-delete "<delete>")
        (explorer-delete-permanently "S-<delete>")
        (explorer-copy "C-c")
        (explorer-cut "C-x")
        (explorer-paste "C-v")
        (explorer-copy-path "M-S-c")
        (explorer-copy-relative-path "C-M-S-c")
        (explorer-reveal-externally "M-S-r")
        (focus-buffers "C-k e" "C-S-b")
        (buffers-next "<down>")
        (buffers-previous "<up>")
        (buffers-open "RET")
        (buffers-close "<delete>")
        (buffers-close-others :none "right-click; the palette")
        (buffers-filter "C-M-f")
        (save-all "C-k s")
        (close-saved "C-k u")
        (close-all "C-k C-w")))
