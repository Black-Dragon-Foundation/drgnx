;; VS Code key profile — command id → keys (docs/guide/keys.md).  On macOS, C- becomes s- (Cmd), except
;; where VS Code's own macOS key differs: :mac gives that one (from VS Code's default keybindings for macOS).
(:name "VS Code"
 :doc "Visual Studio Code's default keys"
 :mac-cmd t
 :bind ((palette "C-S-p" "<f1>")
        (keys-sheet "C-k C-r")
        (keyboard-profile "C-k C-p")
        (quit :none "File → Quit drgnx; C-q closes the window as in VS Code" :mac "s-q")
        (preferences-keep-running :none "in the palette and the Options menu")
        (open-folder "C-k C-o")
        (open-file "C-o")
        (save-file "C-s")
        (line-numbers :none "VS Code has no default key for line numbers")
        (modules-report :none "drgnx-only; in the palette")
        (toggle-sidebar "C-b")
        (wb-unrouted :none "in the palette")
        (agents-view "C-k a")
        (agents-new :none "the Agents tab and transcripts; the palette")
        (agents-new-durable :none "the palette")
        (agents-send :none "the Agents tab and transcripts; the palette")
        (agents-stop "C-c C-c" :map drgnx-agents-transcript-mode-map :mac "C-c C-c")   ; Emacs' C-c keys stay
        (agents-deliver "C-c C-d" :map drgnx-agents-transcript-mode-map :mac "C-c C-d") ; on a Mac: s-c copies
        (agents-edit-queued :none "the [×] buttons in a transcript; the palette")
        (agents-take-over :none "the Agents tab and transcripts; the palette")
        (agents-answer :none "the Agents tab and transcripts; the palette")
        (jobs-log :none "the Agents tab and transcripts; the palette")
        (jobs-stop :none "the Agents tab and transcripts; the palette")
        (job-start :none "the palette")
        (job-approve :none "the palette")
        (job-status :none "the palette")
        (job-stop :none "the palette")
        (job-show :none "the palette")
        (grammars-install :none "the palette")
        (format-on-save :none "the palette")
        (debug-start "<f5>")
        (debug-breakpoint "<f9>")
        (debug-step-over "<f10>")
        (debug-step-in "<f11>" :map drgnx-debug-session-map)
        (debug-step-out "S-<f11>")
        (debug-stop "S-<f5>")
        (toggle-indent-guides :none "the palette")
        (toggle-smooth-scrolling :none "the palette")
        (toggle-sticky-scroll :none "the palette")
        (markdown-preview "C-S-v")
        (diff-working :none "the palette")
        (diff-staged :none "the palette")
        (diff-branch :none "the palette")
        (diff-toggle-file "TAB" :map drgnx-diff-mode-map)
        (diff-next-file "n" :map drgnx-diff-mode-map)
        (diff-prev-file "p" :map drgnx-diff-mode-map)
        (diff-visit "RET" :map drgnx-diff-mode-map)
        (diff-toggle-layout "s" :map drgnx-diff-mode-map)
        (diff-collapse-all :none "the palette")
        (diff-expand-all :none "the palette")
        (toggle-inline-blame :none "the palette")
        (blame-show-commit :none "the palette")
        (git-generate-commit-message :none "the palette")
        (review-branch :none "the palette")
        (review-view :none "the palette")
        (review-refresh :none "the palette")
        (review-visit "RET" :map drgnx-review-mode-map)
        (review-show-diff "d" :map drgnx-review-mode-map)
        (prs-view :none "the palette")
        (prs-fetch :none "the palette")
        (prs-open "RET" :map drgnx-prs-mode-map)
        (prs-changes "d" :map drgnx-prs-mode-map)
        (prs-toggle-closed :none "the palette")
        (agents-open "RET")
        (projects-sync-plans :none "in the palette")
        (work-view "C-k t")
        (work-graph :none "the Work tab; the palette")
        (work-start-agent :none "the Work tab; the palette")
        (work-open-worktree :none "the Work tab; the palette")
        (work-open "RET")
        (work-toggle "TAB")
        (work-refresh "g")
        (work-filter "f")
        (work-hide-merged "m")
        (ai-tab "TAB" :map drgnx-ai-ghost-mode-map)
        (ai-accept :none "Tab while a suggestion shows; the palette")
        (ai-accept-word "C-<right>" :map drgnx-ai-ghost-showing-map)
        (ai-accept-line :none "the palette")
        (ai-dismiss "C-g" :map drgnx-ai-ghost-showing-map)
        (ai-complete-toggle :none "in the palette")
        (ai-edit "C-k C-e")
        (ai-edit-apply-hunk "C-c C-a" :map drgnx-ai-edit-review-mode-map :mac "C-c C-a")
        (ai-edit-done "C-c C-c" :map drgnx-ai-edit-review-mode-map :mac "C-c C-c")
        (ai-edit-reject "C-c C-k" :map drgnx-ai-edit-review-mode-map :mac "C-c C-k")
        (ai-ask :none "in the palette")
        (ai-choose :none "in the palette")
        (ai-load-keys :none "drgnx open runs it once per start; the palette")
        (agents-reply "RET")
        (agents-review-done "C-c C-c" :mac "C-c C-c")
        (agents-review-reject "C-c C-k" :mac "C-c C-k")
        (onboarding :none "Help → Welcome; the palette")
        (onboarding-environment :none "the Welcome list; the palette")
        (onboarding-look-and-keys :none "the Welcome list; the palette")
        (onboarding-projects :none "the Welcome list; the palette")
        (onboarding-ai :none "the Welcome list; the palette")
        (onboarding-search :none "the Welcome list; the palette")
        (onboarding-agents :none "the Welcome list; the palette")
        (onboarding-daemon :none "the Welcome list; the palette")
        (onboarding-portability :none "the Welcome list; the palette")
        (onboarding-finish :none "the Welcome list; the palette")
        (file-save-as "C-S-s")
        (file-new "C-n")
        (file-reopen-tab "C-S-t")
        (file-new-window "C-S-n")
        (file-close-window "C-q" :mac "s-W")
        (go-recent "C-<tab>" :mac "C-<tab>")
        (go-symbol-project "C-t")
        (go-back "M-<left>" :mac "C--")
        (go-forward "M-<right>" :mac "C-_")
        (search-file "C-f")
        (search-replace :none "C-S-h is Replace in Files (replace-in-files); the palette")
        (edit-select-all "C-S-a" :mac "s-a")
        (edit-select-line "C-l")
        (edit-next-occurrence "C-d")
        (edit-all-occurrences "C-S-l")
        (edit-redo "C-S-z")
        (edit-comment "C-/")
        (edit-delete-line "C-S-k")
        (edit-move-up "M-<up>")
        (edit-move-down "M-<down>")
        (edit-duplicate "M-S-<down>")
        (edit-line-below "C-<return>")
        (edit-line-above "C-S-<return>")
        (edit-line-start "<home>" :mac ("s-<left>" "<home>"))
        (edit-line-end "<end>" :mac ("s-<right>" "<end>"))
        (edit-buffer-start "C-<home>" :mac "s-<up>")
        (edit-buffer-end "C-<end>" :mac "s-<down>")
        (edit-word-left "C-<left>" :mac "M-<left>")
        (edit-word-right "C-<right>" :mac "M-<right>")
        (edit-delete-word-back "C-<backspace>" :mac "M-<backspace>")
        (edit-delete-line-back :none "VS Code has no Linux key for it" :mac "s-<backspace>")
        (code-quick-fix "C-.")
        (code-problems "C-S-m")
        (code-format :none "in the palette (VS Code's C-S-i is the LLM Menu here, as in gryphn)")
        (view-zoom-in "C-=" "C-+")
        (view-zoom-out "C--")
        (view-zoom-reset "C-0")
        (view-escape "<escape>")
        (buffers-save :none "the Buffers right-click menu")
        (buffers-copy-path :none "the Buffers right-click menu")
        (buffers-reveal :none "the Buffers right-click menu")
        (buffers-full-view :none "in the palette")
        (explorer-reveal-in-buffers :none "the Explorer's right-click menu")
        (explorer-open-in-dired :none "the Explorer's right-click menu")
        (explorer-other-window :none "the Explorer's right-click menu")
        (view-panel-next "M-`")
        (help-mode-menu "C-'")
        (go-window-pick "M-o")
        (go-jump "C-;")
        (edit-undo-tree :none "in the palette")
        (search-edit-results "C-c C-p" :map (grep . grep-mode-map) :mac "C-c C-p")
        (search-apply-edits "C-s" :map (wgrep . wgrep-mode-map))
        (git-hunk-show :none "in the palette")
        (git-hunk-revert :none "in the palette")
        (git-hunk-stage :none "in the palette")
        (view-keycast :none "in the palette")
        (llm-menu "C-S-i")
        (llm-send "C-c RET" :mac "C-c RET")
        (code-definition "<f12>")
        (code-references "S-<f12>")
        (code-rename :none "<f2> is Rename Symbol (rename-symbol); the palette")
        (code-hover "C-S-SPC")
        (scm-view "C-S-g" :mac "C-S-g")
        (buffers-diff :none "in the palette and the Buffers right-click menu")
        (scm-blame :none "in the palette")
        (terminal-new "C-S-`" :mac "C-S-`")
        (explorer-terminal-here :none "the Explorer's right-click menu")
        (go-quick-open "C-p")
        (search-project :none "C-S-f is View: Search; the palette")
        (search-semantic "C-k C-f")
        (search-index-project :none "in the palette")
        (search-index-status :none "in the palette")
        (search-set-up :none "in the palette")
        (go-symbol "C-S-o")
        (org-capture "C-c c" :mac "C-c c")
        (org-agenda "C-c a" :mac "C-c a")
        (edit-fold "C-{" :mac "M-s-[")
        (edit-unfold "C-}" :mac "M-s-]")
        (edit-case-cycle :none "in the palette")
        (edit-case-camel :none "in the palette")
        (edit-case-snake :none "in the palette")
        (edit-case-kebab :none "in the palette")
        (edit-expand "M-S-<right>" :mac "C-S-s-<right>")
        (edit-shrink "M-S-<left>" :mac "C-S-s-<left>")
        (go-line :none "M-g g (C-g is quit in Emacs)")
        (preferences-theme :none "in the palette and the Options menu")
        (view-zen "C-k z" "<f11>")
        (preferences-modules "C-," :mac ())   ; on a Mac s-, is All Preferences, Modules one of them
        (preferences-user-config :none "in the palette and the Options menu")
        (preferences :none "C-, is Preferences: Modules; in the palette" :mac "s-,")
        (modules-toggle "RET")
        (move-editor-to-new-window :none "in the palette")
        (open-editor-in-new-window "C-k o")
        (move-group-to-new-window :none "in the palette")
        (buffers-toggle-all-windows :none "in the palette")
        (focus-outline "C-M-o")
        (outline-open "RET")
        (wb-save-layout :none "in the palette (also on exit)")
        (wb-restore-layout :none "in the palette (also at start)")
        (split-editor-right "C-\\")
        (split-editor-down "C-k C-\\")
        (close-group :none "in the palette (VS Code has no default key)")
        (close-group-editors "C-k w")
        (focus-group-1 "C-1" "M-1")
        (focus-group-2 "C-2" "M-2")
        (focus-group-3 "C-3" "M-3")
        (move-editor-to-next-group "C-M-<right>" :mac "C-s-<right>")
        (close-tab "C-w" "C-<f4>" :mac "s-w")
        (next-tab "C-<next>" :mac "M-s-<right>")
        (previous-tab "C-<prior>" :mac "M-s-<left>")
        (toggle-panel "C-`" "M-j" :everywhere "C-j" :mac ("C-`" "M-j"))   ; s-` is macOS' next window
        (focus-panel :none "in the palette")
        (toggle-right-dock "C-M-b")
        (focus-editor :none "C-1 focuses group 1 (the editor, with one group)")
        (dock-back "<escape>")
        (focus-explorer :none "C-S-e is View: Explorer; the palette")
        (explorer-next "<down>")
        (explorer-previous "<up>")
        (explorer-expand "<right>")
        (explorer-collapse "<left>")
        (explorer-open "RET")
        (explorer-preview "SPC")
        (explorer-toggle :none "a click or <right>/<left>")
        (explorer-refresh :none "the title bar's refresh (M3b); in the palette")
        (explorer-select-down "S-<down>")
        (explorer-select-up "S-<up>")
        (explorer-mark "C-SPC" :mac "C-SPC")   ; s-SPC is Spotlight
        (explorer-find "C-M-f")
        (explorer-find-clear :none "Find with an empty text; the palette")
        (explorer-new-file :none "the Explorer's right-click menu and the palette")
        (explorer-rename "<f2>")
        (explorer-delete "<delete>" :mac ("s-<backspace>" "<delete>"))
        (explorer-delete-permanently "S-<delete>" :mac ("M-s-<backspace>" "S-<delete>"))
        (explorer-copy "C-c")
        (explorer-cut "C-x")
        (explorer-paste "C-v")
        (explorer-copy-path "M-S-c" :mac "M-s-c")
        (explorer-copy-relative-path "C-M-S-c")
        (explorer-reveal-externally "M-S-r" :mac "M-s-r")
        (focus-buffers "C-k e" "C-S-b")
        (buffers-next "<down>")
        (buffers-previous "<up>")
        (buffers-open "RET")
        (buffers-close "<delete>")
        (buffers-close-others :none "right-click; the palette")
        (buffers-filter "C-M-f")
        (save-all "C-k s" :mac "M-s-s")
        (close-saved "C-k u")
        (close-all "C-k C-w")
        (view-explorer "C-S-e")
        (view-search "C-S-f")
        (replace-in-files "C-S-h")
        (rename-symbol "<f2>")
        (replace-in-file "C-h")
        (replace-all "C-M-<return>" "C-<return>" :map (drgnx-replace . drgnx-replace-keys-map))
