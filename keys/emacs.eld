;; Emacs key profile — command id → keys (docs/guide/keys.md).  The emacs layer also claims Emacs' own
;; default bindings (:claims-defaults): a later layer that rebinds one of them is reported.
(:name "Emacs"
 :doc "GNU Emacs' default keys"
 :claims-defaults t
 :bind ((palette "C-S-p")
        (keys-sheet "C-h C-k")
        (keyboard-profile :none "in the palette")
        (open-file "C-x C-f")
        (save-file "C-x C-s")
        (line-numbers :none "Emacs has no default key for line numbers")
        (modules-report :none "drgnx-only; in the palette")
        (toggle-sidebar "<f8>")
        (wb-unrouted :none "in the palette")
        (agents-view :none "in the palette")
        (agents-new :none "the Agents tab and transcripts; the palette")
        (agents-new-durable :none "the palette")
        (agents-send :none "the Agents tab and transcripts; the palette")
        (agents-stop "C-c C-c" :map drgnx-agents-transcript-mode-map)
        (agents-deliver "C-c C-d" :map drgnx-agents-transcript-mode-map)
        (agents-edit-queued :none "the [×] buttons in a transcript; the palette")
        (agents-take-over :none "the Agents tab and transcripts; the palette")
        (agents-answer :none "the Agents tab and transcripts; the palette")
        (jobs-log :none "the Agents tab and transcripts; the palette")
        (jobs-stop :none "the Agents tab and transcripts; the palette")
        (job-start :none "the palette")
        (job-approve :none "the palette")
        (job-status :none "the palette")
        (job-stop :none "the palette")
        (job-show :none "the palette")
        (grammars-install :none "the palette")
        (format-on-save :none "the palette")
        (debug-start :none "the palette")
        (debug-breakpoint :none "the palette")
        (debug-step-over :none "the palette")
        (debug-step-in :none "the palette")
        (debug-step-out :none "the palette")
        (debug-stop :none "the palette")
        (toggle-indent-guides :none "the palette")
        (toggle-smooth-scrolling :none "the palette")
        (toggle-sticky-scroll :none "the palette")
        (markdown-preview :none "the palette")
        (diff-working :none "the palette")
        (diff-staged :none "the palette")
        (diff-branch :none "the palette")
        (diff-toggle-file "TAB" :map drgnx-diff-mode-map)
        (diff-next-file "n" :map drgnx-diff-mode-map)
        (diff-prev-file "p" :map drgnx-diff-mode-map)
        (diff-visit "RET" :map drgnx-diff-mode-map)
        (diff-toggle-layout "s" :map drgnx-diff-mode-map)
        (diff-collapse-all :none "the palette")
        (diff-expand-all :none "the palette")
        (agents-open "RET")
        (projects-sync-plans :none "in the palette")
        (work-view :none "in the palette")
        (work-graph :none "the Work tab; the palette")
        (work-start-agent :none "the Work tab; the palette")
        (work-open-worktree :none "the Work tab; the palette")
        (work-open "RET")
        (work-toggle "TAB")
        (work-refresh "g")
        (work-filter "f")
        (work-hide-merged "m")
        (ai-tab "TAB" :map drgnx-ai-ghost-mode-map)
        (ai-accept :none "Tab while a suggestion shows; the palette")
        (ai-accept-word "C-<right>" :map drgnx-ai-ghost-showing-map)
        (ai-accept-line :none "the palette")
        (ai-dismiss "<escape>" :map drgnx-ai-ghost-showing-map)
        (ai-complete-toggle :none "in the palette")
        (ai-edit "C-c e")
        (ai-edit-apply-hunk "C-c C-a" :map drgnx-ai-edit-review-mode-map)
        (ai-edit-done "C-c C-c" :map drgnx-ai-edit-review-mode-map)
        (ai-edit-reject "C-c C-k" :map drgnx-ai-edit-review-mode-map)
        (ai-ask :none "in the palette")
        (ai-choose :none "in the palette")
        (agents-reply "RET")
        (agents-review-done "C-c C-c")
        (agents-review-reject "C-c C-k")
        (onboarding :none "Help → Welcome; the palette")
        (onboarding-environment :none "the Welcome list; the palette")
        (onboarding-look-and-keys :none "the Welcome list; the palette")
        (onboarding-projects :none "the Welcome list; the palette")
        (onboarding-ai :none "the Welcome list; the palette")
        (onboarding-search :none "the Welcome list; the palette")
        (onboarding-agents :none "the Welcome list; the palette")
        (onboarding-daemon :none "the Welcome list; the palette")
        (onboarding-portability :none "the Welcome list; the palette")
        (onboarding-finish :none "the Welcome list; the palette")
        (file-save-as :none "C-x C-w (stock)")
        (file-new :none "in the palette")
        (file-reopen-tab :none "in the palette")
        (file-new-window :none "C-x 5 2 (stock)")
        (file-close-window :none "C-x 5 0 (stock)")
        (go-recent :none "C-x b (stock)")
        (go-symbol-project :none "C-M-. (stock)")
        (go-back :none "M-, (stock)")
        (go-forward :none "C-M-, (stock)")
        (search-file :none "C-s (stock incremental search)")
        (search-replace :none "C-x p r (stock)")
        (edit-select-all :none "C-x h (stock)")
        (edit-select-line :none "in the palette")
        (edit-next-occurrence :none "in the palette")
        (edit-all-occurrences :none "in the palette")
        (edit-redo :none "C-? (stock)")
        (edit-comment :none "C-x C-; (stock)")
        (edit-delete-line :none "C-S-<backspace> (stock)")
        (edit-move-up :none "in the palette")
        (edit-move-down :none "in the palette")
        (edit-duplicate :none "in the palette")
        (edit-line-below :none "in the palette")
        (edit-line-above :none "in the palette (C-o opens a line)")
        (code-quick-fix :none "in the palette")
        (code-problems :none "in the palette")
        (code-format :none "in the palette")
        (view-zoom-in :none "C-x C-+ (stock)")
        (view-zoom-out :none "C-x C-- (stock)")
        (view-zoom-reset :none "C-x C-0 (stock)")
        (view-escape :none "C-g, ESC ESC ESC (stock)")
        (buffers-save :none "the Buffers right-click menu")
        (buffers-copy-path :none "the Buffers right-click menu")
        (buffers-reveal :none "the Buffers right-click menu")
        (buffers-full-view :none "C-x C-b is the Buffers panel; ibuffer in the palette")
        (explorer-reveal-in-buffers :none "the Explorer's right-click menu")
        (explorer-open-in-dired :none "the Explorer's right-click menu")
        (explorer-other-window :none "the Explorer's right-click menu")
        (view-panel-next :none "in the palette")
        (help-mode-menu :none "C-mouse-3 (stock)")
        (go-window-pick :none "C-x o (stock)")
        (go-jump :none "in the palette")
        (edit-undo-tree :none "in the palette")
        (search-edit-results :none "wgrep's own C-c C-p")
        (search-apply-edits :none "wgrep's own C-c C-c")
        (git-hunk-show :none "diff-hl's own C-x v *")
        (git-hunk-revert :none "diff-hl's own C-x v n")
        (git-hunk-stage :none "diff-hl's own C-x v S")
        (view-keycast :none "in the palette")
        (llm-menu :none "in the palette")
        (llm-send "C-c RET")
        (code-definition :none "M-. (stock)")
        (code-references :none "M-? (stock)")
        (code-rename :none "in the palette")
        (code-hover :none "C-h . (stock)")
        (scm-view :none "C-x v d (stock)")
        (buffers-diff :none "in the palette")
        (scm-blame :none "C-x v g (stock)")
        (terminal-new :none "in the palette")
        (explorer-terminal-here :none "the Explorer's right-click menu")
        (go-quick-open :none "C-x p f (stock)")
        (search-project :none "C-x p g (stock)")
        (search-semantic "C-c s s")
        (search-index-project :none "in the palette")
        (search-index-status :none "in the palette")
        (search-set-up :none "in the palette")
        (go-symbol :none "M-g i (stock)")
        (org-capture "C-c c")
        (org-agenda "C-c a")
        (edit-fold :none "in the palette (hideshow: C-c @ C-h)")
        (edit-unfold :none "in the palette (hideshow: C-c @ C-s)")
        (edit-case-cycle :none "in the palette")
        (edit-case-camel :none "in the palette")
        (edit-case-snake :none "in the palette")
        (edit-case-kebab :none "in the palette")
        (edit-expand :none "in the palette (C-M-SPC marks an expression)")
        (edit-shrink :none "in the palette")
        (go-line :none "M-g g (stock)")
        (preferences-theme :none "in the palette and the Options menu")
        (view-zen :none "in the palette")
        (preferences-modules :none "in the palette and the Options menu")
        (modules-toggle "RET")
        (move-editor-to-new-window :none "in the palette; C-x 5 2 makes a frame (stock)")
        (open-editor-in-new-window :none "C-x 5 2 (stock)")
        (move-group-to-new-window :none "in the palette")
        (buffers-toggle-all-windows :none "in the palette")
        (focus-outline :none "in the palette")
        (outline-open "RET")
        (wb-save-layout :none "in the palette (also on exit)")
        (wb-restore-layout :none "in the palette (also at start)")
        (split-editor-right :none "C-x 3 splits (stock)")
        (split-editor-down :none "C-x 2 splits (stock)")
        (close-group :none "C-x 0 (stock)")
        (close-group-editors :none "in the palette")
        (focus-group-1 :none "C-x o moves between windows")
        (focus-group-2 :none "C-x o moves between windows")
        (focus-group-3 :none "C-x o moves between windows")
        (move-editor-to-next-group :none "in the palette")
        (close-tab :none "in the palette")
        (next-tab :none "C-x <right> / C-x <left> stay Emacs' next-buffer / previous-buffer")
        (previous-tab :none "C-x <left> stays Emacs' previous-buffer")
        (toggle-panel :none "in the palette")
        (focus-panel :none "in the palette")
        (toggle-right-dock :none "in the palette")
        (focus-editor :none "C-x o moves between windows")
        (dock-back "q")
        (focus-explorer "C-x M-e")
        (explorer-next "n" "C-n" "<down>")
        (explorer-previous "p" "C-p" "<up>")
        (explorer-expand "<right>")
        (explorer-collapse "<left>")
        (explorer-open "RET")
        (explorer-preview "SPC")
        (explorer-toggle "TAB")
        (explorer-refresh "g")
        (explorer-select-down "S-<down>")
        (explorer-select-up "S-<up>")
        (explorer-mark "m")
        (explorer-find "/")
        (explorer-find-clear :none "/ with an empty text; the palette")
        (explorer-new-file "+")
        (explorer-rename "R")
        (explorer-delete "D")
        (explorer-delete-permanently :none "C-u D")
        (explorer-copy "M-w")
        (explorer-cut "C-w")
        (explorer-paste "C-y")
        (explorer-copy-path "w")
        (explorer-copy-relative-path "W")
        (explorer-reveal-externally "o x")
        (focus-buffers "C-x C-b")
        (buffers-next "n" "C-n" "<down>")
        (buffers-previous "p" "C-p" "<up>")
        (buffers-open "RET")
        (buffers-close "d" "k")
        (buffers-close-others "o")
        (buffers-filter "/")
        (save-all :none "C-x s stays Emacs' save-some-buffers, which asks per buffer")
        (close-saved :none "in the palette")
        (close-all :none "in the palette")))
