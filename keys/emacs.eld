;; Emacs key profile — command id → keys (docs/guide/keys.md).  The emacs layer also claims Emacs' own
;; default bindings (:claims-defaults): a later layer that rebinds one of them is reported.
(:name "Emacs"
       :doc "GNU Emacs' default keys"
       :claims-defaults t
       :bind ((palette "C-S-p")
              (keys-sheet "C-h C-k")
              (keyboard-profile :none "in the palette")
              (notebook-run-cell "C-c C-c")
              (notebook-run-and-advance "C-c C-n")
              (notebook-run-all "C-c C-r")
              (notebook-run-above "C-c C-u")
              (notebook-run-below "C-c C-d")
              (notebook-interrupt "C-c C-i")
              (notebook-restart "C-c C-k")
              (notebook-restart-run-all "C-c C-S-k")
              (notebook-add-below "C-c C-b")
              (notebook-add-above "C-c C-a")
              (notebook-cut-cell "C-c C-x")
              (notebook-copy-cell "C-c C-w")
              (notebook-paste-cell "C-c C-y")
              (notebook-delete-cell "C-c C-S-d")
              (notebook-move-up "C-c C-<up>")
              (notebook-move-down "C-c C-<down>")
              (notebook-cell-menu "C-c C-.")
              (notebook-split-cell "C-c C-s")
