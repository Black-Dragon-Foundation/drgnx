;; Emacs key profile — command id → keys (docs/keys.md).  The emacs layer also claims Emacs' own
;; default bindings (:claims-defaults): a later layer that rebinds one of them is reported.
(:name "Emacs"
 :doc "GNU Emacs' default keys"
 :claims-defaults t
 :bind ((palette "C-S-p")
        (keys-sheet "C-h C-k")
        (keyboard-profile :none "in the palette")
        (open-file "C-x C-f")
        (save-file "C-x C-s")
        (line-numbers :none "Emacs has no default key for line numbers")
        (modules-report :none "drgnx-only; in the palette")
        (toggle-sidebar "<f8>")
        (wb-unrouted :none "in the palette")
        (move-editor-to-new-window :none "in the palette; C-x 5 2 makes a frame (stock)")
        (open-editor-in-new-window :none "C-x 5 2 (stock)")
        (move-group-to-new-window :none "in the palette")
        (buffers-toggle-all-windows :none "in the palette")
        (focus-outline :none "in the palette")
        (outline-open "RET")
        (wb-save-layout :none "in the palette (also on exit)")
        (wb-restore-layout :none "in the palette (also at start)")
        (split-editor-right :none "C-x 3 splits (stock)")
        (split-editor-down :none "C-x 2 splits (stock)")
        (close-group :none "C-x 0 (stock)")
        (focus-group-1 :none "C-x o moves between windows")
        (focus-group-2 :none "C-x o moves between windows")
        (focus-group-3 :none "C-x o moves between windows")
        (move-editor-to-next-group :none "in the palette")
        (close-tab :none "in the palette")
        (next-tab :none "C-x <right> / C-x <left> stay Emacs' next-buffer / previous-buffer")
        (previous-tab :none "C-x <left> stays Emacs' previous-buffer")
        (toggle-panel :none "in the palette")
        (focus-panel :none "in the palette")
        (toggle-right-dock :none "in the palette")
        (focus-editor :none "C-x o moves between windows")
        (dock-back "q")
        (focus-explorer "C-x M-e")
        (explorer-next "n" "C-n" "<down>")
        (explorer-previous "p" "C-p" "<up>")
        (explorer-expand "<right>")
        (explorer-collapse "<left>")
        (explorer-open "RET")
        (explorer-preview "SPC")
        (explorer-toggle "TAB")
        (explorer-refresh "g")
        (explorer-select-down "S-<down>")
        (explorer-select-up "S-<up>")
        (explorer-mark "m")
        (explorer-find "/")
        (explorer-find-clear :none "/ with an empty text; the palette")
        (explorer-new-file "+")
        (explorer-rename "R")
        (explorer-delete "D")
        (explorer-delete-permanently :none "C-u D")
        (explorer-copy "M-w")
        (explorer-cut "C-w")
        (explorer-paste "C-y")
        (explorer-copy-path "w")
        (explorer-copy-relative-path "W")
        (explorer-reveal-externally "o x")
        (focus-buffers "C-x C-b")
        (buffers-next "n" "C-n" "<down>")
        (buffers-previous "p" "C-p" "<up>")
        (buffers-open "RET")
        (buffers-close "d" "k")
        (buffers-close-others "o")
        (buffers-filter "/")
        (save-all :none "C-x s stays Emacs' save-some-buffers, which asks per buffer")
        (close-saved :none "in the palette")
        (close-all :none "in the palette")))
