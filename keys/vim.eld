;; Vim key profile — command id → keys (docs/guide/keys.md).  Commands are on the leader key (SPC) in
;; evil's normal state, bound once evil loads (the evil module, M4).  :claims are Vim's own
;; normal-mode keys, so a layer that rebinds one of them is reported.
(:name "Vim"
 :doc "Vim / Neovim keys (evil), commands on the SPC leader"
 :map (evil . evil-normal-state-map)
 :bind ((palette "SPC SPC")
        (keys-sheet "SPC ?")
        (keyboard-profile "SPC h k")
        (open-file "SPC f f")
        (save-file "SPC f s")
        (line-numbers "SPC u l")
        (modules-report "SPC h m")
        (toggle-sidebar "SPC e")
        (wb-unrouted :none "in the palette")
        (agents-view "SPC a v")
        (agents-new :none "the Agents tab and transcripts; the palette")
        (agents-send :none "the Agents tab and transcripts; the palette")
        (agents-stop "C-c C-c" :map drgnx-agents-transcript-mode-map)
        (agents-deliver "C-c C-d" :map drgnx-agents-transcript-mode-map)
        (agents-edit-queued :none "the [×] buttons in a transcript; the palette")
        (agents-take-over :none "the Agents tab and transcripts; the palette")
        (agents-answer :none "the Agents tab and transcripts; the palette")
        (jobs-log :none "the Agents tab and transcripts; the palette")
        (jobs-stop :none "the Agents tab and transcripts; the palette")
        (agents-open "RET")
        (projects-sync-plans :none "in the palette")
        (work-view "SPC a w")
        (work-graph :none "the Work tab; the palette")
        (work-start-agent :none "the Work tab; the palette")
        (work-open-worktree :none "the Work tab; the palette")
        (work-open "RET")
        (work-toggle "TAB")
        (work-refresh "R")
        (work-filter "F")
        (work-hide-merged "M")
        (ai-tab "TAB" :map drgnx-ai-ghost-mode-map)
        (ai-accept :none "Tab while a suggestion shows; the palette")
        (ai-accept-word "C-<right>" :map drgnx-ai-ghost-showing-map)
        (ai-accept-line :none "the palette")
        (ai-dismiss "<escape>" :map drgnx-ai-ghost-showing-map)
        (ai-complete-toggle :none "in the palette")
        (ai-edit "SPC a e")
        (ai-edit-done "C-c C-c" :map drgnx-ai-edit-review-mode-map)
        (ai-edit-reject "C-c C-k" :map drgnx-ai-edit-review-mode-map)
        (agents-reply "RET")
        (agents-review-done "C-c C-c")
        (agents-review-reject "C-c C-k")
        (onboarding :none "Help → Welcome; the palette")
        (onboarding-environment :none "the Welcome list; the palette")
        (onboarding-look-and-keys :none "the Welcome list; the palette")
        (onboarding-projects :none "the Welcome list; the palette")
        (onboarding-ai :none "the Welcome list; the palette")
        (onboarding-search :none "the Welcome list; the palette")
        (onboarding-agents :none "the Welcome list; the palette")
        (onboarding-daemon :none "the Welcome list; the palette")
        (onboarding-portability :none "the Welcome list; the palette")
        (onboarding-finish :none "the Welcome list; the palette")
        (file-save-as "SPC f w")
        (file-new "SPC f n")
        (file-reopen-tab "SPC f r")
        (file-new-window :none "in the palette")
        (file-close-window :none ":q in the last editor; the palette")
        (go-recent "SPC b b")
        (go-symbol-project "SPC s y")
        (go-back :none "C-o (Vim's jump back)")
        (go-forward :none "C-i (Vim's jump forward)")
        (search-file :none "/ (Vim)")
        (search-replace "SPC s r")
        (edit-select-all :none "ggVG (Vim)")
        (edit-select-line :none "V (Vim)")
        (edit-next-occurrence :none "in the palette")
        (edit-all-occurrences :none "in the palette")
        (edit-redo :none "C-r (Vim)")
        (edit-comment "SPC c c")
        (edit-delete-line :none "dd (Vim)")
        (edit-move-up :none "in the palette")
        (edit-move-down :none "in the palette")
        (edit-duplicate :none "yyp (Vim)")
        (edit-line-below :none "o (Vim)")
        (edit-line-above :none "O (Vim)")
        (code-quick-fix "SPC c a")
        (code-problems "SPC c x")
        (code-format "SPC c f")
        (view-zoom-in :none "in the palette")
        (view-zoom-out :none "in the palette")
        (view-zoom-reset :none "in the palette")
        (view-escape :none "<escape> is Vim's")
        (buffers-save :none "the Buffers right-click menu")
        (buffers-copy-path :none "the Buffers right-click menu")
        (buffers-reveal :none "the Buffers right-click menu")
        (buffers-full-view "SPC b i")
        (explorer-reveal-in-buffers :none "the Explorer's right-click menu")
        (explorer-open-in-dired :none "the Explorer's right-click menu")
        (explorer-other-window :none "the Explorer's right-click menu")
        (view-panel-next "SPC u p")
        (help-mode-menu "SPC m")
        (go-window-pick "SPC w w")
        (go-jump "SPC s j")
        (edit-undo-tree "SPC u t")
        (search-edit-results :none "in the palette")
        (search-apply-edits :none "in the palette")
        (git-hunk-show "SPC g h")
        (git-hunk-revert "SPC g r")
        (git-hunk-stage "SPC g S")
        (view-keycast "SPC u k")
        (llm-menu "SPC a m")
        (llm-send "SPC a s")
        (code-definition "SPC c d")
        (code-references "SPC c r")
        (code-rename "SPC c R")
        (code-hover "SPC c h")
        (scm-view "SPC g s")
        (buffers-diff "SPC g d")
        (scm-blame "SPC g b")
        (terminal-new "SPC t n")
        (explorer-terminal-here :none "the Explorer's right-click menu")
        (go-quick-open "SPC f p")
        (search-project "SPC s p")
        (go-symbol "SPC s s")
        (org-capture "SPC n c")
        (org-agenda "SPC n a")
        (edit-fold "SPC z c")
        (edit-unfold "SPC z o")
        (edit-case-cycle "SPC c ~")
        (edit-case-camel :none "in the palette")
        (edit-case-snake :none "in the palette")
        (edit-case-kebab :none "in the palette")
        (edit-expand "SPC v")
        (edit-shrink "SPC V")
        (go-line "SPC g l")
        (preferences-theme "SPC h t")
        (view-zen "SPC u z")
        (preferences-modules :none "in the palette and the Options menu")
        (modules-toggle "RET")
        (move-editor-to-new-window "SPC w n")
        (open-editor-in-new-window "SPC w o")
        (move-group-to-new-window "SPC w g")
        (buffers-toggle-all-windows "SPC b a")
        (focus-outline "SPC o")
        (outline-open "RET" "o")
        (wb-save-layout :none "in the palette (also on exit)")
        (wb-restore-layout :none "in the palette (also at start)")
        (split-editor-right "SPC w v")
        (split-editor-down "SPC w s")
        (close-group "SPC w c")
        (close-group-editors :none "in the palette")
        (focus-group-1 "SPC 1")
        (focus-group-2 "SPC 2")
        (focus-group-3 "SPC 3")
        (move-editor-to-next-group "SPC w m")
        (close-tab "SPC b d")
        (next-tab "SPC b n")
        (previous-tab "SPC b p")
        (toggle-panel "SPC j")
        (focus-panel :none "in the palette")
        (toggle-right-dock "SPC R")
        (focus-editor :none "C-w moves between windows")
        (dock-back "<escape>" :map drgnx-wb-dock-map)
        (focus-explorer "SPC E")
        (explorer-next "j" "<down>")
        (explorer-previous "k" "<up>")
        (explorer-expand "l" "<right>")
        (explorer-collapse "h" "<left>")
        (explorer-open "RET" "o")
        (explorer-preview "g o")
        (explorer-toggle :none "l/h")
        (explorer-refresh "R")
        (explorer-select-down "J")
        (explorer-select-up "K")
        (explorer-mark "m")
        (explorer-find "/")
        (explorer-find-clear :none "/ with an empty text; the palette")
        (explorer-new-file "a")
        (explorer-rename "r")
        (explorer-delete "d")
        (explorer-delete-permanently "D")
        (explorer-copy "y")
        (explorer-cut "x")
        (explorer-paste "p")
        (explorer-copy-path "g y")
        (explorer-copy-relative-path "Y")
        (explorer-reveal-externally "s")
        (focus-buffers "SPC ,")
        (buffers-next "j" "<down>")
        (buffers-previous "k" "<up>")
        (buffers-open "RET" "o")
        (buffers-close "x" "d d")
        (buffers-close-others "O")
        (buffers-filter "/")
        (save-all "SPC f S")
        (close-saved "SPC b u")
        (close-all "SPC b A"))
 :claims ((editing "C-o" "jump back")
          (editing "C-w" "window commands (prefix)")
          (editing "C-v" "visual block")
          (editing "C-a" "increment number")
          (editing "C-x" "decrement number")
          (editing "C-u" "scroll up")
          (editing "C-d" "scroll down")
          (editing "C-r" "redo")
          (editing "C-e" "scroll line down")
          (editing "C-y" "scroll line up")
          (editing "C-f" "page down")
          (editing "C-b" "page up")
          (editing "C-n" "next line")
          (editing "C-p" "previous line")
          (editing "C-t" "tag stack back")
          (editing "C-z" "emacs state")
          (editing "C-]" "jump to tag")))
