;; Vim key profile — command id → keys (docs/keys.md).  Commands are on the leader key (SPC) in
;; evil's normal state, bound once evil loads (the evil module, M4).  :claims are Vim's own
;; normal-mode keys, so a layer that rebinds one of them is reported.
(:name "Vim"
 :doc "Vim / Neovim keys (evil), commands on the SPC leader"
 :map (evil . evil-normal-state-map)
 :bind ((palette "SPC SPC")
        (keys-sheet "SPC ?")
        (keyboard-profile "SPC h k")
        (open-file "SPC f f")
        (save-file "SPC f s")
        (line-numbers "SPC u l")
        (modules-report "SPC h m")
        (toggle-sidebar "SPC e")
        (wb-unrouted :none "in the palette")
        (close-tab "SPC b d")
        (next-tab "SPC b n")
        (previous-tab "SPC b p")
        (toggle-panel "SPC j")
        (focus-panel :none "in the palette")
        (toggle-right-dock "SPC R")
        (focus-editor :none "C-w moves between windows")
        (dock-back "<escape>" :map drgnx-wb-dock-map)
        (focus-explorer "SPC E")
        (explorer-next "j" "<down>")
        (explorer-previous "k" "<up>")
        (explorer-expand "l" "<right>")
        (explorer-collapse "h" "<left>")
        (explorer-open "RET" "o")
        (explorer-preview "g o")
        (explorer-toggle :none "l/h")
        (explorer-refresh "R")
        (explorer-select-down "J")
        (explorer-select-up "K")
        (explorer-mark "m")
        (explorer-find "/")
        (explorer-find-clear :none "/ with an empty text; the palette")
        (explorer-new-file "a")
        (explorer-rename "r")
        (explorer-delete "d")
        (explorer-delete-permanently "D")
        (explorer-copy "y")
        (explorer-cut "x")
        (explorer-paste "p")
        (explorer-copy-path "g y")
        (explorer-copy-relative-path "Y")
        (explorer-reveal-externally "s")
        (focus-buffers "SPC ,")
        (buffers-next "j" "<down>")
        (buffers-previous "k" "<up>")
        (buffers-open "RET" "o")
        (buffers-close "x" "d d")
        (buffers-close-others "O")
        (buffers-filter "/")
        (save-all "SPC f S")
        (close-saved "SPC b u")
        (close-all "SPC b A"))
 :claims ((editing "C-o" "jump back")
          (editing "C-w" "window commands (prefix)")
          (editing "C-v" "visual block")
          (editing "C-a" "increment number")
          (editing "C-x" "decrement number")
          (editing "C-u" "scroll up")
          (editing "C-d" "scroll down")
          (editing "C-r" "redo")
          (editing "C-e" "scroll line down")
          (editing "C-y" "scroll line up")
          (editing "C-f" "page down")
          (editing "C-b" "page up")
          (editing "C-n" "next line")
          (editing "C-p" "previous line")
          (editing "C-t" "tag stack back")
          (editing "C-z" "emacs state")
          (editing "C-]" "jump to tag")))
