;; Vim key profile — command id → keys (docs/guide/keys.md).  Commands are on the leader key (SPC) in
;; evil's normal state, bound once evil loads (the evil module, M4).  :claims are Vim's own
;; normal-mode keys, so a layer that rebinds one of them is reported.
(:name "Vim"
 :doc "Vim / Neovim keys (evil), commands on the SPC leader"
 :map (evil . evil-normal-state-map)
 :bind ((palette "SPC SPC")
        (keys-sheet "SPC ?")
        (keyboard-profile "SPC h k")
        (quit :none "File → Quit drgnx; the palette")
        (preferences-keep-running :none "in the palette and the Options menu")
        (open-folder "SPC f o")
        (open-file "SPC f f")
        (save-file "SPC f s")
        (line-numbers "SPC u l")
        (modules-report "SPC h m")
        (toggle-sidebar "SPC e")
        (wb-unrouted :none "in the palette")
        (agents-view "SPC a v")
        (agents-new :none "the Agents tab and transcripts; the palette")
        (agents-new-durable :none "the palette")
        (agents-send :none "the Agents tab and transcripts; the palette")
        (agents-stop "C-c C-c" :map drgnx-agents-transcript-mode-map)
        (agents-deliver "C-c C-d" :map drgnx-agents-transcript-mode-map)
        (agents-edit-queued :none "the [×] buttons in a transcript; the palette")
        (agents-take-over :none "the Agents tab and transcripts; the palette")
        (agents-answer :none "the Agents tab and transcripts; the palette")
