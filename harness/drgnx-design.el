;;; drgnx-design.el --- the design system's generated pages (docs/design/) -*- lexical-binding: t -*-

;; SPDX-License-Identifier: GPL-3.0-or-later

;;; Commentary:
;; docs/design/ is drgnx's design system: hand-written guidance plus pages generated from the code that draws the
;; look, so they cannot disagree with it.  This file builds the generated ones:
;;   tokens.md, tokens.css and img/tokens-VARIANT.svg   from themes/drgnx-tokens.eld and the faces the theme generator
;;                                                      makes (which faces use which token).
;; `drgnx design' writes them (`drgnx-design-regenerate'); `drgnx design --check' lists the stale ones and exits 1
;; (`drgnx-design-stale'; test/unit/design-test.el runs the same comparison in the unit suite).  No colour literal
;; lives here: every colour on a page is read from the token table.  See docs/develop/design-system.md.

;;; Code:
(require 'cl-lib)
(require 'subr-x)
(require 'seq)
(require 'drgnx-paths)
(require 'drgnx-color)
(require 'drgnx-file)
(require 'drgnx-faces)
(require 'drgnx-theme-gen (expand-file-name "themes/drgnx-theme-gen" drgnx-dir))

(defconst drgnx-design-dir "docs/design/" "Where the design system lives, relative to the checkout.")

(defconst drgnx-design-variants
  '((dark . "Dark") (light . "Light") (hc . "High contrast"))
  "The look's variants and the headings the pages give them.")

(defconst drgnx-design--notice
  "Generated by `bin/drgnx design` from %s. Do not edit; change the source and regenerate."
  "The line every generated page carries.")

(defun drgnx-design--table ()
  "The token table: ((dark . ALIST) (light . ALIST) (hc . ALIST))."
  (drgnx-theme--read))

(defun drgnx-design--tokens (variant)
  "The token names of VARIANT, in the table's order."
  (mapcar #'car (alist-get variant (drgnx-design--table))))

;;;; Which faces use which token

(defun drgnx-design--sentinels (tokens)
  "A hash table token → a colour string of its own, and its reverse, for TOKENS: the generator is run with these in
place of the real colours, so every colour a face names can be traced back to the token it came from."
  (let ((forward (make-hash-table :test #'eq)) (back (make-hash-table :test #'equal)) (i 0))
    (dolist (token tokens)
      (let ((colour (format "#%02x%02x%02x" (+ 16 (* 3 (% i 80))) (+ 16 (* 3 (/ i 80))) 128)))
        (puthash token colour forward)
        (puthash colour token back)
        (cl-incf i)))
    (cons forward back)))

(defun drgnx-design--collect (value back)
  "The tokens whose sentinel colours occur in VALUE (a face attribute value), using the table BACK."
  (cond ((stringp value) (when-let* ((token (gethash value back))) (list token)))
        ((consp value) (append (drgnx-design--collect (car value) back) (drgnx-design--collect (cdr value) back)))))

(defun drgnx-design-faces (variant)
  "What the theme generator makes for VARIANT: ((FACE :inherit INHERIT :tokens TOKENS)…), in its order."
  (let* ((maps (drgnx-design--sentinels (drgnx-design--tokens variant)))
         (forward (car maps)) (back (cdr maps)))
    (mapcar (lambda (spec)
              (let ((attrs (cdr spec)))
                (list (car spec) :inherit (let ((i (plist-get attrs :inherit))) (if (listp i) i (list i)))
                      :tokens (delete-dups (drgnx-design--collect attrs back)))))
            (drgnx-theme--faces variant (lambda (name)
                                          (or (gethash name forward)
                                              (error "drgnx-design: no token `%s' in the %s variant" name variant)))))))

(defun drgnx-design--faces-using (token faces)
  "The names of the FACES (as `drgnx-design-faces' gives them) that name TOKEN."
  (mapcar #'car (seq-filter (lambda (f) (memq token (plist-get (cdr f) :tokens))) faces)))

;;;; Tokens

(defun drgnx-design--percent (alpha) (format "%s %%" (let ((p (* 100 alpha))) (if (= p (round p)) (round p) p))))

(defun drgnx-design--definition (value)
  "How the table defines a token whose entry is VALUE, in words."
  (cond ((stringp value) "fixed")
        ((symbolp value) (format "the colour of `%s`" value))
        ((eq (car value) 'tint)
         (format "%s at %s over `editor`" (drgnx-design--source (cadr value)) (drgnx-design--percent (cddr value))))
        ((eq (car value) 'over)
         (format "%s at %s over `%s`" (drgnx-design--source (nth 2 value)) (drgnx-design--percent (nthcdr 3 value))
                 (nth 1 value)))
        (t (format "%S" value))))

(defun drgnx-design--source (colour)
  "COLOUR of a tint: a token's name in backticks, or the literal colour as the table has it."
  (format "`%s`" colour))

(defun drgnx-design--on (variant)
  "The colour for text and outlines drawn on VARIANT's editor surface."
  (drgnx-look-token 'fg variant))

(defun drgnx-design--text-on (colour variant)
  "The better of VARIANT's `fg' and `editor' as text on COLOUR."
  (let ((a (drgnx-look-token 'fg variant)) (b (drgnx-look-token 'editor variant)))
    (if (>= (drgnx-color-contrast colour a) (drgnx-color-contrast colour b)) a b)))

(defun drgnx-design--sheet (variant)
  "An SVG sheet of VARIANT's tokens: a swatch each, named, on the variant's own editor colour."
  (let* ((tokens (drgnx-design--tokens variant)) (columns 8) (w 132) (h 74)
         (rows (ceiling (length tokens) (float columns)))
         (i 0) (cells nil))
    (dolist (token tokens)
      (let* ((x (+ 8 (* w (% i columns)))) (y (+ 8 (* h (/ i columns))))
             (colour (drgnx-look-token token variant)))
        (push (format (concat "<rect x=\"%d\" y=\"%d\" width=\"%d\" height=\"40\" rx=\"6\" fill=\"%s\" stroke=\"%s\"/>"
                              "<text x=\"%d\" y=\"%d\" font-size=\"11\" fill=\"%s\">%s</text>"
                              "<text x=\"%d\" y=\"%d\" font-size=\"10\" fill=\"%s\">%s</text>\n")
                      x y (- w 12) colour (drgnx-look-token 'border variant)
                      x (+ y 54) (drgnx-design--on variant) token
                      x (+ y 66) (drgnx-look-token 'muted variant) colour)
              cells)
        (cl-incf i)))
    (format (concat "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"%d\" height=\"%d\" viewBox=\"0 0 %d %d\" "
                    "font-family=\"sans-serif\">\n<rect width=\"100%%\" height=\"100%%\" fill=\"%s\"/>\n%s</svg>\n")
            (+ 8 (* w columns)) (+ 16 (* h rows)) (+ 8 (* w columns)) (+ 16 (* h rows))
            (drgnx-look-token 'editor variant) (apply #'concat (nreverse cells)))))

(defun drgnx-design--tokens-section (variant)
  "The tokens page's section for VARIANT."
  (let ((faces (drgnx-design-faces variant)) (entries (alist-get variant (drgnx-design--table))))
    (concat
     (format "## %s\n\n![The %s tokens](img/tokens-%s.svg)\n\n" (alist-get variant drgnx-design-variants)
             (downcase (alist-get variant drgnx-design-variants)) variant)
     "| Token | Value | Definition | Faces |\n|---|---|---|---|\n"
     (mapconcat (lambda (entry)
                  (let ((used (drgnx-design--faces-using (car entry) faces)))
                    (format "| `%s` | `%s` | %s | %s |" (car entry) (drgnx-look-token (car entry) variant)
                            (drgnx-design--definition (cdr entry))
                            (if used (mapconcat (lambda (f) (format "`%s`" f)) used ", ") "-"))))
                entries "\n")
     "\n")))

(defun drgnx-design--tokens-page ()
  "docs/design/tokens.md."
  (concat
   "# Colour tokens\n\n"
   (format "<!-- %s -->\n\n" (format drgnx-design--notice "themes/drgnx-tokens.eld"))
   "Every colour drgnx draws is one of these tokens, in one of three variants. A face names a token (never a colour), "
   "a theme turns the token table into faces, and nothing outside `themes/` holds a colour literal. "
   "*Definition* says how the table builds a token: a tint is a colour at an alpha over the editor surface. "
   "*Faces* are the faces the theme generator gives the token to; faces that inherit them (the semantic ones) "
   "carry the colour further, see [faces](../guide/face.md). "
   "The same values, as CSS custom properties, are in [tokens.css](tokens.css).\n\n"
   (mapconcat #'drgnx-design--tokens-section (mapcar #'car drgnx-design-variants) "\n")))

(defun drgnx-design--css-block (css variant)
  "The declarations of VARIANT's first block in CSS (a string): from its comment to the closing brace."
  (when (string-match (format "/\\* %s \\*/\n[^{]*{\n\\(\\(?:[^}]*\\)\\)}" variant) css)
    (match-string 1 css)))

(defun drgnx-design--declarations (variant indent)
  "VARIANT's tokens as CSS custom properties, each on a line indented by INDENT."
  (mapconcat (lambda (token) (format "%s--%s: %s;\n" indent token (drgnx-look-token token variant)))
             (drgnx-design--tokens variant) ""))

(defun drgnx-design--tokens-css ()
  "docs/design/tokens.css: the tokens as CSS custom properties, one block per variant."
  (concat
   (format "/* %s */\n" (format drgnx-design--notice "themes/drgnx-tokens.eld"))
   (mapconcat (lambda (variant)
                (format "/* %s */\n%s {\n%s}\n" variant
                        (pcase variant
                          ('dark ":root,\n:root[data-theme=\"dark\"]")
                          (_ (format ":root[data-theme=\"%s\"]" variant)))
                        (drgnx-design--declarations variant "  ")))
              (mapcar #'car drgnx-design-variants) "")
   "/* the reader's system asks for it, and the page does not choose */\n"
   "@media (prefers-color-scheme: light) {\n  :root:not([data-theme]) {\n"
   (drgnx-design--declarations 'light "    ") "  }\n}\n"
   "@media (prefers-contrast: more) {\n  :root:not([data-theme]) {\n"
   (drgnx-design--declarations 'hc "    ") "  }\n}\n"))

(defun drgnx-design--section (page variant)
  "The section of the tokens PAGE (a string) for VARIANT."
  (let ((start (format "\n## %s\n" (alist-get variant drgnx-design-variants))))
    (when-let* ((from (string-search start page)))
      (let ((to (string-search "\n## " page (+ from (length start)))))
        (substring page from to)))))

;;;; The pages

(defvar drgnx-design-page-makers '(drgnx-design--tokens-pages)
  "Functions that return generated pages as ((PATH . TEXT)…), PATH relative to docs/design/.")

(defun drgnx-design--tokens-pages ()
  "tokens.md, tokens.css and the swatch sheets."
  (append (list (cons "tokens.md" (drgnx-design--tokens-page))
                (cons "tokens.css" (drgnx-design--tokens-css)))
          (mapcar (lambda (variant) (cons (format "img/tokens-%s.svg" variant) (drgnx-design--sheet variant)))
                  (mapcar #'car drgnx-design-variants))))

(defun drgnx-design-pages ()
  "Every generated page: ((PATH . TEXT)…), PATH relative to docs/design/."
  (apply #'append (mapcar #'funcall drgnx-design-page-makers)))

(defun drgnx-design--read (file)
  "The text of FILE, or nil when there is none."
  (when (file-exists-p file)
    (with-temp-buffer
      (let ((coding-system-for-read 'utf-8-unix)) (insert-file-contents file))
      (buffer-string))))

(defun drgnx-design-stale (&optional dir)
  "The generated pages (paths relative to DIR, default the checkout's docs/design/) whose file is missing or differs."
  (let ((dir (or dir (expand-file-name drgnx-design-dir drgnx-dir))))
    (mapcar #'car (seq-remove (lambda (page) (equal (cdr page) (drgnx-design--read (expand-file-name (car page) dir))))
                              (drgnx-design-pages)))))

(defun drgnx-design-regenerate (&optional dir)
  "Write every generated page under DIR (default the checkout's docs/design/); the paths written, relative to DIR."
  (let ((dir (or dir (expand-file-name drgnx-design-dir drgnx-dir))) (written nil))
    (dolist (page (drgnx-design-pages))
      (let ((file (expand-file-name (car page) dir)))
        (unless (equal (cdr page) (drgnx-design--read file))
          (make-directory (file-name-directory file) t)
          (drgnx-file-write-text file (cdr page))
          (push (car page) written))))
    (nreverse written)))

(defun drgnx-design-cli-run (args)
  "`drgnx design [--check]': write the generated pages, or with --check only say which are stale.
Exit code: 0 current (or written), 1 with --check when a page is stale, 2 for an unknown argument."
  (cond ((equal args '("--check"))
         (let ((stale (drgnx-design-stale)))
           (dolist (p stale) (princ (format "stale: %s%s\n" drgnx-design-dir p)))
           (if stale (progn (princ "run: bin/drgnx design\n") 1) 0)))
        ((null args)
         (dolist (p (drgnx-design-regenerate)) (princ (format "wrote %s%s\n" drgnx-design-dir p)))
         0)
        (t (princ "usage: drgnx design [--check]\n") 2)))

(defun drgnx-design-cli ()
  "bin/drgnx design: the arguments after --."
  (let ((args (cdr (member "--" command-line-args-left))))
    (setq command-line-args-left nil)
    (kill-emacs (drgnx-design-cli-run args))))

(provide 'drgnx-design)
;;; drgnx-design.el ends here
