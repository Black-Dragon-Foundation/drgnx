;;; drgnx-ui.el --- Start, drive, capture and stop drgnx harness sessions -*- lexical-binding: t -*-

;; SPDX-License-Identifier: GPL-3.0-or-later

;;; Commentary:
;; The harness controller, run in batch Emacs by `drgnx ui …', `drgnx test --ui' and the
;; MCP server.  A session `drgnx-ui-N-HEX' is GUI Emacs under `mutter --headless' in its own
;; dbus session (or headless sway, Xvfb, Xvfb with i3: `drgnx-ui-compositors'), launched as a
;; transient systemd user unit.  It is reached only through
;; its own server socket inside its run directory; nothing here talks to any other
;; Emacs.  See docs/develop/harness.md.

;;; Code:
(require 'cl-lib)
(require 'json)
(require 'subr-x)
(require 'drgnx-env)
(require 'drgnx-test-env (expand-file-name "drgnx-test-env" (file-name-directory (or load-file-name buffer-file-name))))

(defconst drgnx-ui-harness-dir (file-name-directory (or load-file-name buffer-file-name)))
(defconst drgnx-ui-repo-dir (file-name-directory (directory-file-name drgnx-ui-harness-dir)))
(defvar drgnx-ui-session-repo nil
  "The drgnx checkout whose init/, core/, wb/ and modules/ a session boots (nil: `drgnx-ui-repo-dir').  The harness
(prelude, drgnx-uitest, the perf probes) always comes from the controller's own tree; `test --perf --ab REF' points
this at an exported REF.")
(defconst drgnx-ui-name-regexp "\\`drgnx-ui-[0-9]+-[0-9a-f]\\{6\\}\\'"
  "A session id: drgnx-ui-N-HEX (`drgnx-ui-next-name').  Never reused, so an id names one session only.")
(defconst drgnx-ui-legacy-name-regexp "\\`drgnx-ui-[0-9]+\\'"
  "The id shape before ids carried a hex part (drgnx-ui-N): refused everywhere but by reap.")
(defconst drgnx-ui-legacy-message "harness upgraded: ids are drgnx-ui-N-xxxxxx; start a new session (drgnx ui start)"
  "What a legacy id, or a session started before every form named its session, is refused with.")
(defconst drgnx-ui-tombstone-days 7
  "Days a stopped session's tombstone (ROOT/ended/ID.eld) is kept; a pruned id is only unknown, never reused.")
(defvar drgnx-ui-owner-kind 'cli
  "Who starts the sessions of this process, for session.json's :owner: cli, mcp (`drgnx-ui-mcp-main'), test
\(`drgnx-ui-run-ert-session', and DRGNX_TEST_ISOLATED=1) or check (DRGNX_CHECK=1 wins over test).")
(defvar drgnx-ui-owner-client nil
  "The MCP client's token (`drgnx-ui-mcp--token') while it starts a session: session.json's :owner :client.")
(defconst drgnx-ui-keep-env
  '("USER" "LOGNAME" "LANG" "LC_ALL" "PATH" "GRYPHN_EMACS_DIR" "DRGNX_STARTUP_TRACE"
    "DRGNX_UITEST_SETTLE_SCALE" "DRGNX_MODAL_ELPA" "DRGNX_CHILDFRAME_ELPA" "DRGNX_LEASE_HELD" "DRGNX_PERF_GLITNIR")
  "The only variables a session inherits; everything else (keys, tokens) stays out.  Not HOME: a session's is
RUN/home (`drgnx-ui-session-env').")
(defvar drgnx-ui-session-tier 'ui
  "The `drgnx-test-env' tier of the sessions started now: ui, or scenario, bench or perf, which those controllers
bind around their `drgnx-ui-start'.")
(defconst drgnx-ui-link drgnx-test-env-config-links
  "Code directories of an external config, linked read-only into the session.")
(defconst drgnx-ui-copy '("custom.el") "Files of an external config the session may write: copied.")

(defconst drgnx-ui--early-init
  ";;; early-init.el --- generated by drgnx for a harness session; do not edit -*- lexical-binding: t -*-
(load (expand-file-name \"init/prelude.el\" (getenv \"DRGNX_UI_HARNESS\")) nil t)
(drgnx-ui-load-config \"early-init.el\")
(drgnx-ui-gc-early)
")
(defconst drgnx-ui--init
  ";;; init.el --- generated by drgnx for a harness session; do not edit -*- lexical-binding: t -*-
(drgnx-ui-early-server)
(drgnx-ui-load-config \"init.el\")
(drgnx-ui-gc-setup)
")

(define-error 'drgnx-ui-error "drgnx harness")
(define-error 'drgnx-ui-refused "refused" 'drgnx-ui-error)

(defun drgnx-ui--fail (fmt &rest args)
  (signal 'drgnx-ui-error (list (apply #'format fmt args))))

(defun drgnx-ui--refuse (fmt &rest args)
  (signal 'drgnx-ui-refused (list (apply #'format fmt args))))

;;;; Small helpers

(defun drgnx-ui--json (value)
  "VALUE as JSON text (decoded: `json-serialize' returns unibyte UTF-8)."
  (decode-coding-string (json-serialize value) 'utf-8))

(defun drgnx-ui--parse-json (text)
  (json-parse-string text :object-type 'plist :array-type 'array :null-object :null :false-object :false))

(defun drgnx-ui--read-json (file)
  (drgnx-ui--parse-json (with-temp-buffer (insert-file-contents file) (buffer-string))))

(defun drgnx-ui--write (file text)
  (let ((coding-system-for-write 'utf-8-unix))
    (write-region text nil file nil 'silent)))

(defun drgnx-ui--run (program &rest args)
  "Run PROGRAM with ARGS to completion; return (EXIT . OUTPUT).  A missing PROGRAM is exit 127."
  (with-temp-buffer
    (let ((rc (condition-case err (apply #'call-process program nil t nil args)
                (file-missing (insert (error-message-string err)) 127))))
      (cons rc (buffer-string)))))

(defun drgnx-ui--run-with-timeout (timeout program &rest args)
  "Run PROGRAM with ARGS for at most TIMEOUT seconds; return (EXIT OUTPUT).
EXIT is the symbol `timeout' when the process had to be killed."
  (let* ((buf (generate-new-buffer " *drgnx-ui*"))
         (proc (make-process :name "drgnx-ui" :buffer buf :command (cons program args)
                             :connection-type 'pipe :noquery t :coding 'utf-8-unix
                             :sentinel #'ignore))
         (deadline (+ (float-time) timeout)))
    (unwind-protect
        (progn
          (while (and (process-live-p proc) (< (float-time) deadline))
            (accept-process-output proc 0.05))
          (if (process-live-p proc)
              (progn (delete-process proc) (list 'timeout ""))
            (while (accept-process-output proc 0))
            (list (process-exit-status proc) (with-current-buffer buf (buffer-string)))))
      (kill-buffer buf))))

(defun drgnx-ui--emacsclient ()
  "The emacsclient that belongs to this Emacs, else the one on PATH."
  (let ((own (expand-file-name "emacsclient" invocation-directory)))
    (if (file-executable-p own) own "emacsclient")))

(defun drgnx-ui-el (value)
  "VALUE as an elisp literal for an emacsclient form."
  (cond ((memq value '(nil :false :null)) "nil")
        ((eq value t) "t")
        ((numberp value) (number-to-string value))
        (t (prin1-to-string (format "%s" value)))))

(defun drgnx-ui-parse-reply (out)
  "Parse emacsclient OUT: the API's JSON text printed as an elisp string literal.  A {\"refused\": WHY} reply is a
`drgnx-ui-refused' (`drgnx-uitest-api-as': the session is not the one addressed)."
  (let ((reply (drgnx-ui--parse-json (car (read-from-string (string-trim out))))))
    (if (and (consp reply) (stringp (plist-get reply :refused)))
        (drgnx-ui--refuse "%s" (plist-get reply :refused))
      reply)))

;;;; Preparing a session

(declare-function drgnx-state-dir "drgnx-paths")

(defun drgnx-ui-state-root ()
  "Directory holding session run directories ($DRGNX_UI_STATE, else ui/ in `drgnx-state-dir')."
  (let ((base (getenv "DRGNX_UI_STATE")))
    (directory-file-name
     (if (and base (not (string-empty-p base)))
         (expand-file-name base)
       ;; by file: `bin/drgnx ui-launcher' loads this with the harness alone on `load-path'
       (require 'drgnx-paths (expand-file-name "core/drgnx-paths" drgnx-ui-repo-dir))
       (expand-file-name "ui" (drgnx-state-dir))))))

(declare-function drgnx-paths-recorded-emacs "drgnx-paths")
(declare-function drgnx-emacs-program "drgnx-paths")

(defun drgnx-ui-emacs-bin ()
  "The Emacs sessions run: $DRGNX_EMACS, else the one install.sh recorded, else Nidhogg, a pgtk Emacs, else the Emacs that is running (`drgnx-emacs-program'; never a bare \"emacs\")."
  (or (getenv "DRGNX_EMACS")
      (progn   ; by file: `bin/drgnx ui-launcher' loads this with the harness alone on `load-path'
        (require 'drgnx-paths (expand-file-name "core/drgnx-paths" drgnx-ui-repo-dir))
        (drgnx-paths-recorded-emacs))
      (executable-find "nidhogg") (executable-find "emacs-pgtk")
      (progn (require 'drgnx-paths (expand-file-name "core/drgnx-paths" drgnx-ui-repo-dir))
             (drgnx-emacs-program))))

;;;; Compositors

(defconst drgnx-ui-compositors '("mutter" "sway" "x11" "i3" "kwin" "niri")
  "What a session's Emacs runs under: headless mutter (Wayland), headless sway (wlroots), Xvfb alone, Xvfb
with i3, KWin's virtual backend, or niri nested in a headless sway (one output).")

(defun drgnx-ui-default-compositor ()
  "$DRGNX_UI_COMPOSITOR when it names one of `drgnx-ui-compositors', else \"mutter\"."
  (let ((c (getenv "DRGNX_UI_COMPOSITOR")))
    (if (member c drgnx-ui-compositors) c "mutter")))

(defun drgnx-ui-x11-emacs-bin ()
  "The X11 Emacs of the x11 and i3 sessions: $DRGNX_UI_X11_EMACS, else emacs-lucid (the GTK X11 build sees one
monitor under Xvfb; the Lucid build reads the RandR 1.5 monitors `xrandr --setmonitor' makes)."
  (let ((e (getenv "DRGNX_UI_X11_EMACS")))
    (if (and e (not (string-empty-p e))) e (or (executable-find "emacs-lucid") "emacs-lucid"))))

(defun drgnx-ui--compositor-programs (compositor)
  "The programs COMPOSITOR's sessions start, in the order they are needed."
  (pcase compositor
    ("sway" '("sway" "swaymsg"))
    ("x11" (list "Xvfb" "xrandr" "setpriv" "dbus-run-session" (drgnx-ui-x11-emacs-bin)))
    ("i3" (list "Xvfb" "xrandr" "i3" "i3-msg" "setpriv" "dbus-run-session" (drgnx-ui-x11-emacs-bin)))
    ("kwin" '("kwin_wayland"))
    ("niri" '("sway" "swaymsg" "niri"))))

(defun drgnx-ui--ere-quote (s)
  "S as a POSIX extended regexp matching itself (for `pgrep -f'; `regexp-quote' is Emacs syntax)."
  (replace-regexp-in-string "[][\\\\.^$*+?(){}|]" "\\\\\\&" s))

(defun drgnx-ui--check-path-chars (what path)
  "Signal `drgnx-ui-error' unless PATH has only characters a WM config and a shell take as they are."
  (when (string-match-p "[^-A-Za-z0-9_./+@%:=,]" path)
    (drgnx-ui--fail "%s cannot use %s: a harness path for a WM may hold only letters, digits and -_./+@%%:=,"
                    what path)))

(defun drgnx-ui--check-compositor (compositor)
  "Signal `drgnx-ui-error' unless COMPOSITOR is known and its programs are on `exec-path'."
  (unless (member compositor drgnx-ui-compositors)
    (drgnx-ui--fail "compositor must be one of %s, got %S" (string-join drgnx-ui-compositors ", ") compositor))
  (dolist (p (drgnx-ui--compositor-programs compositor))
    (unless (executable-find p)
      (drgnx-ui--fail "%s is not installed here: run bin/drgnx test --container --ui --compositor %s"
                      (file-name-nondirectory p) compositor))))

(defun drgnx-ui-session-runtime-dir (name &optional root)
  "Session NAME's own XDG_RUNTIME_DIR under sway, x11 and i3 (state ROOT): sway's IPC socket and Wayland
display, and whatever the session's programs put in a runtime directory, live there, never in the caller's.
Next to the session's socket directory, so just as short.  Always computed from NAME and ROOT, never read back
from session.json."
  (concat (drgnx-ui-socket-dir name root) "-xdg"))

(defun drgnx-ui--sway-socket (name &optional root)
  "Where session NAME's sway listens: pinned with SWAYSOCK in its own runtime directory."
  (expand-file-name "sway-ipc.sock" (drgnx-ui-session-runtime-dir name root)))

(defun drgnx-ui--i3-socket (name &optional root)
  "Where session NAME's i3 listens (`ipc-socket' in its i3.conf): in its private socket directory."
  (expand-file-name "i3" (drgnx-ui-socket-dir name root)))

(defun drgnx-ui--session-run (sess)
  "SESS's run directory as the harness made it: from its name and the state root, not from session.json."
  (expand-file-name (plist-get sess :name) (drgnx-ui-state-root)))

(defvar drgnx-ui--x11-dir "/tmp"
  "Where X servers keep their locks (.XN-lock) and sockets (.X11-unix/XN); tests bind it.")

(defun drgnx-ui--x11-files (n)
  "Display N's lock and socket files."
  (list (expand-file-name (format ".X%d-lock" n) drgnx-ui--x11-dir)
        (expand-file-name (format ".X11-unix/X%d" n) drgnx-ui--x11-dir)))

(defun drgnx-ui--display-reservations ()
  "The directory of X display reservations, shared by every state root of this user: one directory per number."
  (expand-file-name "x11" (expand-file-name "drgnx-ui" (drgnx-ui-runtime-dir))))

(defun drgnx-ui--reservation-owner (n)
  "The run directory that reserved display N, or nil."
  (let ((f (expand-file-name "owner" (expand-file-name (number-to-string n) (drgnx-ui--display-reservations)))))
    (and (file-regular-p f) (with-temp-buffer (insert-file-contents f) (buffer-string)))))

(defun drgnx-ui--reserve-display (run)
  "Reserve the first X display number from 90 up (well above a desktop's own) for the session in RUN and
return it.  A number is free when no X lock or socket has it and `make-directory' of its reservation
succeeds — atomic, so two harness processes (of any state root) never get the same one.  A reservation whose
run directory is gone (a crashed session) is taken over."
  (let ((dir (drgnx-ui--display-reservations)) (n 90) got)
    (drgnx-ui--make-private-dir dir)
    (while (not got)
      (when (> n 999) (drgnx-ui--fail "no free X display between :90 and :999"))
      (let* ((r (expand-file-name (number-to-string n) dir))
             (owner (expand-file-name "owner" r)))
        (cond
         ((seq-some #'file-exists-p (drgnx-ui--x11-files n)) (cl-incf n))
         ((condition-case nil (progn (make-directory r) t) (file-already-exists nil))
          (drgnx-ui--write owner run)
          (setq got n))
         ((and (drgnx-ui--reservation-stale-p n) (drgnx-ui--take-over-reservation n run)) (setq got n))
         (t (cl-incf n)))))
    got))

(defun drgnx-ui--reservation-stale-p (n)
  "Non-nil if display N's reservation is stale: its session's run directory is gone, or it never got an owner
\(a minute is plenty)."
  (let ((r (expand-file-name (number-to-string n) (drgnx-ui--display-reservations)))
        (o (drgnx-ui--reservation-owner n)))
    (and (file-directory-p r)
         (if o (not (file-directory-p o))
           (< (float-time (or (file-attribute-modification-time (file-attributes r)) 0)) (- (float-time) 60))))))

(defvar drgnx-ui--reservation-lock-wait 2.0
  "Seconds a start waits for the reservations' lock before it skips the number it wanted.")

(defun drgnx-ui--call-with-reservation-lock (fn)
  "Call FN holding the reservations' lock (`x11/.lock', made with `make-directory'); its value, or nil when
the lock stays taken for `drgnx-ui--reservation-lock-wait' seconds.  A lock older than 10 s is a crashed
holder's and is taken over."
  (let ((lock (expand-file-name ".lock" (drgnx-ui--display-reservations)))
        (deadline (+ (float-time) drgnx-ui--reservation-lock-wait))
        held)
    (while (and (not held) (< (float-time) deadline))
      (if (condition-case nil (progn (make-directory lock) t) (file-already-exists nil))
          (setq held t)
        (let ((mt (file-attribute-modification-time (file-attributes lock))))
          (when (and mt (< (float-time mt) (- (float-time) 10)))
            (ignore-errors (delete-directory lock)))
          ;; still there (held, or an old one that cannot be removed): wait, never spin
          (when (file-exists-p lock) (sleep-for 0.02)))))
    (when held
      (unwind-protect (funcall fn) (ignore-errors (delete-directory lock))))))

(defun drgnx-ui--take-over-reservation (n run)
  "Give the stale reservation of display N to RUN; non-nil if this call won it.  Under the reservations' lock
the staleness is checked again, so of two starts that both found N stale only the first takes it (without
the lock the second would delete the first's fresh reservation and take N too)."
  (drgnx-ui--call-with-reservation-lock
   (lambda ()
     (let ((r (expand-file-name (number-to-string n) (drgnx-ui--display-reservations))))
       (when (drgnx-ui--reservation-stale-p n)
         (ignore-errors (delete-directory r t))
         (when (condition-case nil (progn (make-directory r) t) (file-already-exists nil))
           (drgnx-ui--write (expand-file-name "owner" r) run)
           t))))))

(defun drgnx-ui--release-display (n run)
  "Give display N back, if RUN holds it."
  (when (equal (drgnx-ui--reservation-owner n) run)
    (delete-directory (expand-file-name (number-to-string n) (drgnx-ui--display-reservations)) t)))

(defun drgnx-ui--own-display (display run)
  "DISPLAY's number when it is \":N\" with N ≥ 90 and reserved by RUN; else nil (session.json is not trusted)."
  (and (stringp display) (string-match "\\`:\\([0-9]+\\)\\'" display)
       (let ((n (string-to-number (match-string 1 display))))
         (and (>= n 90) (equal (drgnx-ui--reservation-owner n) run) n))))

(defun drgnx-ui--write-xauthority (file n)
  "Write FILE (mode 0600): an X authority with a random MIT-MAGIC-COOKIE-1 for display N, any host.  Xvfb gets
it with -auth, the session's programs with XAUTHORITY: nobody else can connect to the display."
  (let* ((data (with-temp-buffer
                 (set-buffer-multibyte nil)
                 (let ((coding-system-for-read 'binary))
                   (call-process "head" nil t nil "-c" "16" "/dev/urandom"))
                 (buffer-string)))
         (field (lambda (s) (concat (unibyte-string (ash (length s) -8) (logand (length s) 255)) s))))
    (unless (= (length data) 16) (drgnx-ui--fail "could not read 16 random bytes for the X cookie"))
    (with-file-modes #o600
      (let ((coding-system-for-write 'no-conversion))
        (write-region (concat (unibyte-string #xff #xff)           ; FamilyWild
                              (funcall field "") (funcall field (number-to-string n))
                              (funcall field "MIT-MAGIC-COOKIE-1") (funcall field data))
                      nil file nil 'silent)))))

(defun drgnx-ui--monitor-scale (sess k)
  "The scale of SESS's monitor K (0-based): 1 without `:scales'."
  (or (ignore-errors (aref (plist-get sess :scales) k)) 1))   ; :scales is a vector: session.json holds it

(defun drgnx-ui--logical-width (w scale)
  "The logical width of a monitor W device pixels wide at SCALE."
  (round (/ (float w) scale)))

(defun drgnx-ui--monitor-geometries (sess)
  "SESS's monitors as (X W H), side by side from the left: W and H in device pixels, X in the compositor's
logical pixels (a monitor at scale S is W / S logical pixels wide)."
  (let* ((size (mapcar #'string-to-number (split-string (plist-get sess :size) "x")))
         (w (nth 0 size)) (h (nth 1 size)) (x 0))
    (cl-loop for k below (or (plist-get sess :monitors) 1)
             collect (list x w h)
             do (cl-incf x (drgnx-ui--logical-width w (drgnx-ui--monitor-scale sess k))))))

(defun drgnx-ui--env-monitors ()
  "$DRGNX_UI_MONITORS as a number of monitors (a whole test tier's sessions get that many), or nil when unset."
  (let ((e (getenv "DRGNX_UI_MONITORS")))
    (unless (member e '(nil ""))
      (unless (string-match-p "\\`[1-9][0-9]?\\'" e)
        (drgnx-ui--fail "DRGNX_UI_MONITORS must be a number of monitors, got %S" e))
      (string-to-number e))))

(defun drgnx-ui--scales (monitors scales)
  "The per-monitor scales of a session with MONITORS monitors: SCALES (a number for all, or a list, one per
monitor), else $DRGNX_UI_SCALES (\"1 2\"), else $DRGNX_UI_SCALE.  A list of MONITORS numbers, or nil when every
scale is 1."
  (let* ((n (if (integerp monitors) monitors 1))
         (env-list (getenv "DRGNX_UI_SCALES"))
         (raw (cond (scales (if (listp scales) scales (list scales)))
                    ((member env-list '(nil "")) (let ((s (getenv "DRGNX_UI_SCALE"))) (and (not (member s '(nil ""))) (list s))))
                    (t (split-string env-list " " t))))
         (nums (mapcar (lambda (s) (if (numberp s) s (string-to-number s))) raw)))
    (dolist (s nums)
      (unless (and (> s 0) (<= s 8)) (drgnx-ui--fail "a monitor scale must be above 0 and at most 8, got %S" raw)))
    (let ((per-monitor (cond ((null nums) nil)
                             ((= (length nums) 1) (make-list n (car nums)))
                             ((/= (length nums) n)
                              (drgnx-ui--fail "scales need one per monitor: %d scales for %d monitors (%S)"
                                              (length nums) n raw))
                             (t nums))))
      (and (seq-some (lambda (s) (/= s 1)) per-monitor) per-monitor))))

(defun drgnx-ui--emacs-args (sess)
  "Arguments of SESS's Emacs after the binary: its init directory, and `--fg-daemon' in a daemon session."
  (append (list "--init-directory" (expand-file-name "init" (plist-get sess :run)))
          (and (eq (plist-get sess :daemon) t) '("--fg-daemon"))))

(defun drgnx-ui-sway-config (sess)
  "The sway config of SESS: one output per monitor side by side, no bar, no borders, no XWayland (it would
take an X display in the shared /tmp), and the session's Emacs, after which sway exits — sway lives as long
as Emacs, as mutter does with `--'.  Emacs is not full screen: sway tiles it.  Nothing is included (no
/etc/sway, no ~/.config/sway).  A niri session's sway runs niri instead (`drgnx-ui-niri-config'), which runs
Emacs."
  (let ((cmd (mapconcat #'shell-quote-argument
                        (if (equal (plist-get sess :compositor) "niri")
                            (list "niri" "-c" (expand-file-name "niri.kdl" (plist-get sess :run)))
                          (cons (drgnx-ui-emacs-bin) (drgnx-ui--emacs-args sess)))
                        " ")))
    ;; sway reads `;' as a command separator unless the line is quoted, and expands `$'
    (when (string-match-p "[\"'$\\\n]" cmd)
      (drgnx-ui--fail "sway cannot run %s: its paths must not contain quotes, $, backslashes or newlines" cmd))
    ;; sway aborts when its socket path does not fit the 108 bytes of a socket address
    (let ((sock (drgnx-ui--sway-socket (plist-get sess :name) (file-name-directory (plist-get sess :run)))))
      (when (> (string-bytes sock) 100) (drgnx-ui--fail "%s is too long for sway's socket" sock)))
    (concat "# generated by drgnx for a harness session; do not edit\n"
            (cl-loop for (x w h) in (drgnx-ui--monitor-geometries sess) for k from 1
                     concat (format "output HEADLESS-%d resolution %dx%d position %d 0\n" k w h x)
                     when (plist-get sess :scales)
                     concat (format "output HEADLESS-%d scale %s\n" k (number-to-string (drgnx-ui--monitor-scale sess (1- k)))))
            "default_border none\n"
            "default_floating_border none\n"
            "xwayland disable\n"
            ;; sway opens an exec'd program's windows on the workspace focused when it ran it, and the first
            ;; output is not always the focused one at start
            "focus output HEADLESS-1\n"
            (format "exec \"%s; swaymsg exit\"\n" cmd))))

(defun drgnx-ui-niri-config (sess)
  "The niri config of SESS: run RUN/niri-session.sh (the session's Emacs), no XWayland (xwayland-satellite would
take an X display in the shared /tmp), no hotkey overlay over the window, no animations, no screenshots.
Nothing is included (no ~/.config/niri)."
  (let ((script (expand-file-name "niri-session.sh" (plist-get sess :run))))
    (drgnx-ui--check-path-chars "niri" script)
    (concat "// generated by drgnx for a harness session; do not edit\n"
            (format "spawn-at-startup \"sh\" \"%s\"\n" script)
            "xwayland-satellite { off; }\n"
            "hotkey-overlay { skip-at-startup; }\n"
            "animations { off; }\n"
            "prefer-no-csd\n"
            "screenshot-path null\n")))

(defun drgnx-ui-niri-session-script (sess)
  "The shell script niri starts in SESS: the session's Emacs, without the variables of the sway niri runs in
\(Emacs must see niri, not sway), then niri quits, and with it the sway around it."
  (concat "# generated by drgnx for a harness session; do not edit\n"
          "unset SWAYSOCK I3SOCK\n"
          (mapconcat #'shell-quote-argument (cons (drgnx-ui-emacs-bin) (drgnx-ui--emacs-args sess)) " ")
          "\nrc=$?\n"
          "niri msg action quit --skip-confirmation\n"
          "exit $rc\n"))

(defun drgnx-ui--kwin-needs-script-p (sess)
  "Non-nil when SESS has scales: they reach KWin through `kscreen-doctor' in RUN/kwin-session.sh.  Never
`kwin_wayland --scale', the windowed mode's: on the virtual backend it multiplies the outputs' size and leaves their
scale at 1 (KWin 6.7: at 1600x900 and 2 the root saw a 3200x1800 monitor at scale 1)."
  (and (plist-get sess :scales) t))

(defun drgnx-ui-kwin-session-script (sess)
  "The shell script of a kwin session whose scales `kscreen-doctor' sets (output.N.scale.S, N from 1), after
which it runs the session's Emacs."
  (concat "# generated by drgnx for a harness session; do not edit\n"
          "i=0; while [ $i -lt 50 ]; do\n  "
          (mapconcat (lambda (s) (format "kscreen-doctor output.%d.scale.%s" (car s) (number-to-string (cdr s))))
                     (cl-loop for s across (plist-get sess :scales) for k from 1 collect (cons k s)) " && ")
          " && break\n  i=$((i + 1)); sleep 0.2\ndone\n"
          "exec " (mapconcat #'shell-quote-argument (cons (drgnx-ui-emacs-bin) (drgnx-ui--emacs-args sess)) " ") "\n"))

(defun drgnx-ui-kwin-session-command (sess)
  "KWin's `--exit-with-session' command for SESS: its Emacs (or RUN/kwin-session.sh, which sets the scales
first), after which KWin exits.  KWin splits the string at spaces, so every part must be a plain path."
  (let ((parts (if (drgnx-ui--kwin-needs-script-p sess)
                   (list "sh" (expand-file-name "kwin-session.sh" (plist-get sess :run)))
                 (cons (drgnx-ui-emacs-bin) (drgnx-ui--emacs-args sess)))))
    (dolist (p parts) (drgnx-ui--check-path-chars "kwin" p))
    (string-join parts " ")))

(defun drgnx-ui--sess-i3-socket (sess)
  "SESS's i3 socket, for its state root (that of its run directory)."
  (drgnx-ui--i3-socket (plist-get sess :name) (file-name-directory (plist-get sess :run))))

(defun drgnx-ui-i3-config (sess)
  "The i3 config of SESS: no bar, no borders, its IPC socket in the session's socket directory."
  (let ((sock (drgnx-ui--sess-i3-socket sess)))
    (drgnx-ui--check-path-chars "i3" sock)
    (concat "# i3 config version 4\n# generated by drgnx for a harness session; do not edit\n"
            "font pango:monospace 8\n"
            (format "ipc-socket %s\n" sock)
            "default_border none\n"
            "default_floating_border none\n")))

(defun drgnx-ui--x11-script (sess)
  "The shell script of an x11 or i3 session (run inside `dbus-run-session').
Xvfb on the session's reserved display, only for clients with the session's cookie (-auth RUN/Xauthority);
ready when it writes its display number to RUN/xvfb.ready (-displayfd), and if it ends first (the display is
taken after all) the session ends.  One RandR monitor per monitor of SESS (Xvfb has one output, `screen';
`-noreset' keeps the monitors when a client such as xrandr disconnects); i3 for i3; then the X11 Emacs.  When
Emacs ends, so do i3 and Xvfb; they also die with this shell (`setpriv --pdeathsig KILL'), even when it is
killed."
  (let* ((geoms (drgnx-ui--monitor-geometries sess))
         (h (nth 2 (car geoms)))
         (mm (lambda (px) (round (* px 25.4) 96)))
         (run (plist-get sess :run))
         (q (lambda (f) (shell-quote-argument (expand-file-name f run))))
         (i3 (equal (plist-get sess :compositor) "i3"))
         (sock (and i3 (shell-quote-argument (drgnx-ui--sess-i3-socket sess))))
         (wait (lambda (test pid)
                 (format "i=0; until %s; do kill -0 %s 2>/dev/null || exit 1; i=$((i+1)); [ $i -ge 200 ] && exit 1; sleep 0.05; done\n"
                         test pid))))
    (concat
     (format "setpriv --pdeathsig KILL Xvfb %s -noreset -nolisten tcp -auth %s -displayfd 3 -screen 0 %dx%dx24 +extension RANDR 3>%s & xvfb=$!\n"
             (plist-get sess :display) (funcall q "Xauthority") (apply #'+ (mapcar #'cadr geoms)) h
             (funcall q "xvfb.ready"))
     (format "echo $xvfb > %s\n" (funcall q "xvfb.pid"))
     (funcall wait (format "[ -s %s ]" (funcall q "xvfb.ready")) "$xvfb")
     (cl-loop for (x w mh) in geoms for k from 1
              concat (format "xrandr --setmonitor XVFB-%d %d/%dx%d/%d+%d+0 %s\n"
                             k w (funcall mm w) mh (funcall mm mh) x (if (= k 1) "screen" "none")))
     (if i3
         (concat (format "setpriv --pdeathsig KILL i3 -c %s & wm=$!\n" (funcall q "i3.conf"))
                 (funcall wait (format "[ -S %s ]" sock) "$wm")
                 ;; i3 starts on the output under the pointer, the middle of the screen: Emacs opens on the first
                 (format "i3-msg -q -s %s focus output XVFB-1\n" sock)
                 ;; as i3 gives its children: Emacs under i3 knows its WM
                 (format "export I3SOCK=%s\n" sock))
       "wm=\n")
     ;; --no-x-resources: no ~/.Xdefaults, $XENVIRONMENT or app-defaults — nothing of the user's
     (mapconcat #'shell-quote-argument
                (cons (drgnx-ui-x11-emacs-bin) (cons "--no-x-resources" (drgnx-ui--emacs-args sess))) " ")
     "\nrc=$?\nkill $wm $xvfb 2>/dev/null\nexit $rc\n")))

(defun drgnx-ui-resolve-config (config)
  "nil for the minimal config, else the external config directory (must hold init.el)."
  (unless (member config '(nil "" "minimal"))
    (let ((dir (expand-file-name (pcase config
                                   ("gryphn" (or (getenv "DRGNX_GRYPHN_CONFIG") "~/.config/emacs"))
                                   ("drgnx" (expand-file-name "init" (or drgnx-ui-session-repo drgnx-ui-repo-dir)))
                                   (_ config)))))
      (unless (file-regular-p (expand-file-name "init.el" dir))
        (drgnx-ui--fail "config %S: no init.el in %s" config dir))
      (directory-file-name (file-truename dir)))))

(defun drgnx-ui-private-tmp-dir (name what)
  "The directory NAME in `temporary-file-directory', made private (mode 0700) if it is not there; it is checked
to be yours.  WHAT says what it holds, for the error."
  (let ((dir (expand-file-name name temporary-file-directory)))
    (drgnx-ui--make-private-dir dir)
    ;; /tmp is shared: anyone may have made this name first (or a symlink to elsewhere)
    (let ((attrs (file-attributes dir 'integer)))
      (unless (and (eq (file-attribute-type attrs) t)
                   (eql (file-attribute-user-id attrs) (user-uid))
                   (equal (file-attribute-modes attrs) "drwx------"))
        (drgnx-ui--fail "%s must be a directory of yours with mode 0700 (%s)" dir what)))
    dir))

(defun drgnx-ui-runtime-dir ()
  "$XDG_RUNTIME_DIR, or a private fallback where it is unset (containers): the sessions'
Wayland displays and server sockets live here."
  (let ((xdg (getenv "XDG_RUNTIME_DIR")))
    (if (and xdg (not (string-empty-p xdg)))
        (directory-file-name xdg)
      (drgnx-ui-private-tmp-dir (format "drgnx-ui-%d" (user-uid)) "it holds the sessions' sockets"))))

(defun drgnx-ui-socket-dir (name &optional root)
  "Directory for session NAME's server socket: short, private, keyed by the state ROOT.
Unix socket paths are limited to ~108 bytes, so sockets never live under ROOT itself, and the directory is NAME
without its \"drgnx-ui-\" (the socket inside it has the whole NAME)."
  (let* ((runtime (drgnx-ui-runtime-dir))
         (root (directory-file-name (expand-file-name (or root (drgnx-ui-state-root))))))
    (expand-file-name (string-remove-prefix "drgnx-ui-" name)
                      (expand-file-name (substring (md5 root) 0 8)
                                        (expand-file-name "drgnx-ui" runtime)))))

(defun drgnx-ui--make-private-dir (dir)
  "Create DIR and missing parents, each mode 0700 (server-start refuses anything else)."
  (unless (file-directory-p dir)
    (drgnx-ui--make-private-dir (directory-file-name (file-name-directory (directory-file-name dir))))
    ;; another Emacs may make a shared parent between the check and here (sessions start from several processes);
    ;; a file of that name that is no directory is still an error (and keeps its mode)
    (condition-case err (make-directory dir)
      (file-already-exists (unless (file-directory-p dir) (signal (car err) (cdr err)))))
    (set-file-modes dir #o700)))

(defun drgnx-ui--owner ()
  "session.json's :owner for a session this process starts: its kind, checkout, pid and, for an MCP client, its token."
  (append (list :kind (cond ((equal (getenv "DRGNX_CHECK") "1") "check")
                            ((equal (getenv "DRGNX_TEST_ISOLATED") "1") "test")
                            (t (symbol-name drgnx-ui-owner-kind)))
                :worktree (directory-file-name drgnx-ui-repo-dir) :pid (emacs-pid))
          (and (stringp drgnx-ui-owner-client) (list :client drgnx-ui-owner-client))))

(defun drgnx-ui--save (sess)
  (drgnx-ui--write (expand-file-name "session.json" (plist-get sess :run)) (drgnx-ui--json sess)))

(defun drgnx-ui-prepare-run (name &optional config size root daemon monitors compositor scales)
  "Create the run directory for session NAME under ROOT; return the session plist.
DAEMON non-nil: Emacs runs as a daemon (no frame until `drgnx-ui-new-frame').
SIZE: WxH in device pixels (nil: $DRGNX_UI_SIZE, else 1600x900).
MONITORS: how many virtual monitors of SIZE (default 1).  SCALES: a scale for all monitors or a list, one per
monitor (nil: $DRGNX_UI_SCALES \"1 2\", else $DRGNX_UI_SCALE, else 1); mutter, sway and kwin only.
COMPOSITOR: one of `drgnx-ui-compositors' (nil: the
default, `drgnx-ui-default-compositor'); every one but mutter gets a private runtime directory; sway gets
RUN/sway.conf, x11 and i3 a free X display, i3 also RUN/i3.conf, niri (one monitor only) RUN/sway.conf,
RUN/niri.kdl and RUN/niri-session.sh."
  (let* ((size (or size (let ((e (getenv "DRGNX_UI_SIZE"))) (and (not (member e '(nil ""))) e)) "1600x900"))
         (compositor (or compositor (drgnx-ui-default-compositor)))
         (monitors (or monitors (drgnx-ui--env-monitors)))
         (scales (drgnx-ui--scales monitors scales)))
    (unless (string-match-p "\\`[0-9]+x[0-9]+\\'" size)
      (drgnx-ui--fail "size must be WxH, got %S" size))
    (drgnx-ui--check-compositor compositor)
    (when (and scales (member compositor '("x11" "i3" "niri")))
      (drgnx-ui--fail "the %s compositor has no monitor scale; scales run under mutter, sway or kwin" compositor))
    (when (and (equal compositor "niri") (integerp monitors) (> monitors 1))
      (drgnx-ui--fail "niri runs nested in sway here, with one output only: it cannot have %d monitors" monitors))
    (let* ((cfg (drgnx-ui-resolve-config config))
           (root (directory-file-name (expand-file-name (or root (drgnx-ui-state-root)))))
           (run (expand-file-name name root))
           (init (expand-file-name "init" run))
           (sock (drgnx-ui-socket-dir name root)))
      (make-directory root t)
      (make-directory run)                ; signals if it exists: never reuse a run dir
      (make-directory init)
      (make-directory (expand-file-name "out" run))
      (make-directory (expand-file-name "tmp" run))     ; the session's TMPDIR: gone with the run dir
      (make-directory (expand-file-name "home" run))    ; its HOME, too
      (when (file-directory-p sock) (delete-directory sock t))   ; stale, from a crashed session
      (drgnx-ui--make-private-dir sock)
      (drgnx-ui--write (expand-file-name "early-init.el" init) drgnx-ui--early-init)
      (drgnx-ui--write (expand-file-name "init.el" init) drgnx-ui--init)
      (when cfg
        (dolist (n drgnx-ui-link)
          (let ((src (expand-file-name n cfg)))
            (when (file-exists-p src) (make-symbolic-link src (expand-file-name n init)))))
        (dolist (n drgnx-ui-copy)
          (let ((src (expand-file-name n cfg)))
            (when (file-regular-p src) (copy-file src (expand-file-name n init) nil t)))))
      (let ((sess (list :name name :id name :owner (drgnx-ui--owner)
                        :run run :socket (expand-file-name name sock) :size size
                        :config (if (member config '(nil "")) "minimal" config)
                        :config_dir (or cfg "") :created (float-time) :compositor compositor)))
        (when daemon (setq sess (plist-put sess :daemon t)))
        (when (and (integerp monitors) (> monitors 1)) (setq sess (plist-put sess :monitors monitors)))
        (when scales (setq sess (plist-put sess :scales (vconcat scales))))
        (unless (equal compositor "mutter")
          ;; the session's own runtime directory: nothing it starts reaches the caller's (its bus, its sockets)
          (let ((xdg (drgnx-ui-session-runtime-dir name root)))
            (when (file-directory-p xdg) (delete-directory xdg t))   ; stale, from a crashed session
            (drgnx-ui--make-private-dir xdg)
            (setq sess (plist-put sess :xdg_runtime_dir xdg))))
        (pcase compositor
          ("sway" (drgnx-ui--write (expand-file-name "sway.conf" run) (drgnx-ui-sway-config sess)))
          ("kwin" (drgnx-ui-kwin-session-command sess)       ; its paths are checked before anything starts
           (when (drgnx-ui--kwin-needs-script-p sess)
             (drgnx-ui--write (expand-file-name "kwin-session.sh" run) (drgnx-ui-kwin-session-script sess))))
          ("niri" (drgnx-ui--write (expand-file-name "sway.conf" run) (drgnx-ui-sway-config sess))
           (drgnx-ui--write (expand-file-name "niri.kdl" run) (drgnx-ui-niri-config sess))
           (drgnx-ui--write (expand-file-name "niri-session.sh" run) (drgnx-ui-niri-session-script sess)))
          ((or "x11" "i3")
           (let ((n (drgnx-ui--reserve-display run)))
             (setq sess (plist-put sess :display (format ":%d" n)))
             ;; a session that cannot be made gives its number back at once
             (condition-case err
                 (progn
                   (drgnx-ui--write-xauthority (expand-file-name "Xauthority" run) n)
                   (when (equal compositor "i3")
                     (drgnx-ui--write (expand-file-name "i3.conf" run) (drgnx-ui-i3-config sess))))
               (error (drgnx-ui--release-display n run)
                      (signal (car err) (cdr err)))))))
        (drgnx-ui--save sess)
        sess))))

(defvar drgnx-ui-session-extra-env nil
  "\"K=V\" strings added to the environment of the sessions started while this is bound, after the session's own
variables (a later entry wins): a test puts a package's directory on the daemon's load path with EMACSLOADPATH
\(`drgnx-tty-session-kitty-start').  Nil for every session the CLI and the MCP server start.  Only names in
`drgnx-ui-session-extra-env-names' are taken; anything else signals.")

(defconst drgnx-ui-session-extra-env-names '("EMACSLOADPATH" "DRGNX_PERF_GLITNIR")
  "The variables `drgnx-ui-session-extra-env' may set.  Not HOME, DISPLAY, the bus, XDG_RUNTIME_DIR or TMPDIR:
a later entry wins, so one of those would move a session out of its run directory or onto the user's desktop.")

(defun drgnx-ui--check-extra-env (env)
  "ENV (\"K=V\" strings) when every name is in `drgnx-ui-session-extra-env-names'; else signal."
  (dolist (kv env env)
    (let ((name (and (stringp kv) (string-match "\\`\\([^=]+\\)=" kv) (match-string 1 kv))))
      (unless (member name drgnx-ui-session-extra-env-names)
        (drgnx-ui--fail "drgnx-ui-session-extra-env: %S is not one of %s" kv
                        (string-join drgnx-ui-session-extra-env-names ", "))))))

(defun drgnx-ui--last-wins (env)
  "ENV (\"K=V\" strings) with one entry per name, the last one, in order."
  (let (seen out)
    (dolist (kv (reverse env))
      (let ((name (car (split-string kv "="))))
        (unless (member name seen) (push name seen) (push kv out))))
    out))

(defun drgnx-ui-session-env (sess &optional extra)
  "Environment (\"K=V\" strings) for SESS: `drgnx-test-env' of `drgnx-ui-session-tier' in the run directory (its
HOME, XDG directories, dead bus), the allowlist, the session's variables, its compositor's,
`drgnx-ui-session-extra-env' (checked: `drgnx-ui--check-extra-env'), EXTRA.  A later entry replaces an earlier one
of the same name."
  (drgnx-ui--last-wins
   (append (seq-filter (lambda (kv) (string-search "=" kv))   ; `env -i' already drops the unset ones
                       (drgnx-test-env drgnx-ui-session-tier (plist-get sess :run)))
           (delq nil (mapcar (lambda (k) (let ((v (getenv k))) (and v (concat k "=" v))))
                             drgnx-ui-keep-env))
           (list (concat "DRGNX_UI_NAME=" (plist-get sess :name))
                 (concat "DRGNX_UI_RUN=" (plist-get sess :run))
                 (concat "TMPDIR=" (expand-file-name "tmp" (plist-get sess :run)))
                 (concat "DRGNX_UI_HARNESS=" (directory-file-name drgnx-ui-harness-dir))
                 (concat "DRGNX_UI_CONFIG=" (plist-get sess :config_dir))
                 ;; what the session was started at, for tests that check it (test/ui/smoke-test.el)
                 (concat "DRGNX_UI_SESSION_SIZE=" (plist-get sess :size))
                 (concat "DRGNX_UI_SESSION_SCALES="(mapconcat #'number-to-string (plist-get sess :scales) " "))
                 ;; sway, x11, i3: the session's own runtime dir, so its sockets are never the caller's
                 (concat "XDG_RUNTIME_DIR=" (or (plist-get sess :xdg_runtime_dir) (drgnx-ui-runtime-dir)))
                 (concat "DRGNX_UI_SOCKET_DIR=" (directory-file-name (file-name-directory (plist-get sess :socket))))
                 (concat "EMACS_SOCKET_NAME=" (plist-get sess :socket))
                 ;; no language server per fixture project (12 pyrights in one scenario run); a test that wants
                 ;; one sets this to "" in its session
                 "DRGNX_NO_LANGUAGE_SERVERS=1"
                 "DRGNX_NO_SHELL_ENV=1"     ; the session's PATH, never the login shell's (a test clears it)
                 ;; GTK's own input method, never the host's IM or the compositor's text-input: keys compose the
                 ;; same in every session (the IME preedit test, test/ui/childframe-extra-test.el)
                 "GTK_IM_MODULE=gtk-im-context-simple"
                 ;; drgnx's own config and state stay in the run dir: a session never reads the
                 ;; user's ~/.config/drgnx or writes ~/.local/state.
                 (concat "DRGNX_CONFIG_DIR=" (expand-file-name "drgnx-config" (plist-get sess :run)))
                 (concat "XDG_STATE_HOME=" (expand-file-name "state" (plist-get sess :run)))
                 ;; …and its packages: never the user's ~/.local/share/drgnx (M5 review I9)
                 (concat "DRGNX_DATA_DIR=" (expand-file-name "drgnx-data" (plist-get sess :run))))
           (pcase (plist-get sess :compositor)
             ;; mutter and the session's Emacs keep their font and GL shader caches in the run dir, never ~/.cache
             ;; (rebuilt on every start: a test never writes the user's home)
             ("mutter" (list (concat "XDG_CACHE_HOME=" (drgnx-ui--session-cache sess))
                             (concat "MESA_SHADER_CACHE_DIR=" (expand-file-name "mesa" (drgnx-ui--session-cache sess)))))
             ;; wlroots without a GPU, a seat or input devices; one output per monitor
             ;; (sway takes SWAYSOCK as the path to listen on, and gives it to its children)
             ;; niri: the same sway, with one output, runs niri (its winit backend: one window, one output)
             ((or "sway" "niri") (delq nil (list "WLR_BACKENDS=headless" "WLR_RENDERER=pixman" "WLR_LIBINPUT_NO_DEVICES=1"
                                                 (format "WLR_HEADLESS_OUTPUTS=%d" (or (plist-get sess :monitors) 1))
                                                 (concat "SWAYSOCK=" (drgnx-ui--sway-socket (plist-get sess :name)
                                                                                            (file-name-directory (plist-get sess :run))))
                                                 ;; niri renders with GL: Mesa's shader cache stays in the run directory
                                                 (and (equal (plist-get sess :compositor) "niri")
                                                      (concat "XDG_CACHE_HOME=" (drgnx-ui--session-cache sess)))
                                                 (and (equal (plist-get sess :compositor) "niri")
                                                      (concat "MESA_SHADER_CACHE_DIR=" (expand-file-name "mesa" (drgnx-ui--session-cache sess)))))))
             ;; no WAYLAND_DISPLAY (`env -i'): the X11 Emacs only sees its own X display, with its cookie
             ((or "x11" "i3") (list (concat "DISPLAY=" (plist-get sess :display))
                                    (concat "XAUTHORITY=" (expand-file-name "Xauthority" (plist-get sess :run)))))
             ;; what a Plasma session sets (drgnx detects KWin by XDG_CURRENT_DESKTOP); KWin reads and writes its
             ;; config (kwinrc, kwinoutputconfig.json), data and caches in the run directory, never in ~
             ("kwin" (let ((xdg (expand-file-name "xdg" (plist-get sess :run))))
                       (list "XDG_CURRENT_DESKTOP=KDE" "KDE_FULL_SESSION=true" "XDG_SESSION_TYPE=wayland"
                             (concat "XDG_CONFIG_HOME=" (expand-file-name "config" xdg))
                             (concat "XDG_DATA_HOME=" (expand-file-name "data" xdg))
                             (concat "XDG_CACHE_HOME=" (drgnx-ui--session-cache sess))
                             (concat "MESA_SHADER_CACHE_DIR=" (expand-file-name "mesa" (drgnx-ui--session-cache sess)))))))
           (drgnx-ui--check-extra-env drgnx-ui-session-extra-env)
           extra)))

(defun drgnx-ui--session-cache (sess)
  "RUN/xdg/cache: the cache directory of SESS's mutter, KWin or niri (and of what renders with GL in it), never ~/.cache."
  (expand-file-name "xdg/cache" (plist-get sess :run)))

(defun drgnx-ui-env-argv (env)
  (append '("env" "-i") env))

(defun drgnx-ui--mutter-scale-prefix (sess)
  "The command words that run before SESS's Emacs under mutter when it has scales, else nil: `gdctl set' puts
each virtual monitor (Meta-0, Meta-1, …) in a logical monitor of its scale (R12: mutter 50 takes a fractional
scale on a headless monitor), retried while mutter's display config service comes up; then it execs Emacs.  When
every try failed it prints gdctl's last error and exits without Emacs, so the session fails to start with that error in
its log (UI-SCALE-1: an image without gdctl's python3-gobject started every session at scale 1)."
  (when (plist-get sess :scales)
    (let ((args (cl-loop for (x _w _h) in (drgnx-ui--monitor-geometries sess)
                         for s across (plist-get sess :scales) for k from 0
                         append (append '("--logical-monitor") (and (= k 0) '("--primary"))
                                        (list "--monitor" (format "Meta-%d" k) "--scale" (number-to-string s)
                                              "--x" (number-to-string x) "--y" "0")))))
      (list "sh" "-c"
            (format (concat "i=0; until err=$(gdctl set %s 2>&1); do i=$((i+1)); if [ $i -ge 50 ]; then "
                            ;; one line: the error's last (a Python traceback ends with the exception)
                            "echo \"drgnx harness: scale not applied: gdctl set failed $i times: "
                            "$(printf '%%s\\n' \"$err\" | tail -n 1)\" >&2; exit 1; fi; "
                            "sleep 0.2; done; exec \"$@\"")
                    (mapconcat #'shell-quote-argument args " "))
            "sh"))))

(defun drgnx-ui-compositor-argv (sess)
  "The command that runs SESS's compositor and, inside it, its Emacs."
  (pcase (or (plist-get sess :compositor) "mutter")
    ((or "sway" "niri") (list "dbus-run-session" "--" "sway" "-c" (expand-file-name "sway.conf" (plist-get sess :run))))
    ;; the virtual backend: no GPU, one output per monitor; no XWayland (no X display in the shared /tmp)
    ("kwin" (let ((size (split-string (plist-get sess :size) "x")))
              (append
               (list "dbus-run-session" "--" "kwin_wayland" "--virtual" "--width" (car size) "--height" (cadr size)
                     "--output-count" (number-to-string (or (plist-get sess :monitors) 1)))
               ;; the scales are set by RUN/kwin-session.sh (kscreen-doctor)
               (list "--socket" "wayland-1" "--no-lockscreen" "--no-global-shortcuts"
                     "--exit-with-session" (drgnx-ui-kwin-session-command sess)))))
    ((or "x11" "i3") (list "dbus-run-session" "--" "sh" "-c" (drgnx-ui--x11-script sess)))
    (_
     (append (list "dbus-run-session" "--" "mutter" "--headless" "--wayland" "--no-x11"
                   "--wayland-display" (plist-get sess :name))
             (cl-loop repeat (or (plist-get sess :monitors) 1) append (list "--virtual-monitor" (plist-get sess :size)))
             (list "--")
             (drgnx-ui--mutter-scale-prefix sess)
             (list (drgnx-ui-emacs-bin) "--init-directory" (expand-file-name "init" (plist-get sess :run)))
             ;; A daemon has no frame until a client asks for one (`drgnx-ui-new-frame').
             (if (eq (plist-get sess :daemon) t) '("--fg-daemon") '("--fullscreen"))))))

(defun drgnx-ui--lease-dir ()
  "The host lease's directory (bin/drgnx lease) when an interactive session takes a light slot, else nil.  Off, as
in bin/drgnx: inside a leased command (DRGNX_LEASE_HELD: test, check, perf), in CI, DRGNX_LEASE=off, no `flock', no
directory."
  (unless (or (equal (getenv "CI") "true") (equal (getenv "DRGNX_LEASE") "off") (getenv "DRGNX_LEASE_HELD")
              (not (executable-find "flock")))
    (cond ((getenv "DRGNX_LEASE_DIR"))
          ((getenv "XDG_RUNTIME_DIR") (expand-file-name "drgnx/lease" (getenv "XDG_RUNTIME_DIR"))))))

(defun drgnx-ui--lease-refusal (log)
  "\"no light slot free in 120 s: HOLDERS\" when LOG (a session's last lines) says the lease refused it, else nil."
  (when (string-match "no light slot free in 120 s; holders:\n\\(\\(?:.*\n?\\)*\\)" log)
    (format "no light slot free in 120 s: %s"
            (mapconcat #'identity (split-string (match-string 1 log) "\n" t) "; "))))

(defun drgnx-ui-launch-argv (sess)
  (append (list "systemd-run" "--user" "--quiet" "--collect" "--unit" (plist-get sess :name)
                ;; a session never outlives its budget: 30 min, or $DRGNX_UI_MAX_RUNTIME s (the soak)
                "-p" (format "RuntimeMaxSec=%s" (or (getenv "DRGNX_UI_MAX_RUNTIME") "1800")) "-p" "MemoryMax=3G"
                ;; a stop kills what is left after 10 s (systemd's default is 90): with ask-to-exit (8 s at most) a
                ;; session's stop takes 18 s at the very most, within bin/drgnx check's 25 s grace for an ended job
                "-p" "TimeoutStopSec=10" "--")
          (let ((lease (drgnx-ui--lease-dir)))
            ;; an interactive session holds a light slot while it lives: no slot in 120 s and it exits.  Its
            ;; environment is `env -i', so the lease directory is passed; the unit is capped (3G) already.
            (append (drgnx-ui-env-argv (append (drgnx-ui-session-env sess)
                                               (and lease (append (list (concat "DRGNX_LEASE_DIR=" lease) "DRGNX_LEASE_CAP=off")
                                                                  (delq nil (mapcar (lambda (k) (let ((v (getenv k))) (and v (concat k "=" v))))
                                                                                    '("DRGNX_LEASE_LIGHT" "DRGNX_LEASE_HEAVY")))))))
                    (and lease (list (expand-file-name "bin/drgnx" drgnx-ui-repo-dir) "lease" "light" "--wait" "120" "--"))
                    (drgnx-ui-compositor-argv sess)))))

;;;; Lifecycle

(defun drgnx-ui-unit-active-p (name)
  (eq 0 (car (drgnx-ui--run "systemctl" "--user" "is-active" "--quiet" name))))

(defvar drgnx-ui--name-counter 0 "Makes each id this process draws differ, even within one clock tick.")

(defun drgnx-ui--highest-n (dir &optional suffix)
  "The highest N of a drgnx-ui-N, drgnx-ui-N-HEX or drgnx-ui-test-N-HEX entry in DIR (SUFFIX, a regexp, ending it), or 0."
  (let ((n 0))
    (dolist (f (and (file-directory-p dir)
                    (directory-files dir nil (concat "\\`drgnx-ui-\\(?:test-\\)?[0-9]+\\(?:-[0-9a-f]\\{6\\}\\)?" suffix "\\'")))
               n)
      (string-match "\\`drgnx-ui-\\(?:test-\\)?\\([0-9]+\\)" f)
      (setq n (max n (string-to-number (match-string 1 f)))))))

(defun drgnx-ui--counter-value (root)
  "The number in ROOT/counter, or 0."
  (let ((file (expand-file-name "counter" root)))
    (if (file-readable-p file)
        (with-temp-buffer (insert-file-contents file) (string-to-number (buffer-string)))
      0)))

(defun drgnx-ui-next-name (root &optional kind)
  "A new session id drgnx-ui-N-HEX (drgnx-ui-test-N-HEX for KIND \"test\") for ROOT.  N, for people, is one above the
highest of ROOT/counter, the names in ROOT and in the runtime directory, and the tombstones in ROOT/ended; it is
written back to ROOT/counter.  HEX is six hex digits from this pid, the time and a counter.  Ids are never reused
\(HARNESS-SESS-2: agents in other worktrees addressed each other's sessions when a stopped session's drgnx-ui-N came
back); uniqueness is the hex and the claim: one taken as a run directory, a Wayland display or a unit is skipped,
and the run directory claims it (`drgnx-ui-prepare-run' fails when it exists)."
  (let ((n (1+ (max (drgnx-ui--counter-value root) (drgnx-ui--highest-n root)
                    (drgnx-ui--highest-n (drgnx-ui-runtime-dir))
                    (drgnx-ui--highest-n (expand-file-name "ended" root) "\\.eld"))))
        (prefix (if (equal kind "test") "drgnx-ui-test" "drgnx-ui"))
        name)
    (while (progn (setq name (format "%s-%d-%s" prefix n
                                     (substring (md5 (format "%d %.9f %d" (emacs-pid) (float-time)
                                                             (cl-incf drgnx-ui--name-counter)))
                                                0 6)))
                  (or (file-exists-p (expand-file-name name root))
                      (file-exists-p (expand-file-name name (drgnx-ui-runtime-dir)))
                      (drgnx-ui-unit-active-p name))))
    (make-directory root t)
    ;; written whole and renamed in: several Emacs draw names at once, and a lock file would stop the second one
    (let ((tmp (expand-file-name (format "counter.%d" (emacs-pid)) root)) (create-lockfiles nil))
      (write-region (number-to-string n) nil tmp nil 'silent)
      (rename-file tmp (expand-file-name "counter" root) t))
    name))

;;;; Tombstones: when a session ended, so its id is refused with a reason

(defun drgnx-ui--tombstone-file (root id)
  (expand-file-name (concat id ".eld") (expand-file-name "ended" root)))

(defun drgnx-ui--tombstone (root id reason)
  "Record that session ID of state ROOT ended, REASON being `stopped' or `reaped'."
  (let ((file (drgnx-ui--tombstone-file root id)))
    (make-directory (file-name-directory file) t)
    (with-temp-file file
      (prin1 (list :ended (format-time-string "%FT%T%z") :reason reason :by (emacs-pid)
                   :worktree (directory-file-name drgnx-ui-repo-dir))
             (current-buffer)))))

(defun drgnx-ui--prune-tombstones (root)
  "Delete ROOT's tombstones older than `drgnx-ui-tombstone-days'."
  (let ((dir (expand-file-name "ended" root))
        (cutoff (- (float-time) (* 86400 drgnx-ui-tombstone-days))))
    (dolist (f (and (file-directory-p dir) (directory-files dir t "\\.eld\\'")))
      (when (< (float-time (file-attribute-modification-time (file-attributes f))) cutoff)
        (ignore-errors (delete-file f))))))

(defun drgnx-ui-claim-run (config size root &optional daemon monitors compositor scales)
  "Prepare a session's run in ROOT under the first free name.  Several processes may start sessions at
once (bin/drgnx check): a name another took between the choice and the claim — its run directory exists,
so `drgnx-ui-prepare-run' refuses it — moves on to the next one."
  (let (sess (tries 0))
    (while (not sess)
      (condition-case err
          (setq sess (drgnx-ui-prepare-run (drgnx-ui-next-name root) config size root daemon monitors compositor scales))
        (file-already-exists (when (> (cl-incf tries) 50) (signal (car err) (cdr err))))))
    sess))

;;;; Sessions this process started (stopped if it is ended early)

(defvar drgnx-ui--own nil
  "Sessions this process started and has not stopped: (NAME . STATE-ROOT), or (:group . RUN) for a test-suite
session.")

(defun drgnx-ui--own-add (name root) (push (cons name root) drgnx-ui--own))
(defun drgnx-ui--own-remove (name) (setq drgnx-ui--own (seq-remove (lambda (e) (equal (car e) name)) drgnx-ui--own)))

(defun drgnx-ui--stop-no-block (name root)
  "Tell session NAME's systemd unit (of state ROOT) to stop, without waiting; nothing if it is not this root's unit."
  (when (drgnx-ui--unit-owned-p name (expand-file-name name root))
    (drgnx-ui--run "systemctl" "--user" "stop" "--no-block" name)))

(defun drgnx-ui--stop-own-on-exit ()
  "`kill-emacs-hook': with DRGNX_UI_STOP_ON_EXIT set (bin/drgnx check, the test-* tiers), stop the sessions
this process started and did not stop — it was ended early (a timeout, C-c), its own clean-up never ran.
Without it nothing is stopped: `drgnx ui start' sessions are meant to outlive the command."
  (when (getenv "DRGNX_UI_STOP_ON_EXIT")
    ;; every unit is told to stop first (no waiting), so the stops below run side by side
    (dolist (e drgnx-ui--own)
      (unless (eq (car e) :group) (ignore-errors (drgnx-ui--stop-no-block (car e) (cdr e)))))
    (dolist (e drgnx-ui--own)
      (ignore-errors
        (if (eq (car e) :group) (drgnx-ui--kill-group (cdr e))
          (let ((process-environment (cons (concat "DRGNX_UI_STATE=" (cdr e)) process-environment)))
            (drgnx-ui-stop (car e))))))
    (setq drgnx-ui--own nil)))

(add-hook 'kill-emacs-hook #'drgnx-ui--stop-own-on-exit)

(defun drgnx-ui--claim-and-launch (config size root &optional daemon monitors compositor scales)
  "Claim a name in ROOT and launch the session's processes; the session plist.  Unit names are the
user's, across state roots: one another root's session holds (systemd: \"already loaded\") is given back
and the next name tried."
  (let (sess (refused nil))
    (unwind-protect
        (while (not sess)
          (let* ((s (drgnx-ui-claim-run config size root daemon monitors compositor scales))
                 (launcher (drgnx-ui-launcher)))
            (setq s (plist-put s :launcher launcher))
            (if (equal launcher "detached")
                (setq sess (plist-put s :pgid (condition-case err (drgnx-ui--launch-detached s)
                                                ;; its group may have started: stop finds it by the pgid file
                                                (error (drgnx-ui-stop (plist-get s :name))
                                                       (signal (car err) (cdr err))))))
              (let ((r (apply #'drgnx-ui--run (drgnx-ui-launch-argv s))))
                (cond ((eq (car r) 0) (setq sess s))
                      ;; kept claimed while we look further, so the next choice is another name
                      ((and (string-match-p "already loaded\\|has a fragment\\|already exists" (cdr r)) (< (length refused) 20))
                       (push (plist-get s :name) refused))
                      (t (drgnx-ui-stop (plist-get s :name))
                         (drgnx-ui--fail "systemd-run failed: %s" (string-trim (cdr r)))))))))
      ;; our runs of the refused names go (stop leaves a unit it does not own alone)
      (dolist (n refused) (drgnx-ui-stop n)))
    sess))

(defun drgnx-ui-journal-tail (name)
  "The session's last log lines, without systemd's own (very long) start/stop lines."
  (mapconcat #'identity
             (seq-remove (lambda (l) (string-search "[systemd-run]" l))
                         (split-string (cdr (drgnx-ui--run "journalctl" "--user" "-u" name "-n" "30"
                                                           "--no-pager" "-o" "cat"))
                                       "\n" t))
             "\n"))

(defun drgnx-ui--choose-launcher (container systemd-p override)
  "\"systemd\" (a transient user unit) on a host with a systemd user session, else \"detached\".
OVERRIDE (from $DRGNX_UI_LAUNCHER) wins."
  (cond ((member override '("systemd" "detached")) override)
        ((and (not container) systemd-p) "systemd")
        (t "detached")))

(defun drgnx-ui-launcher ()
  (drgnx-ui--choose-launcher (drgnx-env-container) (drgnx-env-systemd-user-p)
                             (getenv "DRGNX_UI_LAUNCHER")))

(defun drgnx-ui--read-pgid (run)
  (let ((file (expand-file-name "pgid" run)))
    (and (file-exists-p file)
         (let ((pgid (string-trim (with-temp-buffer (insert-file-contents file) (buffer-string)))))
           (and (string-match-p "\\`[0-9]+\\'" pgid) pgid)))))

(defun drgnx-ui--launch-detached (sess)
  "Start SESS as its own process group (no systemd); return the group id."
  (let* ((run (plist-get sess :run))
         (cmd (mapconcat #'shell-quote-argument
                         (append (drgnx-ui-env-argv (drgnx-ui-session-env sess))
                                 (drgnx-ui-compositor-argv sess))
                         " "))
         (deadline (+ (float-time) 5)))
    ;; The caps of the systemd launcher: RuntimeMaxSec (timeout TERMs the group, KILLs it 10 s later) and a
    ;; virtual-memory ulimit (generous, since a GL stack maps a lot; MemoryMax=3G is the systemd one).
    (call-process "setsid" nil 0 nil "-f" "sh" "-c"
                  (format "echo $$ > %s; ulimit -v %d 2>/dev/null; exec timeout -k 10 %s %s > %s 2>&1"
                          (shell-quote-argument (expand-file-name "pgid" run))
                          (* 16 1024 1024)
                          (shell-quote-argument (or (getenv "DRGNX_UI_MAX_RUNTIME") "1800")) cmd
                          (shell-quote-argument (expand-file-name "session.log" run))))
    (while (and (not (drgnx-ui--read-pgid run)) (< (float-time) deadline))
      (sleep-for 0.02))
    (or (drgnx-ui--read-pgid run) (drgnx-ui--fail "setsid did not start %s" (plist-get sess :name)))))

(defun drgnx-ui--group-ours-p (pgid run)
  "Non-nil while process group PGID has a member that belongs to the session started in RUN.
Checks the whole group, not just its leader (which may exit first on TERM), and requires
a member's command line to name RUN — the pgid file may be stale and the id reused by an
unrelated group.  Ids 0 and 1 are never ours."
  (and (stringp pgid) (string-match-p "\\`[0-9]+\\'" pgid) (> (string-to-number pgid) 1)
       (eq 0 (car (drgnx-ui--run "pgrep" "-g" pgid "-f" "--" (concat (drgnx-ui--ere-quote run) "/"))))))

(defun drgnx-ui--unit-owned-p (name run)
  "Non-nil if systemd unit NAME is running the session whose run directory is RUN.
Unit names are global; another state root may run a session with the same name."
  (string-search (concat "DRGNX_UI_RUN=" run " ") (or (drgnx-ui--unit-cmdline name) "")))

(defun drgnx-ui-alive-p (sess)
  "Non-nil while SESS's own unit or process group is running."
  (let ((run (plist-get sess :run)))
    (if (equal (plist-get sess :launcher) "detached")
        (drgnx-ui--group-ours-p (plist-get sess :pgid) run)
      (and (drgnx-ui-unit-active-p (plist-get sess :name))
           (drgnx-ui--unit-owned-p (plist-get sess :name) run)))))

(defun drgnx-ui--log-tail (sess)
  (if (equal (plist-get sess :launcher) "detached")
      (let ((log (expand-file-name "session.log" (plist-get sess :run))))
        (if (file-exists-p log)
            (with-temp-buffer
              (insert-file-contents log)
              (buffer-substring (save-excursion (goto-char (point-max)) (forward-line -30) (point))
                                (point-max)))
          ""))
    (drgnx-ui-journal-tail (plist-get sess :name))))

(defun drgnx-ui-start (&optional config size timeout daemon monitors compositor scales)
  "Start a session (CONFIG minimal, gryphn or a directory); return its plist once ready.
DAEMON non-nil: run Emacs as a daemon; open frames with `drgnx-ui-new-frame'.  MONITORS: how
many virtual monitors (default 1).  COMPOSITOR: mutter, sway, x11, i3, kwin or niri (nil:
`drgnx-ui-default-compositor').  SIZE: WxH in device pixels (nil: $DRGNX_UI_SIZE, else 1600x900).  SCALES: a
monitor scale for all monitors, or a list, one per monitor (nil: $DRGNX_UI_SCALES \"1 2\", else $DRGNX_UI_SCALE,
else 1); the session is ready only when its root frame shows the first monitor's scale (10 s, else this
stops it and fails with \"scale S not applied\"; `drgnx-uitest-scale-ready-p')."
  (let* ((root (drgnx-ui-state-root))
         (_ (make-directory root t))
         (_ (drgnx-ui--prune-eln-cache root))
         (_ (drgnx-ui--prune-tombstones root))
         (sess (drgnx-ui--claim-and-launch config size root daemon monitors compositor scales))
         (name (plist-get sess :name))
         (run (plist-get sess :run)))
    (drgnx-ui--own-add name root)
    (drgnx-ui--save sess)                 ; stop needs :launcher/:pgid from here on
    (let ((ready (expand-file-name "ready.json" run))
          (t0 (float-time))
          ;; a session waiting for its lease slot (up to 120 s) is not slow to boot
          (deadline (+ (float-time) (or timeout 60) (if (drgnx-ui--lease-dir) 120 0)))
          (next-probe 0) prompt)
      (while (and (not (file-exists-p ready)) (not prompt))
        (when (or (> (float-time) deadline) (not (drgnx-ui-alive-p sess)))
          (let ((log (drgnx-ui--log-tail sess)))
            (drgnx-ui-stop name)
            (if-let* ((refusal (drgnx-ui--lease-refusal log)))
                (drgnx-ui--fail "%s: %s" name refusal)
              (drgnx-ui--fail "%s did not become ready:\n%s" name log))))
        ;; Still booting after 2 s: is the configuration asking something?  (The server
        ;; and harness agent start before the configuration's init.el.)
        (when (and (> (float-time) (+ t0 2)) (> (float-time) next-probe))
          (setq next-probe (+ (float-time) 1))
          (let ((p (ignore-errors
                     (plist-get (drgnx-ui-call sess "(drgnx-uitest-api-boot-status)" 5) :prompt))))
            (when (stringp p) (setq prompt p))))
        (unless prompt (sleep-for 0.1)))
      (if prompt
          (setq sess (plist-put sess :ready (list :init_running t :prompt prompt
                                                  :init_error :false :server_error :false)))
        (setq sess (plist-put sess :ready (drgnx-ui--read-json ready)))
        (let ((ready-info (plist-get sess :ready)))
          (unless (eq (plist-get ready-info :server_error) :false)
            (drgnx-ui-stop name)
            (drgnx-ui--fail "%s: the session's server did not start: %s"
                            name (plist-get ready-info :server_error)))
          ;; the session waited 10 s for its root frame to show the scale (harness/init/prelude.el)
          (when (stringp (plist-get ready-info :scale_error))
            (drgnx-ui-stop name)
            (drgnx-ui--fail "%s: scale %s not applied (%s)" name
                            (number-to-string (aref (plist-get sess :scales) 0)) (plist-get ready-info :scale_error)))
          (unless (equal (plist-get ready-info :socket) (plist-get sess :socket))
            (drgnx-ui-stop name)
            (drgnx-ui--fail "%s: the configuration moved the session's server to %s (expected %s); \
refusing a session the harness cannot own"
                            name (plist-get ready-info :socket) (plist-get sess :socket)))))
      (drgnx-ui--save sess)
      sess)))

(defun drgnx-ui--check-name (name &optional legacy-ok)
  "Refuse NAME unless it is a session id (drgnx-ui-N-HEX); a legacy drgnx-ui-N is refused with
`drgnx-ui-legacy-message', or let through with LEGACY-OK."
  (cond ((and (stringp name) (string-match-p drgnx-ui-name-regexp name)))
        ((and (stringp name) (string-match-p drgnx-ui-legacy-name-regexp name))
         (or legacy-ok (drgnx-ui--refuse "%s" drgnx-ui-legacy-message)))
        (t (drgnx-ui--refuse "%S is not a drgnx harness session (drgnx-ui-N-HEX)" name))))

(defun drgnx-ui--stop-group (pgid run)
  "TERM process group PGID if it is RUN's session, KILL it if it is still there after 2 s."
  (when (drgnx-ui--group-ours-p pgid run)
    (drgnx-ui--run "kill" "-TERM" "--" (concat "-" pgid))
    (let ((deadline (+ (float-time) 2)))
      (while (and (drgnx-ui--group-ours-p pgid run) (< (float-time) deadline))
        (sleep-for 0.05)))
    (when (drgnx-ui--group-ours-p pgid run)
      (drgnx-ui--run "kill" "-KILL" "--" (concat "-" pgid)))))

(defun drgnx-ui--display-in-use-p (name)
  "Non-nil while some process serves Wayland display NAME."
  (eq 0 (car (drgnx-ui--run "pgrep" "-f" "--" (format "--wayland-display %s " name)))))

(defun drgnx-ui--remove-wayland-display (name)
  "Remove mutter's Wayland socket and lock for display NAME — a killed mutter leaves them
behind — unless a live session (perhaps of another state root) still serves it."
  (unless (drgnx-ui--display-in-use-p name)
    (dolist (f (list name (concat name ".lock")))
      (let ((path (expand-file-name f (drgnx-ui-runtime-dir))))
        (when (file-exists-p path) (delete-file path))))))

(defun drgnx-ui--serving-p (pattern)
  "Non-nil while some process's command line matches PATTERN (an extended regexp)."
  (eq 0 (car (drgnx-ui--run "pgrep" "-f" "--" pattern))))

(defun drgnx-ui--pid-alive-p (pid)
  (and (integerp pid) (> pid 1) (process-attributes pid) t))

(defun drgnx-ui--remove-compositor-files (name run &optional display)
  "Remove what a killed sway, Xvfb or i3 of session NAME (run directory RUN) leaves behind.
The session's runtime directory goes once no process names RUN on its command line.  DISPLAY (\":N\", from
session.json) counts only when RUN reserved it (`drgnx-ui--own-display'); its X socket and lock go only when
the Xvfb this session started (RUN/xvfb.pid) is dead, had listened on N (it wrote N to RUN/xvfb.ready, which
`-displayfd' does only once it listens: an Xvfb that failed to bind owned nothing) and the files are the
user's; the reservation goes once that Xvfb is gone."
  (let ((xdg (drgnx-ui-session-runtime-dir name)))
    (when (and (file-directory-p xdg) (not (drgnx-ui--serving-p (concat (drgnx-ui--ere-quote run) "/"))))
      (delete-directory xdg t)))
  (when-let* ((n (drgnx-ui--own-display display run)))
    (let* ((slurp (lambda (f) (let ((f (expand-file-name f run)))
                                (and (file-regular-p f)
                                     (string-trim (with-temp-buffer (insert-file-contents f) (buffer-string)))))))
           (pid (let ((p (funcall slurp "xvfb.pid"))) (and p (string-to-number p))))
           (listened (equal (funcall slurp "xvfb.ready") (number-to-string n))))
      (unless (drgnx-ui--pid-alive-p pid)
        (when (and listened pid (> pid 1))             ; it ran on N: what it left is its own
          (dolist (f (drgnx-ui--x11-files n))
            (when (eql (file-attribute-user-id (file-attributes f 'integer)) (user-uid))
              (delete-file f))))
        (drgnx-ui--release-display n run)))))

(defun drgnx-ui--ask-to-exit (socket &optional wait)
  "Ask the Emacs listening on SOCKET to exit (its kill-emacs-hook runs: the layout is saved), and wait
up to WAIT seconds (default 5) for its socket to go.  Never blocks longer; errors are ignored."
  (when-let* ((client (executable-find "emacsclient")))
    (ignore-errors (call-process "timeout" nil nil nil "3" client "-s" socket "--eval" "(kill-emacs)"))
    (let ((deadline (+ (float-time) (or wait 5))))
      (while (and (file-exists-p socket) (< (float-time) deadline)) (sleep-for 0.05)))))

(defun drgnx-ui-stop (name &optional legacy-ok)
  "Stop session NAME — Emacs asked to exit first, then the session's processes — and remove its run
and socket directories.  A tombstone (`drgnx-ui--tombstone') says when and why it ended: `stopped', or `reaped'
with LEGACY-OK, which reap passes to also take a legacy drgnx-ui-N."
  (drgnx-ui--check-name name legacy-ok)
  (drgnx-ui--own-remove name)
  (drgnx-ui--prune-tombstones (drgnx-ui-state-root))
  (when (file-directory-p (expand-file-name name (drgnx-ui-state-root)))
    (drgnx-ui--tombstone (drgnx-ui-state-root) name (if legacy-ok 'reaped 'stopped)))
  (let* ((run (expand-file-name name (drgnx-ui-state-root)))
         (sock (drgnx-ui-socket-dir name))
         (file (expand-file-name "session.json" run))
         (sess (and (file-exists-p file) (ignore-errors (drgnx-ui--read-json file))))
         (socket (expand-file-name name sock)))
    ;; SIGTERM to the whole session can take the compositor first; Emacs then loses its display
    ;; and exits without its kill-emacs-hook.
    (when (file-exists-p socket) (drgnx-ui--ask-to-exit socket))
    ;; No :launcher saved yet (a start that failed early) but a pgid file: a detached session.
    (if (or (equal (plist-get sess :launcher) "detached")
            (and (not (plist-get sess :launcher)) (drgnx-ui--read-pgid run)))
        (drgnx-ui--stop-group (or (plist-get sess :pgid) (drgnx-ui--read-pgid run)) run)
      ;; Only our own unit: another state root may run a session with the same name.
      (when (drgnx-ui--unit-owned-p name run)
        (drgnx-ui--run "systemctl" "--user" "stop" name)))
    (drgnx-ui--remove-wayland-display name)
    (drgnx-ui--remove-compositor-files name run (plist-get sess :display))
    (when (file-directory-p run) (delete-directory run t))
    (when (file-directory-p sock) (delete-directory sock t))
    (ignore-errors (delete-directory (file-name-directory sock))))   ; the per-root dir, once empty
  (list :stopped name))

(defun drgnx-ui--yours-p (owner client)
  "Whether a session with OWNER (session.json's :owner) is the caller's: the MCP client with token CLIENT, or, with
no CLIENT (the CLI), a cli-started session of this checkout."
  (if (stringp client)
      (equal (plist-get owner :client) client)
    (and (equal (plist-get owner :kind) "cli")
         (equal (plist-get owner :worktree) (directory-file-name drgnx-ui-repo-dir)))))

(defun drgnx-ui-ls (&optional client)
  "Sessions of this state root, as a vector of plists, each with its :owner and whether it is :yours (an MCP
client passes its token as CLIENT)."
  (let ((root (drgnx-ui-state-root)))
    (vconcat
     (cl-loop for name in (and (file-directory-p root) (directory-files root nil drgnx-ui-name-regexp))
              for file = (expand-file-name "session.json" (expand-file-name name root))
              when (file-exists-p file)
              collect (let ((s (drgnx-ui--read-json file)))
                        (list :name name :active (if (drgnx-ui-alive-p s) t :false)
                              :launcher (or (plist-get s :launcher) "systemd")
                              :config (plist-get s :config) :size (plist-get s :size)
                              :owner (or (plist-get s :owner) :null)
                              :yours (if (drgnx-ui--yours-p (plist-get s :owner) client) t :false)))))))

(defun drgnx-ui--unit-cmdline (name)
  (cdr (drgnx-ui--run "systemctl" "--user" "show" "-p" "ExecStart" "--value" name)))

(defun drgnx-ui-reap-targets (root units cmdline-fn)
  "Sessions of state ROOT: its run dirs, plus live UNITS whose command line points into it.
Units of other state roots (another checkout, a test run) are left alone."
  (let ((names (and (file-directory-p root)
                    (append (directory-files root nil drgnx-ui-name-regexp)
                            (directory-files root nil drgnx-ui-legacy-name-regexp)))))
    (dolist (line (split-string units "\n" t))
      (let ((name (string-remove-suffix ".service" (car (split-string line)))))
        (when (and (or (string-match-p drgnx-ui-name-regexp name) (string-match-p drgnx-ui-legacy-name-regexp name))
                   (string-search (format "DRGNX_UI_RUN=%s/%s" root name)
                                  (or (funcall cmdline-fn name) "")))
          (push name names))))
    (sort (delete-dups names) #'string<)))

(defconst drgnx-ui-test-run-max-days 7
  "Days a failed test run's directory (drgnx-ui-test-*, kept for debugging) is kept.")

(defun drgnx-ui--remove-old-test-runs (root)
  "Delete ROOT's test run directories (drgnx-ui-test-N-HEX, or the older drgnx-ui-test-PID-N) last changed more
than `drgnx-ui-test-run-max-days' ago.  A test run lasts minutes, so none of them is live."
  (let ((cutoff (- (float-time) (* 86400 drgnx-ui-test-run-max-days))))
    (dolist (name (and (file-directory-p root) (directory-files root nil "\\`drgnx-ui-test-[0-9]+-[0-9a-f]+\\'")))
      (let* ((dir (expand-file-name name root))
             (attrs (file-attributes dir)))
        (when (and (eq (file-attribute-type attrs) t)
                   (< (float-time (file-attribute-modification-time attrs)) cutoff))
          (delete-directory dir t))))))

(defconst drgnx-ui-eln-max-days 30
  "Days a native-compiled file in the sessions' shared eln cache is kept after its last use.")

(defun drgnx-ui--prune-eln-cache (root)
  "Delete .eln files in ROOT's shared eln cache (harness/init/prelude.el) unused for
`drgnx-ui-eln-max-days' — last use is the later of access and modification time — then the
directories left empty: the cache of an Emacs no longer run goes with its last file.  Emacs
recreates a directory it compiles into."
  (let ((cache (expand-file-name "eln-cache" root))
        (cutoff (- (float-time) (* 86400 drgnx-ui-eln-max-days))))
    (when (file-directory-p cache)
      (dolist (f (directory-files-recursively cache "\\.eln\\'"))
        (let ((a (file-attributes f)))
          (when (and (eq (file-attribute-type a) nil)
                     (< (max (float-time (file-attribute-access-time a))
                             (float-time (file-attribute-modification-time a)))
                        cutoff))
            (ignore-errors (delete-file f)))))
      ;; deepest first: a directory comes after its contents
      (dolist (d (directory-files-recursively cache "" t))
        (when (eq (file-attribute-type (file-attributes d)) t)
          (ignore-errors (delete-directory d)))))))   ; only if empty

(defun drgnx-ui-reap ()
  "Stop every session of this state root, live or stale; return their names.
Old kept test runs go too (`drgnx-ui--remove-old-test-runs'), and the eln cache is pruned."
  (drgnx-ui--remove-old-test-runs (drgnx-ui-state-root))
  (drgnx-ui--prune-eln-cache (drgnx-ui-state-root))
  (let* ((units (cdr (drgnx-ui--run "systemctl" "--user" "list-units" "drgnx-ui-*" "--all"
                                    "--plain" "--no-legend")))
         (names (drgnx-ui-reap-targets (drgnx-ui-state-root) units #'drgnx-ui--unit-cmdline)))
    (dolist (name names) (drgnx-ui-stop name t))
    (vconcat names)))

(defun drgnx-ui--check-client (sess client adopt)
  "Refuse SESS to the MCP client with token CLIENT when another client started it, unless ADOPT; adopting is
recorded in session.json (:adopted).  A CLIENT-less caller (the CLI) and a session no client started pass."
  (let ((theirs (plist-get (plist-get sess :owner) :client)))
    (when (and (stringp client) (stringp theirs) (not (equal client theirs)))
      (unless adopt
        (let ((owner (plist-get sess :owner)))
          (drgnx-ui--refuse "%s belongs to another client (%s, %s, pid %s); pass adopt: true to drive it"
                            (plist-get sess :name) (plist-get owner :kind) (plist-get owner :worktree)
                            (plist-get owner :pid))))
      (unless (seq-some (lambda (a) (equal (plist-get a :client) client)) (plist-get sess :adopted))
        (setq sess (plist-put sess :adopted (vconcat (plist-get sess :adopted)
                                                     (list (list :client client :at (format-time-string "%FT%T%z"))))))
        (drgnx-ui--save sess))))
  sess)

(defun drgnx-ui--check-tombstone (name)
  "Refuse NAME when a tombstone says the session ended: an id is never reused."
  (let ((tomb (drgnx-ui--read-eld (drgnx-ui--tombstone-file (drgnx-ui-state-root) name))))
    (when tomb
      (drgnx-ui--refuse "%s ended at %s (%s); ids are never reused: start a new session"
                        name (plist-get tomb :ended) (plist-get tomb :reason)))))

(defun drgnx-ui-check-owner (name &rest args)
  "For a command that ends session NAME (ui_stop): its tombstone, then its client, as `drgnx-ui-own-session' checks
them, without needing a live socket.  ARGS: :client and :adopt."
  (drgnx-ui--check-name name)
  (drgnx-ui--check-tombstone name)
  (let ((file (expand-file-name "session.json" (expand-file-name name (drgnx-ui-state-root)))))
    (when (file-exists-p file)
      (drgnx-ui--check-client (drgnx-ui--read-json file) (plist-get args :client) (plist-get args :adopt)))))

(cl-defun drgnx-ui-own-session (name &key client adopt)
  "Session NAME if this harness started it and its socket exists; else signal `drgnx-ui-refused'.
In this order: NAME is a session id (a legacy drgnx-ui-N is refused with `drgnx-ui-legacy-message'); no tombstone
says it ended; session.json is its own (:id, :name, :run, compositor); it was not started by another MCP client
\(CLIENT is the caller's token; ADOPT drives it anyway and records that); its socket exists."
  (drgnx-ui--check-name name)
  (drgnx-ui--check-tombstone name)
  (let* ((run (expand-file-name name (drgnx-ui-state-root)))
         (file (expand-file-name "session.json" run)))
    (unless (file-exists-p file)
      (drgnx-ui--refuse "no harness session %s (see ui_list)" name))
    (let ((sess (drgnx-ui--read-json file))
          (sock (expand-file-name name (drgnx-ui-socket-dir name))))
      ;; the session's Emacs can write its session.json: an id, name or run directory other than the ones the harness
      ;; computed would point the WM, display and frame calls at another session
      (unless (and (equal (plist-get sess :id) name) (equal (plist-get sess :name) name)
                   (equal (plist-get sess :run) run))
        (drgnx-ui--refuse "%s: its session.json names another session (%S, %S)"
                          name (plist-get sess :name) (plist-get sess :run)))
      ;; …or another compositor: every one but mutter has a private runtime directory, so a session.json that says
      ;; mutter there would point frames at the caller's runtime directory (M12c-2-2)
      (when (and (member (plist-get sess :compositor) '(nil "mutter"))
                 (file-directory-p (drgnx-ui-session-runtime-dir name)))
        (drgnx-ui--refuse "%s: its session.json says mutter, but it has a private runtime directory" name))
      (setq sess (drgnx-ui--check-client sess client adopt))
      (unless (and (equal (plist-get sess :socket) sock)
                   (string-prefix-p "s" (or (file-attribute-modes (file-attributes sock)) "")))
        (drgnx-ui--refuse "%s has no live socket (stopped or crashed? see ui_list)" name))
      sess)))

;;;; Driving a session

(defun drgnx-ui-call (sess form &optional timeout)
  "Evaluate FORM (a string) in SESS through its socket; parse the JSON reply.  The form goes as
\(drgnx-uitest-api-as ID FORM): the session answers only if its own id is ID, so no socket path reaches another
session (HARNESS-SESS-1).  A session that does not know `drgnx-uitest-api-as' was started before that."
  (let* ((timeout (or timeout 20))
         (r (drgnx-ui--run-with-timeout timeout (drgnx-ui--emacsclient) "-a" "false"
                                        "-s" (plist-get sess :socket) "-e"
                                        (format "(drgnx-uitest-api-as %s %s)" (drgnx-ui-el (plist-get sess :name)) form))))
    (pcase r
      (`(timeout ,_)
       (drgnx-ui--fail "%s: no answer in %ss (stuck on a prompt? take a ui_screenshot) [%s]"
                       (plist-get sess :name) timeout (truncate-string-to-width form 90 nil nil t)))
      (`(0 ,out) (drgnx-ui-parse-reply out))
      (`(,_ ,out)
       (if (string-match-p "void.*drgnx-uitest-api-as" out)
           (drgnx-ui--refuse "%s" drgnx-ui-legacy-message)
         (drgnx-ui--fail "%s" (string-trim out)))))))

(defconst drgnx-ui-drag-max-steps 200
  "The most movement events one drag may be asked for.  They go out one per 40 ms tick, so 200
take about 8 s — what fits the 10 s the measurement waits for input to be delivered and settle.")

(defun drgnx-ui--drag-point (value what)
  "VALUE as a frame pixel (X . Y) of non-negative integers: a cons, a list or array of two, or an
object with :x and :y (what JSON gives).  WHAT names it in the error."
  (let* ((xy (cond ((and (consp value) (integerp (cdr value))) (list (car value) (cdr value)))
                   ((and (consp value) (keywordp (car value)))
                    (list (plist-get value :x) (plist-get value :y)))
                   ((proper-list-p value) value)
                   ((vectorp value) (append value nil))))
         (ok (and (proper-list-p xy) (= (length xy) 2) (cl-every (lambda (n) (and (integerp n) (>= n 0))) xy))))
    (unless ok
      (drgnx-ui--fail "drag %s must be pixel coordinates (two non-negative integers), got %S" what value))
    (cons (car xy) (cadr xy))))

(defun drgnx-ui--drag-spec (spec)
  "Validate the drag SPEC (:from XY :to XY :steps N :button B); return (FX FY TX TY BUTTON STEPS).
BUTTON defaults to 1, STEPS to nil (the harness's default).  Anything else is a harness error —
never a drag from 0,0."
  (let ((from (drgnx-ui--drag-point (plist-get spec :from) ":from"))
        (to (drgnx-ui--drag-point (plist-get spec :to) ":to"))
        (button (if (plist-member spec :button) (plist-get spec :button) 1))
        (steps (plist-get spec :steps)))
    (unless (memq button '(1 2 3))
      (drgnx-ui--fail "drag button must be 1, 2 or 3, got %S" button))
    (unless (or (null steps) (and (integerp steps) (<= 1 steps drgnx-ui-drag-max-steps)))
      (drgnx-ui--fail "drag steps must be an integer from 1 to %d, got %S" drgnx-ui-drag-max-steps steps))
    (list (car from) (cdr from) (car to) (cdr to) button steps)))

(defun drgnx-ui-act (sess action)
  "Queue ACTION in SESS: (:keys K), (:type T), (:buffer B :text T), (:x X :y Y) or
(:drag (:from (X . Y) :to (X . Y) :steps N :button B)), with optional :button, :count,
:hold_ms (not for :drag).  Returns the API's reply."
  (let ((opts (mapconcat (lambda (k) (drgnx-ui-el (plist-get action k)))
                         '(:button :count :hold_ms) " ")))
    (cond
     ((plist-member action :keys)
      (drgnx-ui-call sess (format "(drgnx-uitest-api-keys %s)" (drgnx-ui-el (plist-get action :keys)))))
     ((plist-member action :type)
      (drgnx-ui-call sess (format "(drgnx-uitest-api-type %s)" (drgnx-ui-el (plist-get action :type)))))
     ((plist-member action :drag)
      (pcase-let ((`(,fx ,fy ,tx ,ty ,button ,steps) (drgnx-ui--drag-spec (plist-get action :drag))))
        (drgnx-ui-call sess (format "(drgnx-uitest-api-drag %d %d %d %d %d %s)" fx fy tx ty button
                                    (drgnx-ui-el steps)))))
     ((and (plist-member action :buffer) (plist-member action :text))
      (drgnx-ui-call sess (format "(drgnx-uitest-api-click-target %s %s %s)"
                                  (drgnx-ui-el (plist-get action :buffer))
                                  (drgnx-ui-el (plist-get action :text)) opts)))
     ((and (plist-member action :x) (plist-member action :y))
      (drgnx-ui-call sess (format "(drgnx-uitest-api-click %d %d %s)"
                                  (truncate (plist-get action :x)) (truncate (plist-get action :y)) opts)))
     (t (drgnx-ui--fail "unknown action %S: use keys, type, buffer+text, x+y or drag" action)))))

(defun drgnx-ui-wait (sess &optional quiet-ms timeout-s)
  "Poll SESS until settled (QUIET-MS without change); t, or nil after TIMEOUT-S."
  (let ((deadline (+ (float-time) (or timeout-s 10))) settled)
    (while (and (not settled) (< (float-time) deadline))
      (if (eq (plist-get (drgnx-ui-call sess (format "(drgnx-uitest-api-status %d)" (or quiet-ms 300)))
                         :settled)
              t)
          (setq settled t)
        (sleep-for 0.05)))
    settled))

(defun drgnx-ui--wait-delivered (sess &optional timeout-s)
  "Poll SESS until its queued input has been delivered and read (at most TIMEOUT-S, default 10)."
  (let ((deadline (+ (float-time) (or timeout-s 10))))
    (while (and (< (float-time) deadline)
                (eq (plist-get (drgnx-ui-call sess "(drgnx-uitest-api-status)") :busy) t))
      (sleep-for 0.04))))

(defun drgnx-ui-measure (sess actions &optional quiet-ms timeout-s)
  "Run ACTIONS (a list of action plists) as one measurement; return the jank report.
An action that fails ends the measurement (the session's recorder stops) and the error names it."
  (drgnx-ui-call sess "(drgnx-uitest-api-measure-begin)")
  (let ((ended nil))
    (unwind-protect
        (let* ((replies (cl-loop for (a . more) on actions
                                 for i from 1
                                 collect (condition-case err
                                             (prog1 (drgnx-ui-act sess a)
                                               ;; A later click is resolved against the layout the
                                               ;; earlier actions produce, so let them run first.
                                               (when more (drgnx-ui--wait-delivered sess)))
                                           (error (drgnx-ui--fail "action %d %S: %s" i a
                                                                  (if (stringp (cadr err)) (cadr err)
                                                                    (error-message-string err)))))))
               (settled (drgnx-ui-wait sess quiet-ms timeout-s))
               (report (progn (setq ended t) (drgnx-ui-call sess "(drgnx-uitest-api-measure-end)"))))
          (append (list :settled (if settled t :false) :actions (vconcat replies)) report))
      (unless ended (ignore-errors (drgnx-ui-call sess "(drgnx-uitest-api-measure-end)" 5))))))

(defun drgnx-ui-state-diff (a b)
  "Changes from state A to state B (both as `drgnx-ui-state' returns them):
plists (:window ID :field F :old O :new N); frame-level fields have :window nil; a window only
in A is (:field \"removed\" :old BUFFER), only in B (:field \"added\" :new BUFFER)."
  (let ((wa (append (plist-get a :windows) nil)) (wb (append (plist-get b :windows) nil)) changes)
    (dolist (k '(:frame :minibuffer_h :children))
      (unless (equal (plist-get a k) (plist-get b k))
        (push (list :window nil :field (substring (symbol-name k) 1) :old (plist-get a k) :new (plist-get b k)) changes)))
    (dolist (w wa)
      (let ((other (seq-find (lambda (x) (equal (plist-get x :id) (plist-get w :id))) wb)))
        (if (not other)
            (push (list :window (plist-get w :id) :field "removed" :old (plist-get w :buffer) :new nil) changes)
          (cl-loop for (k v) on w by #'cddr
                   unless (equal v (plist-get other k))
                   do (push (list :window (plist-get w :id) :field (substring (symbol-name k) 1) :old v :new (plist-get other k)) changes))
          ;; fields only the newer state has
          (cl-loop for (k v) on other by #'cddr
                   unless (plist-member w k)
                   do (push (list :window (plist-get w :id) :field (substring (symbol-name k) 1) :old nil :new v) changes)))))
    (dolist (w wb)
      (unless (seq-find (lambda (x) (equal (plist-get x :id) (plist-get w :id))) wa)
        (push (list :window (plist-get w :id) :field "added" :old nil :new (plist-get w :buffer)) changes)))
    (nreverse changes)))

(defun drgnx-ui-state (sess)
  (drgnx-ui-call sess "(drgnx-uitest-api-state)"))

;;;; The session's window manager (sway, i3)

(defconst drgnx-ui--wm-timeout 5 "Seconds a WM tool may take before it is killed.")

(defun drgnx-ui--wm-run (program &rest args)
  "Run PROGRAM with ARGS for at most `drgnx-ui--wm-timeout' s, without the caller's WM sockets in its
environment; return (EXIT STDOUT STDERR), EXIT `timeout' when it had to be killed."
  (unless (executable-find program) (drgnx-ui--fail "%s is not installed here" program))
  (let* ((process-environment (append '("SWAYSOCK" "I3SOCK") process-environment))
         (out (generate-new-buffer " *drgnx-ui-wm*" t))
         (err (generate-new-buffer " *drgnx-ui-wm-stderr*" t))
         (proc (make-process :name "drgnx-ui-wm" :buffer out :stderr err :command (cons program args)
                             :connection-type 'pipe :noquery t :coding 'utf-8-unix :sentinel #'ignore))
         (stderr (get-buffer-process err))
         (deadline (+ (float-time) drgnx-ui--wm-timeout)))
    (set-process-sentinel stderr #'ignore)    ; no "finished" line in ERR
    (unwind-protect
        (progn
          (while (and (process-live-p proc) (< (float-time) deadline))
            (accept-process-output proc 0.05))
          (let ((live (process-live-p proc)))
            (unless live
              (while (accept-process-output proc 0))
              ;; stderr is a pipe of its own, which reading PROC's output once it exited does not read: read it to
              ;; its end (it closes), within the same deadline
              (while (and (process-live-p stderr) (< (float-time) deadline))
                (accept-process-output stderr 0.05)))
            (list (if live 'timeout (process-exit-status proc))
                  (with-current-buffer out (buffer-string))
                  (with-current-buffer err (buffer-string)))))
      (delete-process proc)
      (when-let* ((p (get-buffer-process err))) (delete-process p))
      (kill-buffer out)
      (kill-buffer err))))

(defun drgnx-ui--own-socket-p (path)
  "Non-nil if PATH is a socket of this user's (not a symlink to one)."
  (let ((a (file-attributes path 'integer)))
    (and a (null (file-attribute-type a)) (string-prefix-p "s" (file-attribute-modes a))
         (eql (file-attribute-user-id a) (user-uid)))))

(defun drgnx-ui--wm-socket (sess)
  "SESS's own WM socket, from the harness's own state (the session's name and the state root), never from
session.json or the caller's $SWAYSOCK/$I3SOCK: sway's is pinned in the session's runtime directory, i3's is
the `ipc-socket' of the i3.conf the harness wrote.  It must be a socket of this user's."
  (let ((sock (pcase (plist-get sess :compositor)
                ("sway" (drgnx-ui--sway-socket (plist-get sess :name)))
                ("i3" (drgnx-ui--i3-socket (plist-get sess :name))))))
    (unless (drgnx-ui--own-socket-p sock)
      (drgnx-ui--fail "%s: no %s socket of yours at %s (has it started?)"
                      (plist-get sess :name) (plist-get sess :compositor) sock))
    sock))

(defun drgnx-ui--wm-msg (sess &rest args)
  "Run SESS's WM client (swaymsg, i3-msg) with its own socket and ARGS; return the parsed JSON reply."
  (let* ((program (if (equal (plist-get sess :compositor) "sway") "swaymsg" "i3-msg"))
         (r (apply #'drgnx-ui--wm-run program "-s" (drgnx-ui--wm-socket sess) args))
         (err-tail (lambda () (string-join (last (split-string (nth 2 r) "\n" t) 5) "\n"))))
    (if (eq (car r) 'timeout)
        (drgnx-ui--fail "%s: %s gave no answer in %ss%s" (plist-get sess :name) program drgnx-ui--wm-timeout
                        (let ((e (funcall err-tail))) (if (string-empty-p e) "" (concat ": " e))))
      ;; an error (exit 2) still prints its JSON reply: the caller sees "success": false
      (condition-case nil (drgnx-ui--parse-json (nth 1 r))
        (error (drgnx-ui--fail "%s: %s failed (exit %s): %s %s" (plist-get sess :name) program (car r)
                               (string-trim (nth 1 r)) (funcall err-tail)))))))

(defun drgnx-ui-wm (sess)
  "SESS's window-manager tree, read only: (:wm \"sway\"|\"i3\" :tree TREE) from the session's own WM, or
\(:wm \"none\") under mutter and bare X11."
  (pcase (plist-get sess :compositor)
    ("sway" (list :wm "sway" :tree (drgnx-ui--wm-msg sess "-t" "get_tree" "-r")))
    ("i3" (list :wm "i3" :tree (drgnx-ui--wm-msg sess "-t" "get_tree")))
    ;; named, but their window lists are not read: tests ask Emacs which monitor a frame is on
    ((and c (or "kwin" "niri")) (list :wm c))
    (_ (list :wm "none"))))

(defun drgnx-ui-wm-command (sess command)
  "Run COMMAND (a sway or i3 command, e.g. \"output HEADLESS-2 disable\") in SESS's own WM; the parsed
reply.  For tests only: neither the CLI nor the MCP server offers it."
  (unless (member (plist-get sess :compositor) '("sway" "i3"))
    (drgnx-ui--fail "%s has no window manager to command" (plist-get sess :name)))
  (apply #'drgnx-ui--wm-msg sess (append (and (equal (plist-get sess :compositor) "sway") '("-r"))
                                         (list "--" command))))

(defun drgnx-ui--display-env (sess)
  "The variables that point a client at SESS's own display (\"K=V\", or \"K\" to unset one of the caller's).
The runtime directory and the X display are the ones the harness made and reserved, not what session.json says."
  (pcase (or (plist-get sess :compositor) "mutter")
    ((and c (or "sway" "kwin" "niri"))
     (let* ((xdg (drgnx-ui-session-runtime-dir (plist-get sess :name)))
            (files (and (file-directory-p xdg) (directory-files xdg)))
            (wl (pcase c
                  ("sway" (seq-find (lambda (f) (string-match-p "\\`wayland-[0-9]+\\'" f)) files))
                  ("kwin" (car (member "wayland-1" files)))   ; its --socket
                  ;; niri's own display, as its IPC socket names it (the sway around it has another)
                  ("niri" (seq-some (lambda (f) (and (string-match "\\`niri\\.\\(wayland-[0-9]+\\)\\.[0-9]+\\.sock\\'" f)
                                                     (match-string 1 f)))
                                    files)))))
       (unless wl (drgnx-ui--fail "%s: %s's Wayland display is not in %s" (plist-get sess :name) c xdg))
       (list (concat "WAYLAND_DISPLAY=" wl) (concat "XDG_RUNTIME_DIR=" xdg) "DISPLAY")))
    ((or "x11" "i3")
     (let ((run (drgnx-ui--session-run sess)))
       (unless (drgnx-ui--own-display (plist-get sess :display) run)
         (drgnx-ui--fail "%s: display %S is not the one the harness reserved for it"
                         (plist-get sess :name) (plist-get sess :display)))
       (list (concat "DISPLAY=" (plist-get sess :display))
             (concat "XAUTHORITY=" (expand-file-name "Xauthority" run)) "WAYLAND_DISPLAY")))
    (_ (list (concat "WAYLAND_DISPLAY=" (plist-get sess :name))
             (concat "XDG_RUNTIME_DIR=" (drgnx-ui-runtime-dir))))))

(defun drgnx-ui--client-env (sess)
  "The whole environment of the emacsclient that opens a frame in SESS: the allowlist (`drgnx-ui-keep-env') and
SESS's display, nothing else of the caller's.  server.el gives a frame its client's environment and drgnx reads
the window-manager variables from the frame first, so the caller's SWAYSOCK, NIRI_SOCKET, XDG_CURRENT_DESKTOP or
session bus would point the frame at the caller's own desktop; without them it falls back to the session's."
  (append (list (concat "HOME=" (expand-file-name "home" (plist-get sess :run))))
          (delq nil (mapcar (lambda (k) (let ((v (getenv k))) (and v (concat k "=" v)))) drgnx-ui-keep-env))
          (seq-filter (lambda (kv) (string-search "=" kv)) (drgnx-ui--display-env sess))))

(defun drgnx-ui-new-frame (sess &optional timeout)
  "Open a frame in daemon session SESS the way a user does: `emacsclient -c'.
Returns (:exit :output :client_ms :visible_ms :hooks) — HOOKS are the slowest frame-hook
functions and hook totals measured in the session."
  (drgnx-ui-call sess "(drgnx-uitest-api-time-frame-hooks)")
  (let* ((before (plist-get (drgnx-ui-call sess "(drgnx-uitest-api-gui-frames)") :visible))
         (process-environment (drgnx-ui--client-env sess))
         (t0 (float-time))
         (r (drgnx-ui--run-with-timeout (or timeout 30) (drgnx-ui--emacsclient) "-a" "false"
                                        "-s" (plist-get sess :socket) "-c" "-n"))
         (client-ms (round (* 1000 (- (float-time) t0))))
         (deadline (+ t0 (or timeout 30)))
         visible-ms)
    (while (and (not visible-ms) (< (float-time) deadline))
      (if (> (or (ignore-errors (plist-get (drgnx-ui-call sess "(drgnx-uitest-api-gui-frames)" 5) :visible)) 0)
             before)
          (setq visible-ms (round (* 1000 (- (float-time) t0))))
        (sleep-for 0.02)))
    (list :exit (if (eq (car r) 'timeout) :null (car r)) :output (string-trim (cadr r))
          :client_ms client-ms :visible_ms (or visible-ms :null)
          :hooks (plist-get (drgnx-ui-call sess "(drgnx-uitest-api-frame-hook-times)") :hooks))))

(defun drgnx-ui-composite-argv (cap out)
  (append (list "magick" (plist-get cap :root))
          (cl-mapcan (lambda (c) (list (plist-get c :path) "-geometry"
                                       (format "+%d+%d" (plist-get c :x) (plist-get c :y)) "-composite"))
                     (append (plist-get cap :children) nil))
          (list out)))

(defun drgnx-ui-screenshot (sess &optional path)
  "PNG of SESS's frame with child frames composited, at PATH (default: the shots dir)."
  (let* ((tmp (make-temp-file (expand-file-name "shot" (expand-file-name "out" (plist-get sess :run))) t))
         (cap (drgnx-ui-call sess (format "(drgnx-uitest-api-screenshot %s)" (drgnx-ui-el tmp))))
         (out (if path
                  (expand-file-name path)
                (let ((shots (expand-file-name "shots" (drgnx-ui-state-root))))
                  (make-directory shots t)
                  (expand-file-name (format "%s-%s.png" (plist-get sess :name)
                                            (format-time-string "%Y%m%d-%H%M%S-%3N"))
                                    shots))))
         (r (apply #'drgnx-ui--run (drgnx-ui-composite-argv cap out))))
    (delete-directory tmp t)
    (unless (eq (car r) 0) (drgnx-ui--fail "compositing failed: %s" (string-trim (cdr r))))
    (list :path out :width (plist-get cap :width) :height (plist-get cap :height)
          :children (length (plist-get cap :children)) :windows (plist-get cap :windows))))

;;;; GUI test runs

(defun drgnx-ui--kill-group (run)
  "KILL the process group of the session started in RUN (only if it is that session)."
  (let ((pgid (drgnx-ui--read-pgid run)))
    (when (drgnx-ui--group-ours-p pgid run)
      (drgnx-ui--run "kill" "-KILL" "--" (concat "-" pgid)))))

(defun drgnx-ui--name-pattern (name)
  "An extended regexp for `pgrep -f' matching command lines with session NAME as a path component (…/NAME/…,
or …/NAME at a word's end), never one that merely contains NAME (…-12-3 in …-12-34)."
  (concat "/" (drgnx-ui--ere-quote name) "(/| |$)"))

(defun drgnx-ui--test-run-argv (name timeout scope script)
  "The command running a test session's SCRIPT as a process group of its own (setsid -w).  With SCOPE (a host
with a systemd user session) it runs in a transient scope NAME.scope, capped like a session's unit: what it
leaves behind can be stopped as one, and it ends 60 s after TIMEOUT at the latest."
  (append (and scope (list "systemd-run" "--user" "--scope" "--quiet" "--collect" "--unit" name
                           "-p" "MemoryMax=3G" "-p" (format "RuntimeMaxSec=%d" (+ timeout 60)) "--"))
          (list "setsid" "-w" "sh" "-c" script)))

(defun drgnx-ui--run-control-env ()
  "The run-control variables of this process that the session's Emacs (started under `env -i') must see:
DRGNX_TEST_NO_TIMING=1 leaves the tests tagged `:timing' out there as it does in a batch run."
  (and (equal (getenv "DRGNX_TEST_NO_TIMING") "1") (list "DRGNX_TEST_NO_TIMING=1")))

(defun drgnx-ui-run-ert-session (tests-dir &optional timeout config extra-env)
  "Run the ERT suite in TESTS-DIR inside a foreground session of CONFIG (default minimal),
with EXTRA-ENV (\"K=V\" strings).  Return (RC RESULTS RUN)."
  (let* ((name (drgnx-ui-next-name (drgnx-ui-state-root) "test"))
         (_ (drgnx-ui--remove-old-test-runs (drgnx-ui-state-root)))   ; failed runs kept long enough
         (_ (drgnx-ui--prune-eln-cache (drgnx-ui-state-root)))
         (sess (let ((drgnx-ui-owner-kind 'test)) (drgnx-ui-prepare-run name config nil)))   ; $DRGNX_UI_SIZE, $DRGNX_UI_SCALE(S)
         (run (plist-get sess :run))
         (results (expand-file-name "results.json" run))
         (pgid-file (expand-file-name "pgid" run))
         (env (drgnx-ui-session-env sess (append (list (concat "DRGNX_UI_TEST=" (expand-file-name tests-dir))
                                                       (concat "DRGNX_UI_RESULTS=" results))
                                                 (drgnx-ui--run-control-env)
                                                 extra-env)))
         (cmd (mapconcat #'shell-quote-argument
                         (append (drgnx-ui-env-argv env) (drgnx-ui-compositor-argv sess)) " "))
         (_ (push (cons :group run) drgnx-ui--own))     ; this process ended meanwhile: its group goes too
         (scope (equal (drgnx-ui-launcher) "systemd"))
         (r (apply #'drgnx-ui--run-with-timeout (or timeout 110)
                   (drgnx-ui--test-run-argv
                    name (or timeout 110) scope
                    (format "echo $$ > %s; exec %s > %s 2>&1" (shell-quote-argument pgid-file) cmd
                            (shell-quote-argument (expand-file-name "session.log" run)))))))
    (setq drgnx-ui--own (delete (cons :group run) drgnx-ui--own))
    (when (eq (car r) 'timeout) (drgnx-ui--kill-group run))
    ;; whatever is left in the scope (a server whose shell was killed) goes with it
    (when scope (drgnx-ui--run "systemctl" "--user" "stop" (concat name ".scope")))
    (drgnx-ui--run "pkill" "-KILL" "-f" "--" (drgnx-ui--name-pattern name))   ; belt and braces
    (drgnx-ui--remove-wayland-display name)
    (drgnx-ui--remove-compositor-files name run (plist-get sess :display))
    (delete-directory (drgnx-ui-socket-dir name) t)
    (ignore-errors (delete-directory (drgnx-ui-socket-dir "")))
    (list (if (eq (car r) 'timeout) 124 (car r))
          (and (file-exists-p results) (drgnx-ui--read-json results))
          run)))

(defun drgnx-ui-run-live-tests (&optional dir)
  "The live suite (DIR, default test/live) the way bin/drgnx check's live shards run it: in a child Emacs under
`drgnx-run-ert-batch' (`drgnx-test-env': a temp HOME, state directory and runtime directory, a dead session bus, no
provider key), its files in one process.  Never in this process: its environment is the user's (URGENT-3-UI-LIVE).
Print the child's output; return non-nil when it passed."
  (let* ((dir (or dir (expand-file-name "test/live" drgnx-ui-repo-dir)))
         (done nil) (code nil)
         (process-environment (append (list "DRGNX_TEST_ONE_PROCESS=1") (drgnx-test-env-outer) process-environment))
         (p (make-process
             :name "drgnx-ui-live" :noquery t :connection-type 'pipe :buffer nil
             :command (list (or (getenv "DRGNX_EMACS") (expand-file-name invocation-name invocation-directory))
                            "--batch" "-Q" "--eval" "(setq load-prefer-newer t)" "-L" (directory-file-name drgnx-ui-harness-dir) "-L" (expand-file-name "core" drgnx-ui-repo-dir)
                            "-L" (expand-file-name "wb" drgnx-ui-repo-dir)
                            "-l" "drgnx-ui" "-l" (expand-file-name "run-ert.el" drgnx-ui-harness-dir)
                            "-f" "drgnx-run-ert-batch" (expand-file-name dir))
             :filter (lambda (_p s) (princ s))
             :sentinel (lambda (proc _e)
                         (unless (process-live-p proc) (setq code (process-exit-status proc) done t))))))
    (while (not done) (accept-process-output p 0.2))
    (eql code 0)))

(defun drgnx-ui-run-ui-tests ()
  "`drgnx test --ui': the GUI suite in a session, then the live suite in a sandboxed Emacs.  Return an exit code."
  (let* ((t0 (float-time))
         (ok (eq 0 (drgnx-ui-run-ui-session-tests))))
    (setq ok (and (drgnx-ui-run-live-tests) ok))
    (princ (format "ui tier: %s in %.1fs\n" (if ok "green" "RED") (- (float-time) t0)))
    (if ok 0 1)))

(defun drgnx-ui--harness-lines (log)
  "The lines of the file LOG that the harness's session scripts wrote (they start with \"drgnx harness: \")."
  (and (file-readable-p log)
       (with-temp-buffer
         (insert-file-contents log)
         (seq-filter (lambda (l) (string-prefix-p "drgnx harness: " l)) (split-string (buffer-string) "\n" t)))))

(defun drgnx-ui-run-ui-session-tests ()
  "The GUI suite (test/ui) in a session — the first half of `drgnx test --ui', alone for bin/drgnx check (which
runs the live suite in shards).  Return an exit code."
  (require 'drgnx-run-ert (expand-file-name "run-ert.el" drgnx-ui-harness-dir))
  (let* ((timeout (string-to-number (or (getenv "DRGNX_UI_TEST_TIMEOUT") "110")))
         (selector (let ((s (getenv "DRGNX_TEST_SELECTOR"))) (and s (not (string-empty-p s)) s)))
         ;; read here first: a selector that does not read fails now, not after a session started
         (_ (when selector
              (condition-case err (read-from-string selector)
                (error (drgnx-ui--fail "DRGNX_TEST_SELECTOR %S is not an ERT selector: %s"
                                       selector (error-message-string err))))))
         ;; a narrowed run stays narrow in the session too
         (res (drgnx-ui-run-ert-session (expand-file-name "test/ui" drgnx-ui-repo-dir) timeout nil
                                        (and selector (list (concat "DRGNX_TEST_SELECTOR=" selector)))))
         (rc (nth 0 res)) (results (nth 1 res)) (run (nth 2 res))
         (ok (and (eq rc 0) results (eq (plist-get results :failed) 0))))
    (if results
        (progn
          (princ (format "ui ERT: %s/%s passed%s\n" (plist-get results :passed) (plist-get results :total)
                         (if selector (format " (selector %s)" selector) "")))
          (seq-doseq (f (plist-get results :failures))
            (princ (format "  FAIL %s: %s\n" (plist-get f :name) (plist-get f :condition)))))
      (princ (format "ui ERT: no results (exit %s); log kept in %s\n" rc run))
      ;; what the harness wrote to the session's log (a scale gdctl could not set): in a container, the log goes with it
      (dolist (l (drgnx-ui--harness-lines (expand-file-name "session.log" run))) (princ (concat "  " l "\n"))))
    (when ok (delete-directory run t))
    (if ok 0 1)))

(defun drgnx-ui--config-name (config)
  "Scenario name of CONFIG: minimal, gryphn, drgnx, or a directory's base name."
  (if (member config '("minimal" "gryphn" "drgnx")) config
    (file-name-nondirectory (directory-file-name config))))

(defun drgnx-ui--read-eld (file)
  (and (file-exists-p file) (with-temp-buffer (insert-file-contents file) (read (current-buffer)))))

(defun drgnx-ui--frame-scenario (config dir)
  "The new-frame budget of suite DIR (its frames.eld) on CONFIG: open frames in a daemon
session with emacsclient -c and compare the median time-to-visible with the budget.
Prints the outcome; returns non-nil if it was as expected."
  (let* ((spec (drgnx-ui--read-eld (expand-file-name "frames.eld" dir)))
         (budget (alist-get 'budget-ms spec 500))
         (n (alist-get 'frames spec 3))
         (name 'drgnx-scenario/frame-from-daemon-fast)
         (known (memq name (cdr (assq (intern (drgnx-ui--config-name config))
                                      (drgnx-ui--read-eld (expand-file-name "known-red.eld" dir))))))
         (s (drgnx-ui-start config nil 60 t))
         times exits hooks)
    (unwind-protect
        (dotimes (_ n)
          (let ((f (drgnx-ui-new-frame (drgnx-ui-own-session (plist-get s :name)))))
            (push (plist-get f :visible_ms) times)
            (push (plist-get f :exit) exits)
            (unless hooks (setq hooks (plist-get f :hooks)))))   ; the first frame's
      (drgnx-ui-stop (plist-get s :name)))
    (pcase-let ((`(,outcome . ,detail) (drgnx-ui--frame-outcome (reverse times) (reverse exits) budget known)))
      (princ (pcase outcome
               ('green (format "  green        %s (%s)\n" name detail))
               ('known (format "  red (known)  %s: %s\n" name detail))
               (_ (format "  RED          %s: %s\n" name detail))))
      (unless (eq outcome 'green)
        (seq-doseq (h hooks) (princ (format "                 first frame: %s %d ms\n" (plist-get h :name) (plist-get h :ms)))))
      (memq outcome '(green known)))))

(defun drgnx-ui--frame-outcome (times exits budget known)
  "Judge frame TIMES (ms, :null when never visible) with emacsclient EXITS against BUDGET.
Returns (OUTCOME . DETAIL): `green', `known' (a known red, over budget), `red' (over budget,
or a known red that is now within it) or `error' (a frame never appeared or emacsclient
failed — never a known red)."
  (let* ((ms (sort (seq-filter #'numberp times) #'<))
         (median (and ms (= (length ms) (length times)) (nth (/ (length ms) 2) ms)))
         (frames (mapconcat (lambda (v) (format "%s" v)) times ", ")))
    (cond
     ((or (null median) (seq-some (lambda (e) (not (eql e 0))) exits))
      (cons 'error (format "a frame did not appear or emacsclient failed (frames: %s; exits: %s)"
                           frames (mapconcat (lambda (v) (format "%s" v)) exits ", "))))
     ((<= median budget)
      (cons (if known 'red 'green)
            (format "%smedian %d ms <= budget %d ms (frames: %s)" (if known "known red, but " "") median budget frames)))
     (t (cons (if known 'known 'red) (format "median %d ms > budget %d ms (frames: %s)" median budget frames))))))

(defun drgnx-ui-run-scenarios (&optional config dir)
  "`drgnx test --scenario': run the scenario suite DIR (default test/scenario) in a session of
CONFIG (default drgnx) and print each scenario: green, red (known) with its trace, RED
(unexpected) or skipped.  Return an exit code: 0 unless a result was unexpected."
  (require 'drgnx-run-ert (expand-file-name "run-ert.el" drgnx-ui-harness-dir))
  (let ((drgnx-ui-session-tier 'scenario)
        (config (or config "drgnx"))
        (dir (expand-file-name (or dir "test/scenario") drgnx-ui-repo-dir))
        (t0 (float-time)))
    (cond
     ((and (equal config "gryphn") (not (ignore-errors (drgnx-ui-resolve-config "gryphn"))))
      (princ "scenarios: the gryphn configuration is not on this machine; skipped\n")
      0)
     ((and (not (equal config "minimal"))
           (condition-case err (progn (drgnx-ui-resolve-config config) nil)
             (drgnx-ui-error (princ (format "scenarios: %s\n" (error-message-string err))) t)))
      2)
     (t
      (pcase-let ((`(,rc ,results ,run)
                   (drgnx-ui-run-ert-session
                    dir (string-to-number (or (getenv "DRGNX_SCENARIO_TIMEOUT") "300")) config
                    (append (list (concat "DRGNX_SCENARIO_CONFIG=" (drgnx-ui--config-name config)))
                            ;; a narrowed run stays narrow in the session too (M12f-A3-1)
                            (let ((s (getenv "DRGNX_TEST_SELECTOR")))
                              (and s (not (string-empty-p s)) (list (concat "DRGNX_TEST_SELECTOR=" s))))))))
        (if (not results)
            (progn (princ (format "scenarios (%s): no results (exit %s); log kept in %s\n" config rc run)) 1)
          (let ((reds (append (plist-get results :known_red) nil))
                (fails (append (plist-get results :failures) nil)))
            (princ (format "scenarios on %s:\n" config))
            (seq-doseq (test (plist-get results :tests))
              (let* ((name (plist-get test :name))
                     (red (seq-find (lambda (r) (equal (plist-get r :name) name)) reds))
                     (fail (seq-find (lambda (f) (equal (plist-get f :name) name)) fails)))
                (cond
                 (fail (princ (format "  RED          %s: %s\n" name (plist-get fail :condition))))
                 (red (princ (format "  red (known)  %s: %s\n" name (plist-get red :summary)))
                      (seq-doseq (line (plist-get red :trace)) (princ (format "                 %s\n" line))))
                 ((equal (plist-get test :result) "skipped") (princ (format "  skipped      %s\n" name)))
                 (t (princ (format "  green        %s\n" name))))))
            (dolist (f fails)                    ; load failures have no test entry
              (when (string-prefix-p "load " (plist-get f :name))
                (princ (format "  RED          %s: %s\n" (plist-get f :name) (plist-get f :condition)))))
            (let ((ok (and (eq rc 0) (null fails)))
                  (kept (expand-file-name (format "scenarios/%s.json" (drgnx-ui--config-name config))
                                          (drgnx-ui-state-root))))
              ;; The last results per configuration stay, for docs and comparisons.
              (make-directory (file-name-directory kept) t)
              (copy-file (expand-file-name "results.json" run) kept t)
              (princ (format "results: %s\n" kept))
              (when ok (delete-directory run t))
              (when (file-exists-p (expand-file-name "frames.eld" dir))
                (setq ok (and (drgnx-ui--frame-scenario config dir) ok)))
              (princ (format "scenario tier: %s in %.1fs\n" (if ok "as expected" "UNEXPECTED RESULTS")
                             (- (float-time) t0)))
              (if ok 0 1)))))))))

;;;; Command line

(defconst drgnx-ui-usage "usage: drgnx ui COMMAND
  start [--config minimal|drgnx|gryphn|DIR] [--size WxH] [--daemon] [--monitors N]
        [--compositor mutter|sway|x11|i3|kwin|niri]   start a session (--daemon: no frame yet)
  frame NAME                                          open a frame in a daemon session (emacsclient -c)
  wm NAME                                             the session's own sway or i3 tree (read only)
  stop NAME | ls | reap                               stop one / list / stop all of this state root
  state NAME                                          frame, windows, child frames
  shot NAME [PATH]                                    screenshot (child frames composited)
  click NAME X Y | click NAME --buffer B --text T     [--button N] [--count N] [--hold-ms N]
  keys NAME KEYS | type NAME TEXT                     kbd syntax / literal text
  measure NAME ACTIONS-JSON                           several actions, one jank report
  mcp                                                 serve the drgnx-ui MCP tools on stdio
  test-ui                                             the --ui test tier
  test-ui-session                                     its test/ui half alone (bin/drgnx check)
See docs/develop/harness.md.")

(defconst drgnx-ui--boolean-flags '("--daemon") "CLI options that take no value.")

(defun drgnx-ui--parse-args (args)
  "Split ARGS into (POSITIONAL . OPTIONS); `--some-name VALUE' becomes :some_name VALUE,
a boolean flag (`drgnx-ui--boolean-flags') becomes :name t."
  (let (pos opts)
    (while args
      (let ((a (pop args)))
        (if (string-prefix-p "--" a)
            (let ((key (intern (concat ":" (string-replace "-" "_" (substring a 2))))))
              (if (member a drgnx-ui--boolean-flags)
                  (setq opts (plist-put opts key t))
                (unless args (drgnx-ui--fail "%s needs a value" a))
                (setq opts (plist-put opts key (pop args)))))
          (push a pos))))
    (cons (nreverse pos) opts)))

(defun drgnx-ui--click-action (pos opts)
  (append (if (plist-get opts :buffer)
              (list :buffer (plist-get opts :buffer) :text (plist-get opts :text))
            (unless (and (stringp (nth 1 pos)) (stringp (nth 2 pos))
                         (string-match-p "\\`[0-9]+\\'" (nth 1 pos)) (string-match-p "\\`[0-9]+\\'" (nth 2 pos)))
              (drgnx-ui--fail "click needs X Y in pixels (non-negative integers) or --buffer B --text T, got %S"
                              (cdr pos)))
            (list :x (string-to-number (nth 1 pos)) :y (string-to-number (nth 2 pos))))
          (cl-loop for k in '(:button :count :hold_ms)
                   when (plist-get opts k) append (list k (string-to-number (plist-get opts k))))))

(defun drgnx-ui--dispatch (cmd args)
  "Run CLI command CMD with ARGS; return a value to print as JSON, or an exit code."
  (pcase-let* ((`(,pos . ,opts) (drgnx-ui--parse-args args))
               (name (car pos)))
    (pcase cmd
      ("start" (drgnx-ui-start (plist-get opts :config) (plist-get opts :size) nil (plist-get opts :daemon)
                               (let ((m (plist-get opts :monitors)))
                                 (and m (if (string-match-p "\\`[1-9][0-9]*\\'" m) (string-to-number m)
                                          (drgnx-ui--fail "--monitors needs a whole number above 0, got %S" m))))
                               (plist-get opts :compositor)))
      ("frame" (drgnx-ui-new-frame (drgnx-ui-own-session name)))
      ("wm" (drgnx-ui-wm (drgnx-ui-own-session name)))
      ("stop" (drgnx-ui-stop name))
      ("ls" (drgnx-ui-ls))
      ("reap" (drgnx-ui-reap))
      ("state" (drgnx-ui-state (drgnx-ui-own-session name)))
      ("shot" (drgnx-ui-screenshot (drgnx-ui-own-session name) (nth 1 pos)))
      ("click" (drgnx-ui-measure (drgnx-ui-own-session name) (list (drgnx-ui--click-action pos opts))))
      ("keys" (drgnx-ui-measure (drgnx-ui-own-session name) (list (list :keys (nth 1 pos)))))
      ("type" (drgnx-ui-measure (drgnx-ui-own-session name) (list (list :type (nth 1 pos)))))
      ("measure" (drgnx-ui-measure (drgnx-ui-own-session name)
                                   (append (drgnx-ui--parse-json (or (nth 1 pos) "[]")) nil)))
      ("test-ui" (drgnx-ui-run-ui-tests))
      ("test-ui-session" (drgnx-ui-run-ui-session-tests))
      ("test-scenario" (drgnx-ui-run-scenarios (plist-get opts :config) (plist-get opts :dir)))
      ("test-bench" (require 'drgnx-bench) (let ((drgnx-ui-session-tier 'bench)) (drgnx-bench-run)))
      ("test-perf" (require 'drgnx-perf-run)
       (let ((drgnx-ui-session-tier 'perf))
         (cond
          ((getenv "DRGNX_PERF_AB")
           (drgnx-perf-ab (getenv "DRGNX_PERF_AB") :n (string-to-number (or (getenv "DRGNX_PERF_AB_N") "100"))))
          ((getenv "DRGNX_PERF_AB_ENV")
           (drgnx-perf-ab-env (getenv "DRGNX_PERF_AB_ENV") :n (string-to-number (or (getenv "DRGNX_PERF_AB_N") "100"))))
          (t (drgnx-perf-run (getenv "DRGNX_PERF_AUDIT"))))))
      ("test-soak" (require 'drgnx-perf-run)
       (let ((drgnx-ui-session-tier 'perf)) (drgnx-perf-soak (and (car pos) (string-to-number (car pos))))))
      ("mcp" (require 'drgnx-ui-mcp) (drgnx-ui-mcp-main))
      (_ (drgnx-ui--fail "unknown command %S\n%s" cmd drgnx-ui-usage)))))

(defun drgnx-ui-batch-setup ()
  "UTF-8 for stdout, process arguments and files, whatever the caller's locale."
  (set-language-environment "UTF-8")
  (setq locale-coding-system 'utf-8-unix))

(defun drgnx-ui--decode-arg (arg)
  "ARG as text: without a UTF-8 locale Emacs leaves the command line as raw bytes (it is decoded
before `drgnx-ui-batch-setup' runs), so a unibyte argument is decoded as UTF-8."
  (if (multibyte-string-p arg) arg (decode-coding-string arg 'utf-8)))

(defun drgnx-ui-cli ()
  "Entry point for `drgnx ui' (batch): run the command in `command-line-args-left', exit."
  (drgnx-ui-batch-setup)
  (let* ((args (prog1 (mapcar #'drgnx-ui--decode-arg
                              (if (equal (car command-line-args-left) "--")
                                  (cdr command-line-args-left)
                                command-line-args-left))
                 (setq command-line-args-left nil)))
         (cmd (car args)))
    ;; the test tiers' sessions are theirs alone: a tier ended early (C-c) stops them on the way out
    (when (and (stringp cmd) (string-prefix-p "test-" cmd)) (setenv "DRGNX_UI_STOP_ON_EXIT" "1"))
    (kill-emacs
     (if (member cmd '(nil "help" "-h" "--help"))
         (progn (princ drgnx-ui-usage) (terpri) 0)
       (condition-case err
           (let ((out (drgnx-ui--dispatch cmd (cdr args))))
             (if (integerp out)
                 out
               (princ (drgnx-ui--json out)) (terpri) 0))
         (drgnx-ui-error (message "drgnx ui: %s" (error-message-string err)) 1))))))

(provide 'drgnx-ui)
