;;; Commentary:
;; The high-contrast theme, generated from themes/drgnx-tokens.eld by `drgnx-theme-define': no tints, no shadow faces,
;; every text pair at least 7:1.

;;; Code:
(require 'drgnx-theme-gen (expand-file-name "drgnx-theme-gen" (file-name-directory (or load-file-name buffer-file-name))))
(drgnx-theme-define drgnx-high-contrast hc)
