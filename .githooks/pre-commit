#!/usr/bin/env bash
# drgnx pre-commit: this repository is public. Refuse commits that add secrets or personal
# machine details. Scans only the lines being added. Bypass is not allowed (no --no-verify).
set -euo pipefail

patterns=(
  'sk-or-v1-[A-Za-z0-9]{20,}'          # OpenRouter keys
  'sk-ant-[A-Za-z0-9_-]{20,}'          # Anthropic keys
  'sk-[A-Za-z0-9]{32,}'                # OpenAI-style keys
  'gh[pousr]_[A-Za-z0-9]{30,}'         # GitHub tokens
  'AKIA[0-9A-Z]{16}'                   # AWS access keys
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  '/home/[a-z][a-z0-9_-]*/'            # absolute home paths
  '/Users/[A-Za-z][A-Za-z0-9_-]*/'
  '\.claude/projects/'                 # agent session paths
)
pattern="$(IFS='|'; echo "${patterns[*]}")"

# Added lines only, excluding this hook itself.
hits="$(git diff --cached -U0 --no-color -- . ':(exclude).githooks/pre-commit' \
          | grep -E '^\+[^+]' | grep -nE -- "$pattern" || true)"
if [ -n "$hits" ]; then
  echo "pre-commit: refusing to commit secrets or personal paths into a public repo:" >&2
  echo "$hits" | sed 's/^/  /' >&2
  exit 1
fi

# Never commit environment or secrets files.
if git diff --cached --name-only | grep -qE '(^|/)(\.env(\..*)?|secrets\.env|.*\.pem|.*\.key)$'; then
  echo "pre-commit: refusing to commit an env/secrets/key file." >&2
  exit 1
fi

# Emacs Lisp is formatted (bin/drgnx fmt): the staged content of every added or changed .el file.
mapfile -t el < <(git diff --cached --name-only --diff-filter=ACMR -- '*.el')
if [ "${#el[@]}" -gt 0 ]; then
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  top="$(git rev-parse --show-toplevel)"
  for f in "${el[@]}"; do mkdir -p "$tmp/$(dirname "$f")"; git show ":$f" > "$tmp/$f"; done
  if ! out="$(cd "$tmp" && "$top/bin/drgnx" fmt --check "${el[@]}" 2>&1)"; then
    echo "pre-commit: Emacs Lisp not formatted — run bin/drgnx fmt (or bin/drgnx fmt FILE…):" >&2
    echo "$out" | sed "s/^/  /" >&2
    exit 1
  fi
fi
