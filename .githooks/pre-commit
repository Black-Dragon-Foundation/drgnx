#!/usr/bin/env bash
# drgnx pre-commit: this repository is public. Refuse commits that add secrets or personal
# machine details. Scans only the lines being added. Bypass is not allowed (no --no-verify).
set -euo pipefail

patterns=(
  'sk-or-v1-[A-Za-z0-9]{20,}'          # OpenRouter keys
  'sk-ant-[A-Za-z0-9_-]{20,}'          # Anthropic keys
  'sk-[A-Za-z0-9]{32,}'                # OpenAI-style keys
  '(^|[^A-Za-z0-9])sk-(proj|svcacct|admin)-[A-Za-z0-9_-]{20,}'  # OpenAI project, service account, admin keys (not inside a word: desk-admin-…)
  'gh[pousr]_[A-Za-z0-9]{30,}'         # GitHub tokens
  'github_pat_[A-Za-z0-9_]{22,}'       # GitHub fine-grained tokens
  'AKIA[0-9A-Z]{16}'                   # AWS access keys
  'AGE-SECRET-KEY-1[0-9A-Z]{58}'          # age identities
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  '/home/[a-z][a-z0-9_-]*/'            # absolute home paths
  '/Users/[A-Za-z][A-Za-z0-9_-]*/'
  '\.claude/projects/'                 # agent session paths
)
pattern="$(IFS='|'; echo "${patterns[*]}")"
secret_files='(^|/)(\.env(\..*)?|secrets\.env|.*\.pem|.*\.key)$'

# --all (CI): the same checks over every tracked file instead of the staged lines.
if [ "${1:-}" = --all ]; then
  hits="$(git grep -nIE -e "$pattern" -- . ':(exclude).githooks/pre-commit' || true)"
  files="$(git ls-files | grep -E "$secret_files" || true)"
  [ -z "$hits" ] || { echo "leak scan: secrets or personal paths in tracked files:" >&2; echo "$hits" | sed 's/^/  /' >&2; }
  [ -z "$files" ] || { echo "leak scan: env/secrets/key files are tracked:" >&2; echo "$files" | sed 's/^/  /' >&2; }
  [ -z "$hits$files" ] || exit 1
  echo "leak scan: clean"
  exit 0
fi

# Added lines only, excluding this hook itself.
hits="$(git diff --cached -U0 --no-color -- . ':(exclude).githooks/pre-commit' \
          | grep -E '^\+[^+]' | grep -nE -- "$pattern" || true)"
if [ -n "$hits" ]; then
  echo "pre-commit: refusing to commit secrets or personal paths into a public repo:" >&2
  echo "$hits" | sed 's/^/  /' >&2
  exit 1
fi

# Never commit environment or secrets files.
if git diff --cached --name-only | grep -qE "$secret_files"; then
  echo "pre-commit: refusing to commit an env/secrets/key file." >&2
  exit 1
fi

# The standards (docs/develop/standards/README.md) over the staged files: the table's checks and each file's findings.
# DRGNX_XTASK names another way to run `cargo xtask` (one that builds elsewhere); unset, it is cargo itself.
top="$(git rev-parse --show-toplevel)"
if [ -f "$top/standards.toml" ]; then
  mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
  # shellcheck disable=SC2086 # DRGNX_XTASK is a command line
  (cd "$top" && ${DRGNX_XTASK:-cargo xtask} standards --changed "${staged[@]}") || {
    echo "pre-commit: the standards refuse this commit (cargo xtask standards; docs/develop/standards/README.md)." >&2
    exit 1
  }
fi
